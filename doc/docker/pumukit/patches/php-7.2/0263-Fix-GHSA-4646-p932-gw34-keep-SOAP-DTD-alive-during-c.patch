From: Jakub Zelenka <bukka@php.net>
Date: Sun, 1 Nov 2026 15:18:09 +0100
Subject: Fix GHSA-4646-p932-gw34: keep SOAP DTD alive during cleanup

(cherry picked from commit 66db5cda7df3d7a0e1fc7b171bd9ca318fca49fb)
(cherry picked from commit 47f8976103f6022dc10d12eed151b2bc2980ac72)
(cherry picked from commit 57d625e81be43c2f21fcfbde4d508220f50ef2a5)
(cherry picked from commit 0289ac37e28d8be9937328980e6b82ad97937c43)
(cherry picked from commit 43f1e582da656d8f9a213d89a03e0ea439bdaeea)
---
 ext/soap/php_xml.c                      |  3 +++
 ext/soap/tests/GHSA-4646-p932-gw34.phpt | 35 +++++++++++++++++++++++++++++++++
 2 files changed, 38 insertions(+)
 create mode 100644 ext/soap/tests/GHSA-4646-p932-gw34.phpt

diff --git a/ext/soap/php_xml.c b/ext/soap/php_xml.c
index 0e3339f..5a18051 100644
--- a/ext/soap/php_xml.c
+++ b/ext/soap/php_xml.c
@@ -53,6 +53,9 @@ static void cleanup_xml_node(xmlNodePtr node)
 				xmlUnlinkNode(trav);
 				xmlFreeNode(trav);
 			}
+		} else if (trav->type == XML_DTD_NODE) {
+			/* Attribute-value entity references can share content with the DTD.
+			 * Keep it alive until the document itself is freed. */
 		} else if ((trav->type != XML_ELEMENT_NODE) &&
 		           (trav->type != XML_CDATA_SECTION_NODE)) {
 			xmlUnlinkNode(trav);
diff --git a/ext/soap/tests/GHSA-4646-p932-gw34.phpt b/ext/soap/tests/GHSA-4646-p932-gw34.phpt
new file mode 100644
index 0000000..8e3567d
--- /dev/null
+++ b/ext/soap/tests/GHSA-4646-p932-gw34.phpt
@@ -0,0 +1,35 @@
+--TEST--
+GHSA-4646-p932-gw34: DTD entity references must not outlive their declarations
+--POST--
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE Envelope [<!ENTITY e "boom">]>
+<SOAP-ENV:Envelope xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/"
+                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+                   xmlns:xsd="http://www.w3.org/2001/XMLSchema"
+                   xmlns:ns1="urn:t">
+  <SOAP-ENV:Header>
+    <h SOAP-ENV:actor="&e;" SOAP-ENV:mustUnderstand="1"/>
+  </SOAP-ENV:Header>
+  <SOAP-ENV:Body>
+    <ns1:echo_><param0 xsi:type="xsd:string">x</param0></ns1:echo_>
+  </SOAP-ENV:Body>
+</SOAP-ENV:Envelope>
+--EXTENSIONS--
+soap
+--FILE--
+<?php
+function echo_($x) {
+    return $x;
+}
+
+$server = new SoapServer(null, [
+    'uri' => 'urn:t',
+    'style' => SOAP_RPC,
+    'use' => SOAP_ENCODED,
+]);
+$server->addFunction('echo_');
+$server->handle();
+?>
+--EXPECT--
+<?xml version="1.0" encoding="UTF-8"?>
+<SOAP-ENV:Envelope xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/"><SOAP-ENV:Body><SOAP-ENV:Fault><faultcode>SOAP-ENV:Server</faultcode><faultstring>DTD are not supported by SOAP</faultstring></SOAP-ENV:Fault></SOAP-ENV:Body></SOAP-ENV:Envelope>
