From: =?utf-8?b?T25kxZllaiBTdXLDvQ==?= <ondrej@sury.org>
Date: Tue, 17 Nov 2026 08:42:19 +0100
Subject: fix GHSA-qc49 test for 7.3 and older (no arrow functions,
 no short list syntax)

(cherry picked from commit 496179af56a1f4eb947db332dfc34e93cacf2dbf)
---
 sapi/fpm/tests/unread-body-keep-conn.phpt      | 8 ++++----
 sapi/fpm/tests/unread-body-partial-record.phpt | 8 ++++----
 2 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/sapi/fpm/tests/unread-body-keep-conn.phpt b/sapi/fpm/tests/unread-body-keep-conn.phpt
index 42a9d3e..75f61c4 100644
--- a/sapi/fpm/tests/unread-body-keep-conn.phpt
+++ b/sapi/fpm/tests/unread-body-keep-conn.phpt
@@ -15,9 +15,9 @@ function record(int $type, string $content, int $id): string
 function params(array $params): string
 {
     $encoded = '';
-    $encodeLength = static fn(int $length): string => $length < 128
-        ? chr($length)
-        : pack('N', $length | 0x80000000);
+    $encodeLength = static function (int $length): string {
+        return $length < 128 ? chr($length) : pack('N', $length | 0x80000000);
+    };
     foreach ($params as $name => $value) {
         $encoded .= $encodeLength(strlen($name)) . $encodeLength(strlen($value)) . $name . $value;
     }
@@ -35,7 +35,7 @@ function request(int $id, bool $keep, array $params, string $stdin): string
 
 function transact(string $address, string $request): string
 {
-    [$host, $port] = explode(':', $address);
+    list($host, $port) = explode(':', $address);
     $socket = fsockopen($host, (int) $port);
     stream_set_timeout($socket, 3);
     $written = 0;
diff --git a/sapi/fpm/tests/unread-body-partial-record.phpt b/sapi/fpm/tests/unread-body-partial-record.phpt
index 5bd1ea7..2b819b7 100644
--- a/sapi/fpm/tests/unread-body-partial-record.phpt
+++ b/sapi/fpm/tests/unread-body-partial-record.phpt
@@ -15,9 +15,9 @@ function record(int $type, string $content, int $id): string
 function params(array $params): string
 {
     $encoded = '';
-    $encodeLength = static fn(int $length): string => $length < 128
-        ? chr($length)
-        : pack('N', $length | 0x80000000);
+    $encodeLength = static function (int $length): string {
+        return $length < 128 ? chr($length) : pack('N', $length | 0x80000000);
+    };
     foreach ($params as $name => $value) {
         $encoded .= $encodeLength(strlen($name)) . $encodeLength(strlen($value)) . $name . $value;
     }
@@ -35,7 +35,7 @@ function request(int $id, bool $keep, array $params, string $stdin): string
 
 function transact(string $address, string $request): string
 {
-    [$host, $port] = explode(':', $address);
+    list($host, $port) = explode(':', $address);
     $socket = fsockopen($host, (int) $port);
     stream_set_timeout($socket, 3);
     $written = 0;
