{% extends '@Shared/Views/layout/layout.html.twig' %}

{% block body %}
<div class="container-fluid mt-3">
    {% include '@Shared/Views/partials/_title.html.twig' with {'page_title': 'media_processing.page.list'|trans({}, 'media_processing')} %}

    {% include '@Shared/Views/components/table/_table.html.twig' with {
        id: 'jobsTable',
        title: 'media_processing.table.title'|trans({}, 'media_processing'),
        server_side: true,
        ajax_url: path('media_processing_jobs_list_data'),
        checkbox: true,
        columns: [
            {'field': 'mm_id', 'label': 'media_processing.table.multimedia_object'|trans({}, 'media_processing'), 'sortable': true},
            {'field': 'profile', 'label': 'media_processing.table.profile'|trans({}, 'media_processing'), 'sortable': true},
            {'field': 'status', 'label': 'media_processing.table.status'|trans({}, 'media_processing'), 'sortable': true},
            {'field': 'priority', 'label': 'media_processing.table.priority'|trans({}, 'media_processing'), 'sortable': true},
            {'field': 'cpu', 'label': 'media_processing.table.cpu'|trans({}, 'media_processing')},
            {'field': 'timeini', 'label': 'media_processing.table.created'|trans({}, 'media_processing'), 'sortable': true},
            {'field': 'duration', 'label': 'media_processing.table.duration'|trans({}, 'media_processing'), 'sortable': true},
            {'field': 'actions', 'label': 'media_processing.table.actions'|trans({}, 'media_processing'), 'align': 'right'}
        ]
    } %}
</div>
{% endblock %}
