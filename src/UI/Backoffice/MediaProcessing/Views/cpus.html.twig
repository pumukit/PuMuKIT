{% extends '@Shared/Views/layout/layout.html.twig' %}

{% block body %}
<div class="container-fluid mt-3">
    {% include '@Shared/Views/partials/_title.html.twig' with {'page_title': 'media_processing.page.cpus'|trans({}, 'media_processing')} %}

    {% if localCpus is not empty %}
        <div class="row mb-4">
            <div class="col-12">
                <h3 class="mb-3">
                    <i class="fa fa-server"></i> {{ 'media_processing.cpus.local'|trans({}, 'media_processing') }}
                </h3>
            </div>
            {% for name, cpu in localCpus %}
                {% include '@MediaProcessing/Views/partials/_cpu_card.html.twig' with {
                    'name': name,
                    'cpu': cpu,
                    'cpusInMaintenance': cpusInMaintenance
                } %}
            {% endfor %}
        </div>
    {% endif %}

    {% if remoteCpus is not empty %}
        <div class="row">
            <div class="col-12">
                <h3 class="mb-3">
                    <i class="fa fa-cloud"></i> {{ 'media_processing.cpus.remote'|trans({}, 'media_processing') }}
                </h3>
            </div>
            {% for name, cpu in remoteCpus %}
                {% include '@MediaProcessing/Views/partials/_cpu_card.html.twig' with {
                    'name': name,
                    'cpu': cpu,
                    'cpusInMaintenance': cpusInMaintenance
                } %}
            {% endfor %}
        </div>
    {% endif %}

    {% if localCpus is empty and remoteCpus is empty %}
        <div class="alert alert-info">
            <i class="fa fa-info-circle"></i>
            No hay CPUs configuradas en el sistema.
        </div>
    {% endif %}
</div>

<script>
function toggleMaintenance(cpuName, isChecked) {
    const action = isChecked ? 'deactivate' : 'activate';
    const url = `/admin/backend/media_processing/cpus/${cpuName}/maintenance/${action}`;

    fetch(url, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            window.location.reload();
        } else {
            alert('Error al cambiar el estado de mantenimiento');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error al cambiar el estado de mantenimiento');
    });
}
</script>
{% endblock %}

