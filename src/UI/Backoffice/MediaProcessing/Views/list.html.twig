{% extends '@Shared/Views/layout/layout.html.twig' %}

{% block body %}
<div class="container-fluid mt-3">
    {% include '@Shared/Views/partials/_title.html.twig' with {'page_title': 'transcoding.page.list'|trans({}, 'transcoding')} %}

    {% include '@Shared/Views/components/table/_table.html.twig' with {
        id: 'jobsTable',
        title: 'transcoding.table.title'|trans({}, 'transcoding'),
        server_side: true,
        ajax_url: path('transcoding_jobs_list_data'),
        checkbox: false,
        columns: [
            {'field': 'id', 'label': 'ID', 'visible': false},
            {'field': 'mm_id', 'label': 'transcoding.table.multimedia_object'|trans({}, 'transcoding'), 'sortable': true},
            {'field': 'profile', 'label': 'transcoding.table.profile'|trans({}, 'transcoding'), 'sortable': true},
            {'field': 'status_text', 'label': 'transcoding.table.status'|trans({}, 'transcoding'), 'sortable': true},
            {'field': 'priority', 'label': 'transcoding.table.priority'|trans({}, 'transcoding'), 'sortable': true},
            {'field': 'cpu', 'label': 'transcoding.table.cpu'|trans({}, 'transcoding')},
            {'field': 'timeini', 'label': 'transcoding.table.created'|trans({}, 'transcoding'), 'sortable': true},
            {'field': 'timestart', 'label': 'transcoding.table.started'|trans({}, 'transcoding'), 'sortable': true},
            {'field': 'timeend', 'label': 'transcoding.table.finished'|trans({}, 'transcoding'), 'sortable': true},
            {'field': 'actions', 'label': 'transcoding.table.actions'|trans({}, 'transcoding'), 'align': 'right'}
        ]
    } %}
</div>

<script>
function cancelJob(jobId) {
    if (!confirm('{{ 'transcoding.confirm.cancel_job'|trans({}, 'transcoding') }}')) {
        return;
    }

    const cancelUrl = `/admin/backend/transcoding/jobs/${jobId}/cancel`;

    fetch(cancelUrl, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            $('#jobsTable').bootstrapTable('refresh');
            alert('{{ 'transcoding.flash.job_cancelled'|trans({}, 'transcoding') }}');
        } else {
            alert('{{ 'transcoding.error.cancel_failed'|trans({}, 'transcoding') }}');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('{{ 'transcoding.error.cancel_failed'|trans({}, 'transcoding') }}');
    });
}
</script>
{% endblock %}


