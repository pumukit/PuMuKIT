{% extends '@Shared/Views//layout/layout.html.twig' %}

{% block body %}
    <div class="container-fluid mt-3">

        {% include '@Series/Views//partials/_series_header.html.twig' with {
            series: series
        } %}

        <div class="tabs-scroll">
            <ul class="nav nav-tabs modern-tabs text-uppercase small mobile-tabs">
                {% if customTabs is defined and customTabs is not empty %}
                    {% for customTab in customTabs %}
                        <li class="nav-item">
                            <a class="nav-link {{ tab == customTab.key ? 'active' : '' }}" href="{{ path('series_view', {id: series.id, tab: customTab.key}) }}">
                                <i class="{{ customTab.icon }}"></i> {{ customTab.label|trans }}
                            </a>
                        </li>
                    {% endfor %}
                {% endif %}
            </ul>
        </div>

        <div class="mt-3">
            {% set currentTabTemplate = null %}
            {% if customTabs is defined and customTabs is not empty %}
                {% for customTab in customTabs %}
                    {% if tab == customTab.key %}
                        {% set currentTabTemplate = customTab.template %}
                    {% endif %}
                {% endfor %}
            {% endif %}

            {% if currentTabTemplate %}
                {% include currentTabTemplate with {series: series, formBuildEvent: formBuildEvent} %}
            {% else %}
                <div class="alert alert-warning">
                    <i class="fa fa-exclamation-triangle"></i> {{ 'series.view.tab_not_found'|trans({'%tab%': tab}, 'series') }}
                </div>
            {% endif %}
        </div>

    </div>
{% endblock %}
