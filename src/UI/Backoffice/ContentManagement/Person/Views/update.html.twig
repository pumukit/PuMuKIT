{% extends '@Shared/Views/layout/layout.html.twig' %}

{% block body %}
    <div class="container-fluid mt-3">
        {% include '@Shared/Views/partials/_title.html.twig' with {'page_title': 'person.page.update'|trans({}, 'person')} %}

        <div class="card">
            <div class="card-body">
                <form method="post" action="{{ path('person_update', {'id': person.id}) }}">
                    <div class="mb-3">
                        <label for="name" class="form-label">{{ 'person.form.name'|trans({}, 'person') }}</label>
                        <input type="text" class="form-control" id="name" name="name" value="{{ person.name }}" required>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">{{ 'person.form.email'|trans({}, 'person') }}</label>
                        <input type="email" class="form-control" id="email" name="email" value="{{ person.email|default('') }}">
                    </div>

                    <div class="mb-3">
                        <label for="web" class="form-label">{{ 'person.form.web'|trans({}, 'person') }}</label>
                        <input type="url" class="form-control" id="web" name="web" value="{{ person.web|default('') }}">
                    </div>

                    <div class="mb-3">
                        <label for="phone" class="form-label">{{ 'person.form.phone'|trans({}, 'person') }}</label>
                        <input type="tel" class="form-control" id="phone" name="phone" value="{{ person.phone|default('') }}">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">{{ 'person.form.honorific'|trans({}, 'person') }}</label>
                        <div id="honorificFields">
                            <div class="input-group mb-2">
                                <span class="input-group-text">EN</span>
                                <input type="text" class="form-control" name="honorific_en" data-locale="en" value="{{ person.i18nHonorific['en']|default('') }}">
                            </div>
                            <div class="input-group mb-2">
                                <span class="input-group-text">ES</span>
                                <input type="text" class="form-control" name="honorific_es" data-locale="es" value="{{ person.i18nHonorific['es']|default('') }}">
                            </div>
                        </div>
                        <input type="hidden" id="honorific" name="honorific">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">{{ 'person.form.firm'|trans({}, 'person') }}</label>
                        <div id="firmFields">
                            <div class="input-group mb-2">
                                <span class="input-group-text">EN</span>
                                <input type="text" class="form-control" name="firm_en" data-locale="en" value="{{ person.i18nFirm['en']|default('') }}">
                            </div>
                            <div class="input-group mb-2">
                                <span class="input-group-text">ES</span>
                                <input type="text" class="form-control" name="firm_es" data-locale="es" value="{{ person.i18nFirm['es']|default('') }}">
                            </div>
                        </div>
                        <input type="hidden" id="firm" name="firm">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">{{ 'person.form.post'|trans({}, 'person') }}</label>
                        <div id="postFields">
                            <div class="input-group mb-2">
                                <span class="input-group-text">EN</span>
                                <input type="text" class="form-control" name="post_en" data-locale="en" value="{{ person.i18nPost['en']|default('') }}">
                            </div>
                            <div class="input-group mb-2">
                                <span class="input-group-text">ES</span>
                                <input type="text" class="form-control" name="post_es" data-locale="es" value="{{ person.i18nPost['es']|default('') }}">
                            </div>
                        </div>
                        <input type="hidden" id="post" name="post">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">{{ 'person.form.bio'|trans({}, 'person') }}</label>
                        <div id="bioFields">
                            <div class="input-group mb-2">
                                <span class="input-group-text">EN</span>
                                <textarea class="form-control" name="bio_en" data-locale="en" rows="3">{{ person.i18nBio['en']|default('') }}</textarea>
                            </div>
                            <div class="input-group mb-2">
                                <span class="input-group-text">ES</span>
                                <textarea class="form-control" name="bio_es" data-locale="es" rows="3">{{ person.i18nBio['es']|default('') }}</textarea>
                            </div>
                        </div>
                        <input type="hidden" id="bio" name="bio">
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-pumukit">{{ 'person.form.update'|trans({}, 'person') }}</button>
                        <a href="{{ path('person_index') }}" class="btn btn-secondary">{{ 'person.form.cancel'|trans({}, 'person') }}</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('form');

            form.addEventListener('submit', function(e) {
                const collectI18nFields = (fieldId, containerId) => {
                    const fields = {};
                    document.querySelectorAll(`#${containerId} input, #${containerId} textarea`).forEach(input => {
                        const locale = input.dataset.locale;
                        if (input.value) {
                            fields[locale] = input.value;
                        }
                    });
                    document.getElementById(fieldId).value = JSON.stringify(fields);
                };

                collectI18nFields('honorific', 'honorificFields');
                collectI18nFields('firm', 'firmFields');
                collectI18nFields('post', 'postFields');
                collectI18nFields('bio', 'bioFields');
            });
        });
    </script>
{% endblock %}

