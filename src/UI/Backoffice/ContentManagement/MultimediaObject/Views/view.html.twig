{% extends '@Shared/Views//layout/layout.html.twig' %}

{% block body %}
    <div class="container-fluid mt-3">

        {% include '@MultimediaObject/Views//partials/_multimedia_object_header.html.twig' with {
            object: object
        } %}

        <ul class="nav nav-tabs modern-tabs text-uppercase small flex-wrap justify-content-start" role="tablist">
            <li class="nav-item">
                <a class="nav-link {{ tab == 'general' ? 'active' : '' }}" href="{{ path('multimedia_object_view', {id: object.id, tab: 'general'}) }}">
                    <i class="fa-solid fa-ellipsis"></i> {{ "General"|trans }}
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link {{ tab == 'publication' ? 'active' : '' }}" href="{{ path('multimedia_object_view', {id: object.id, tab: 'publication'}) }}">
                    <i class="fa-solid fa-newspaper"></i> {{ "Publication"|trans }}
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link {{ tab == 'metadata' ? 'active' : '' }}" href="{{ path('multimedia_object_view', {id: object.id, tab: 'metadata'}) }}">
                    <i class="fa fa-edit me-1"></i> {{ "Metadata"|trans }}
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link {{ tab == 'tags' ? 'active' : '' }}" href="{{ path('multimedia_object_view', {id: object.id, tab: 'tags'}) }}">
                    <i class="fa fa-tags me-1"></i> {{ "Tags"|trans }}
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link {{ tab == 'owners' ? 'active' : '' }}" href="{{ path('multimedia_object_view', {id: object.id, tab: 'owners'}) }}">
                    <i class="fa fa-users me-1"></i> {{ "Owners"|trans }}
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link {{ tab == 'people' ? 'active' : '' }}" href="{{ path('multimedia_object_view', {id: object.id, tab: 'people'}) }}">
                    <i class="fa fa-user me-1"></i> {{ "People"|trans }}
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link {{ tab == 'media' ? 'active' : '' }}" href="{{ path('multimedia_object_view', {id: object.id, tab: 'media'}) }}">
                    <i class="fa fa-photo-video me-1"></i> {{ "Media"|trans }}
                </a>
            </li>
        </ul>

        <div class="mt-3">
            {% include '@MultimediaObject/Views//tabs/' ~ tab ~ '.html.twig' %}
        </div>
    </div>
{% endblock %}
