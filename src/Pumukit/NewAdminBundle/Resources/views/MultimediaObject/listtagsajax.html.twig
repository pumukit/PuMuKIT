{% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) %}
{% for node in nodes %}
  {% set children_length = node.getNumberOfChildren() %}
   <a href="#"
      {% if node.getMetatag() %}data-action="click->admin--tag-picker#select"{% else %}data-action="click->admin--tag-picker#select dblclick->admin--tag-picker#add"{% endif %}
      data-admin--tag-picker-id-param="{{ node.id|json_encode }}"
      class="list-group-item notload tag_li_parent_{{ parent }}
             c_{{ node.path|replace({ ("|" ~ node.cod ~ "|"): '', '|': ' c_'}) }}
             {{ (children_length)?'collapsed':'element' }}
             {{ node.getMetatag()?'metatag' }}
             tag-add-{{ node.cod }}
             {{ (node.getNumberMultimediaObjects()==0)?'nomm' }}">

     {% if not node.getMetatag() %}
     <span class="badge text-bg-secondary" id="info_num_mm_{{ node.id }}">{{ node.getNumberMultimediaObjects() }}</span>
     {% endif %}

     <span class="pmk-padding-left-{{ 10 * (node.level - 3) }}"
           {% if children_length %} data-action="click->admin--tag-picker#toggle" data-admin--tag-picker-id-param="{{ node.id|json_encode }}" data-admin--tag-picker-block-param="{{ block_tag|json_encode }}" data-admin--tag-picker-cod-param="{{ node.cod|json_encode }}"{% endif %}>
       <i class="fa-solid tag_icon"></i>
     </span>
     <span class="tag">
       {% if is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::SHOW_CODES')) %}
           {{ node.getCod() }} -
       {% endif %}
       {{ node.getTitle() }}
     </span>
   </a>
{% endfor %}
{% endif %}
