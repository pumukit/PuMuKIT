{% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) %}
    {% set video_url = url('pumukit_webtv_multimediaobject_index', {id: mm.id}) %}
    {% set magic_url = url('pumukit_webtv_multimediaobject_magicindex', {secret: mm.secret}) %}
{% endif %}
<div class="row">
    {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SHOW_MULTIMEDIA_OBJECT_INFO_URL')) %}
        <div class="background_id col-lg-12">
            <form>
                <fieldset class="row">
                    <legend>Info {% if mm.numericalID %}- <span title="{% trans %}Numerical ID{% endtrans %}">({{ mm.numericalID }})</span>{% endif %}</legend>
                    <div class="mb-3 col-lg-6">
                        <div class="row"><label for="inputMMId" class="col-2 col-form-label">Id:</label>
                        <div class="col-10 input-group">
                            <input type="text" class="form-control" id="inputMMId" readonly data-controller="core--select" data-action="click->core--select#select" value="{{ mm.id }}">
                        </div>
                        <label for="inputMMTitle" class="col-2 col-form-label">{% trans %}Title{% endtrans %}:</label>
                        <div class="col-10 input-group">
                            <input type="text" class="form-control" id="inputMMTitle" readonly data-controller="core--select" data-action="click->core--select#select" value="{{ mm.title }}">
                        </div></div>
                    </div>
                    <div class="mb-3 col-lg-6">
                        <div class="row"><label for="inputROUrl" class="col-2 col-form-label hidden-naked">Url:</label>
                        <div class="col-10 input-group hidden-naked">
                            <input type="text" class="form-control" id="inputROUrl" readonly data-controller="core--select" data-action="click->core--select#select" value="{{ video_url }}">
                            {% if is_published and is_playable %}
                                <span class="input-group-text"><a href="{{ video_url }}" target="_blank" title="{% trans %}Video URL{% endtrans %}"><i class="fa-solid fa-arrow-up-right-from-square"></i></a></span>
                            {% else %}
                                <span class="input-group-text"><i class="fa-solid fa-triangle-exclamation" title="{% trans %}Warning: This link will give a 404 error until this multimedia object is correctly published.{% endtrans %}"></i></span>
                            {% endif %}
                        </div>
                        {% if is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_MAGIC_URL')) %}
                        <label for="inputROMagicUrl" class="col-2 col-form-label hidden-naked pmk-word-break-break-all pmk-overflow-hidden pmk-white-space-nowrap"
                               data-bs-toggle="tooltip" data-bs-placement="bottom"
                               title="{% trans %}This URL will give you access to the series without login.{% endtrans %}">
                            {% trans %}Magic Url{% endtrans %}:
                        </label>
                        <div class="col-10 input-group hidden-naked">
                            <input type="text" class="form-control" id="inputROMagicUrl" readonly data-controller="core--select" data-action="click->core--select#select" value="{{ magic_url }}" data-bs-toggle="tooltip" data-bs-placement="bottom" title="{% trans %}This URL will give you access to the series without login.{% endtrans %}" />
                            {% if (is_hidden or is_published) and is_playable %}
                                <span class="input-group-text">
                                    <a id="alinkROMagicUrl" href="{{ magic_url }}" target="_blank" title="{% trans %}Magic Url{% endtrans %}">
                                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                    </a>
                                </span>
                            {% else %}
                                <span class="input-group-text">
                                    <i class="fa-solid fa-triangle-exclamation" title="{% trans %}Warning: This link will show a player with no video until a display track is added.{% endtrans %}"></i>
                                </span>
                            {% endif %}
                            <span class="input-group-text">
                                <a href="#" data-action="click->admin--actions#magicUrl"
                                   data-admin--actions-url-param="{{ path('pumukitnewadmin_mms_generate_magic_url', {'id': mm.id}) }}"
                                   data-admin--actions-template-param="{{ url('pumukit_webtv_multimediaobject_magicindex', {secret: '__secret__'}) }}"
                                   data-admin--actions-confirm-param="{{ 'Are you sure you want to regenerate the magic url for this multimedia object?'|trans }}"
                                   data-admin--actions-success-param="{{ 'Magic Url successfully generated.'|trans }}"
                                   data-admin--actions-input-param="#inputROMagicUrl"
                                   data-admin--actions-link-param="#alinkROMagicUrl"
                                   title="{% trans %}Submit generate magic URL{% endtrans %}">
                                    <i class="fa-solid fa-repeat"></i>
                                </a>
                            </span>
                        </div>
                        {% endif %}
                        {% if is_published and is_playable and mm.isExternalType() %}
                            {% if mm.getDisplayTrack() %}
                                {% set video_url = url('pumukit_webtv_multimediaobject_index', {id: mm.id, 'track_id': mm.getDisplayTrack().id() }) %}
                            {% else %}
                                {% set video_url = url('pumukit_webtv_multimediaobject_index', {id: mm.id }) %}
                            {% endif %}
                            <label for="inputROUrl" class="col-2 col-form-label hidden-naked">Broadcast:</label>
                            <div class="col-10 input-group hidden-naked">
                                <input type="text" class="form-control" id="inputROUrl" readonly data-controller="core--select" data-action="click->core--select#select" value="{{ video_url }}">

                                <span class="input-group-text">
                                    <a href="{{ video_url }}" target="_blank" title="{% trans %}Video URL{% endtrans %}">
                                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                    </a>
                                </span>
                            </div>
                        {% endif %}</div>
                    </div>
                </fieldset>
                <button title="{% trans %}Read only form{% endtrans %}" aria-label="{% trans %}Read only form{% endtrans %}" hidden="true"></button>
            </form>
        </div>
    {% endif %}
</div>

<div class="row">
    {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) %}
        <div class="col-12 ">
            <br />
            {% if warning_on_unpublished and (not is_published or not is_playable) %}
                <span class="alert alert-dismissable alert-warning">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    {% trans %}WARNING, this multimedia object is not yet published on WebTV, or does not have a playable resource.{% endtrans %}
                </span>&nbsp;
                <br />
                <br />
            {% endif %}
        </div>
    {% endif %}
</div>
