<input type="hidden" id="mm_id_grouprelation" value="{{ mm.id }}"/>
<div class="card">
  <div class="card-header">
    {% trans %}ADMIN GROUPS{% endtrans %}&nbsp;
    {% if template %}
    <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" data-bs-placement="right" title="{% trans %}Groups that can admin this series{% endtrans %}"></i>
    {% else %}
    <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" data-bs-placement="right" title="{% trans %}Groups that can admin this multimedia object{% endtrans %}"></i>
    {% endif %}
  </div>
  {% set can_modify_groups = app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::MODIFY_OWNER')) %}
  <div class="card-body" id="group_mm{{ template }}"
       data-controller="admin--group-lists"
       data-admin--mm-groups-target="lists"
       data-action="admin--group-lists:load->admin--group-lists#load"
       data-admin--group-lists-name-value="mm{{ template }}"
       data-admin--group-lists-show-codes-value="{{ is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::SHOW_CODES')) ? 'true' : 'false' }}"
       data-admin--group-lists-editable-value="{{ can_modify_groups ? 'true' : 'false' }}"
       data-admin--group-lists-message-value="{{ 'WARNING: You do not have enough permissions to modify admin groups.'|trans }}">
    <div class="row pumukitnewadmin-groups-list-title-row">
      <div class="pumukitnewadmin-groups-list-title pmk-width-45pct pmk-max-width-430">
        {% trans %}Available Groups{% endtrans %}:
      </div>
      <div class="pumukitnewadmin-groups-list-title">
        <strong>{% trans %}Selected Admin Groups{% endtrans %}:</strong>
      </div>
    </div>
    <div class="pumukitnewadmin-groups-boxes">
	  <div class="tag list-group pmk-tag-tree pumukitnewadmin-groups-list-box list-box-width" id="delete_mm{{ template }}_groups" data-admin--group-lists-target="available">
        {% include '@PumukitNewAdmin/MultimediaObject/availablegroups.html.twig' with {'resource': mm, 'groups': groups, 'resource_name': 'mm'~template} %}
	  </div>
	  <div class="pumukitnewadmin-groups-arrows">
	    <a href="#" data-action="click->admin--group-lists#moveFromCurrent">&#8592;</a>
	    <a href="#" data-action="click->admin--group-lists#moveFromAvailable">&#8594;</a>
	  </div>
      {# Groups added to the multimedia object #}
	  <div class="tag pumukitnewadmin-groups-list-box list-box-width" id="added_mm{{ template }}_groups">
	    <div class="tag_tree list-group" id="add_mm{{ template }}_groups" data-admin--group-lists-target="current">
          {% include '@PumukitNewAdmin/MultimediaObject/selectedgroups.html.twig' with {'resource': mm, 'groups': groups, 'resource_name': 'mm'~template} %}
	    </div>
      </div>
	</div>
  </div>
</div>
