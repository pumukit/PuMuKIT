<div class="table-responsive">
    {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) %}
        <table class="table table-striped table-hover">
            <thead>
                {% include "@PumukitNewAdmin/MultimediaObject/listth.html.twig" %}
            </thead>

            <tbody>
            {% for mm in mms %}
                <tr class="pmk-cursor-pointer{% if (app.session.get('admin/mms/id') == mm.id ) %} success{% endif %}">
                    <td headers="th-checkbox">
                        <div class="form-check pumukit-mms-checkbox">
                            <label>
                                <input id="{{ mm.id }}" class="mm_checkbox" type="checkbox">
                            </label>
                        </div>
                    </td>
                    <td headers="th-status" class="text-center">
                        <span id="table_mms_status_wrapper_{{ mm.id }}" data-id="{{ mm.id }}">
                            {% include '@PumukitNewAdmin/MultimediaObject/status.html.twig' with {'mm': mm} %}
                        </span>
                    </td>
                    <td class="pmk-width-1em" headers="th-icons">
                        {% include '@PumukitNewAdmin/MultimediaObject/updatemenu.html.twig' with {'mm': mm} %}
                    </td>
                    {% if not is_naked() %}
                        <td class="pmk-width-1em" headers="th-icons">
                            {{ mm.containsTagWithCod('PUDENEW')?'<i class="fa-solid fa-spell-check">':'&nbsp;' }}
                        </td>
                    {% endif %}
                    {% include '@PumukitNewAdmin/MultimediaObject/lms_options.html.twig' %}
                    {% include '@PumukitNewAdmin/MultimediaObject/sortingactions.html.twig' %}
                    <td headers="th-img" data-action="click->admin--actions#edit" data-admin--actions-name-param="mm" data-admin--actions-show-param="{{ path('pumukitnewadmin_mms_show', {'id': mm.id}) }}" data-admin--actions-update-param="{{ path('pumukitnewadmin_mms_edit', {'id': mm.id}) }}">
                        {% include "@PumukitNewAdmin/Misc/img_list.html.twig"  with {'object' : mm, 'type': 'mm' } %}
                    </td>
                    <td headers="th-title" data-action="click->admin--actions#edit" data-admin--actions-name-param="mm" data-admin--actions-show-param="{{ path('pumukitnewadmin_mms_show', {'id': mm.id}) }}" data-admin--actions-update-param="{{ path('pumukitnewadmin_mms_edit', {'id': mm.id}) }}">
                        <span class="shorten-title">{{ mm.getTitle() }}</span>
                    </td>
                    <td headers="th-type" class="text-center" data-action="click->admin--actions#edit" data-admin--actions-name-param="mm" data-admin--actions-show-param="{{ path('pumukitnewadmin_mms_show', {'id': mm.id}) }}" data-admin--actions-update-param="{{ path('pumukitnewadmin_mms_edit', {'id': mm.id}) }}">
                        {% if mm.isVideoType() %}
                            <i class="fa-solid fa-file-video pmk-font-size-20" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getStringType(mm.getType()) }}"></i>
                        {% elseif mm.isAudioType() %}
                            <i class="fa-solid fa-file-audio pmk-font-size-20" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getStringType(mm.getType()) }}"></i>
                        {% elseif mm.isImageType() %}
                            <i class="fa-solid fa-file-image pmk-font-size-20" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getStringType(mm.getType()) }}"></i>
                        {% elseif mm.isDocumentType() %}
                            <i class="fa-solid fa-file-lines pmk-font-size-20" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getStringType(mm.getType()) }}"></i>
                        {% elseif mm.isExternalType() %}
                            <i class="fa-solid fa-link pmk-font-size-20" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getStringType(mm.getType()) }}"></i>
                        {% endif %}
                    </td>
                    <td headers="th-media" class="text-center" data-action="click->admin--actions#edit" data-admin--actions-name-param="mm" data-admin--actions-show-param="{{ path('pumukitnewadmin_mms_show', {'id': mm.id}) }}" data-admin--actions-update-param="{{ path('pumukitnewadmin_mms_edit', {'id': mm.id}) }}">
                        {{ mm.medias|length }}
                    </td>
                    <td headers="th-duration" class="text-center" data-action="click->admin--actions#edit" data-admin--actions-name-param="mm" data-admin--actions-show-param="{{ path('pumukitnewadmin_mms_show', {'id': mm.id}) }}" data-admin--actions-update-param="{{ path('pumukitnewadmin_mms_edit', {'id': mm.id}) }}">
                        {% if mm.isVideoAudioType() %}{{ mm.getRealDuration()| duration_string }}{% else %}0{% endif %}
                        {% if mm.getProperty('soft-editing-duration') %}
                            <i class="fa-solid fa-scissors" data-bs-toggle="tooltip" data-bs-placement="left" title="{{ mmobj_duration(mm) | duration_string }}"></i>
                        {% endif %}
                    </td>
                    <td headers="th-rec-date" class="text-nowrap" data-action="click->admin--actions#edit" data-admin--actions-name-param="mm" data-admin--actions-show-param="{{ path('pumukitnewadmin_mms_show', {'id': mm.id}) }}" data-admin--actions-update-param="{{ path('pumukitnewadmin_mms_edit', {'id': mm.id}) }}">
                        {{ mm.getRecordDate()| format_datetime('medium','none',locale=app.request.getLocale()) }}
                    </td>
                    <td headers="th-pub-date" class="text-nowrap" data-action="click->admin--actions#edit" data-admin--actions-name-param="mm" data-admin--actions-show-param="{{ path('pumukitnewadmin_mms_show', {'id': mm.id}) }}" data-admin--actions-update-param="{{ path('pumukitnewadmin_mms_edit', {'id': mm.id}) }}">
                        {{ mm.getPublicDate()| format_datetime('medium','none',locale=app.request.getLocale()) }}
                    </td>
                    <td headers="th-channel" class="text-center" data-action="click->admin--actions#edit" data-admin--actions-name-param="mm" data-admin--actions-show-param="{{ path('pumukitnewadmin_mms_show', {'id': mm.id}) }}" data-admin--actions-update-param="{{ path('pumukitnewadmin_mms_edit', {'id': mm.id}) }}">
                        {% if mm.containsTagWithCod('PUCHWEBTV') %}
                            <i class="fa-solid fa-check text-success"></i>
                        {% else %}
                            <i class="fa-solid fa-xmark text-danger"></i>
                        {% endif %}
                    </td>
                    <td headers="th-broadcast" class="text-center" data-action="click->admin--actions#edit" data-admin--actions-name-param="mm" data-admin--actions-show-param="{{ path('pumukitnewadmin_mms_show', {'id': mm.id}) }}" data-admin--actions-update-param="{{ path('pumukitnewadmin_mms_edit', {'id': mm.id}) }}">
                        {% if mm.getEmbeddedBroadcast().getType() == 'public' %}
                            <i class="fa-solid fa-globe" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getEmbeddedBroadcast().getStringType() }}"></i>
                        {% elseif mm.getEmbeddedBroadcast().getType() == 'password' %}
                            <i class="fa-solid fa-unlock" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getEmbeddedBroadcast().getStringType() }}"></i>
                        {% elseif mm.getEmbeddedBroadcast().getType() == 'login' %}
                            <i class="fa-solid fa-user" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getEmbeddedBroadcast().getStringType() }}"></i>
                        {% elseif mm.getEmbeddedBroadcast().getType() == 'groups' %}
                            <i class="fa-solid fa-users" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getEmbeddedBroadcast().getStringType() }}"></i>
                        {% endif %}
                    </td>
                    <td headers="th-views" class="text-center" data-action="click->admin--actions#edit" data-admin--actions-name-param="mm" data-admin--actions-show-param="{{ path('pumukitnewadmin_mms_show', {'id': mm.id}) }}" data-admin--actions-update-param="{{ path('pumukitnewadmin_mms_edit', {'id': mm.id}) }}">
                        <span>{{ mm.getNumview() }}</span>
                    </td>
                    <td headers="th-play" class="text-nowrap" data-action="click->admin--actions#openModal" data-admin--actions-url-param="{{ path('pumukitnewadmin_mms_modal_preview', {'id': mm.id}) }}">
                        <small><i class="fa-solid fa-play pmk-color-grey"></i></small>
                    </td>
                </tr>
                {% set last = mm %}
            {% else %}
                <tr>
                    <td colspan="13" headers="th-checkbox th-icons th-icons th-icons th-icons th-icons th-video th-img th-title th-duration th-rec-date th-pub-date">
                        {% trans %}There are no multimedia objects with those values.{% endtrans %}
                    </td>
                </tr>
            {% endfor %}

            {% if 0 == mms|length %}
                {% set range = 1..9 %}
            {% elseif (mms|length - (mms.getMaxPerPage() * (mms.getCurrentPage() - 1))) < (mms.maxPerPage) %}
                {% set range = (mms|length - (mms.getMaxPerPage() * (mms.getCurrentPage() - 1)))..(mms.maxPerPage-1) %}
            {% else %}
                {% set range = [] %}
            {% endif %}

            {% for i in range %}
                <tr>
                    <td headers="th-checkbox">&nbsp;</td>
                    <td headers="th-icons">&nbsp;</td>
                    {% if not is_naked() %}
                        <td headers="th-icons">&nbsp;</td>
                    {% endif %}
                    {% if is_naked() %}
                        <td headers="th-icons">&nbsp;</td>
                    {% endif %}
                    {% if series.sorting == constant('SORT_MANUAL', series) %}
                        <td headers="th-icons">&nbsp;</td>
                        <td headers="th-icons">&nbsp;</td>
                    {% endif %}
{#                    <td headers="th-icons">&nbsp;</td>#}
                    <td headers="th-img">&nbsp;</td>
                    <td headers="th-title">&nbsp;</td>
                    <td headers="th-type">&nbsp;</td>
                    <td headers="th-media">&nbsp;</td>
                    <td headers="th-duration">&nbsp;</td>
                    <td headers="th-rec-date">&nbsp;</td>
                    <td headers="th-pub-date">&nbsp;</td>
                    <td headers="th-status">&nbsp;</td>
                    <td headers="th-channel">&nbsp;</td>
                    <td headers="th-broadcast">&nbsp;</td>
                    <td headers="th-views">&nbsp;</td>
                    <td headers="th-play">&nbsp;</td>
                </tr>
            {% endfor %}
            </tbody>
            <tfoot>
            <tr>
                <td colspan="17" class="foot-td">
                    <div class="row pmk-margin-left-0 pmk-margin-right-0">
                        <div class="col-md-6">
                            {{ mms.getNbResults }} {% trans %}Mm. Obj.{% endtrans %}
                            {% if app.session.get('admin/mms/criteria')|length != 0 %}
                                <a class="cancel-search-button pmk-color-blue pmk-font-weight-normal" title="{% trans %}Cancel current search{% endtrans %}" href="?criteria[reset]=true">{% trans %}Cancel search{% endtrans %}</a>
                            {% endif %}
                        </div>
                        <div class="col-md-6 text-end">
                            <div class="pagerfanta">
                                {% set pagerClass = 'twitter_bootstrap5' %}
                                {% set pagerStyles = {"css_container_class": "pagination pagination-sm", "next_message": "&raquo;", "prev_message": "&laquo;", "routeParams": {"id": series.id}, "routeName": "pumukitnewadmin_mms_index"} %}
                                {% include "@PumukitNewAdmin/Misc/pager.html.twig" with {'objects' : mms, 'pagerClass': pagerClass, 'pagerStyles': pagerStyles} %}
                                {% if not is_naked() %}
                                    <input class="pmk-width-25 pmk-text-align-center pmk-cursor-pointer" title="{% trans %}Go to page{% endtrans %}" type="number"
                                           value="{{ mms.getCurrentPage() }}"
                                           data-action="change->admin--actions#go" data-admin--actions-url-param="?id={{ series.id }}&page="/>

                                    <select data-action="change->admin--actions#go" data-admin--actions-url-param="{{ path('pumukitnewadmin_mms_index') }}?id={{ series.id }}&page=1&paginate=" aria-label="{% trans %}Select the number of multimedia objects to display per page.{% endtrans %}">
                                        <option {% if mms.maxPerPage == 10 %}selected{% endif %} value="10">10</option>
                                        <option {% if mms.maxPerPage == 20 %}selected{% endif %} value="20">20</option>
                                        <option {% if mms.maxPerPage == 50 %}selected{% endif %} value="50">50</option>
                                    </select>
                                {% endif %}

                            </div>
                        </div>
                    </div>
                </td>
            </tr>
            </tfoot>
        </table>
    {% endif %}
</div>
