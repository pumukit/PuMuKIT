{% if app.user and is_granted('ROLE_ADD_HEAD_AND_TAIL') and mm.isVideoAudioType() %}

    <div class="form-row block-multimedia-object-playlist pmk-margin-bottom-5rem">
        <dt>{% trans %}Head and tail video{% endtrans %}:</dt>
        <dd>
            <div class="row pmk-margin-top-1rem" id="head_and_tail_mms_{{ mm.id }}">
                <div class="col-md-6">
                    <label for="head_video_select" hidden>{{ "Head"|trans }}</label>
                    <select id="head_video_select" name="head_video_select" class="form form-select head_video_select" data-action="change->admin--actions#send" data-admin--actions-url-param="{{ path('pumukit_newadmin_head_and_tail_update', {'type': 'head', 'multimediaObject': mm.id, 'element': '__value__'}) }}">
                        <option value="default">{{ "Default"|trans }}</option>
                        {% for element in videos_as_head() %}
                            <option value="{{ element.id }}" {% if mm.getVideoHead()|default(null) == element.id %}selected{% endif %}>{{ element.getTitle() }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-6">
                    <label for="tail_video_select" hidden>{{ "Tail"|trans }}</label>
                    <select id="tail_video_select" name="tail_video_select" class="form form-select tail_video_select" data-action="change->admin--actions#send" data-admin--actions-url-param="{{ path('pumukit_newadmin_head_and_tail_update', {'type': 'tail', 'multimediaObject': mm.id, 'element': '__value__'}) }}">
                        <option value="default">{{ "Default"|trans }}</option>
                        {% for element in videos_as_tail() %}
                            <option value="{{ element.id }}" {% if mm.getVideoTail()|default(null) == element.id %}selected{% endif %}>{{ element.getTitle() }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        </dd>
    </div>
{% endif %}
