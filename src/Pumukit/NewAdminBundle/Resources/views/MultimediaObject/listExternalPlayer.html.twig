<div class="modal-header">
    <h3 class="modal-title pumukitnewadmin-modal-title-margin" id="myModalLabel">{% trans %}External media{% endtrans %}</h3>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body" data-controller="admin--external-player">
    <fieldset>
        <div class="mb-3">
            {% set urlexternal = '' %}
            <iframe id="externalplayer" height="100%" width="100%" data-admin--external-player-target="frame" data-action="load->admin--external-player#resize" src="{{ urlexternal }}"></iframe>
        </div>
    </fieldset>
    {{ form_start(form, {'attr': {'id': 'externalplayerform', 'data-action': 'submit->admin--external-player#submit'}}) }}
    {% if is_granted('ROLE_ADD_EXTERNAL_PLAYER') %}
        <div class="row form-update-external">

            <div class="col-12 col-sm-9 col-md-9">
                {% set placeholder = 'No external media set' %}
                {% if urlexternal != '' %}
                    {{ form_row(form.url, {'value': urlexternal, 'attr': {'data-admin--external-player-target': 'url'}}) }}
                {% else %}
                    {{ form_row(form.url, {'attr' : {'placeholder': placeholder, 'data-admin--external-player-target': 'url'}}) }}
                {% endif %}
            </div>
            <div class="col-12 col-sm-3 col-md-3 align-self-end"><a href="#" id="previewIframe" class="btn w-100 btn-primary" data-action="click->admin--external-player#preview" title="{% trans %}Preview{% endtrans %}">{% trans %}Preview{% endtrans %}</a></div>
            <div class="col-12" style="margin-top:15px">
                {{ form_row(form.title) }}
            </div>
        </div>
    {% endif %}
    <div class="modal-footer px-0 pb-0 mt-4">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Cancel{% endtrans %}</button>
        {% if is_granted('ROLE_ADD_EXTERNAL_PLAYER') %}
        <button type="submit" class="btn btn-primary">{% trans %}Submit{% endtrans %}</button>
        {% endif %}

    </div>
    {{ form_end(form) }}
</div>
