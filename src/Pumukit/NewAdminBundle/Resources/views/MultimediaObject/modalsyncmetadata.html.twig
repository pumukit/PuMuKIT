{% set modify_owners = false %}
{% if is_granted('ROLE_MODIFY_OWNER') %}
    {% set modify_owners = true %}
{% endif %}

<div class="modal-header">
    <h3 class="modal-title text-center">
        {% trans %}Sync metadata for all multimedia objects{% endtrans %}
    </h3>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    <hr/>
</div>

<form id="sync_metadata_mmo" data-controller="admin--modal-form" data-action="submit->admin--modal-form#submit"
      data-admin--modal-form-refresh-value="{{ [{target: '#list_mms', url: path('pumukitnewadmin_mms_list', {'id': multimediaObject.series.getId()})}]|json_encode }}"
      data-admin--modal-form-success-message-value="{{ 'Sync up metadata was successfully.'|trans }}"
      data-admin--modal-form-error-message-value="{{ 'There was an error sync up metadata.'|trans }}"
      data-admin--modal-form-title-error-value="true"
      action="{{ path('pumukitnewadmin_mms_update_sync_metadata', {'id' : multimediaObject.getId() } ) }}" method="POST">
    <div class="modal-body">
        <div class="row">
            <div class="col-md-4">
                <h4 class="text-center">
                    <strong>{% trans %}Metadata{% endtrans %}</strong>
                </h4>
                <hr/>
                <div class="row">
                    {% for title, field in fields %}
                        {% if (title != 'owners' and title != 'groups' and title != 'publishingdecisions') or ((title == 'owners' or title == 'groups') and modify_owners) or (title == 'publishingdecisions' and is_granted('ROLE_ACCESS_PUBLICATION_TAB') ) or is_granted('ROLE_SUPER_ADMIN') %}
                            <div class="col-md-12">
                                <div class="form-check pmk-display-table-row">
                                    <label for="metadata_{{ title }}_all">
                                        <input id="metadata_{{ title }}_all" type="checkbox" name="metadata_{{ title }}_all"/>
                                        {{ field|trans }}
                                    </label>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
            <div class="col-md-4">
                <h4 class="text-center">
                    <strong>{% trans %}Tags{% endtrans %}</strong>
                </h4>
                <hr/>
                <div class="row">
                    {% for tag in tags | filter(tag => tag.cod != 'ROOT') %}
                        <div class="col-md-12">
                            <div class="form-check pmk-display-table-row">
                                <label for="metadata_tag_{{ tag.getId() }}">
                                    <input id="metadata_tag_{{ tag.getId() }}" type="checkbox" name="metadata_tag_{{ tag.getId() }}"/>
                                    {{ tag.getTitle() }}
                                </label>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="col-md-4">
                <h4 class="text-center">
                    <strong>{% trans %}People{% endtrans %}</strong>
                </h4>
                <hr/>
                <div class="row">
                    {% for role in roles |filter(role => role.cod != 'owner') %}
                        <div class="col-md-12">
                            <div class="form-check pmk-display-table-row">
                                <label for="metadata_role_{{ role.getId() }}">
                                    <input id="metadata_role_{{ role.getId() }}" type="checkbox" name="metadata_role_{{ role.getId() }}"/>
                                    {{ role.getName() }}
                                </label>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <hr/>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            {% trans %}Cancel{% endtrans %}
        </button>
        <button type="submit" class="btn btn-pumukit">
            {% trans %}Sync{% endtrans %}
        </button>
    </div>

</form>
