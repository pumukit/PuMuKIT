{% form_theme form_pub '@PumukitNewAdmin/Themes/fields.html.twig' %}

<div id="tv_admin_container_pub" class="pmk-well">
    <form id="pumukitnewadmin_mms_updatepub_form"
          data-controller="admin--meta-form admin--modal-form"
          data-action="submit->admin--modal-form#submit change->admin--meta-form#changed"
          data-admin--meta-form-remember-value="#remember_save_mm_pub"
          data-admin--meta-form-always-value="true"
          data-admin--modal-form-target-value="#list_mms"
          data-admin--modal-form-refresh-value="{{ [{target: '#preview_mm', url: path('pumukitnewadmin_mms_show', {'id': mm.id})}, {target: '#links_mm_' ~ mm.id, url: path('pumukitnewadmin_mms_links', {'id': mm.id})}]|json_encode }}"
          data-admin--modal-form-modal-value=""
          data-admin--modal-form-success-message-value="{{ 'Multimedia Object saved OK'|trans }}"
          data-admin--modal-form-fail-message-value="{{ 'Multimedia Object saved ERROR'|trans }}"
          action="{{ path('pumukitnewadmin_mms_update_pub', {'id': mm.id}) }}" method="POST">

        <input type="hidden" name="id" id="mm_id_pub" value="{{ mm.id }}">
        <input type="hidden" name="series_id" id="series_id_updatepub" value="{{ mm.series.id }}">

        <div class="row">
            <div class="col-6">
                <div>
                    <span id="remember_save_mm_pub" class="alert alert-dismissable alert-danger pmk-display-none">{% trans %}
                        Press OK for changes to take effect{% endtrans %}</span> &nbsp;
                </div>
            </div>
            <div class="col-6 text-end">
                <button id="pumukitnewadmin_mms_updatepub_cancel" type="button" class="btn btn-secondary" data-action="click->admin--meta-form#cancel">{% trans %}
                    Cancel{% endtrans %}</button>
                <button type="submit" class="btn btn-pumukit" data-action="click->admin--meta-form#hideRemember">{% trans %}
                    OK{% endtrans %}</button>
            </div>
        </div>

        <fieldset class="row">
            <legend hidden>{% trans %}Update publication{% endtrans %}</legend>
            <div class="col-md-7">
                <div class="mb-3">
                    {{ form_label(form_pub['status'],{},  {'label_attr': {'class': 'update_pub_status_label' }}) }}
                    {{ form_widget(form_pub['status'], {'attr': {'class' : 'update_pub_status'}}) }}
                </div>

                <div class="mb-3{{ (mm.getStatus() == 1) ? ' pmk-background-color-f2f2f2' : '' }}" id="pumukitnewadmin_mms_pub_channel">
                    <label for="pub" class="form-label">{% trans %}Publication Channels{% endtrans %}</label>
                    <div id="list_pub_{{ mm.id }}">
                        {% include '@PumukitNewAdmin/MultimediaObject/listpub.html.twig' with {'mm': mm, 'pubs': pub_channels, 'pub_type': 'channels'} %}
                    </div>
                </div>
                <div class="mb-3" id="pumukitnewadmin_mms_pub_decision">
                    <label for="announce_label" class="form-label">{% trans %}Publishing
                        Decisions{% endtrans %}</label>
                    <div id="list_pubdecisions_{{ mm.id }}">
                        {% include '@PumukitNewAdmin/MultimediaObject/listpub.html.twig' with {'mm': mm, 'pubs': pub_decisions, 'pub_type': 'decisions'} %}
                    </div>
                </div>
                <div class="mb-3" id="pumukitnewadmin_mms_pub_broadcast">
                    <label for="announce_label" class="form-label">{% trans %}Broadcast profile{% endtrans %}</label>
                    <div id="list_pubbroadcast_{{ mm.id }}">
                        {% include '@PumukitNewAdmin/MultimediaObject/listbroadcast.html.twig' with {'mm': mm} %}
                    </div>
                </div>
                {% for pub in pub_channels %}
                    {% if pub.getProperty('advanced_configuration') and path_exists(pub.getProperty('advanced_configuration')) %}
                        <div class="pmk-padding-top-15 pmk-display-none" id="youtube_advanced_configuration">
                            {{ render(path( pub.getProperty('advanced_configuration'), {'id' : mm.getId()})) }}
                        </div>
                    {% endif %}
                {% endfor %}

                {{ form_rest(form_pub) }}

                {% if app.user and is_granted('ROLE_ACCESS_HEAD_AND_TAIL_MANAGER') and mm.isVideoType() and not mm.isMultistream() and not mm.isPrototype() %}
                    <label class="pmk-margin-top-1rem">{{ "Video options"|trans }}</label>
                    <div class="form-check pmk-margin-bottom-4">
                        <label>
                            <input id="video_head_option" type="checkbox" name="video_head_option" data-action="change->admin--actions#send" data-admin--actions-url-param="{{ path('pumukit_newadmin_head_and_tail_set_head', {'multimediaObject': mm.id, 'isHead': '__value__'}) }}" {% if mm.isHead()|default(false) %}checked{% endif %}> {{ "Video head"|trans }}
                        </label>
                    </div>
                    <div class="form-check">
                        <label>
                            <input id="video_tail_option" type="checkbox" name="video_tail_option" data-action="change->admin--actions#send" data-admin--actions-url-param="{{ path('pumukit_newadmin_head_and_tail_set_tail', {'multimediaObject': mm.id, 'isTail': '__value__'}) }}" {% if mm.isTail()|default(false) %}checked{% endif %}> {{ "Video tail"|trans }}
                        </label>
                    </div>
                {% endif %}
            </div>
        </fieldset>
    </form>
</div>
