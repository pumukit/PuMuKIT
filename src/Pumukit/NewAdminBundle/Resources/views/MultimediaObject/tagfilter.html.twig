<div class="row"><div class="input-group col-5">
  <div class="form-control-wrapper">
    <input type="search"
           class="tag_filter form-control empty pmk-font-size-80pct pmk-height-18"
           placeholder="{% trans %}Insert filter...{% endtrans %}"
           id="filter_tags_{{ parentId }}"
           data-action="input->admin--tag-picker#filter"
           data-admin--tag-picker-block-param="{{ parentId|json_encode }}" />
    <span class="material-input"></span>
  </div>
  <span class="input-group-text">
    <input class="btn btn-secondary btn-sm pmk-padding-1-5 pmk-margin-5-1"
           type="button"
           value="reset search"
           size="20"
           pattern=""
           data-action="click->admin--tag-picker#reset"
           data-admin--tag-picker-block-param="{{ parentId|json_encode }}" />
  </span>
  <img class="pmk-width-30 pmk-opacity-0 pmk-width-30 pmk-opacity-0" id="tag_filter_{{parentId}}_loader"
       alt="{% trans %}Spinner{% endtrans %}"
       src="{{ asset('bundles/pumukitnewadmin/images/admin/load/spinner.gif')}}"/>
</div></div>
