{% if series.sorting == constant('SORT_MANUAL', series) %}
<td class="pmk-width-1em" headers="th-icons">
    {% if mms.getCurrentPage() != 1 or not loop.first %}
        {% apply pumukit_spaceless %}
            <a class="pmk-color-00786d" data-action="click->admin--actions#post" href="{{ path('pumukitnewadmin_mms_down', {'id': mm.id}) }}" title="{% trans %}Move one position up{% endtrans %}">&#8593;</a>
            <a data-action="click->admin--actions#post" href="{{ path('pumukitnewadmin_mms_bottom', {'id': mm.id}) }}" title="{% trans %}Move to the beginning of the list{% endtrans %}">
                <i class="fa-solid fa-arrows-up-to-line"></i>
            </a>
        {% endapply %}
    {% endif %}
</td>
<td class="pmk-width-1em" headers="th-icons">
    {% if (mms.getCurrentPage() != mms.getNbPages()) or (loop.index + ((mms.getCurrentPage() - 1 ) * mms.getMaxPerPage()) != mms.getNbResults()) %}
        {% apply pumukit_spaceless %}
            <a class="pmk-color-00786d" data-action="click->admin--actions#post" href="{{ path('pumukitnewadmin_mms_up', {'id': mm.id}) }}" title="{% trans %}Move one position down{% endtrans %}">&#8595;</a>
            <a data-action="click->admin--actions#post" href="{{ path('pumukitnewadmin_mms_top', {'id': mm.id}) }}" title="{% trans %}Move to the end of the list{% endtrans %}">
                <i class="fa-solid fa-arrows-down-to-line"></i>
            </a>
        {% endapply %}
    {% endif %}
</td>
{% endif %}
