{% if has_pending_jobs(mm) %}
  <i class="fa-solid fa-arrows-rotate pmk-job-animate table_mms_job_animate" data-bs-toggle="tooltip" data-bs-placement="right" title="{% apply pumukit_spaceless %}
    {{ "{0} |{1} 1 pending job.  |]1,Inf[ %count% pending jobs."|trans({'%count%':  mm.getProperty('pending_jobs')|length}) }}
    {{ "{0} |{1} 1 executing job. |]1,Inf[ %count% executing jobs."|trans({'%count%':  mm.getProperty('executing_jobs')|length}) }}
      {% endapply %}"></i>
{% else %}
  {% if not is_naked() %}
  <i id="table_mms_status_{{ mm.id }}" class="{{ mm.status|status_icon }}" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm|status_text }}"></i>
  {% endif %}
{% endif %}

{% if 'XMLHttpRequest' == app.request.headers.get('X-Requested-With') %}
<span hidden data-controller="admin--pic-sync" data-admin--pic-sync-resource-value="{{ mm.id }}" data-admin--pic-sync-count-value="{{ mm.getPics()|length }}" data-admin--pic-sync-url-value="{{ path('pumukitnewadmin_mmspic_list', {'id': mm.id}) }}"></span>
{% endif %}
