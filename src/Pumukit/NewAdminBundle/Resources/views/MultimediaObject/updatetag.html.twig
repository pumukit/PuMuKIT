<div id="tv_admin_container_tag" class="pmk-well"
     data-controller="admin--tag-picker"
     data-admin--tag-picker-mm-value="{{ mm.id }}"
     data-admin--tag-picker-add-url-value="{{ path('pumukitnewadmin_mms_addtag', {'id': mm.id, 'tagId': '__tag__'}) }}"
     data-admin--tag-picker-delete-url-value="{{ path('pumukitnewadmin_mms_deletetag', {'id': mm.id, 'tagId': '__tag__'}) }}"
     data-admin--tag-picker-children-url-value="{{ path('pumukitnewadmin_mms_getchildrentag', {'id': '__tag__'}) }}"
     data-admin--tag-picker-search-url-value="{{ path('pumukitnewadmin_mms_searchtag') }}"
     data-admin--tag-picker-reload-url-value="{{ path('pumukitnewadmin_mms_reloadtags') }}"
     data-admin--tag-picker-codes-value="{{ is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::SHOW_CODES')) ? 'true' : 'false' }}"
     data-admin--tag-picker-refresh-value="{{ [{target: '#preview_mm', url: path('pumukitnewadmin_mms_show', {'id': mm.id})}]|json_encode }}">
    <div class="pmk-max-height-800 pmk-overflow-y-auto pmk-padding-7">
        {% for parent in parent_tags | filter(parent => parent.getDisplay() and parent.getChildren()|length != 0 and not parent.getProperty('hide_in_tag_group')) %}
            <div class="card panel-tag-{{ parent.cod }}">
                <div class="card-header">{{ parent.title }}</div>
                <div class="card-body" id="tag{{ parent.id }}_mms">
                    <div class="row">
                        <div class="col-12">
                            {% include '@PumukitNewAdmin/MultimediaObject/tagfilter.html.twig' with {'parentId': parent.id, 'mmId': mm.id} %}
                        </div>
                    </div>

                    <div class="row"><div class="col-12 pmk-overflow-hidden pmk-height-270">
                        {# Available tags #}
                        <div class="tag list-group pmk-tag-tree pmk-width-40pct pmk-max-width-400 pmk-float-left pmk-height-260 pmk-border-1-solid-bbb pmk-overflow-x-hidden pmk-overflow-y-scroll" id="all_tag_{{ parent.id }}">
                            {% if (0 != parent.getChildren()|length) %}
                                {% include '@PumukitNewAdmin/MultimediaObject/listtagsajax.html.twig' with {'mmId': mm.id, 'parent': 'root', 'block_tag': parent.id, 'nodes': parent.getChildren()} %}
                            {% endif %}
                        </div>

                        <div class="tag list-group pmk-tag-tree filter pmk-display-none pmk-width-400 pmk-float-left pmk-height-260 pmk-border-1-solid-bbb pmk-overflow-x-hidden pmk-overflow-y-scroll" id="all_tag_{{ parent.id }}_filter">
                            {# Here is where the filtered tags go when dynamically load using JS #}
                        </div>


                        <div class="pmk-float-left pmk-padding-150-5-0">
                            <a href="#" data-action="click->admin--tag-picker#removeActive" data-admin--tag-picker-cod-param="{{ parent.cod|json_encode }}">&#8592;</a>
                            <a href="#" data-action="click->admin--tag-picker#addActive" data-admin--tag-picker-block-param="{{ parent.id|json_encode }}">&#8594;</a>
                        </div>

                        {# Added tags#}
                        <div class="tag pmk-width-40pct pmk-max-width-400 pmk-height-260 pmk-border-1-solid-bbb pmk-float-left pmk-overflow-x-hidden pmk-overflow-y-scroll" id="select_tag_{{ parent.id }}">
                            <div class="tag_tree list-group" id="select_ul_tag_cod_{{ parent.cod }}">
                                {% for embedded_tag in mm.getTags() | filter(embedded_tag => embedded_tag.isDescendantOf(parent)) %}
                                    <a href="#" class="list-group-item tag-rm-{{ embedded_tag.cod }}"
                                       id="select_li_{{ embedded_tag.id }}"
                                       data-action="click->admin--tag-picker#select dblclick->admin--tag-picker#remove"
                                       data-admin--tag-picker-id-param="{{ embedded_tag.id|json_encode }}">
                                        {% if is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::SHOW_CODES')) %}
                                            {{ embedded_tag.getCod() }} -
                                        {% endif %}
                                        {{ embedded_tag.getTitle() }}
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div></div>
                </div>
            </div>
        {% endfor %}
    </div>
    <div class="pmk-height-41"></div>
</div>
