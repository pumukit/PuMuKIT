<div class="pmk-well"
     data-controller="admin--mm-groups"
     data-action="admin--group-lists:changed->admin--mm-groups#changed"
     data-admin--mm-groups-mm-value="{{ mm.id }}"
     data-admin--mm-groups-template-value="{{ template }}"
     data-admin--mm-groups-update-url-value="{{ path('pumukitnewadmin_mms_updategroups', {'id': mm.id}) }}"
     data-admin--mm-groups-groups-url-value="{{ path('pumukitnewadmin_mms_getgroups', {'id': mm.id}) }}"
     data-admin--mm-groups-last-relation-url-value="{{ path('pumukitnewadmin_mms_user_last_relation') }}"
     data-admin--mm-groups-preview-url-value="{{ path('pumukitnewadmin_mms_show', {'id': mm.id}) }}"
     data-admin--mm-groups-series-url-value="{{ path('pumukitnewadmin_series_index') }}"
     data-admin--mm-groups-messages-value="{{ {saved: 'Successfully updated groups in Mm.'|trans, confirm: 'Are you sure you want to delete the relation of'|trans, noAccess: 'WARNING: You will no longer have access to this Multimedia Object.'|trans, deleted: 'Person successfully removed from Multimedia Object'|trans, deleteError: 'Error deleting Person'|trans}|json_encode }}">
    <input type="hidden" name="id" id="mm_id_group" value="{{ mm.id }}">
    <input type="hidden" name="series_id" id="series_id_updategroup" value="{{ mm.series.id }}">
    <input type="hidden" name="template" id="template" value="{{ template }}">
    <div class="row">
      <div class="col-6">
        <span id="remember_save_mm{{ template }}_group" data-admin--mm-groups-target="remember" class="alert alert-dismissable alert-danger pmk-display-none pmk-vertical-align-middle">{% trans %}Press OK for changes to take effect{% endtrans %}</span> &nbsp;
        <span id="warning_personal_user_mm{{ template }}_group" data-admin--mm-groups-target="warning" class="alert alert-dismissable alert-danger pmk-display-none pmk-vertical-align-middle">{% trans %}WARNING: If you press OK, you will no longer have access to this Multimedia Object{% endtrans %}</span> &nbsp;
      </div>
      <div class="col-6 text-end">
        <button type="button" class="btn btn-secondary" id="pumukitnewadmin_mm{{ template }}_updategroup_reset" data-action="click->admin--mm-groups#reset">{% trans %}Cancel{% endtrans %}</button>
        <button type="submit" class="btn btn-pumukit" id="pumukitnewadmin_mm{{ template }}_updategroup_submit" data-action="click->admin--mm-groups#save">{% trans %}OK{% endtrans %}</button>
      </div>
    </div>
    <fieldset>
      <legend hidden>{% trans %}Relations list{% endtrans %}</legend>
    <dl class="pmk-margin-0">
      {% if personal_scope_role %}
      <div class="form-row">
          <div id="{{ personal_scope_role.getId() }}_person_mms{{ template }}">
            {% include '@PumukitNewAdmin/MultimediaObject/listownerrelation.html.twig' with {'people': mm.getPeopleByRole(personal_scope_role, true), 'mm': mm, 'role': personal_scope_role, 'personal_scope_role': personal_scope_role, 'template': template} %}
          </div>
      </div>
      <hr class="pumukit-green"/>
      {% endif %}
      <div class="form-row">
          <div id="group_mms{{ template }}">
            {% include '@PumukitNewAdmin/MultimediaObject/listgrouprelation.html.twig' with {'groups': groups, 'mm': mm, 'template': template} %}
          </div>
      </div>
    </dl>
  </fieldset>
</div>
