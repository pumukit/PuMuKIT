{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block body %}
    <h3 class="cab_body_div">
        <a title="{% trans %}Back to series list{% endtrans %}" href="{{ path('pumukitnewadmin_series_index') }}" class="btn btn-pumukit float-end pmk-margin-0">
            « {% trans %}Back to series list{% endtrans %}
        </a>
        <ul class="breadcrumb pmk-margin-bottom-5">
            <li class="breadcrumb-item">
                <a href="{{ path('pumukitnewadmin_series_index') }}">
                    {% if app.user and is_granted('ROLE_SCOPE_PERSONAL') %}
                        {% trans %}My Series{% endtrans %}
                    {% else %}
                        {% trans %}Series{% endtrans %}
                    {% endif %}
                </a>
            </li>
            <li class="active breadcrumb-item">{% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) %} {{ series.getTitle() }}{% endif %}</li>
        </ul>
        {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) %}
            <input type="hidden" name="series_id" id="mms_series_id" value="{{ series.id }}"/>
        {% endif %}
    </h3>

    <div class="row">
        {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) %}
            <div id="tv_admin_content" class="col-md-10" data-controller="admin--job-status" data-admin--job-status-url-value="{{ path('pumukitnewadmin_mms_status', {'id': '__id__'}) }}">
                <div class="pmk-well">
                    <div id="list_mms">
                        {% include '@PumukitNewAdmin/MultimediaObject/list.html.twig' %}
                    </div>
                    <div class="row">
                        <div class="col-4">
                            <select id="options_mms" class="form-select" title="{% trans %}Actions on selected items{% endtrans %}" data-controller="admin--batch" data-action="change->admin--batch#run"
                                    data-admin--batch-name-value="mm" data-admin--batch-plural-value="mms" data-admin--batch-preview-value="mm"
                                    data-admin--batch-urls-value="{{ {delete: path('pumukitnewadmin_mms_batch_delete', {'ids': '__ids__'}), invert: path('pumukitnewadmin_mms_invert_announce', {'ids': '__ids__'}), cut: path('pumukitnewadmin_mms_cut', {'ids': '__ids__'}), paste: path('pumukitnewadmin_mms_paste', {'seriesId': series.id}), playlist: path('pumukitnewadmin_playlistmms_modal_add', {'ids': '__ids__'})}|json_encode }}"
                                    data-admin--batch-announce-value="{{ {edit: '#inputMMId', checkbox: '#list_pubdecisions___id__ #pub_decisions_PUDENEW'}|json_encode }}"
                                    data-admin--batch-messages-value="{{ {confirm: 'Are you sure?'|trans, success: 'Multimedia Object(s) successfully deleted.'|trans, selectAny: 'Select any multimedia object.'|trans, active: '(active)'|trans, noneSelected: 'No multimedia object selected'|trans, paste: 'Paste multimedia objects'|trans, cutOne: 'Multimedia Object cut. Paste it in the desire Series.'|trans, cutMany: 'Multimedia Objects cut. Paste them in the desire Series.'|trans, pasteConfirm: 'Paste multimedia object(s) in this series?'|trans, pasted: 'Multimedia Object(s) pasted in the Series.'|trans}|json_encode }}">
                                <option value="default" selected="selected">{% trans %}Select an action{% endtrans %}...</option>
                                <option disabled="">---</option>
                                <option value="delete_selected">{% trans %}Delete selected{% endtrans %}</option>

                                {% if not is_naked() %}
                                    <option {% if disable_pudenew %}disabled=""{% endif %} value="invert_announce_selected">{% trans %}Announce/Not announce selected{% endtrans %}</option>
                                {% endif %}

                                <option disabled="">---</option>
                                <option value="order_manual" data-type="sort" data-url="{{ path('pumukitnewadmin_mms_reorder', {'seriesId': series.id, 'sorting': 0, 'fieldName': 'rank', 'order': 'asc'}) }}" {% if series.sorting == constant('SORT_MANUAL', series) %}data-active="1"{% endif %}>
                                    {% trans %}List multimedia objects in a manual order{% endtrans %}
                                    {% if series.sorting == constant('SORT_MANUAL', series) %}{% trans %}(active){% endtrans %}{% endif %}
                                </option>
                                <option value="order_pub_date_desc" data-type="sort" data-url="{{ path('pumukitnewadmin_mms_reorder', {'seriesId': series.id, 'sorting': 2, 'fieldName': 'public_date', 'order': 'desc'}) }}" {% if series.sorting == constant('SORT_PUB_DES', series) %}data-active="1"{% endif %}>
                                    {% trans %}List multimedia objects in descending order of publication date{% endtrans %}
                                    {% if series.sorting == constant('SORT_PUB_DES', series) %}{% trans %}(active){% endtrans %}{% endif %}
                                </option>
                                <option value="order_pub_date_asc" data-type="sort" data-url="{{ path('pumukitnewadmin_mms_reorder', {'seriesId': series.id, 'sorting': 1, 'fieldName': 'public_date', 'order': 'asc'}) }}" {% if series.sorting == constant('SORT_PUB_ASC', series) %}data-active="1"{% endif %}>
                                    {% trans %}List multimedia objects in ascending order of publication date{% endtrans %}
                                    {% if series.sorting == constant('SORT_PUB_ASC', series) %}{% trans %}(active){% endtrans %}{% endif %}
                                </option>
                                <option value="order_rec_date_desc" data-type="sort" data-url="{{ path('pumukitnewadmin_mms_reorder', {'seriesId': series.id, 'sorting': 3, 'fieldName': 'record_date', 'order': 'desc'}) }}" {% if series.sorting == constant('SORT_REC_DES', series) %}data-active="1"{% endif %}>
                                    {% trans %}List multimedia objects in descending order of recording date{% endtrans %}
                                    {% if series.sorting == constant('SORT_REC_DES', series) %}{% trans %}(active){% endtrans %}{% endif %}
                                </option>
                                <option value="order_rec_date_asc" data-type="sort" data-url="{{ path('pumukitnewadmin_mms_reorder', {'seriesId': series.id, 'sorting': 4, 'fieldName': 'record_date', 'order': 'asc'}) }}" {% if series.sorting == constant('SORT_REC_ASC', series) %}data-active="1"{% endif %}>
                                    {% trans %}List multimedia objects in ascending order of recording date{% endtrans %}
                                    {% if series.sorting == constant('SORT_REC_ASC', series) %}{% trans %}(active){% endtrans %}{% endif %}
                                </option>
                                <option value="order_abc" data-type="sort" data-url="{{ path('pumukitnewadmin_mms_reorder', {'seriesId': series.id, 'sorting': 5, 'fieldName': 'title.es', 'order': 'asc'}) }}" {% if series.sorting == constant('SORT_ALPHAB', series) %}data-active="1"{% endif %}>
                                    {% trans %}List multimedia objects in ascending order of title{% endtrans %}
                                    {% if series.sorting == constant('SORT_ALPHAB', series) %}{% trans %}(active){% endtrans %}{% endif %}
                                </option>
                                <option disabled="">---</option>
                                <option value="cut_mm">{% trans %}Cut multimedia objects{% endtrans %}</option>
                                {% if app.session.has('admin/mms/cut') and app.session.get('admin/mms/cut') %}
                                    <option value="paste_mm" id="paste_mm">
                                        {% trans %}Paste multimedia objects{% endtrans %} ({% for id in app.session.get('admin/mms/cut') %}{{ id }}{% if not loop.last %},&nbsp;{% endif %}{% endfor %})
                                    </option>
                                {% else %}
                                    <option class="pmk-display-none" value="paste_mm" id="paste_mm"></option>
                                {% endif %}
                                {% if app.user and is_playlist_enabled() and is_granted('ROLE_ACCESS_EDIT_PLAYLIST') %}
                                    <option value="add_playlist">{% trans %}Add to playlist{% endtrans %}</option>
                                {% endif %}
                            </select>
                        </div>
                        <div class="col-8 text-end">
                            {# RENDERS ANY BUTTONS DEFINED IN AN EXTRA PLUGIN #}
                            {% for item in get_extra_buttons() %}
                                {% if app.user and is_granted(item.accessRole) %}
                                    <a title="{{ item.name | trans }}" class="btn btn-pumukit qa_series_button_{{ item.name }} extra_button" href="{{ path(item.uri, {'series': series.id }) }}">
                                        <i class="{{ item.iconClass | default('fas fa-plus') }}"></i>
                                        {{ item.name | trans }}
                                    </a>
                                {% endif %}
                            {% endfor %}
                                <a class="extra_button btn btn-primary btn-pumukit wizard_button" href="{{ path('wizard_upload', {'series': series.id}) }}">
                                    <i class="fas fa-upload"></i>
                                    {% trans %}Upload{% endtrans %}
                                </a>
                                {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ADD_EXTERNAL_PLAYER')) %}
                                <a class="extra_button btn btn-primary wizard_button" href="{{ path('pumukitnewadmin_mms_listexternalproperties', {'series': series.id}) }}" title="{% trans %}Edit{% endtrans %}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-dismiss="modal" data-bs-target="#myModal">
                                    <i class="fas fa-link"></i>
                                    {% trans %}Link{% endtrans %}
                                </a>
                                {% endif %}
                        </div>
                    </div>
                </div>
                <div id="edit_mm">
                    {% if(app.session.has('admin/series/id') and app.session.has('admin/mms/id')) %}
                        {{ render(url('pumukitnewadmin_mms_edit', {'id': app.session.get('admin/mms/id'), 'seriesId': app.session.get('admin/series/id')})) }}
                    {% endif %}
                </div>
            </div>

            <div id="tv_admin_bar" class="col-md-2 d-none d-md-block">
                <div id="preview_mm" class="pmk-well">
                    {% if(app.session.has('admin/mms/id')) %}
                        <div data-controller="admin--include" data-admin--include-src-value="{{ url('pumukitnewadmin_mms_show', {'id': app.session.get('admin/mms/id')}) }}"></div>
                    {% else %}
                        {% trans %}Select any multimedia object.{% endtrans %}
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="col-md-12">
                <div class="pmk-well">
                    {% trans %}You don't have enough permissions to access this content.{% endtrans %}
                </div>
            </div>
        {% endif %}
    </div>

    <div class="pmk-modal modal fade" id="myAuxModal" tabindex="-1" role="dialog" aria-labelledby="myAuxModalLabel" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
            </div>
        </div>
    </div>
{% endblock %}
