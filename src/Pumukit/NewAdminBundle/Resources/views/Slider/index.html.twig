{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block body %}

    <h3 class="cab_body_div">
        <ul class="breadcrumb pmk-margin-bottom-5">
            <li class="active breadcrumb-item">
                {% trans %}Slider manager{% endtrans %}
            </li>
        </ul>
    </h3>

    <div class="pmk-well slider-manager" data-controller="admin--slider"
         data-admin--slider-url-value="{{ path('pumukit_newadmin_slider_order') }}"
         data-admin--slider-token-value="{{ csrf_token('slider_order') }}"
         data-admin--slider-messages-value="{{ {saved: 'Order saved successfully'|trans, error: 'Error saving order'|trans}|json_encode }}">

        <p class="text-muted slider-description">
            {% trans %}Drag and drop the contents to change their order in the slider.{% endtrans %}
        </p>

        <div id="slider-sortable">
            {% for mm in multimediaObjects %}
                <div class="slider-item" data-id="{{ mm.id }}" draggable="true" data-admin--slider-target="item" data-action="dragstart->admin--slider#start dragend->admin--slider#end dragover->admin--slider#over">
                    <div class="slider-handle" title="{% trans %}Drag to reorder{% endtrans %}">
                        <i class="fa-solid fa-bars"></i>
                    </div>

                    <div class="slider-position" data-admin--slider-target="position">
                        {{ loop.index }}
                    </div>

                    {% set src = mm|first_url_pic(false, false) %}

                    <div class="slider-thumbnail">
                        <a href="{{ path('pumukitnewadmin_mms_shortener', {id: mm.id}) }}" title="{% trans %}Edit multimedia object{% endtrans %}">
                            <img src="{{ src }}" class="img-fluid" alt="{{ mm.getTitle() }}">
                        </a>
                    </div>

                    <div class="slider-content">
                        <div class="slider-main-info">
                            <div class="slider-title">
                                <a href="{{ path('pumukitnewadmin_mms_shortener', {id: mm.id}) }}" title="{% trans %}Edit multimedia object{% endtrans %}">
                                    {{ mm.getTitle() }}
                                </a>
                            </div>

                            <div class="slider-metadata">
                                {% if mm.getSeries() %}
                                    <span class="slider-metadata-item" title="{% trans %}Series{% endtrans %}">
                                        <i class="fa-solid fa-folder-open"></i>
                                        {{ mm.getSeries().getTitle() }}
                                    </span>
                                {% endif %}

                                <span class="slider-metadata-item" title="{% trans %}Type{% endtrans %}">
                                    {% if mm.isVideoType() %}
                                        <i class="fa-solid fa-file-video"></i>
                                    {% elseif mm.isAudioType() %}
                                        <i class="fa-solid fa-file-audio"></i>
                                    {% elseif mm.isImageType() %}
                                        <i class="fa-solid fa-file-image"></i>
                                    {% elseif mm.isDocumentType() %}
                                        <i class="fa-solid fa-file-lines"></i>
                                    {% elseif mm.isExternalType() %}
                                        <i class="fa-solid fa-link"></i>
                                    {% endif %}

                                    {{ mm.getStringType(mm.getType()) }}
                                </span>

                                {% if mm.getPublicDate() %}
                                    <span class="slider-metadata-item" title="{% trans %}Publication date{% endtrans %}">
                                        <i class="fa-solid fa-calendar"></i>
                                        {{ mm.getPublicDate()|format_datetime('medium', 'none', locale=app.request.getLocale()) }}
                                    </span>
                                {% endif %}

                            </div>
                        </div>

                        <div class="slider-status">
                            {% if mm.containsTagWithCod('PUCHWEBTV') %}
                                <span class="badge text-bg-info">
                                    <i class="fa-solid fa-globe"></i>
                                    WebTV
                                </span>
                            {% else %}
                                <span class="badge text-bg-secondary">
                                    <i class="fa-solid fa-xmark"></i>
                                    WebTV
                                </span>
                            {% endif %}

                            {% if mm.status == constant('Pumukit\\SchemaBundle\\Document\\MultimediaObject::STATUS_PUBLISHED') %}
                                <span class="badge text-bg-success">
                                    <i class="fa-solid fa-check"></i>
                                    {% trans %}Published{% endtrans %}
                                </span>
                            {% else %}
                                <span class="badge text-bg-secondary">
                                    <i class="fa-solid fa-xmark"></i>
                                    {% trans %}Not published{% endtrans %}
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="alert alert-info">
                    {% trans %}There are no contents in the slider{% endtrans %}
                </div>
            {% endfor %}
        </div>

        {% if multimediaObjects|length %}
            <div class="slider-actions">
                <button id="save-slider-order" type="button" class="btn btn-primary" data-action="click->admin--slider#save">
                    {% trans %}Save{% endtrans %}
                </button>
            </div>
        {% endif %}

    </div>

{% endblock %}
