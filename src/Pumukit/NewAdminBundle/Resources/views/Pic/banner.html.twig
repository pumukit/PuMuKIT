<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">{% trans %}add new banner{% endtrans %}</h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">

    <div id="div_banner_file">
        {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) %}
            {% set upload_path = path('pumukitnewadmin_'~resource_name~'pic_upload', {'id': resource.id, 'banner': true}) %}
            <div data-controller="admin--upload-form"
                 data-action="submit->admin--upload-form#submit core--uploader:success->admin--upload-form#uploaded core--uploader:failed->admin--upload-form#failed"
                 data-admin--upload-form-refresh-value="{{ [{target: '#edit_series', url: path('pumukitnewadmin_series_update', {'id': resource.id})}]|json_encode }}"
                 data-admin--upload-form-success-message-value="{{ "New Thumbnail added."|trans }}"
                 data-admin--upload-form-empty-message-value="{{ "Select a file on first place. Thank you."|trans }}"
                 data-admin--upload-form-invalid-url-message-value="{{ "The given URL is not valid"|trans }}.">
                <form autocomplete="off" method="post" enctype="multipart/form-data" action="{{ upload_path }}"
                      {{ uploader_attributes({
                          transport: 'xhr',
                          endpoint: upload_path,
                          formMeta: true,
                          restrictions: {maxNumberOfFiles: 1, allowedFileTypes: ['image/*']},
                          xhr: {fieldName: 'file'},
                          dashboard: {height: 260, hideUploadButton: true}
                      }) }}>
                    <input type="hidden" name="type" id="type" value="url">
                    <input type="hidden" name="{{ resource_name }}" id="{{ resource_name }}" value="{{ resource.id }}">
                    <fieldset>
                        <legend hidden>{% trans %}Add a file{% endtrans %}</legend>
                        <div class="mb-3">
                            <label>{% trans %}Add a file{% endtrans %}:</label>
                            <div data-core--uploader-target="dashboard"></div>
                        </div>
                        <div class="mb-3">
                            <label for="file_bannerTargetUrl">{% trans %}Write the target URL{% endtrans %}:</label>
                            <div>
                                <input type="text" name="file_bannerTargetUrl" id="file_bannerTargetUrl" value="" size="65" class="form-control" data-admin--upload-form-target="requiredUrl">
                            </div>
                        </div>
                    </fieldset>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Cancel{% endtrans %}</button>
                        <button type="submit" class="btn btn-pumukit">{% trans %}Add{% endtrans %}</button>
                    </div>
                </form>
            </div>
        {% endif %}
    </div>

    <div class="pmk-clear-both"></div>
</div>
