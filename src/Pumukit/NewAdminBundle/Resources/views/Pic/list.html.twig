{% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) %}
<div id="pic_list_thumbnails"{% if 'XMLHttpRequest' == app.request.headers.get('X-Requested-With') %} data-controller="admin--pic-list" data-admin--pic-list-resource-value="{{ resource.id }}" data-admin--pic-list-default-pic-value="{{ {'series': '/bundles/pumukitschema/images/series_folder.png', 'playlist': '/bundles/pumukitschema/images/playlist_folder.png'}[resource_name]|default('/images/none.jpg') }}"{% endif %}>
  {% set event_poster = (is_event_poster is defined ? is_event_poster : false) %}
  {% for index,pic in resource.getPics() | filter(pic => event_poster and pic.containsTag('poster') or (not event_poster and not pic.containsTag('poster'))) %}
  <div class="pmk-float-left pmk-padding-10">
    <div class="pmk-padding-10 pmk-float-left pmk-text-align-center">
      <div class="wrap0"><div class="wrap1"><div class="wrap2"><div class="wrap3">
              <img class="image-responsive pic-{{ resource.id }} admin-pic-{{ resource.id }} pic-{{ loop.index0 }} {% if loop.first %}first{% endif %} pmk-max-width-146 pmk-height-82" src="{{ pic.getUrl() }}" border="1" alt="{% trans %}Thumbnail{% endtrans %}">
      </div></div></div></div>
    </div>
    <div class="pmk-text-align-center">
      {% if (0 != index) and not event_poster %}
      <a href="#" data-action="click->admin--actions#load" data-admin--actions-url-param="{{ path('pumukitnewadmin_' ~ resource_name ~ 'pic_up', {'id': pic.id}) }}" data-admin--actions-target-param="#pic_{{ resource_name }}_{{ resource.id }}" data-admin--actions-data-param="{{ {method: 'POST'}|json_encode }}" title="{% trans %}Move up thumbnail{% endtrans %}" class="thumbnail_arrow_move_pic {{ (event_poster and pic.containsTag('poster')) ? 'is_poster':'no_poster'}}">&#8592;</a>
      {% endif %}
      {% if event_poster %}
      <a href="#" data-action="click->admin--actions#remove" data-admin--actions-url-param="{{ path('pumukitnewadmin_mmspic_delete', {'id': pic.id, 'is_event_poster': true}) }}" data-admin--actions-target-param="#pic_events_{{ resource.id }}" data-admin--actions-confirm-param="{{ 'Are you sure you want to delete this event poster?'|trans }}" data-admin--actions-success-param="{{ 'Event poster removed.'|trans }}" title="{% trans %}Delete thumbnail{% endtrans %}" class="thumbnail_pic {{ (event_poster and pic.containsTag('poster')) ? 'is_poster':'no_poster'}}">
        <i class="fa-solid fa-xmark"></i>
      </a>
      {% else %}
      <a href="#" {% if 'series' == resource_name %} data-action="click->admin--actions#remove" data-admin--actions-url-param="{{ path('pumukitnewadmin_seriespic_delete', {'id': pic.id}) }}" data-admin--actions-target-param="{{ pic_container|default('#edit_series') }}" data-admin--actions-confirm-param="{{ 'Are you sure you want to delete this thumbnail?'|trans }} {{ 'If it corresponds to the one associated with the banner, the entire header will also be removed.'|trans }}" data-admin--actions-success-param="{{ 'Thumbnail removed.'|trans }}" {% elseif 'playlist' == resource_name %} data-action="click->admin--actions#remove" data-admin--actions-url-param="{{ path('pumukitnewadmin_seriespic_delete', {'id': pic.id}) }}" data-admin--actions-target-param="#edit_playlist" data-admin--actions-reload-param="{{ path('pumukitnewadmin_playlist_update', {'id': resource.id}) }}" data-admin--actions-confirm-param="{{ 'Are you sure you want to delete this thumbnail?'|trans }}" data-admin--actions-success-param="{{ 'Thumbnail removed.'|trans }}" {% else %} data-action="click->admin--actions#remove" data-admin--actions-url-param="{{ path('pumukitnewadmin_' ~ resource_name ~ 'pic_delete', {'id': pic.id}) }}" data-admin--actions-target-param="#pic_{{ resource_name }}_{{ resource.id }}" data-admin--actions-confirm-param="{{ 'Are you sure you want to delete this thumbnail?'|trans }}" data-admin--actions-success-param="{{ 'Thumbnail removed.'|trans }}" {% endif %} title="{% trans %}Delete thumbnail{% endtrans %}" class="thumbnail_pic {{ (event_poster and pic.containsTag('poster')) ? 'is_poster':'no_poster'}}">
        <i class="fa-solid fa-xmark"></i>
      </a>
      {% endif %}
      {% if ((resource.getPics()|length - 1) != index) and not event_poster %}
      <a href="#" data-action="click->admin--actions#load" data-admin--actions-url-param="{{ path('pumukitnewadmin_' ~ resource_name ~ 'pic_down', {'id': pic.id}) }}" data-admin--actions-target-param="#pic_{{ resource_name }}_{{ resource.id }}" data-admin--actions-data-param="{{ {method: 'POST'}|json_encode }}" title="{% trans %}Move down thumbnail{% endtrans %}" class="thumbnail_arrow_move_pic {{ (event_poster and pic.containsTag('poster')) ? 'is_poster':'no_poster'}}">&#8594;</a>
      {% endif %}
    </div>
  </div>
  {% endfor %}
  {% if event_poster and not resource.getPicWithTag('poster') %}
  <div class="pmk-float-left pmk-padding-10">
    <div class="pmk-padding-10 pmk-float-left pmk-text-align-center">
      <div class="wrap0"><div class="wrap1"><div class="wrap2"><div class="wrap3">
              <img class="image-responsive pic-{{ resource.id }} admin-pic-{{ resource.id }} pic-0 first pmk-max-width-146 pmk-height-82"  src="{{ default_poster() }}" border="1" alt="{% trans %}Default live screen image{% endtrans %}">
      </div></div></div></div>
    </div>
    <div class="pmk-text-align-center">
      <a href="#" data-action="click->admin--actions#cancel" title="{% trans %}Default live screen image{% endtrans %}">
        {% trans %}Default live screen image{% endtrans %}
      </a>
    </div>
  </div>
  {% endif %}
  <img class="pmk-position-relative pmk-top-50 pmk-float-left pmk-display-none" id="pic_mms_{{ resource.id }}_load" src="{{ asset('bundles/pumukitnewadmin/images/admin/load/spinner.gif') }}" alt="{% trans %}loading{% endtrans %}"/>
</div>

<div class="pmk-width-120 pmk-float-left pmk-padding-10">
  <div class="pmk-padding-10 pmk-float-left pmk-text-align-center">
    <div class="wrap0"><div class="wrap1"><div class="wrap2"><div class="wrap3">
            <img class="image-responsive" src="{{ asset('bundles/pumukitnewadmin/images/none.jpg') }}" width="100" height="82" border="1" alt="{% trans %}Thumbnail{% endtrans %}">
    </div></div></div></div>
  </div>

  <div class="pmk-text-align-center">
    {% if resource_name == 'mms' and resource.isVideoAudioType() and resource.getDisplayTrack() and not resource.isAudioType() %}
      <a href="{{ path('pumukitnewadmin_mmspic_generate', {'id': resource.id}) }}" class="button_generate_thumbnail" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">{% trans %}Generate thumbnail{% endtrans %}...</a>
    {% elseif event_poster %}
      <a href="{{ path('pumukitnewadmin_'~resource_name~'pic_create', {'id': resource.id, 'is_event_poster': event_poster}) }}" class="button_new_poster" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">{% trans %}New poster{% endtrans %}...</a>
    {% else %}
      <a href="{{ path('pumukitnewadmin_'~resource_name~'pic_create', {'id': resource.id, 'is_event_poster': event_poster}) }}" class="button_new_thumbnail" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">{% trans %}New thumbnail{% endtrans %}...</a>
    {% endif %}
  </div>
</div>
{% else %}
  {% trans %}You don't have enough permissions to access this content.{% endtrans %}
{% endif %}

<div class="pmk-clear-left"></div>

