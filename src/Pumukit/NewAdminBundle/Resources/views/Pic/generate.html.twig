<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">{% trans %}generate new thumbnail{% endtrans %}</h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body" data-controller="admin--pic-generator"
     data-admin--pic-generator-width-value="{{ thumbnail_width }}"
     data-admin--pic-generator-height-value="{{ thumbnail_height }}"
     data-admin--pic-generator-generate-url-value="{{ path('pumukitnewadmin_mmspic_generate', {'id': mm.id}) }}"
     data-admin--pic-generator-mm-id-value="{{ mm.id }}"
     data-admin--pic-generator-list-url-value="{{ path('pumukitnewadmin_mmspic_list', {'id': mm.id}) }}"
     data-admin--pic-generator-list-target-value="#pic_mms_{{ mm.id }}"
     data-admin--pic-generator-message-value="{{ 'Thumbnail generated.'|trans }}">

    <div id="tv_admin_container">
        <div class="row">
            <div class="col-md-5 text-center">
                <!-- PLAYER -->
                <video class="pmk-background-black pmk-width-100pct" id="gen_pic_player" data-admin--pic-generator-target="video" src="{{ track_url(track)|raw }}" controls crossorigin=""></video>
            </div>
            <div class="col-md-2">

                <!-- CONTROLS -->
                <div class="buttons pmk-text-align-center" id="gen_pic_buttons" data-admin--pic-generator-target="buttons">

                    <div class="btn-group btn-group-raised pmk-margin-top-0">
                        <button id="prev-frame-button" data-action="click->admin--pic-generator#previousFrame" title="{% trans %}Prev Frame{% endtrans %}" class="btn btn-sm pmk-padding-8-25">
                            «
                        </button>
                        <button id="next-frame-button" data-action="click->admin--pic-generator#nextFrame" title="{% trans %}Next Frame{% endtrans %}" class="btn btn-sm pmk-padding-8-25">
                            »
                        </button>
                    </div>

                    <button id="take-img-button" data-action="click->admin--pic-generator#take" title="Take image." class="btn btn-primary pmk-padding-8 pmk-white-space-normal">{% trans %}Take image{% endtrans %}</button>


                    <div class="btn-group">
                        <a href="#" data-bs-target="#" class="btn dropdown-toggle pmk-padding-8 pmk-white-space-normal" data-bs-toggle="dropdown">
                            {% trans %}Take burst{% endtrans %}
                        </a>
                        <ul class="dropdown-menu">
                            <li><a href="#" class="take-burst-button dropdown-item" data-num="10" data-action="click->admin--pic-generator#burst" data-admin--pic-generator-num-param="10">10 pictures</a></li>
                            <li><a href="#" class="take-burst-button dropdown-item" data-num="30" data-action="click->admin--pic-generator#burst" data-admin--pic-generator-num-param="30">30 pictures</a></li>
                            <li><a href="#" class="take-burst-button dropdown-item" data-num="50" data-action="click->admin--pic-generator#burst" data-admin--pic-generator-num-param="50">50 pictures</a></li>
                        </ul>
                    </div>

                    <button id="advanced-button" data-action="click->admin--pic-generator#toggleAdvanced" title="Show advanced" class="btn btn-sm pmk-margin-top-0 pmk-padding-1-5 pmk-white-space-nowrap">
                        {% trans %}Show advanced{% endtrans %}
                    </button>

                </div>

            </div>
            <div class="col-md-5 text-center">
                <span id="pic-size" data-admin--pic-generator-target="size" class="badge text-bg-secondary pmk-position-absolute"></span>
                <!-- PREVIEW -->
                <img class="image pmk-width-100pct pmk-height-auto pmk-object-fit-contain" id="gen_pic_img" data-admin--pic-generator-target="image" src="{{ asset('bundles/pumukitnewadmin/images/admin/arrows/redarrow.png') }}">
            </div>

        </div>

        <div class="row pmk-display-none" id="advanced" data-admin--pic-generator-target="advanced">
            {% if mm.isMultistream() %}

            {% trans %}Show{% endtrans %}:
            <div class="btn-group btn-group-raised">
              <button title="{% trans %}Show presenter{% endtrans %}" id="show-presenter" class="btn btn-sm{{ 'presenter/delivery' in track.tags ? ' btn-primary' }}" data-admin--pic-generator-target="stream" data-action="click->admin--pic-generator#showStream" data-admin--pic-generator-url-param="{{ track_url(mm.getFilteredTrackWithTags(['presenter/delivery'])) }}">
                {% trans %}presenter{% endtrans %}
              </button>
              <button title="{% trans %}Show presentation{% endtrans %}" id="show-presentation" class="btn btn-sm{{ 'presenter/delivery' not in track.tags and 'presentation/delivery' in track.tags ? ' btn-primary' }}" data-admin--pic-generator-target="stream" data-action="click->admin--pic-generator#showStream" data-admin--pic-generator-url-param="{{ track_url(mm.getFilteredTrackWithTags(['presentation/delivery'])) }}">
                {% trans %}presentation{% endtrans %}
              </button>
            </div>

            {% endif %}

            {% trans %}Format{% endtrans %}:
            <select id="pic-format" data-admin--pic-generator-target="format" data-action="change->admin--pic-generator#changeFormat">
                <option value="jpeg">jpeg</option>
                <option value="png">png</option>
                {#<option value="webp">webp (experimental)</option>#}
            </select>

            <div class="pmk-display-inline-block" id="quality_image" data-admin--pic-generator-target="qualityBox">
                {% trans %}Quality{% endtrans %}:
                <select id="pic-quality" data-admin--pic-generator-target="quality">
                    <option>1.0</option>
                    <option selected="selected">0.92</option>
                    <option>0.85</option>
                    <option>0.75</option>
                    <option>0.6</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="pmk-overflow-y-scroll pmk-height-210 pmk-margin-top-15" id="frames" data-admin--pic-generator-target="frames"></div>
        </div>

    </div>

    <div class="row"><div class="col-12">
        <label for="url">{% trans %}URL{% endtrans %}</label>
        <input type="text" id="url-file-button" data-action="input->admin--pic-generator#addUrl" name="url" class="form-control"/>
    </div></div>
    <div class="pmk-clear-both"></div>
    <div class="modal-footer">
        <div class="row">
            <div class="col-4">
                <input type="file" id="file-upload-button" data-action="change->admin--pic-generator#upload" name="file" title="{% trans %}Upload a local file.{% endtrans %}" accept="image/*"/>
            </div>
            <div class="col-8 text-end">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Cancel{% endtrans %}</button>
                <button type="submit" id="gen_pic_submit" data-action="click->admin--pic-generator#submit" class="btn btn-pumukit">{% trans %}OK{% endtrans %}</button>
            </div>
        </div>
    </div>
    <canvas class="pmk-display-none" id="canvas-draw-frames" data-admin--pic-generator-target="canvas"></canvas>
</div>
