{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block body %}

    <h3 class="cab_body_div">
        <ul class="breadcrumb pmk-margin-bottom-5">
            <li class="active breadcrumb-item">{% trans %}Permission Profiles{% endtrans %}</li>
        </ul>
    </h3>

    <div class="row">
        <div class="col-md-12">
            <div class="pmk-well">
                {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_PERMISSION_PROFILES')) %}
                    <div id="list_permissionprofiles"
                         data-controller="admin--permission-profiles"
                         data-admin--permission-profiles-save-url-value="{{ path('pumukitnewadmin_permissionprofile_batch_update') }}"
                         data-admin--permission-profiles-messages-value="{{ {saved: 'Permission Profiles successfully updated.'|trans, permission: 'The permission'|trans, dependent: 'is dependent of the permission(s)'|trans, confirm: 'If you click OK you will uncheck all these permissions. Are you sure?'|trans}|json_encode }}">
                        {% include '@PumukitNewAdmin/PermissionProfile/list.html.twig' %}
                    </div>
                {% else %}
                    {% trans %}You don't have enough permissions to access this content.{% endtrans %}
                {% endif %}
            </div>
        </div>
    </div>

{% endblock %}
