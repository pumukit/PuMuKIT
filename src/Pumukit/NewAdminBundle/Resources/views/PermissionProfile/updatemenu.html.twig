<div class="dropdown">
  <i class="fa-solid fa-bars" id="list_pics_{{ permissionprofile.id }}" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></i>
  <ul class="dropdown-menu" role="menu" aria-labelledby="list_permissionprofiles_{{ permissionprofile.id }}">
    <li>
      <a class="dropdown-item" href="{{ path('pumukitnewadmin_permissionprofile_update', {'id': permissionprofile.id}) }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">
        <i class="fa-solid fa-pencil"></i> {% trans %}Edit the permission profile{% endtrans %}
      </a>
    </li>
    <li>
      <a class="dropdown-item" href="#" data-action="click->admin--actions#remove"
         data-admin--actions-url-param="{{ path('pumukitnewadmin_permissionprofile_delete', {'id': permissionprofile.id}) }}"
         data-admin--actions-target-param="#list_permissionprofiles"
         data-admin--actions-confirm-param="{{ 'Are you sure you want to delete the Permission Profile'|trans }} &quot;{{ permissionprofile.name }}&quot;?."
         data-admin--actions-success-param="{{ 'Permission Profile'|trans }} &quot;{{ permissionprofile.name }}&quot; {{ 'successfully deleted'|trans }}.">
        <i class="fa-solid fa-xmark"></i> {% trans %}Delete the permission profile{% endtrans %}
      </a>
    </li>
    <li>
      <a class="dropdown-item" href="#" data-action="click->admin--actions#cancel">
        <strong>{% trans %}Cancel{% endtrans %}...</strong>
      </a>
    </li>
  </ul>
</div>
