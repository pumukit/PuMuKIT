<div class="modal-header">
  <h4 class="modal-title" id="myModalLabel">{% trans %}update permission profile{% endtrans %}</h4>
  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
  {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_PERMISSION_PROFILES')) %}
  {% form_theme form '@PumukitNewAdmin/Themes/fields.html.twig' %}
  <form id="pumukitnewadmin_permissionprofile_form_update"
        data-controller="admin--modal-form" data-action="submit->admin--modal-form#submit" data-admin--modal-form-target-value="#list_permissionprofiles" data-admin--modal-form-success-message-value="{{ 'Permission Profile successfully updated.'|trans }}" data-admin--modal-form-error-message-value="{{ 'There was an error in updating the Permission Profile.'|trans }}" data-admin--modal-form-title-error-value="true"
        action="{{ path('pumukitnewadmin_permissionprofile_update', {'id': permissionprofile.id}) }}" method="POST">
    <fieldset>
      <legend hidden>{% trans %}update permission profile{% endtrans %}</legend>
      <input type="hidden" name="permissionProfileId" id="permissionProfileId" value="{{ permissionprofile.id }}">
      {% for child in form %}
        {{ form_row(child) }}
      {% endfor %}
    </fieldset>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Close{% endtrans %}</button>
      <button type="submit" class="btn btn-pumukit" id="pumukitnewadmin_permissionprofile_form_save">{% trans %}Save changes{% endtrans %}</button>
    </div>
  </form>
  {% else %}
    {% trans %}You don't have enough permissions to access this content.{% endtrans %}
  {% endif %}
</div>
