{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('bundles/pumukitnewadmin/css/admin/panel.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
    {% set urls = {
        summary: path('_api_/dashboard/summary_get'),
        activity: path('_api_/dashboard/activity_get'),
        status: path('_api_/dashboard/status_get')
    } %}
    {% if show_views %}
        {% set urls = urls|merge({views: path('_api_/stats/summary_get')}) %}
    {% endif %}
    {% if show_jobs %}
        {% set urls = urls|merge({jobs: path('_api_/dashboard/jobs_get')}) %}
    {% endif %}
    {% if is_global %}
        {% set urls = urls|merge({storage: path('_api_/dashboard/storage_get')}) %}
    {% endif %}

    <div class="container-fluid panel-page"
         data-controller="admin--dashboard"
         data-admin--dashboard-urls-value="{{ urls|json_encode }}"
         data-admin--dashboard-messages-value="{{ {
             loadError: 'The data could not be loaded.'|trans,
             empty: 'No data to display yet.'|trans,
             videos: '%count% multimedia objects'|trans,
             hours: '%hours% h %minutes% min'|trans,
             usedOf: '%used% of %total%'|trans,
             labels: {
                 published: 'Published'|trans,
                 hidden: 'Hidden'|trans,
                 blocked: 'Blocked'|trans,
                 withoutMedia: 'Without playable media'|trans,
                 waiting: 'Waiting'|trans,
                 executing: 'Executing'|trans,
                 paused: 'Paused'|trans,
                 finished: 'Finished in the last 24 hours'|trans,
                 error: 'Failed in the last 24 hours'|trans
             }
         }|json_encode }}">

        <h3 class="cab_body_div">
            <ul class="breadcrumb pmk-margin-bottom-5">
                <li class="active breadcrumb-item">{% trans %}Dashboard{% endtrans %}</li>
            </ul>
        </h3>

        <div class="panel-kpis">
            <div class="panel-kpi">
                <div class="panel-kpi-label">{% trans %}Series{% endtrans %}</div>
                <div class="panel-kpi-value" data-admin--dashboard-target="series">–</div>
            </div>
            <div class="panel-kpi">
                <div class="panel-kpi-label">{% trans %}Multimedia objects{% endtrans %}</div>
                <div class="panel-kpi-value" data-admin--dashboard-target="multimediaObjects">–</div>
            </div>
            <div class="panel-kpi">
                <div class="panel-kpi-label">{% trans %}Hours of content{% endtrans %}</div>
                <div class="panel-kpi-value" data-admin--dashboard-target="duration">–</div>
            </div>
            {% if show_views %}
                <a class="panel-kpi panel-kpi-link" href="{{ path('pumukit_stats_index') }}">
                    <div class="panel-kpi-label">{% trans %}Views today{% endtrans %}</div>
                    <div class="panel-kpi-value" data-admin--dashboard-target="views">–</div>
                    <div class="panel-kpi-aux">{% trans %}See the statistics{% endtrans %} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></div>
                </a>
            {% endif %}
        </div>

        <div class="row">
            <div class="col-lg-8">
                <section class="panel-card">
                    <header class="panel-card-header">
                        <h3 class="panel-card-title">{% trans %}Multimedia objects added per month{% endtrans %}</h3>
                    </header>
                    <div class="panel-card-body panel-chart">
                        <canvas data-admin--dashboard-target="activity" role="img" aria-label="{% trans %}Multimedia objects added per month{% endtrans %}"></canvas>
                        <p class="panel-state" data-admin--dashboard-target="activityState" hidden></p>
                    </div>
                </section>
            </div>
            <div class="col-lg-4">
                <section class="panel-card">
                    <header class="panel-card-header">
                        <h3 class="panel-card-title">{% trans %}Catalogue status{% endtrans %}</h3>
                    </header>
                    <div class="panel-card-body">
                        <ul class="panel-bars panel-scroll" data-admin--dashboard-target="status"></ul>
                    </div>
                </section>
            </div>
        </div>

        {% if is_global %}
            <div class="row">
                {% if show_jobs %}
                    <div class="col-lg-4">
                        <section class="panel-card">
                            <header class="panel-card-header panel-card-header-link">
                                <h3 class="panel-card-title">{% trans %}Encoder queue{% endtrans %}</h3>
                                <a href="{{ path('pumukit_encoder_info') }}">{% trans %}Encoder jobs{% endtrans %} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                            </header>
                            <div class="panel-card-body">
                                <ul class="panel-counts" data-admin--dashboard-target="jobs"></ul>
                            </div>
                        </section>
                    </div>
                {% endif %}
                <div class="{{ show_jobs ? 'col-lg-8' : 'col-lg-12' }}">
                    <section class="panel-card">
                        <header class="panel-card-header">
                            <h3 class="panel-card-title">{% trans %}Storage{% endtrans %}</h3>
                        </header>
                        <div class="panel-card-body">
                            <ul class="panel-bars panel-scroll" data-admin--dashboard-target="storage"></ul>
                            <p class="panel-state" data-admin--dashboard-target="storageState" hidden></p>
                        </div>
                    </section>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
