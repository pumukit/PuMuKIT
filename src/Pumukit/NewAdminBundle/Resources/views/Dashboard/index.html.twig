{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" type="text/css" media="screen" href="{{ asset('/bundles/pumukitnewadmin/css/admin/dashboard.css') }}"/>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript" src="{{ asset('/bundles/pumukitnewadmin/vendor/chartjs/chart.umd.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('/bundles/pumukitnewadmin/vendor/chartjs/chartjs-adapter-date-fns.bundle.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('/bundles/pumukitnewadmin/vendor/chartjs/chartjs-plugin-zoom.min.js') }}"></script>
{% endblock %}

{% block body %}
    <h3 class="cab_body_div">
        <ul class="breadcrumb" style="margin-bottom: 5px;">
            <li class="active">{% trans %}Dashboard{% endtrans %}</li>
        </ul>
    </h3>

    <div class="text-center well">
        <div style="height: 300px; border: 1px solid #aaa">
            <canvas id="my-timeline"></canvas>
        </div>
        <br/>
        <br/>
        <noscript>
            {% trans %}This page uses Javascript to show you a Timeline.{% endtrans %}
            {% trans %}Please enable Javascript in your browser to see the full page.{% endtrans %}
            {% trans %}Thank you.{% endtrans %}
        </noscript>
    </div>

    <script type="text/javascript">
        (function () {
            const seriesPageLabel = "{{ 'Go to series WebTV page'|trans|e('js') }}";
            const dateLocale = navigator.language || 'en-US';

            fetch("{{ url('pumukit_newadmin_dashboard_seriestimeline') }}", { credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (items) {
                    const data = items.map(function (it) {
                        return { x: it.x, y: 0, title: it.title, link: it.link };
                    });

                    Chart.register(ChartZoom);

                    const ctx = document.getElementById('my-timeline').getContext('2d');
                    const chart = new Chart(ctx, {
                        type: 'scatter',
                        data: {
                            datasets: [{
                                label: "{{ 'Series'|trans|e('js') }}",
                                data: data,
                                backgroundColor: '#3b8bba',
                                borderColor: '#3b8bba',
                                pointRadius: 6,
                                pointHoverRadius: 8,
                            }],
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                x: {
                                    type: 'time',
                                    time: { tooltipFormat: 'PPpp' },
                                    adapters: { date: { locale: dateLocale } },
                                },
                                y: { display: false, min: -1, max: 1 },
                            },
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        title: function (items) {
                                            return items[0].raw.title;
                                        },
                                        label: function (item) {
                                            return new Date(item.raw.x).toLocaleString(dateLocale);
                                        },
                                        afterBody: function () {
                                            return seriesPageLabel;
                                        },
                                    },
                                },
                                zoom: {
                                    pan: { enabled: true, mode: 'x' },
                                    zoom: {
                                        wheel: { enabled: true },
                                        pinch: { enabled: true },
                                        mode: 'x',
                                    },
                                },
                            },
                            onClick: function (_, elements) {
                                if (elements.length === 0) return;
                                const link = data[elements[0].index].link;
                                if (link) {
                                    window.open(link, '_blank');
                                }
                            },
                        },
                    });
                });
        })();
    </script>
    <br/>


    {% if stats %}
        {% include "@PumukitNewAdmin/Dashboard/stats.html.twig" %}
    {% endif %}
{% endblock %}
