<div class="table-responsive">
  {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_ROLES')) %}
    <table class="table table-striped table-hover">
      <thead>
        <tr>
          <th width="1%" id="th-checkbox">
            <div class="form-check">
              <label>
                <input type="checkbox" data-action="click->admin--actions#checkAll" data-admin--actions-name-param="role">
              </label>
            </div>
          </th>
          <th colspan="4" width="7%" id="th-icons"></th>
          <th id="th-display" width="1%">{% trans %}Display{% endtrans %}</th>
          <th id="th-code">{% trans %}Code{% endtrans %}</th>
          <th id="th-name">{% trans %}Name{% endtrans %}</th>
          <th id="th-people" width="1%">{% trans %}People{% endtrans %}</th>
        </tr>
      </thead>
      <tbody>
        {% if roles is empty %}
        <tr>
          <td colspan="10" headers="th-checkbox th-code th-display th-icons th-icons th-icons th-icons th-name th-people">
            {% trans %}There are no roles with those values.{% endtrans %}
          </td>
        </tr>
        {% endif %}
        {% for role in roles %}
        <tr>
          <td headers="th-checkbox">
            <div class="form-check">
              <label>
                <input id="{{ role.id }}" class="role_checkbox" type="checkbox" size="1">
              </label>
            </div>
          </td>
          <td headers="th-icons">
            <a title="{% trans %}Edit Role{% endtrans %} {{ role.cod }}" href="{{ path('pumukitnewadmin_role_update', {'id': role.id}) }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">
              <i class="fa-solid fa-pencil"></i>
            </a>
          <td headers="th-icons">
            <a title="{% trans %}Delete role{% endtrans %}" href="#" data-action="click->admin--actions#remove"
               data-admin--actions-url-param="{{ path('pumukitnewadmin_role_delete', {'id': role.id}) }}"
               data-admin--actions-target-param="#list_roles"
               {% if role.getNumberPeopleInMultimediaObject() != 0 %}data-admin--actions-blocked-param="{{ 'Impossible to delete, role with'|trans }} {{ role.getNumberPeopleInMultimediaObject() }} {{ 'people'|trans }}"{% endif %}
               data-admin--actions-confirm-param="{{ 'Are you sure you want to delete this role?'|trans }}"
               data-admin--actions-success-param="{{ 'Role successfully deleted.'|trans }}">
              <i class="fa-solid fa-xmark"></i>
            </a>
          </td>
          <td headers="th-icons">
              {% if roles.getCurrentPage() != 1 or not loop.first %}
              {% apply pumukit_spaceless %}
              <a data-action="click->admin--actions#post" href="{{ path('pumukitnewadmin_role_down', {'id': role.id}) }}" title="{% trans %}Move one position up{% endtrans %}">&#8593;</a>
              <a data-action="click->admin--actions#post" href="{{ path('pumukitnewadmin_role_bottom', {'id': role.id}) }}" title="{% trans %}Move to the beginning of the list{% endtrans %}"><i class="fa-solid fa-arrows-up-to-line"></i></a>
              {% endapply %}
              {% endif %}
          </td>
          <td headers="th-icons">
              {% if (roles.getCurrentPage() != roles.getNbPages()) or (loop.index + ((roles.getCurrentPage() - 1 ) * roles.getMaxPerPage()) != roles.getNbResults())  %}
              {% apply pumukit_spaceless %}
              <a data-action="click->admin--actions#post" href="{{ path('pumukitnewadmin_role_up', {'id': role.id}) }}" title="{% trans %}Move one position down{% endtrans %}">&#8595;</a>
              <a data-action="click->admin--actions#post" href="{{ path('pumukitnewadmin_role_top', {'id': role.id}) }}" title="{% trans %}Move to the end of the list{% endtrans %}"><i class="fa-solid fa-arrows-down-to-line"></i></a>
              {% endapply %}
              {% endif %}
          </td>
          <td>
            {{ role.display }}
            </td>
          <td headers="th-code">
              {{ role.cod }}
            </td>
          <td headers="th-name">
              {{ role.name }}
            </td>
          <td headers="th-people">
              {{ role.getNumberPeopleInMultimediaObject() }}
            </td>
        </tr>
        {% endfor %}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="10" class="foot-td">
            <div class="row"><div class="col-md-8">
              {{ roles.getNbResults }}
                {{ "{0} roles|{1} role|]1,Inf] roles"|trans({'%count%':  roles.getNbResults}) }}
                {% if app.session.get('admin/role/criteria')|length != 0%}
                <a class="cancel-search-button pmk-color-blue pmk-font-weight-normal" title="{% trans %}Cancel current search{% endtrans %}" href="?criteria[reset]=true" >{% trans %}Cancel search{% endtrans %}</a>
                {% endif %}
            </div>
            <div class="col-md-4 text-end">
              <div class="pagerfanta">
                  {% set pagerClass = 'twitter_bootstrap5' %}
                  {% set pagerStyles = {"css_container_class": "pagination pagination-sm", "next_message": "&raquo;", "prev_message": "&laquo;", "routeName": "pumukitnewadmin_role_index"} %}
                  {% include "@PumukitNewAdmin/Misc/pager.html.twig" with {'objects' : roles, 'pagerClass': pagerClass, 'pagerStyles': pagerStyles} %}

              </div>
            </div></div>
          </td>
        </tr>
      </tfoot>
    </table>
  {% else %}
    {% trans %}You don't have enough permissions to access this content.{% endtrans %}
  {% endif %}
</div>
