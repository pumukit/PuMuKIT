<div class="col-12 col-sm-12 col-md-6">
    <div class="pmk-well">
        <h2 class="text-center">{{ titleList }}</h2>
        <table class="table">
            <thead>
            <tr>
                <th>{{ "Image"|trans }}</th>
                <th>{{ "Title"|trans }}</th>
                <th>{{ "Serie"|trans }}</th>
                <th>{{ "Status"|trans }}</th>
                <th>{{ "WebTV"|trans }}</th>
                <th>{{ "Track"|trans }}</th>
                <th>{{ "Actions"|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% set greenIcon = '<i class="fa-solid fa-check pmk-color-green"></i>' %}
            {% set redIcon = '<i class="fa-solid fa-xmark pmk-color-red"></i>' %}

            {% for element in elementList %}
                <tr>
                    <td>
                        <div class="ratio ratio-16x9">
                            <div class="text-center">
                                <img class="img-fluid pic-{{ element.id }} preview pmk-max-height-100pct" src="{{ element|first_url_pic(true, false) }}" alt="{% trans %}Multimedia object picture{% endtrans %}"/>
                            </div>
                        </div>
                    </td>
                    <td>
                        <a href="{{ path('pumukitnewadmin_mms_shortener', {'id': element.id }) }}">{{ element.getTitle() }}</a></td>
                    <td>{{ element.getSeriesTitle() }}</td>
                    <td>{{ element.isPublished() ? greenIcon|raw : redIcon|raw }}</td>
                    <td>{{ element.containsTagWithCod('PUCHWEBTV') ? greenIcon|raw : redIcon|raw }}</td>
                    <td>{{ element.getDisplayTrack() ? greenIcon|raw : redIcon|raw }}</td>
                    <td>
                        <a class="{{ type }}_element_actions" href="#" title="{{ ("Remove " ~ type)|trans }}" data-action="click->admin--actions#send" data-admin--actions-url-param="{{ path('pumukit_newadmin_head_and_tail_manager_remove_item', {'type': type, 'element': element.id}) }}" data-admin--actions-reload-param="true">
                            <i class="fa-solid fa-trash" data-type="{{ type }}" data-element="{{ element.id }}"></i>
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td class="pmk-text-align-center" colspan="7">{{ "No videos selected"|trans }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
