<div class="modal-header">
  <h4 class="modal-title" id="myModalLabel">{% trans %}change status of multimedia objects inside the series{% endtrans %}:</h4>
  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  <h2 class="modal-title">&laquo;{{ series.getTitle() }}&raquo;</h2>
</div>

<div class="modal-body">
  {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) %}
  <form data-controller="admin--changepub" data-action="submit->admin--changepub#submit"
        data-admin--changepub-url-value="{{ path('pumukitnewadmin_series_updatepub') }}"
        data-admin--changepub-target-value="#list_series"
        action="{{ path('pumukitnewadmin_series_updatepub') }}" method="POST">
    <fieldset>
      <legend hidden>{% trans %}change status of multimedia objects inside the series{% endtrans %}</legend>
      <div class="mb-3">
        <label for="mm" class="form-label">{% trans %}Multimedia Objects{% endtrans %}:</label>
        <div>
          <div class="table-responsive">
            <table id="table_mms_change_pub" class="table table-striped table-hover pmk-overflow-visible">
            <thead>
              <tr>
                <th></th>
                <th>{% trans %}Title{% endtrans %}</th>
                <th>{% trans %}Status{% endtrans %}</th>
                {% for channel in pub_channels %}
                <th{{ (channel.display and not is_granted('ROLE_TAG_DISABLE_' ~ channel.cod|upper)) ? '' : ' class="pmk-color-grey"' }}>{{ channel.getTitle() }}</th>
                {% endfor %}
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <div class="form-check">
                    <label>
                      <input type="checkbox" checked="checked" data-action="click->admin--changepub#checkAll" class="checkbox_change_pub_mms_all">
                    </label>
                  </div>
                </td>
                <td><span class="pmk-font-weight-bold">{% trans %}ALL{% endtrans %}</span></td>
                <td>
                  <select data-action="change->admin--changepub#status"
                          {% if not is_granted('ROLE_CHANGE_MMOBJECT_STATUS') %} disabled="disabled" {% endif %}
                          id="all_status_change_pub" class="form-control">
                    <option selected="selected"></option>
                    <option value="{{ mm_status.published }}">{% trans %}Published{% endtrans %}</option>
                    <option value="{{ mm_status.blocked }}">{% trans %}Blocked{% endtrans %}</option>
                    <option value="{{ mm_status.hidden }}">{% trans %}Hidden{% endtrans %}</option>
                  </select>
                </td>
                {% for channel in pub_channels %}
                {% set disabled = (not channel.display or not is_granted('ROLE_CHANGE_MMOBJECT_PUBCHANNEL') or is_granted('ROLE_TAG_DISABLE_' ~ channel.cod|upper)) %}
                <td>
                  <div class="form-check {{ disabled ? 'pmk_disabled_checkbox' : '' }}">
                    <label>
                      <input type="checkbox"
                             {% if disabled %}
                             disabled="disabled"
                             {% else %}
                             data-action="click->admin--changepub#checkChannel" data-admin--changepub-channel-param="{{ channel.id|json_encode }}"
                             id="{{ channel.id }}"
                             class="checkbox_all_channels checkbox_change_pub_channel_{{ channel.id }}"
                             {% endif %}/>
                    </label>
                  </div>
                </td>
                {% endfor %}
              </tr>

              {% for mm in multimediaObjects | filter(mm => not mm.isLive()) %}
              <tr{{ (mm.status == mm_status.published) ? '' : ' class="pmk-background-color-rgb-242-242-242"' }}>
                <td>
                  <div class="form-check">
                    <label>
                      <input type="checkbox" id="{{ mm.id }}" class="checkbox_change_pub_mms" checked="checked" data-action="click->admin--changepub#checkOne">
                    </label>
                  </div>
                </td>
                <td>{{ mm.getTitle() }}</td>
                <td>
                  <select name="data[{{ mm.id }}][status]"
                          id="status_change_pub_{{ mm.id }}"
                          {% if not is_granted('ROLE_CHANGE_MMOBJECT_STATUS') %} disabled="disabled" {% endif %}
                          class="status_change_pub form-select">
                    <option {{ ((mm_status.published) == mm.status) ? 'selected="selected"' : '' }} value="{{ mm_status.published }}">{% trans %}Published{% endtrans %}</option>
                    <option {{ ((mm_status.blocked) == mm.status) ? 'selected="selected"' : '' }} value="{{ mm_status.blocked }}">{% trans %}Blocked{% endtrans %}</option>
                    <option {{ ((mm_status.hidden) == mm.status) ? 'selected="selected"' : '' }} value="{{ mm_status.hidden }}">{% trans %}Hidden{% endtrans %}</option>
                  </select>
                </td>

                {% for channel in pub_channels %}
                {% set status = mm.containsTag(channel) %}
                {% if not channel.display or not is_granted('ROLE_CHANGE_MMOBJECT_PUBCHANNEL') or is_granted('ROLE_TAG_DISABLE_' ~ channel.cod|upper) %}
                <td>
                  <div class="form-check pmk_disabled_checkbox">
                    <label>
                      <input type="checkbox"
                             disabled="disabled"
                             {{ (status) ? 'checked="checked"' : "" }}
                             />
                    </label>
                  </div>
                </td>
                {% else %}
                <td>
                  <div class="form-check">
                    <label>
                      <input type="checkbox"
                             data-action="click->admin--changepub#checkOneChannel" data-admin--changepub-channel-param="{{ channel.id|json_encode }}"
                             name="data[{{ mm.id }}][pub_channels][{{ channel.id }}]"
                             class="pub_channel_input_checkbox pub_channel_change_pub_{{ channel.id }}"
                             id="pub_channel_change_pub_{{ channel.id }}_mm_{{ mm.id }}"
                             {{ (status) ? 'checked="checked"' : "" }}
                             />
                    </label>
                  </div>
                </td>
                {% endif %}
                {% endfor %}
              </tr>
              {% endfor %}
            </tbody>
          </table>
          </div>
        </div>
        <div class="pmk-text-align-right">{% trans %}Select{% endtrans %}:
          <a href="#" data-action="click->admin--changepub#select" data-admin--changepub-checked-param="false">{% trans %}nothing{% endtrans %}</a>
          <a href="#" data-action="click->admin--changepub#select" data-admin--changepub-checked-param="true">{% trans %}all{% endtrans %}</a>
        </div>
      </div>
    </fieldset>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Close{% endtrans %}</button>
      <button type="submit" class="btn btn-pumukit">{% trans %}Save changes{% endtrans %}</button>
    </div>
  </form>
  {% else %}
    {% trans %}You don't have enough permissions to access this content.{% endtrans %}
  {% endif %}
</div>
