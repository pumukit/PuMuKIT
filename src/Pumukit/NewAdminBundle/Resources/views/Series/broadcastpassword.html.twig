<div id="broadcast_password" data-admin--broadcast-target="passwordPanel" class="card pumukitnewadmin-broadcast-margin{{ embeddedBroadcast ? ((embeddedBroadcast.getType() == broadcast_type) ? '':' pumukitnewadmin-broadcast-hidden') : ' pumukitnewadmin-broadcast-hidden' }}">
  <div class="card-header">
    {% trans %}BROADCAST PASSWORD{% endtrans %}
  </div>
  <div class="card-body" id="password_broadcast">
    <span id="broadcast_password_span" data-action="keyup->admin--broadcast#check">
      <input class="pmk-margin-5" id="broadcast_password_1" data-admin--broadcast-target="password" data-action="change->admin--broadcast#check" name="broadcast_password_1" type="password" placeholder="{% trans %}Introduce a password{% endtrans %}..." value="{{ embeddedBroadcast ? ((embeddedBroadcast.getPassword() is not empty) ? embeddedBroadcast.getPassword() : '') : '' }}" size="17" maxlength="256"/>
      <input id="broadcast_password_2" data-admin--broadcast-target="password" data-action="change->admin--broadcast#check" name="broadcast_password_2" type="password" placeholder="{% trans %}Repeat password{% endtrans %}..." value="{{ embeddedBroadcast ? ((embeddedBroadcast.getPassword() is not empty) ? embeddedBroadcast.getPassword() : '') : '' }}" size="17" maxlength="256" />
      <input type="button" id="broadcast_password_show_hide" data-action="click->admin--broadcast#showHide" class="btn btn-sm" value="{% trans %}Show/Hide password{% endtrans %}" />
      <input type="button" id="broadcast_password_generate" data-action="click->admin--broadcast#generate" class="btn btn-sm" title="{% trans %}Generate random password{% endtrans %}" value="{% trans %}Generate random password{% endtrans %}" />
      <span id="broadcast_password_check_fail" data-admin--broadcast-target="fail" style="display: none; color: red; margin: 0px 10px;">{% trans %}Passwords must match{% endtrans %}.</span>
      <span id="broadcast_password_check_empty" data-admin--broadcast-target="empty" style="display: none; color: red; margin: 0px 10px;">{% trans %}Passwords can not be empty{% endtrans %}.</span>
    </span>
  </div>
</div>
