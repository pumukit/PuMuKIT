{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block body %}

    <h3 class="cab_body_div">
        <ul class="breadcrumb pmk-margin-bottom-5">
            <li class="active breadcrumb-item">
                {% if app.user and is_granted('ROLE_SCOPE_PERSONAL') %}
                    {% trans %}My Series{% endtrans %}
                {% else %}
                    {% trans %}Series{% endtrans %}
                {% endif %}
            </li>
        </ul>
    </h3>

    <div class="row">
        {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) %}
            <div class="col-md-10">
                <div class="pmk-well">
                    <div id="list_series">
                        {% include '@PumukitNewAdmin/Series/list.html.twig' %}
                    </div>
                    <div class="row">
                        <div class="col-4">
                            {% if is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_SERIES_META_GROUP_LIST_OPTIONS')) %}
                            <select id="options_series" class="form-select" title="{% trans %}Actions on selected items{% endtrans %}" data-controller="admin--batch" data-action="change->admin--batch#run"
                                    data-admin--batch-name-value="series" data-admin--batch-plural-value="series" data-admin--batch-preview-value="series"
                                    data-admin--batch-urls-value="{{ {delete: path('pumukitnewadmin_series_batch_delete', {'ids': '__ids__'}), info: path('pumukitnewadmin_info_series', {'ids': '__ids__'}), invert: path('pumukitnewadmin_series_invert_announce', {'ids': '__ids__'})}|json_encode }}"
                                    data-admin--batch-announce-value="{{ {edit: '#inputROId', checkbox: '#pumukitnewadmin_series_announce'}|json_encode }}"
                                    data-admin--batch-messages-value="{{ {confirm: 'Are you sure?'|trans, seriesConfirm: 'Are you sure you want to delete this/these series'|trans ~ '? ' ~ 'This/these series has/have'|trans, objects: 'multimedia object(s)'|trans, and: 'and'|trans, events: 'live event(s)'|trans, success: 'Series'|trans ~ ' ' ~ 'successfully deleted'|trans ~ '.', selectAny: 'Select any series.'|trans}|json_encode }}">
                                <option value="default" selected="selected">{% trans %}Select an action...{% endtrans %}</option>
                                <option disabled="">---</option>
                                <option value="delete_selected_series">{% trans %}Delete selected{% endtrans %}</option>

                                {% if not is_naked() %}
                                    <option {% if disable_pudenew %}disabled=""{% endif %} value="invert_announce_selected">{% trans %}Announce/Not announce selected{% endtrans %}</option>
                                {% endif %}

                            </select>
                            {% endif %}
                        </div>
                        <div class="col-8 text-end">
                            {% if is_granted('ROLE_ACCESS_ADVANCED_UPLOAD') or is_granted('ROLE_ACCESS_WIZARD_UPLOAD') %}
                                <a title="{% trans %}Create new series{% endtrans %}" id="pumukitnewadmin_series_new_button" class="btn btn-pumukit" href="#" data-action="click->admin--actions#create"
                                   data-admin--actions-url-param="{{ path('pumukitnewadmin_series_create') }}"
                                   data-admin--actions-method-param="POST"
                                   data-admin--actions-key-param="seriesId"
                                   data-admin--actions-name-param="series"
                                   data-admin--actions-list-param="#list_series"
                                   data-admin--actions-list-url-param="{{ path('pumukitnewadmin_series_list', {'selectedSeriesId': '__id__'}) }}"
                                   data-admin--actions-show-url-param="{{ path('pumukitnewadmin_series_show', {'id': '__id__'}) }}"
                                   data-admin--actions-edit-url-param="{{ path('pumukitnewadmin_series_update', {'id': '__id__'}) }}"
                                   data-admin--actions-reset-param="#filter_series"
                                   data-admin--actions-success-param="{{ 'Series successfully created.'|trans }}">
                                    <i class="fa-solid fa-plus"></i>
                                    {% trans %}New{% endtrans %}
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div id="edit_series">
                    {% if(app.session.has('admin/series/id')) %}
                        {{ render(url('pumukitnewadmin_series_update', {'id': app.session.get('admin/series/id')})) }}
                    {% endif %}
                </div>
            </div>
            <div class="col-md-2 d-none d-md-block">
                <div id="preview_series" class="pmk-well">
                    {% if(app.session.has('admin/series/id')) %}
                        <div data-controller="admin--include" data-admin--include-src-value="{{ url('pumukitnewadmin_series_show', {'id': app.session.get('admin/series/id')}) }}"></div>
                    {% else %}
                        {% trans %}Select any series.{% endtrans %}
                    {% endif %}
                </div>
                {% include '@PumukitNewAdmin/Series/acordeon.html.twig' with {'name': 'series', 'broadcasts': 'broadcasts', 'seriestypes': 'seriestypes'} %}
            </div>
        {% else %}
            <div class="col-md-12">
                <div class="pmk-well">
                    {% trans %}You don't have enough permissions to access this content.{% endtrans %}
                </div>
            </div>
        {% endif %}
    </div>

    <div class="pmk-modal modal fade" id="myAuxModal_template" tabindex="-1" role="dialog" aria-labelledby="myAuxModal_templateLabel" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
            </div>
        </div>
    </div>
{% endblock %}
