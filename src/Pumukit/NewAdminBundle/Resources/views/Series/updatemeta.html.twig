<div class="pmk-well">
    <form id="pumukitnewadmin_series_updatemeta_form"
          data-controller="admin--modal-form admin--meta-form"
          data-action="submit->admin--modal-form#submit change->admin--meta-form#changed"
          data-admin--modal-form-target-value="#list_series"
          data-admin--modal-form-refresh-value="{{ [{target: '#preview_series', url: path('pumukitnewadmin_series_show', {'id': series.id})}, {target: '#links_series_' ~ series.id, url: path('pumukitnewadmin_series_links', {'id': series.id})}]|json_encode }}"
          data-admin--modal-form-modal-value=""
          data-admin--modal-form-success-message-value="{{ 'Series saved OK'|trans }}"
          data-admin--modal-form-fail-message-value="{{ 'Series saved ERROR'|trans }}"
          data-admin--meta-form-remember-value="#remember_save_series"
          data-admin--meta-form-prefix-value="pumukitnewadmin_series_"
          data-admin--meta-form-keywords-value="{{ {series: path('pumukit_schema_apikeywords_series', {'_format': 'json'})}|json_encode }}"
          action="{{ path('pumukitnewadmin_series_update', {'id': series.id}) }}" method="POST">
        {% form_theme form '@PumukitNewAdmin/Themes/fields.html.twig' %}
        <input type="hidden" name="id" id="series_id_updatemeta" value="{{ series.id }}">

        <div class="row">
            <div class="col-6">
                <span id="remember_save_series" class="alert alert-dismissable alert-danger pmk-display-none pmk-vertical-align-middle">{% trans %}Press OK for the change to take effect{% endtrans %}</span> &nbsp;
            </div>

            <div class="col-6 text-end">
                <button id="pumukitnewadmin_series_updatemeta_cancel" type="button" class="btn btn-secondary" data-action="click->admin--meta-form#cancel">{% trans %}Cancel{% endtrans %}</button>
                <button type="submit" class="btn btn-pumukit" data-action="click->admin--meta-form#hideRemember">{% trans %}OK{% endtrans %}</button>
            </div>
        </div>

        <div>
            <fieldset class="row">
                <legend hidden>{% trans %}Update Series Metadata{% endtrans %}</legend>
                <div class="col-lg-7">
                    {% for child in form | filter(child => child.vars.id not in show_later_fields and child.vars.id not in exclude_fields) %}
                        {{ is_naked() and child.vars.id == 'pumukitnewadmin_series_announce' ? '' : form_row(child) }}
                    {% endfor %}

                    <div class="mb-3">
                        <dl>
                            <dt>{% trans %}Thumbnails{% endtrans %}</dt>
                            <dd>
                                <div id="pic_series_{{ series.id }}">
                                    {% include '@PumukitNewAdmin/Pic/list.html.twig' with {'resource': series, 'resource_name': 'series'} %}
                                </div>
                            </dd>
                        </dl>
                    </div>

                    {% include '@PumukitNewAdmin/Series/HeadAndTail/_form.html.twig' %}

                    <div class="hidden-naked">
                        {% if is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_SERIES_META_HTML_CONFIGURATION')) %}
                            {% include '@PumukitNewAdmin/Series/html_configuration.html.twig' %}
                        {% endif %}

                        {% if is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_SERIES_META_HEADLINE')) %}
                            {{ form_row(form['i18n_line2']) }}
                        {% endif %}

                        {# This iterates over all children except for the excluded ones. form_widget doesn't print the same field twice, so it works ala form_rest(form) #}
                        {% for child in form | filter(child => child.vars.id not in exclude_fields and not child.rendered) %}
                            {{ form_row(child) }}
                        {% endfor %}
                    </div>
                </div>
            </fieldset>
        </div>
    </form>
</div>
