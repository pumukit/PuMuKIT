{% set criteria = app.session.get('admin/series/criteria') %}
<div class="pmk-well">
    <form id="filter_series" class="form">
        <fieldset>
            <legend hidden>{% trans %}Filter Series{% endtrans %}</legend>

            <div id="accordion" role="tablist" aria-roledescription="tablist" aria-multiselectable="true">

                <div class="card pmk-margin-bottom-10">
                    <div class="card-header" role="tab" id="headingSearch">
                        <h2 class="card-title mb-0">
                            <a class="d-block" data-bs-toggle="collapse" href="#collapseSearch" aria-expanded="true" aria-controls="collapseSearch">
                                <i class="mdi-navigation-menu float-end"></i>
                                {% trans %}Search{% endtrans %}
                            </a>
                        </h2>
                    </div>
                    <div id="collapseSearch" data-bs-parent="#accordion" class="panel-collapse collapse show" role="tabpanel" aria-labelledby="headingSearch">
                        <div class="card-body">
                            <div class="mb-3">
                                <label for="filters_search" class="form-label">
                                    {% trans %}Search{% endtrans %}:
                                </label>
                                <div>
                                    <input type="text" class="form-control" name="criteria[search]" id="filters_search" value="{{ criteria['search']|default("") }}">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="filters_date" class="form-label">{% trans %}Date{% endtrans %}:</label>
                                <div class="row">
                                    <div class="col-md-11 offset-md-1">
                                        {% trans %}From{% endtrans %}:&nbsp;
                                        <input type="date" class="form-control" pattern="(\d\d\d\d)-(\d\d)-(\d\d)" title="Format YYYY-MM-DD" name="criteria[date][from]" data-action="change->admin--actions#validateRange" data-admin--actions-from-param="#filters_date_from" data-admin--actions-to-param="#filters_date_to" data-admin--actions-message-param="{{ 'From date must be less than to date'|trans }}" id="filters_date_from" value="{{ criteria['date']['from']|default("") }}">
                                        <br/>
                                        {% trans %}To{% endtrans %}:&nbsp;&nbsp;
                                        <input type="date" class="form-control" pattern="(\d\d\d\d)-(\d\d)-(\d\d)" title="Format YYYY-MM-DD" name="criteria[date][to]" id="filters_date_to" data-action="change->admin--actions#validateRange" data-admin--actions-from-param="#filters_date_from" data-admin--actions-to-param="#filters_date_to" data-admin--actions-message-param="{{ 'From date must be less than to date'|trans }}" value="{{ criteria['date']['to']|default("") }}">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {% set collapseIn = "" %}
                {% if criteria['announce'] is defined or criteria['title'] is defined or criteria['subtitle'] is defined %}
                    {% set collapseIn = "show" %}
                {% endif %}
                <div class="card">
                    <div class="card-header" role="tab" id="headingOthers">
                        <h2 class="card-title mb-0">
                            <a class="d-block collapsed" data-bs-toggle="collapse" href="#collapseOthers" aria-expanded="false" aria-controls="collapseOthers">
                                <i class="mdi-navigation-menu float-end d-block"></i>
                                {% trans %}Others{% endtrans %}
                            </a>
                        </h2>
                    </div>
                    <div id="collapseOthers" data-bs-parent="#accordion" class="panel-collapse collapse {{ collapseIn }}" role="tabpanel" aria-labelledby="headingOthers">
                        <div class="card-body container-fluid">
                            <div class="mb-3">
                                <label for="filters_search_title" class="form-label">
                                    {% trans %}Title{% endtrans %}:
                                </label>
                                <div>
                                    <input type="text" class="form-control" name="criteria[title]" id="filters_search_title" value="{{ criteria['title']|default("") }}">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="filters_search_subtitle" class="form-label">
                                    {% trans %}Subtitle{% endtrans %}:
                                </label>
                                <div>
                                    <input type="text" class="form-control" name="criteria[subtitle]" id="filters_search_subtitle" value="{{ criteria['subtitle']|default("") }}">
                                </div>
                            </div>

                            {% if not disable_pudenew %}
                                <div class="mb-3">
                                    <label for="filters_announce" class="form-label">
                                        {% trans %}Announced{% endtrans %}:
                                    </label>
                                    <div>
                                        <select class="form-select" name="criteria[announce]" id="filters_announce">
                                            <option value="diff">{% trans %}Indifferent{% endtrans %}</option>
                                            <option value="true" {% if criteria is not null and criteria['announce'] is defined and criteria['announce'] == "true" %}selected{% endif %}>
                                                {% trans %}Yes{% endtrans %}
                                            </option>
                                            <option value="false" {% if criteria is not null and criteria['announce'] is defined and criteria['announce'] == "false" %}selected{% endif %}>
                                                {% trans %}No{% endtrans %}
                                            </option>
                                        </select>
                                    </div>
                                </div>
                            {% endif %}

                        </div>
                    </div>
                </div>
            </div>
            <p><strong>{% trans %}Filter by{% endtrans %}:</strong></p>
            <ul class="list-unstyled">
                <li> -
                    <a href="{{ path('pumukitnewadmin_series_index', {'empty_series': true}) }}" title="{% trans %}Show empty series{% endtrans %}">{% trans %}Show empty series{% endtrans %}</a>
                </li>
            </ul>
        </fieldset>

        <div class="text-end">
            <input class="btn btn-secondary" data-action="click->admin--actions#navigate" data-admin--actions-url-param="?criteria[reset]=true" type="button" value="{% trans %}reset{% endtrans %}">
            <input type="submit" name="filter" value="{% trans %}filter{% endtrans %}" class="btn btn-pumukit">
        </div>
    </form>
</div>
