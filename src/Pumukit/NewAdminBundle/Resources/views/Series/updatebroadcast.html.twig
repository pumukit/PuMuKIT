<div class="modal-header">
    <h3 class="modal-title pumukitnewadmin-modal-title-margin" id="myModalLabel">{% trans %}Modify broadcast profile of all multimedia objects in this Series{% endtrans %}</h3>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>

    <div class="modal-body"
         data-controller="admin--broadcast"
         data-action="admin--group-lists:changed->admin--broadcast#groupsChanged"
         data-admin--broadcast-url-value="{{ path('pumukitnewadmin_series_updatebroadcast', {'id': series.id}) }}"
         data-admin--broadcast-password-type-value="{{ constant('Pumukit\\SchemaBundle\\Document\\EmbeddedBroadcast::TYPE_PASSWORD') }}"
         data-admin--broadcast-groups-type-value="{{ constant('Pumukit\\SchemaBundle\\Document\\EmbeddedBroadcast::TYPE_GROUPS') }}"
         data-admin--broadcast-description-value="#pumukitnewadmin_mm_template_broadcast_description"
         data-admin--broadcast-messages-value="{{ {saved: 'Successfully updated Broadcast in all Multimedia Objects.'|trans, mismatch: 'Passwords do not match'|trans}|json_encode }}">
        <span id="warning_modify_series" data-admin--broadcast-target="warning" class="alert alert-dismissable alert-danger pmk-vertical-align-middle">
            {% trans %}WARNING: All Multimedia Objects in this Series will be modified with the selected Broadcast.{% endtrans %}
        </span>

        <form id="pumukitnewadmin_series_updatebroadcast_submit"
              action="{{ path('pumukitnewadmin_series_updatebroadcast', {'id': series.id}) }}" method="POST"
              data-action="submit->admin--broadcast#save">

            <details class="pmk-margin-25-0-15">
                <summary class="pmk-cursor-pointer">{% trans %}Select objects{% endtrans %}</summary>

                <div class="table-responsive">
                    <table id="table_mms_change_pub" class="table table-striped table-hover pmk-overflow-visible">
                        <thead>
                            <tr>
                                <th></th>
                                <th>{% trans %}Title{% endtrans %}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for mm in multimediaObjects | filter(mm => not mm.isLive() and not mm.isPrototype()) %}
                            <tr{{ (mm.ispublished) ? '' : ' class="pmk-background-color-rgb-242-242-242"' }}>
                                <td>
                                    <div class="form-check">
                                        <label>
                                            <input type="checkbox" id="{{ mm.id }}" class="checkbox_change_pub_mms" checked="checked"
                                                   data-admin--broadcast-target="mm"
                                                   data-action="click->admin--broadcast#checkOne">
                                        </label>
                                    </div>
                                </td>
                                <td>{{ mm.getTitle() }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="pmk-text-align-right">{% trans %}Select{% endtrans %}:
                    <a href="#" data-action="click->admin--broadcast#selectAll" data-admin--broadcast-checked-param="false">{% trans %}nothing{% endtrans %}</a>
                    <a href="#" data-action="click->admin--broadcast#selectAll" data-admin--broadcast-checked-param="true">{% trans %}all{% endtrans %}</a>
                </div>
            </details>


            <fieldset>
                <legend hidden>{% trans %}Modify broadcast profile of all multimedia objects in this Series{% endtrans %}</legend>
                <input type="hidden" id="pumukitnewadmin_series_broadcast_series_id" name="" value="{{ series.id }}"/>
                <div class="mb-3">
                    <label class="form-label required">{% trans %}Broadcast Profile{% endtrans %}</label>
                    <div id="pumukitnewadmin_series_broadcast_broadcast">
                        {% for broadcast_type, broadcast_name in broadcasts %}
                            <div class="form-check">
                                <label class="required">
                                    <input id="pumukitnewadmin_series_broadcast_type_{{ broadcast_type }}" name="pumukitnewadmin_mms_broadcast" required="required" value="{{ broadcast_type }}" data-action="change->admin--broadcast#type" type="radio" {{ embeddedBroadcast ? ((embeddedBroadcast.getType() == broadcast_type) ? ' checked="checked"':'') : '' }}><span class="circle"></span><span class="check"></span>
                                    {{ broadcast_name|trans }}
                                </label>
                                {% if broadcast_type == constant('Pumukit\\SchemaBundle\\Document\\EmbeddedBroadcast::TYPE_PUBLIC') %}
                                <i class="fa-solid fa-circle-info pumukitnewadmin-broadcast-info" data-bs-toggle="tooltip" data-bs-placement="right" title="{% trans %}Any Internet user can play this multimedia object{% endtrans %}"></i>
                                {% elseif broadcast_type == constant('Pumukit\\SchemaBundle\\Document\\EmbeddedBroadcast::TYPE_PASSWORD') %}
                                <i class="fa-solid fa-circle-info pumukitnewadmin-broadcast-info" data-bs-toggle="tooltip" data-bs-placement="right" title="{% trans %}Only users with the defined password can play this multimedia object{% endtrans %}"></i>
                                {% elseif broadcast_type == constant('Pumukit\\SchemaBundle\\Document\\EmbeddedBroadcast::TYPE_LOGIN') %}
                                <i class="fa-solid fa-circle-info pumukitnewadmin-broadcast-info" data-bs-toggle="tooltip" data-bs-placement="right" title="{% trans %}Only logged in users in the system can play this multimedia object{% endtrans %}"></i>
                                {% elseif broadcast_type == constant('Pumukit\\SchemaBundle\\Document\\EmbeddedBroadcast::TYPE_GROUPS') %}
                                <i class="fa-solid fa-circle-info pumukitnewadmin-broadcast-info" data-bs-toggle="tooltip" data-bs-placement="right" title="{% trans %}Only users in the selected Groups can play this multimedia object{% endtrans %}"></i>
                                {% endif %}
                            </div>
                            {% if broadcast_type == constant('Pumukit\\SchemaBundle\\Document\\EmbeddedBroadcast::TYPE_PASSWORD') %}
                              {% include '@PumukitNewAdmin/Series/broadcastpassword.html.twig' %}
                            {% elseif broadcast_type == constant('Pumukit\\SchemaBundle\\Document\\EmbeddedBroadcast::TYPE_GROUPS') %}
                              {% include '@PumukitNewAdmin/Series/broadcastgroups.html.twig' with {'groups': groups} %}
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </fieldset>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Close{% endtrans %}</button>
                <button type="submit" id="pumukitnewadmin_series_broadcast_updategroup_submit" data-admin--broadcast-target="submit" class="btn btn-pumukit"{{ embeddedBroadcast ? '':' disabled' }}>{% trans %}Save changes{% endtrans %}</button>
            </div>
        </form>
    </div>
</div>
