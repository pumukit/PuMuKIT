<div class="modal-header">
  <h3 class="modal-title pumukitnewadmin-modal-title-margin" id="myModalLabel">{% trans %}Series properties{% endtrans %}</h3>
  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <fieldset>
      <legend hidden>{% trans %}Series properties{% endtrans %}</legend>
      <div class="mb-3">
        <pre class="pmk-white-space-pre-wrap" id="series_properties_code">{{ series.getProperties()|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
      </div>
    </fieldset>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Close{% endtrans %}</button>
    </div>
</div>
