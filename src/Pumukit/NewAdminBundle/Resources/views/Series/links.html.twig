<div class="row">
    <div class="col-lg-12">
        <form>
            <input class="pmk-display-none" type="submit" value="submit-hidden" aria-hidden="true"/>
            <fieldset class="row">
                <legend>
                    {{ is_naked() ? 'Series Metadata'|trans : 'Metadata'|trans }}
                    {% if series.numericalID %}- <span title="{% trans %}Numerical ID{% endtrans %}">({{ series.numericalID }})</span>{% endif %}
                </legend>
                <div class="mb-3 col-lg-6">
                    <div class="row"><label for="inputROId" class="col-2 col-form-label">Id:</label>
                    <div class="col-10 input-group">
                        <input type="text" class="form-control" id="inputROId" readonly data-controller="core--select" data-action="click->core--select#select" value="{{ series.id }}">
                    </div>
                    <label for="inputROTitle" class="col-2 col-form-label">{% trans %}Title{% endtrans %}:</label>
                    <div class="col-10 input-group">
                        <input type="text" class="form-control" id="inputROTitle" readonly data-controller="core--select" data-action="click->core--select#select" value="{{ series.title }}">
                    </div></div>
                </div>
                <div class="mb-3 col-lg-6">
                    <div class="row"><label for="inputROUrl" class="col-2 col-form-label hidden-naked">Url:</label>
                    <div class="col-10 input-group hidden-naked">
                        <input type="text" class="form-control" id="inputROUrl" readonly data-controller="core--select" data-action="click->core--select#select" value="{{ url('pumukit_webtv_series_index', {id: series.id}) }}">
                        {% if series.isHide() %}
                            <span class="input-group-text"><i class="fa-solid fa-triangle-exclamation" title="{% trans %}Warning: This link will give a 404 error while this series is hidden.{% endtrans %}"></i></span>
                        {% else %}
                            <span class="input-group-text"><a href="{{ url('pumukit_webtv_series_index', {id: series.id}) }}" target="_blank" title="Url"><i class="fa-solid fa-arrow-up-right-from-square"></i></a></span>
                        {% endif %}
                    </div>
                    {% if is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_SERIES_MAGIC_URL')) %}
                    <label for="inputROMagicUrl" class="col-2 col-form-label hidden-naked" data-bs-toggle="tooltip" data-bs-placement="bottom" title="{% trans %}This URL will give you access to the series without login.{% endtrans %}">
                        {% trans %}Magic Url{% endtrans %}:
                    </label>
                    <div class="col-10 input-group hidden-naked">
                        <input type="text" class="form-control" id="inputROMagicUrl" readonly data-controller="core--select" data-action="click->core--select#select" value="{{ url('pumukit_webtv_series_magicindex', {secret: series.secret}) }}" data-bs-toggle="tooltip" data-bs-placement="bottom" title="{% trans %}This URL will give you access to the series without login.{% endtrans %}">
                        {% if series.isHide() %}
                            <span class="input-group-text"><i class="fa-solid fa-triangle-exclamation" title="{% trans %}Warning: This link will give a 404 error while this series is hidden.{% endtrans %}"></i></span>
                        {% else %}
                            <span class="input-group-text"><a id="alinkROMagicUrl" href="{{ url('pumukit_webtv_series_magicindex', {secret: series.secret}) }}" target="_blank" title="{% trans %}Magic URL{% endtrans %}"><i class="fa-solid fa-arrow-up-right-from-square"></i></a></span>
                        {% endif %}
                        <span class="input-group-text">
                            <a href="#" data-action="click->admin--actions#magicUrl"
                               data-admin--actions-url-param="{{ path('pumukitnewadmin_series_generate_magic_url', {'id': series.id}) }}"
                               data-admin--actions-template-param="{{ url('pumukit_webtv_series_magicindex', {secret: '__secret__'}) }}"
                               data-admin--actions-confirm-param="{{ 'Are you sure you want to regenerate the magic url for the Series: "+seriesTitle+"?'|trans|replace({'+seriesTitle+': series.title}) }}"
                               data-admin--actions-success-param="{{ 'Magic Url successfully generated.'|trans }}"
                               data-admin--actions-input-param="#inputROMagicUrl"
                               data-admin--actions-link-param="#alinkROMagicUrl"
                               title="{% trans %}Generate a new magic series link{% endtrans %}">
                                <i class="fa-solid fa-repeat"></i>
                            </a>
                        </span>
                    </div>
                    {% endif %}</div>
                </div>
            </fieldset>
        </form>
    </div>
</div>
