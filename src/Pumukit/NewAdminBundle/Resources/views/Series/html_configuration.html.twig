<div class="mb-3">
    <a class="pmk-color-666 pmk-text-decoration-underline" href="#" data-action="click->admin--actions#toggle" data-admin--actions-selectors-param="{{ ['#pumukitnewadmin_series_header_banner', '#pumukitnewadmin_series_i18n_header', '#pumukitnewadmin_series_i18n_footer', '#pumukitnewadmin_series_series_style', '#html_text_arr_1', '#html_text_arr_2']|json_encode }}">
        <span id="html_text_arr_1">&#9654;</span> <span class="pmk-display-none" id="html_text_arr_2">&#9660;</span>
        {% trans %}Show configuration{% endtrans %} <strong>HTML</strong> {% trans %}Texts.{% endtrans %}
        <i class="mdi-action-info" data-bs-toggle="tooltip" data-bs-placement="right" title="{% trans %}Click to show or add header/banner and footer{% endtrans %}"></i>
    </a>
</div>

{% for child in form | filter(child => child.vars.id in [
    'pumukitnewadmin_series_i18n_header',
    'pumukitnewadmin_series_i18n_footer',
    'pumukitnewadmin_series_series_style'
]) %}
    <div class="hidden-naked mb-3 pmk-display-none" id="{{ child.vars.id }}">
        {% if child.vars.id in ['pumukitnewadmin_series_i18n_header'] %}
            <div>
                <a class="pmk-float-right" href="{{ path('pumukitnewadmin_seriespic_banner', {'id': series.id}) }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">{% trans %}Add banner{% endtrans %}</a>
            </div>
        {% endif %}
        {% if child.vars.id != 'pumukitnewadmin_series_series_style' %}
            <label for="header" class="form-label">{{ child.vars.label }}</label>
            <div>
                {{ form_widget(child) }}
            </div>
        {% endif %}
    </div>
{% endfor %}
