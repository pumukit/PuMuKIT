{% extends 'knp_menu_base.html.twig' %}

{% block root %}
    <ul class="nav flex-column sidebar-menu m-0 p-0">
        {{ block('list') }}
    </ul>
{% endblock %}

{% block list %}
    {% import _self as knp_menu %}
    {% for item in item.children %}
        {{ block('item') }}
    {% endfor %}
{% endblock %}

{% block item %}
        {% set hasChildren = item.hasChildren and options.depth is not same as(0) %}
        {% set itemId = 'submenu-' ~ item.name|replace({' ':'-'}) %}
        <li class="nav-item">
            {% if hasChildren %}
                <button class="btn-toggle btn-pumukit-menu w-100 text-start collapsed"
                        data-bs-toggle="collapse" data-bs-target="#{{ itemId }}"
                        aria-expanded="false">
                    <i class="fa-solid fa-folder me-2"></i>
                    {{ item.label|trans|upper }}
                </button>

                <div class="collapse submenu ps-3" id="{{ itemId }}">
                    <ul class="mb-0 list-group list-group-flush list-unstyled">
                        {% for child in item.children %}
                            <li class="list-group-item list-group-item-pumukit">
                                <a href="{{ child.uri }}" class="link-light d-block py-1 text-decoration-none">
                                    {{ child.label|trans|upper }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% else %}
                <a href="{{ item.uri }}" class="nav-link nav-link-pumukit-menu text-white px-3 py-2 d-flex align-items-center">
                    <i class="fa-solid fa-folder me-2"></i>{{ item.label|trans|upper }}
                </a>
            {% endif %}
        </li>
{% endblock %}
