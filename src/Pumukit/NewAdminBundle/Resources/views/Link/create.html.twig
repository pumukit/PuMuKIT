<div class="modal-header">
  <h4 class="modal-title" id="myModalLabel">{% trans %}create new link{% endtrans %}</h4>
  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
  {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) %}
  {% form_theme form '@PumukitNewAdmin/Themes/fields.html.twig' %}
  <form data-controller="admin--modal-form" data-action="submit->admin--modal-form#submit" data-admin--modal-form-target-value="#links_mms_{{ mm.id }}"
        action="{{ path('pumukitnewadmin_link_create', {'id': mm.id}) }}" method="POST">
    <fieldset>
      {% for child in form %}
      {{ form_row(child) }}
      {% endfor %}
    </fieldset>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Cancel{% endtrans %}</button>
      <button type="submit" class="btn btn-pumukit">{% trans %}OK{% endtrans %}</button>
    </div>
  </form>
  {% else %}
    {% trans %}You don't have enough permissions to access this content.{% endtrans %}
  {% endif %}
</div>
