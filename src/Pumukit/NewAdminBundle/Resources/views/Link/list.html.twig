<table><tbody>
  {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) %}
  {% for link in links %}
    <tr>
      <td><ul><li></li></ul></td>
      <td>
        <a title="{% trans %}Edit file of multimedia object{% endtrans %} {{ link.id }}"
           data-bs-toggle="modal" data-bs-backdrop="static" data-bs-dismiss="modal" data-bs-target="#myModal"
           href="{{ path('pumukitnewadmin_link_update', {'id': link.id, 'mmId': mmId}) }}">
          <i class="fa-solid fa-pencil"></i>
        </a>
      </td>
      <td>
          <a href="#" data-action="click->admin--actions#remove"
               data-admin--actions-url-param="{{ path('pumukitnewadmin_link_delete', {'id': link.id, 'mmId': mmId}) }}"
               data-admin--actions-target-param="#links_mms_{{ mmId }}"
               data-admin--actions-confirm-param="{{ 'Are you sure you want to delete this link?'|trans }}">
             <i class="fa-solid fa-xmark"></i>
          </a>
      </td>
      <td>
        {% if loop.first %}
      &nbsp;
    {% else %}
      <a href="#" data-action="click->admin--actions#load"
               data-admin--actions-url-param="{{ path('pumukitnewadmin_link_up', {'id': link.id, 'mmId': mmId}) }}"
               data-admin--actions-target-param="#links_mms_{{ mmId }}"
               data-admin--actions-data-param="{{ {'_method': 'POST'}|json_encode }}">&#8593;</a>
    {% endif %}
      </td>
      <td>
    {% if loop.last %}
          &nbsp;
    {% else %}
      <a href="#" data-action="click->admin--actions#load"
               data-admin--actions-url-param="{{ path('pumukitnewadmin_link_down', {'id': link.id, 'mmId': mmId}) }}"
               data-admin--actions-target-param="#links_mms_{{ mmId }}"
               data-admin--actions-data-param="{{ {'_method': 'POST'}|json_encode }}">&#8595;</a>
    {% endif %}
      </td>
      <td>
        &nbsp;{% if not is_naked() %}{{ link.id }} - {% endif %}{{ link.getUrl() }}
        {% if link.getHide() %}<span class="badge text-bg-secondary">{% trans %}hidden{% endtrans %}</span></i>{% endif %}
        {% for tag in link.getTags() %}
          <span class="badge text-bg-primary">{{ tag }}</span>
        {% endfor %}
      </td>
    </tr>
  {% endfor %}
  <tr>
    <td><ul><li></li></ul></td>
    <td colspan="6"><a title="{% trans %}Create Link{% endtrans %}" class="button_new_link" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-dismiss="modal" data-bs-target="#myModal" href="{{ path('pumukitnewadmin_link_create', {'id': mmId}) }}">{% trans %}New{% endtrans %}...</a></td>
  </tr>
  {% else %}
    {% trans %}You don't have enough permissions to access this content.{% endtrans %}
  {% endif %}
</tbody></table>

