{% if criteria %}
    {% set criteria_text = criteria['text'] %}
{% endif %}

{% set search_label = "Search"|trans %}
{% set search_placeholder = "Search by title, subtitle or description"|trans %}

<div class="row"><div class="col-12 col-md-7 position-relative">
    <label for="text" class="form-label">{{ search_label }}</label>
    <input id="text" type="text" class="form-control" name="criteria[text]" placeholder="{{ search_placeholder }}" value="{{ criteria_text|default('') }}" />
    <img id="unesco_form_loader" class="text-end" alt="{% trans %}Spinner{% endtrans %}" src="{{ asset('bundles/pumukitnewadmin/images/admin/load/spinner.gif')}}" style="width: 36px; right: -30px; top: 20px; opacity: 0; float: right; position: absolute;"/>
</div>

<div class="col-12 col-md-5 d-flex flex-row-reverse align-items-end gap-2">
    {# NOTE: Keep this button order to send form with intro key and without JS #}
    <input id="submitBasicForm" class="btn btn-pumukit" type="submit" value="{% trans %}Send{% endtrans %}" />
    <button class="btn btn-secondary" data-bs-toggle="collapse" href="#collapseAdvanceForm" aria-expanded="false">
        {% trans %}Advanced{% endtrans %}
    </button>
    <button class="btn btn-secondary unescoResetForm me-auto" data-action="click->admin--unesco#resetSearch" title="{% trans %}Reset{% endtrans %}">
        {% trans %}Reset{% endtrans %}
    </button>
</div></div>
