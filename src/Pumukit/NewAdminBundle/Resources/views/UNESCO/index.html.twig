{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block body %}
    <h3 class="cab_body_div">
        <ul class="breadcrumb pmk-margin-bottom-5">
            <li class="active breadcrumb-item">{{ configuredTag.getTitle() }} {% trans %}catalogue{% endtrans %}</li>
        </ul>
    </h3>

    <div class="row"><div class="col-md-2">
        <div class="pmk-well" id="tag_list_unesco">
            {{ render(controller('Pumukit\\NewAdminBundle\\Controller\\UNESCOController::menuTagsAction')) }}
        </div>
    </div>
    <div class="col-md-8">
        <div id="advance_search">
            {{ render(controller('Pumukit\\NewAdminBundle\\Controller\\UNESCOController::advancedSearchFormAction')) }}

        </div>
        <div id="list_mms" data-refresh-url="{{ path('pumukitnewadmin_unesco_list') }}">
            {{ render(controller('Pumukit\\NewAdminBundle\\Controller\\UNESCOController::listAction')) }}
        </div>
        <div id="edit_mms">
            {% if(app.session.has('admin/unesco/id')) %}
                {{ render(url('pumukit_new_admin_unesco_edit', {'id': app.session.get('admin/unesco/id')})) }}
            {% endif %}
        </div>
    </div>
    <div class="col-md-2">
        <div id="preview_mms">
            {% if app.session.has('admin/unesco/id') %}
                {{ render(controller('Pumukit\\NewAdminBundle\\Controller\\UNESCOController::showAction', {'id' : app.session.get('admin/unesco/id')})) }}
            {% else %}
                {{ render(controller('Pumukit\\NewAdminBundle\\Controller\\UNESCOController::showAction')) }}
            {% endif %}
        </div>
    </div></div>

    <div class="pmk-modal modal fade" id="myAuxModal" tabindex="-1" role="dialog" aria-labelledby="myAuxModalLabel" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
            </div>
        </div>
    </div>

    <div class="pmk-display-none">
        <img width="35" id="dnd_image_1" src="{{ asset('bundles/pumukitnewadmin/images/DnD/1.gif') }}" />
        <img width="35" id="dnd_image_2" src="{{ asset('bundles/pumukitnewadmin/images/DnD/2.gif') }}" />
        <img width="35" id="dnd_image_3" src="{{ asset('bundles/pumukitnewadmin/images/DnD/3.gif') }}" />
        <img width="35" id="dnd_image_4" src="{{ asset('bundles/pumukitnewadmin/images/DnD/4.gif') }}" />
        <img width="35" id="dnd_image_5" src="{{ asset('bundles/pumukitnewadmin/images/DnD/5.gif') }}" />
        <img width="35" id="dnd_image_6" src="{{ asset('bundles/pumukitnewadmin/images/DnD/6.gif') }}" />
        <img width="35" id="dnd_image_7" src="{{ asset('bundles/pumukitnewadmin/images/DnD/7.gif') }}" />
        <img width="35" id="dnd_image_8" src="{{ asset('bundles/pumukitnewadmin/images/DnD/8.gif') }}" />
        <img width="35" id="dnd_image_9" src="{{ asset('bundles/pumukitnewadmin/images/DnD/9.gif') }}" />
        <img width="35" id="dnd_image_10" src="{{ asset('bundles/pumukitnewadmin/images/DnD/10.gif') }}" />
        <img width="35" id="dnd_image_11" src="{{ asset('bundles/pumukitnewadmin/images/DnD/11.gif') }}" />
