<div class="pmk-well" {% include '@PumukitNewAdmin/UNESCO/_controller.html.twig' %}>
    {% if mm is defined and mm is not null %}
        <p>
            {% trans %}Is part of {% endtrans %}:
            <a target="_blank" href="{{ url('pumukitnewadmin_mms_index', {id: mm.series.id}) }}"> {{ mm.series.title }} </a>.
        </p>
        <p>
            {% if mm.getStatus() == 0 and mm.containsTagWithCod('PUCHWEBTV') and mm.getDisplayTrack() %}
                <a target="_blank" href="{{ url('pumukit_webtv_multimediaobject_index', {id: mm.id}) }}">
                    {% trans %}Show video on WebTV{% endtrans %}.
                </a>.
            {% elseif mm.getStatus == 2 and mm.containsTagWithCod('PUCHWEBTV') and mm.getDisplayTrack() %}
                <a target="_blank" href="{{ url('pumukit_webtv_multimediaobject_magicindex', {secret: mm.getSecret() }) }}">
                    {% trans %}Show video on WebTV{% endtrans %}.
                </a>.
            {% endif %}
        </p>

        <div>
            {% include '@PumukitNewAdmin/MultimediaObject/showplayer.html.twig' %}
        </div>

        <div>
            <div class="card border-primary">
                <div class="card-header">
                    <h3 class="panel-title-preview card-title mb-0">Tags {{ configuredTag.getTitle()|upper }}</h3>
                </div>
                <div class="panel-body-preview card-body">
                    <div id="list_unesco" draggable="false" data-action="drop->admin--unesco#dropTag dragenter->admin--unesco#allowDrop dragover->admin--unesco#allowDrop">
                        {% for mtag in mm.tags | filter(mtag => mtag.isDescendantOfByCod(configuredTag.getCod())) %}
                            <div id="taglist_{{ mtag.getCod() }}" class="unesco_tags" draggable="false">
                                <span class="badge text-bg-secondary">{{ mtag.title }} |
                                    <a href="#" data-cod="{{ mtag.getCod() }}" data-href="{{ path('pumukitnewadmin_unesco_delete_tag', {'tagCod': mtag.getCod(), "multimediaObjectId": mm.getId() }) }}" class="delete_tag_unesco" data-action="click->admin--unesco#removeTag" data-admin--unesco-url-param="{{ path('pumukitnewadmin_unesco_delete_tag', {'tagCod': mtag.getCod(), "multimediaObjectId": mm.getId() }) }}" data-admin--unesco-cod-param="{{ mtag.getCod()|json_encode }}">
                                        <i class="fa-solid fa-xmark"></i>
                                    </a>
                                </span>
                            </div>
                        {% else %}
                            <div class="unesco_tags" draggable="true">
                                {% trans %}No tags{% endtrans %}.
                            </div>
                        {% endfor %}

                    </div>
                </div>
            </div>
        </div>

        <div>
            <div class="card border-primary">
                <div class="card-header">
                    <h3 class="panel-title-preview card-title mb-0">{% trans %}People{% endtrans %}</h3>
                </div>
                <div class="panel-body-preview card-body">
                    <ul class="list-unstyled">
                        {% for role in mm.getRoles() | filter(role => role.getDisplay()) %}
                            {% set actors = mm.getPeopleByRole(role, true) %}
                            {% if actors|length != 0 %}
                                <li><u>{{ role.name }}</u></li>
                                <ul>
                                    {% for act in actors %}
                                        <li>
                                            {{ role.getText() }}
                                            {% if act.getWeb() is not empty %}
                                                <a target="_black" title="{{ act.getHName() }}" href="{{ act.getWeb()|safe_url }}">{{ act.getHName() }}</a>
                                            {% else %}
                                                <span title="{{ act.getHName() }}">{{ act.getHName() }}</span>
                                            {% endif %}
                                            <small>{{ act.getInfo() }}</small>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        {% else %}
                            <span>{% trans %}No people.{% endtrans %}</span>
                        {% endfor %}
                    </ul>
                </div>
            </div>

        </div>

    {% else %}
        <p>{% trans %}Select any multimedia object.{% endtrans %}</p>
    {% endif %}
</div>

