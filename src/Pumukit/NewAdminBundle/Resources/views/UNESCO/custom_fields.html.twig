{% set selectedFields = app.request.getSession().get('admin/unesco/selected_fields') %}
{% set allFields = all_custom_fields() %}

<br />
<div class="pmk-well" {% include '@PumukitNewAdmin/UNESCO/_controller.html.twig' %}>
    <div class="row">
        <h4 class="text-center"><strong>{% trans %}Configure your fields list{% endtrans %}</strong></h4>
        <hr />
        <div class="col-12">
            <form class="row" id="choose_fields" method="POST">
                {% for i in 1..10 %}
                    <div class="col-md-2 pmk-width-14_28pct-i">
                        <div class="mb-3">
                            <label for="custom_field_{{ i }}">{{ "Custom field"|trans }} {{ i }}:</label>
                            <select id="custom_field_{{ i }}" name="custom_field_{{ i }}" class="form-select">
                                {% for key, field in allFields %}
                                    <option value="{{ key }}" {% if key == selectedFields['custom_field_'~i]%}selected{% endif %}>
                                        {{ field['label'] }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                {% endfor %}
                <div class="col-md-12">
                    <button class="btn btn-pumukit choose_fields_send float-end" data-action="click->admin--unesco#saveFields">
                        {% trans %}Change{% endtrans %}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

