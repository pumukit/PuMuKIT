{% set custom_fields = app.request.getSession().get('admin/unesco/selected_fields') %}
{% set all_custom_fields = all_custom_fields() %}
{% set click_edit %}data-action="click->admin--actions#edit" data-admin--actions-name-param="&quot;mms&quot;" data-admin--actions-show-param="{{ path('pumukitnewadmin_unesco_show', {'id': mm.id}) }}" data-admin--actions-update-param="{{ path('pumukit_new_admin_unesco_edit', {'id': mm.id}) }}"{% endset %}

<tr id="tr_{{ mm.id }}" class="pmk-cursor-pointer{% if (app.session.get('admin/unesco/id') == mm.id ) %} success{% endif %}">

    <td headers="th-checkbox">
        <div class="form-check pumukit-mms-checkbox">
            <label data-id="{{ mm.id }}" draggable="true" data-action="dragstart->admin--unesco#dragRows dragenter->admin--unesco#highlightTags dragend->admin--unesco#dragRowsEnd">
                <input data-id="{{ mm.id }}" id="{{ mm.id }}" class="mm_checkbox" type="checkbox">
            </label>
        </div>
    </td>
    <td headers="th-icons">
        <span id="table_mms_status_wrapper_{{ mm.id }}" data-id="{{ mm.id }}">
            {# See Track/list for AJAX update #}
            {% include '@PumukitNewAdmin/MultimediaObject/status.html.twig' with {'mm': mm} %}
        </span>
    </td>

    {% if not is_naked() %}
        <td headers="th-icons">
            {{ mm.containsTagWithCod('PUDENEW')?'<i class="mdi-action-spellcheck">':'&nbsp;' }}
        </td>
    {% endif %}
    <td headers="th-icons">
        {% include '@PumukitNewAdmin/UNESCO/updatemenu.html.twig' with {'mm': mm} %}
    </td>

    {% for key, field in custom_fields %}
        {% if 'pics' in field %}
            <td{% if all_custom_fields[field]['render_params']['break-word'] == true %} class="pmk-word-break-break-word"{% endif %} headers="th-{{ loop.index }}" {{ click_edit }}>
                {% include "@PumukitNewAdmin/Misc/img_list.html.twig" with {'object' : mm, 'type' : 'mm'} %}
            </td>
        {% else %}
            {% set text = render_object_field(mm,app.request.getSession(),field) %}
            <td{% if all_custom_fields[field]['render_params']['break-word'] == true %} class="pmk-word-break-break-word"{% endif %} headers="th-{{ loop.index }}" title="{{ text|striptags }}" {{ click_edit }}>
                {% if field in ['record_date','public_date'] %}
                    {{ text| format_datetime('medium','none',locale=app.request.getLocale()) }}
                {% elseif field is same as('title') %}
                    <span class="shorten-title">{{ text|raw }}</span>
                {% elseif field is same as('type') %}
                    {% if mm.isVideoType() %}
                        <i class="fa-solid fa-file-video pmk-font-size-20" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getStringType(mm.getType()) }}"></i>
                    {% elseif mm.isAudioType() %}
                        <i class="fa-solid fa-file-audio pmk-font-size-20" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getStringType(mm.getType()) }}"></i>
                    {% elseif mm.isImageType() %}
                        <i class="fa-solid fa-file-image pmk-font-size-20" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getStringType(mm.getType()) }}"></i>
                    {% elseif mm.isDocumentType() %}
                        <i class="fa-solid fa-file-lines pmk-font-size-20" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getStringType(mm.getType()) }}"></i>
                    {% elseif mm.isExternalType() %}
                        <i class="fa-solid fa-link pmk-font-size-20" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getStringType(mm.getType()) }}"></i>
                    {% endif %}
                {% elseif field is same as('embeddedBroadcast')%}
                    {% if mm.getEmbeddedBroadcast().getType() == 'public' %}
                        <i class="fa-solid fa-globe" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getEmbeddedBroadcast().getStringType() }}"></i>
                    {% elseif mm.getEmbeddedBroadcast().getType() == 'password' %}
                        <i class="fa-solid fa-unlock" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getEmbeddedBroadcast().getStringType() }}"></i>
                    {% elseif mm.getEmbeddedBroadcast().getType() == 'login' %}
                        <i class="fa-solid fa-user" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getEmbeddedBroadcast().getStringType() }}"></i>
                    {% elseif mm.getEmbeddedBroadcast().getType() == 'groups' %}
                        <i class="fa-solid fa-users" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getEmbeddedBroadcast().getStringType() }}"></i>
                    {% endif %}
                {% elseif field is same as('webtv')%}
                    {% if mm.containsTagWithCod('PUCHWEBTV') %}
                        <i class="fa-solid fa-check text-success"></i>
                    {% else %}
                        <i class="fa-solid fa-xmark text-danger"></i>
                    {% endif %}
                {% elseif field is same as('duration')%}
                    {% if mm.isVideoAudioType() %}{{ mm.getRealDuration()| duration_string }}{% else %}0{% endif %}
                    {% if mm.getProperty('soft-editing-duration') %}
                        <i class="mdi-content-content-cut" data-bs-toggle="tooltip" data-bs-placement="left" title="{{ mmobj_duration(mm) | duration_string }}"></i>
                    {% endif %}
                {% else %}
                    {{ text|raw }}
                {% endif %}
            </td>
        {% endif %}
    {% endfor %}
    <td headers="th-play" class="text-nowrap" data-action="click->admin--actions#openModal" data-admin--actions-url-param="{{ path('pumukitnewadmin_mms_modal_preview', {'id': mm.id}) }}">
        <small><i class="fa-solid fa-play pmk-color-grey"></i></small>
    </td>
</tr>
