<div class="pmk-well">
    <div id="links_mm_{{ mm.id }}">
        {{ render(url('pumukitnewadmin_mms_links', {'id': mm.id})) }}
    </div>

    <div role="tabpanel">
        <ul id="menuTab" class="nav nav-tabs" role="tablist" data-controller="admin--tabs" data-admin--tabs-key-value="lastMmTab">
            {% if not is_naked() and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_PUBLICATION_TAB')) %}
                <li class="nav-item">
                    <a class="nav-link{% if is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_PUBLICATION_TAB')) %} active{% endif %}" href="#pubMm" aria-controls="pubMm" role="tab" data-bs-toggle="tab">{% trans %}Publication{% endtrans %}</a>
                </li>
            {% endif %}
            <li class="nav-item">
                <a class="nav-link{% if is_naked() or not is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_PUBLICATION_TAB')) %} active{% endif %}" href="#metaMm" aria-controls="metaMm" role="tab" data-bs-toggle="tab">{% trans %}Basic Metadata{% endtrans %}</a>
            </li>
            {% if not is_naked() %}
                <li class="nav-item">
                    <a class="nav-link" href="#tagMm" aria-controls="tagMm" role="tab" data-bs-toggle="tab">{% trans %}Tags{% endtrans %}</a>
                </li>
            {% endif %}
            {% if not is_naked() %}
                <li class="nav-item">
                    <a class="nav-link" href="#groupMm" aria-controls="groupMm" role="tab" data-bs-toggle="tab">{% trans %}Owners & Groups{% endtrans %}</a>
                </li>
            {% endif %}
            <li class="nav-item">
                <a class="nav-link" href="#personMm" aria-controls="personMm" role="tab" data-bs-toggle="tab">{% trans %}People{% endtrans %}</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#mediaMm" aria-controls="mediaMm" role="tab" data-bs-toggle="tab">{% trans %}Multimedia{% endtrans %}</a>
            </li>
            {% if active_editor and not mm.isExternalType() %}
                <li class="nav-item">
                    <a class="nav-link" href="#editorMm" aria-controls="editorMm" role="tab" data-bs-toggle="tab">{% trans %}Media Edition{% endtrans %}</a>
                </li>
            {% endif %}
        </ul>

        <div class="tab-content">
            {% if not is_naked() and  is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_PUBLICATION_TAB')) %}
                <div id="pubMm" role="tabpanel" class="tab-pane{% if is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_PUBLICATION_TAB')) %} active{% endif %}">
                    {% include '@PumukitNewAdmin/UNESCO/updatepub.html.twig' with {'mm': mm, 'pub_channels': pub_channels, 'pub_decisions': pub_decisions} %}
                </div>
            {% endif %}

            <div id="metaMm" role="tabpanel" class="tab-pane{% if is_naked() or not is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_PUBLICATION_TAB')) %} active{% endif %}">
                {% include '@PumukitNewAdmin/UNESCO/updatemeta.html.twig' with {'mm': mm} %}
            </div>

            {% if not is_naked() %}
                 <div id="tagMm" role="tabpanel" class="tab-pane">
                     {% include '@PumukitNewAdmin/UNESCO/updatetag.html.twig' with {'mm': mm, 'parent_tags': parent_tags, 'template': false} %}
                 </div>
             {% endif %}

            {% if not is_naked() %}
                <div id="groupMm" role="tabpanel" class="tab-pane">
                    {% include '@PumukitNewAdmin/MultimediaObject/updategroup.html.twig' with {'mm': mm, 'personal_scope_role': personal_scope_role} %}
                </div>
            {% endif %}

             <div id="personMm" role="tabpanel" class="tab-pane">
                {% include '@PumukitNewAdmin/MultimediaObject/updateperson.html.twig' with {'mm': mm, 'roles': roles} %}
            </div>

            <div id="mediaMm" role="tabpanel" class="tab-pane">
                {% include '@PumukitNewAdmin/MultimediaObject/updatemedia.html.twig' with {'mm': mm, 'jobs': jobs} %}
            </div>
            {% if active_editor %}
                <div id="editorMm" role="tabpanel" class="tab-pane">
                    {% include '@PumukitNewAdmin/MultimediaObject/editor.html.twig' with {'mm': mm, 'jobs': jobs} %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
