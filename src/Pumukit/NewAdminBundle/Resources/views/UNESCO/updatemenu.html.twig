<div class="dropdown">
    <i class="fa-solid fa-bars" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></i>

    <ul class="dropdown-menu" role="menu" aria-labelledby="list_pics_mm_{{ mm.id }}">

        <li>
            <a href="#" class="qa-button-delete-mms dropdown-item" data-action="click->admin--unesco#remove"
               data-admin--unesco-url-param="{{ path('pumukitnewadmin_unesco_delete', {'multimediaObjectId': mm.id}) }}"
               data-admin--unesco-confirm-param="{{ 'Are you sure you want to delete this multimedia object?'|trans }}">
                <i class="fa-solid fa-xmark"></i>{% trans %}Delete multimedia object{% endtrans %}
            </a>
        </li>

        {% include "@PumukitNewAdmin/MultimediaObject/Menu/_playlist.html.twig" %}

        <li>
            <a href="#" class="qa-button-clone-mms dropdown-item" data-action="click->admin--unesco#clone"
               data-admin--unesco-url-param="{{ path('pumukitnewadmin_unesco_clone', {'multimediaObjectId': mm.id}) }}"
               data-admin--unesco-confirm-param="{{ 'Are you sure you want to clone this multimedia object?'|trans }}">
                <i class="fa-solid fa-copy"></i>{% trans %}Clone multimedia object{% endtrans %}
            </a>
        </li>

        {% include "@PumukitNewAdmin/MultimediaObject/Menu/_properties.html.twig" %}

        {% include "@PumukitNewAdmin/MultimediaObject/Menu/_archive.html.twig" %}

        {% include "@PumukitNewAdmin/MultimediaObject/Menu/_dynamic_menu.html.twig" %}

        {% include "@PumukitNewAdmin/MultimediaObject/Menu/_cancel.html.twig" %}

    </ul>
</div>
