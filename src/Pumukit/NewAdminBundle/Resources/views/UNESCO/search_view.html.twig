{% set criteria = false %}
{% if app.request.session.has('UNESCO/form') %}
    {% set criteria = app.request.session.get('UNESCO/form') %}
{% endif %}

<div class="well" {% include '@PumukitNewAdmin/UNESCO/_controller.html.twig' %}>
    <div class="row">

        <form id="myForm" class="unesco_form" name="advance_form" method="POST" data-action="submit->admin--unesco#search" action="{{ path('pumukitnewadmin_unesco_list') }}">
            <div class="col-xs-12">
                <div id="basic_form">
                    {% include '@PumukitNewAdmin/UNESCO/basic_form.html.twig' %}
                </div>
            </div>
            <div class="col-xs-12">
                <div class="advance_form collapse {% if app.request.session.get('UNESCO/formbasic') is same as(false) %}in{% endif %}" id="collapseAdvanceForm">
                    {% include '@PumukitNewAdmin/UNESCO/advance_form.html.twig' %}
                </div>
            </div>
        </form>
    </div>
</div>


