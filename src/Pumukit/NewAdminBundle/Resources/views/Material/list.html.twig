<table><tbody>
  {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) %}
  {% for material in materials %}
    <tr>
      <td><ul><li></li></ul></td>
      <td>
        <a title="{% trans %}Edit file of multimedia object{% endtrans %} {{ material.id }}"
           data-bs-toggle="modal" data-bs-backdrop="static" data-bs-dismiss="modal" data-bs-target="#myModal"
           href="{{ path('pumukitnewadmin_material_update', {'id': material.id, 'mmId': mmId}) }}">
          <i class="fa-solid fa-pencil"></i>
        </a>
      <td>
      <td>
        <a href="#" data-action="click->admin--actions#remove"
           data-admin--actions-url-param="{{ path('pumukitnewadmin_material_delete', {'id': material.id, 'mmId': mmId}) }}"
           data-admin--actions-target-param="#materials_mms_{{ mmId }}"
           data-admin--actions-confirm-param="{{ 'Are you sure you want to delete this material?'|trans }}"
           data-admin--actions-success-param="{{ 'Material successfully deleted.'|trans }}">
          <i class="fa-solid fa-xmark"></i>
        </a>
      </td>
      <td>
        <a target="_blank" href="{{ material.getUrl(true) }}">
             <i class="fa-solid fa-download"></i>
        </a>
      </td>
      <td>
        {% if loop.first %}
      &nbsp;
    {% else %}
      <a href="#" data-action="click->admin--actions#load"
         data-admin--actions-url-param="{{ path('pumukitnewadmin_material_up', {'id': material.id, 'mmId': mmId}) }}"
         data-admin--actions-target-param="#materials_mms_{{ mmId }}"
         data-admin--actions-data-param="{{ {_method: 'POST'}|json_encode }}">&#8593;</a>
    {% endif %}
      </td>
      <td>
    {% if loop.last %}
          &nbsp;
    {% else %}
      <a href="#" data-action="click->admin--actions#load"
         data-admin--actions-url-param="{{ path('pumukitnewadmin_material_down', {'id': material.id, 'mmId': mmId}) }}"
         data-admin--actions-target-param="#materials_mms_{{ mmId }}"
         data-admin--actions-data-param="{{ {_method: 'POST'}|json_encode }}">&#8595;</a>
    {% endif %}
      </td>
      <td>
        &nbsp; {% if not is_naked() %}{{ material.id }} - {% endif %}{{ material.getName() }} ({{ material.getPath()|basename }}/{{ is_addon_language(material.getLanguage()) ? material.getLanguage() | language_name_custom : material.getLanguage() | language_name | capitalize }})
        {% if material.getHide() %}<span class="badge text-bg-secondary">{% trans %}hidden{% endtrans %}</span></i>{% endif %}
        {% for tag in material.getTags() %}
          <span class="badge text-bg-primary">{{ tag }}</span>
        {% endfor %}
      </td>
    </tr>
  {% endfor %}
  <tr>
    <td><ul><li></li></ul></td>
    <td colspan="6"><a title="{% trans %}Create Material{% endtrans %}" class="button_new_material" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal" href="{{ path('pumukitnewadmin_material_create', {'id': mmId}) }}">{% trans %}New{% endtrans %}...</a></td>
  </tr>
  {% else %}
    {% trans %}You don't have enough permissions to access this content.{% endtrans %}
  {% endif %}
</tbody></table>
