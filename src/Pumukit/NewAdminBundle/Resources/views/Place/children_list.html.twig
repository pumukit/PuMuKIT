{% if children is defined %}

    {% for tag in children %}
        <tr class="pmk-font-size-12">
            <td headers="th-checkbox">
                <div class="form-check">
                    <label>
                        <input id="{{ tag.id }}" class="tag_children_checkbox" type="checkbox">
                    </label>
                </div>
            </td>

            <td headers="th-icons">
                <a class="delete_children_tag" href="#" data-action="click->admin--places#remove" data-admin--places-id-param="{{ tag.id|json_encode }}" data-admin--places-parent-param="{{ tag.parent.id|json_encode }}" data-admin--places-success-param="{{ 'Precinct successfully deleted.'|trans }}" title="{% trans %}delete{% endtrans %}">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            </td>

            <td headers="th-icons">
                <a title="{% trans %}Edit tag {% endtrans %}" href="{{ path('pumukitnewadmin_places_update', {'id': tag.id}) }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">
                    <i class="fa-solid fa-pencil"></i>
                </a>
            </td>

            {#<td headers="th-icons">
                <a title="{% trans %}Clone precinct{% endtrans %}">
                    <i class="fa-solid fa-copy"></i>
                </a>
            </td>#}

            <td class="data_children" data-action="click->admin--places#preview" data-admin--places-id-param="{{ tag.getId()|json_encode }}" headers="th-name">
                {{ tag.getTitle() }}
            </td>

            <td class="data_children text-center" data-action="click->admin--places#preview" data-admin--places-id-param="{{ tag.getId()|json_encode }}" headers="th-num-video">
                {{ tag.getNumberMultimediaObjects() }}
            </td>
        </tr>
    {% else %}
        <tr class="text-center pmk-font-size-12">
            <td colspan="8">{% trans %}No data{% endtrans %}</td>
        </tr>
    {% endfor %}
    <tr>
        <td colspan="6">
            <div class="row"><div class="col-md-8">
            <select id="options_precinct" class="form-select" data-action="change->admin--places#batch" data-admin--places-name-param="tag_children" data-admin--places-parent-param="{{ parent.id|json_encode }}" data-admin--places-success-param="{{ 'Precinct successfully deleted.'|trans }}" title="{% trans %}Actions on selected items{% endtrans %}">
                <option value="default" selected="selected">{% trans %}Select an action...{% endtrans %}</option>
                <option disabled="">---</option>
                <option value="delete_selected">{% trans %}Delete selected{% endtrans %}</option>
            </select>
            </div>
            <div class="col-md-4">
                <a href="{{ path('pumukitnewadmin_places_create', {'id': parent.id }) }}" class="btn btn-pumukit" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">
                    {% trans %}New{% endtrans %}
                </a>
            </div></div>
        </td>
    </tr>

{% else %}
    <tr class="text-center pmk-font-size-12">
        <td colspan="8">{% trans %}Select one place to load data{% endtrans %}</td>
    </tr>
{% endif %}
