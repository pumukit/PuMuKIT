<tr>
    <th id="th-checkbox" width="1%">
        <div class="checkbox">
            <label>
                <input type="checkbox" data-action="click->admin--actions#checkAll" data-admin--actions-name-param="tag_children">
            </label>
        </div>
    </th>
    <th id="th-icons" colspan="2" width="5%"></th>
    <th id="th-name">
        {% trans %}Name{% endtrans %}
    </th>
    <th id="th-num-video" width="1%" class="text-center">
        {% trans %}Videos{% endtrans %}
    </th>
</tr>
