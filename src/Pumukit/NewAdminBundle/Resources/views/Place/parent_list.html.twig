{% for tag in places %}
    <tr class="pmk-font-size-12">
        <td headers="th-checkbox">
            <div class="form-check">
                <label>
                    <input id="{{ tag.id }}" class="tag_parent_checkbox" type="checkbox">
                </label>
            </div>
        </td>

        <td headers="th-icons">
            <a class="delete_parent_tag" href="#" data-action="click->admin--places#remove" data-admin--places-id-param="{{ tag.id|json_encode }}" data-admin--places-success-param="{{ 'Place successfully deleted.'|trans }}" title="{% trans %}delete{% endtrans %}">
                <i class="fa-solid fa-xmark"></i>
            </a>
        </td>

        <td headers="th-icons">
            <a title="{% trans %}Edit tag {% endtrans %}" href="{{ path('pumukitnewadmin_places_update', {'id': tag.id}) }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">
                <i class="fa-solid fa-pencil"></i>
            </a>
        </td>

        {#<td headers="th-icons">
            <a title="{% trans %}Clone place{% endtrans %}">
                <i class="fa-solid fa-copy"></i>
            </a>
        </td>#}

        <td class="load_children" data-action="click->admin--places#children" data-admin--places-id-param="{{ tag.getId()|json_encode }}" data-admin--places-title-param="{{ tag.getTitle()|json_encode }}" headers="th-name">
            {{ tag.getTitle() }}
        </td>
        <td class="load_children" data-action="click->admin--places#children" data-admin--places-id-param="{{ tag.getId()|json_encode }}" data-admin--places-title-param="{{ tag.getTitle()|json_encode }}" headers="th-dir">
            {% if tag.getProperty('address') is not empty %}
                {{ tag.getProperty('address')[app.request.getLocale()] }}
            {% endif %}
        </td>
        <td class="load_children text-center" data-action="click->admin--places#children" data-admin--places-id-param="{{ tag.getId()|json_encode }}" data-admin--places-title-param="{{ tag.getTitle()|json_encode }}" headers="th-num-precinct">
            {{ tag.getChildren()|length }}
        </td>
    </tr>
{% endfor %}
