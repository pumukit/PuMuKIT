<tr>
    <th id="th-checkbox" width="1%">
        <div class="form-check">
            <label>
                <input type="checkbox" data-action="click->admin--actions#checkAll" data-admin--actions-name-param="tag_parent">
            </label>
        </div>
    </th>
    <th id="th-icons" colspan="2" width="5%"></th>
    <th id="th-name">
        {% trans %}Name{% endtrans %}
    </th>
    <th id="th-dir">
        {% trans %}Address{% endtrans %}
    </th>
    <th id="th-num-precinct">
        {% trans %}Precinct{% endtrans %}
    </th>
</tr>
