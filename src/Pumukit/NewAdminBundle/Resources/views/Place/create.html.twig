<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
    <h4 class="modal-title" id="myModalLabel">{% trans %}Create new place{% endtrans %}</h4>
</div>
<div class="modal-body">
    {% form_theme form '@PumukitNewAdmin/Themes/fields.html.twig' %}
    {% set refresh = [{target: '.parent-list', url: path('pumukitnewadmin_places_parent')}] %}
    {% if parent.cod != 'PLACES' %}
        {% set refresh = refresh|merge([{target: '.children-list', url: path('pumukitnewadmin_places_children', {'id': parent.id})}]) %}
    {% endif %}
    <form id="create_place" action="{{ parent.cod != 'PLACES' ? path('pumukitnewadmin_places_create', {'id': parent.id}) : path('pumukitnewadmin_places_create') }}" method="POST"
          data-controller="admin--modal-form" data-action="submit->admin--modal-form#submit"
          data-admin--modal-form-refresh-value="{{ refresh|json_encode }}"
          data-admin--modal-form-success-message-value="{{ 'Place successfully created.'|trans }}"
          data-admin--modal-form-error-message-value="{{ 'There was an error in creating the Tag.'|trans }}">
        <fieldset>
            {% for child in form %}
                {{ form_row(child) }}
            {% endfor %}
        </fieldset>
        <div class="modal-footer">
            <button type="button" class="btn btn-default btn-raised" data-dismiss="modal">{% trans %}Close{% endtrans %}</button>
            <button type="submit" class="btn btn-primary btn-raised">{% trans %}Save changes{% endtrans %}</button>
        </div>
    </form>
</div>
