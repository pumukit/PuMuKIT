{% form_theme form '@PumukitNewAdmin/Themes/fields.html.twig' %}

<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">{% trans %}Create/Update session{% endtrans %}</h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

{{ form_start(form, {'attr' : {
    'id': 'event_session_form',
    'data-action': 'submit->admin--live-event#saveSession',
    'data-admin--live-event-url-param': path('pumukit_new_admin_live_event_sessiontab', {'id': multimediaObject.getId()}),
    'data-admin--live-event-list-param': path('pumukit_new_admin_live_event_session_list', {'id': multimediaObject.getId()})
}}) }}
    <div class="modal-body">
        {% if session_id is defined %}
            <div class="row"><div class="col-12">
                <label for="session_id">{% trans %}Session ID{% endtrans %}</label>
                <input class="form-control" value="{{ session_id }}" id="session_id" disabled />
            </div></div>
            <input type="hidden" value="{{ session_id }}" name="pumukitnewadmin_event_session[id]" />
        {% endif %}
        <div class="row"><div class="col-12 pmk-margin-top-20">
            {{ form_row(form.start) }}
        </div>
        <div class="col-12 pmk-margin-top-20">
            {{ form_row(form.ends) }}
        </div>
        <div class="col-12 pmk-margin-top-20">
            {{ form_row(form.notes, {'attr' : {'style': 'resize: vertical;'}}) }}
        </div></div>
    </div>
    <div class="modal-footer">
        <div class="row">
            <div class="col-md-2 offset-md-5">
                <input class="btn btn-secondary" type="button" value="{% trans %}Cancel{% endtrans %}" data-bs-dismiss="modal">
            </div>
            <div class="col-md-2 offset-md-1">
                <input class="btn btn-pumukit" type="submit" value="{% trans %}Save{% endtrans %}">
            </div>
        </div>
    </div>
{{ form_end(form)}}
