<div class="col-12">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <th id="th-edit"></th>
                <th id="th-id" >ID</th>
                <th id="th-start">{% trans %}Start{% endtrans %}</th>
                <th id="th-ends">{% trans %}End{% endtrans %}</th>
                <th id="th-duration">{% trans %}Duration{% endtrans %}</th>
                <th id="th-notes">{% trans %}Notes{% endtrans %}</th>
            </thead>
            <tbody>
                {% for session in multimediaObject.getEmbeddedEvent().getEmbeddedEventSession() %}
                    <tr>
                        <td>
                            <a class="clone_session" href="#" data-action="click->admin--live-event#session" data-admin--live-event-url-param="{{ path('pumukit_new_admin_live_event_clone_session', {'multimediaObject': multimediaObject.getId(), 'session_id': session.id }) }}" data-admin--live-event-list-param="{{ path('pumukit_new_admin_live_event_session_list', {'id': multimediaObject.getId()}) }}">
                                <i class="fa-solid fa-copy"></i>
                            </a>
                            <a class="edit_session" data-action="click->admin--actions#load" data-admin--actions-url-param="{{ path('pumukit_new_admin_live_event_session_modal', {'multimediaObject': multimediaObject.getId(), 'session_id': session.id }) }}" data-admin--actions-target-param=".modal-session" href="#" title="{% trans %}Edit session{% endtrans %}" data-session_id="" data-bs-toggle="modal" data-bs-target="#updatesessionmodal">
                                <i class="fa-solid fa-pencil"></i>
                            </a>
                            <a class="delete_session" data-action="click->admin--live-event#session" data-admin--live-event-url-param="{{ path('pumukit_new_admin_live_event_session_delete', {'multimediaObject': multimediaObject.getId(), 'session_id': session.id }) }}" data-admin--live-event-list-param="{{ path('pumukit_new_admin_live_event_session_list', {'id': multimediaObject.getId()}) }}" data-admin--live-event-confirm-param="{{ 'Are you sure?'|trans }}" data-admin--live-event-form-param="#event_session_form" href="#" title="{% trans %}Delete session{% endtrans %}">
                                <i class="fa-solid fa-xmark"></i>
                            </a>
                        </td>
                        <td header="th-id">{{ session.id  }}</td>
                        <td header="th-start"> {{ session.start |  format_datetime('medium', 'medium',locale=app.request.getLocale()) }}</td>
                        <td header="th-ends"> {{ session.ends |  format_datetime('medium', 'medium',locale=app.request.getLocale()) }}</td>
                        <td header="th-duration"> {{ (session.duration/60)|number_format(0) }} {% trans %}min.{% endtrans %}</td>
                        <td header="th-notes"> {{ session.notes|nl2br }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
