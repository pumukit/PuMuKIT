{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block body %}
    <h3 class="cab_body_div">
        <ul class="breadcrumb pmk-margin-bottom-5">
            <li class="active breadcrumb-item">{% trans %}Live events{% endtrans %}</li>
        </ul>
    </h3>

    <div class="row" {% include '@PumukitNewAdmin/LiveEvent/_controller.html.twig' %}>
        <div class="col-md-10">
            <div class="pmk-well">
                <div id="list_events">
                    {{ render(controller('Pumukit\\NewAdminBundle\\Controller\\EventsController::listEventAction')) }}
                </div>
                <div class="row">
                    <div class="col-4">
                        <select id="options_events" class="form-select" data-action="change->admin--live-event#batch" title="{% trans %}Actions on selected items{% endtrans %}">
                            <option value="default" selected="selected">
                                {% trans %}Select an action...{% endtrans %}</option>
                            <option disabled="">---</option>
                            <option value="delete_selected">{% trans %}Delete selected{% endtrans %}</option>
                        </select>
                    </div>
                    <div class="col-8 text-end">
                        <a id="button_new_event_from_series" data-action="click->admin--live-event#create" title="{% trans %}Create new series of live events{% endtrans %}" class="btn btn-pumukit button_new_event_and_series" href="#">
                            {% trans %} New event and series{% endtrans %}
                        </a>
                        <a href="{{ path('pumukitnewadmin_live_event_change_series') }}" title="{% trans %}Create new live event{% endtrans %}" class="btn btn-pumukit button_new_event_from_series" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">
                            {% trans %} New event from series{% endtrans %}
                        </a>
                    </div>
                </div>
            </div>
            <div class="row">
                <div id="edit_events" class="col-12">
                    {% if(app.session.has('admin/live/event/id')) %}
                        {{ render(url('pumukit_new_admin_live_event_edit', {'id': app.session.get('admin/live/event/id')})) }}
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-md-2 d-none d-md-block">
            <div id="preview_events" class="pmk-well">
                {% if(app.session.has('admin/live/event/id')) %}
                    <div data-controller="admin--include" data-admin--include-src-value="{{ url('pumukit_new_admin_live_event_show', {'id': app.session.get('admin/live/event/id')}) }}"></div>
                {% else %}
                    {% trans %}Select any live event.{% endtrans %}
                {% endif %}
            </div>
            {% include '@PumukitNewAdmin/LiveEvent/filters.html.twig' %}
        </div>
    </div>

{% endblock %}
