<div class="pmk-well">
    <div class="row">
        <div class="col-md-12">
            <p><strong>{% trans %}Filter by{% endtrans %}:</strong></p>
            <ul class="list-unstyled">
                <li>
                    - <a class="filterSearchEvents" data-type="now" href="#" data-action="click->admin--live-event#filterType" data-admin--live-event-type-param="now">{% trans %}Live events{% endtrans %}</a>
                </li>
                <li>
                    - <a class="filterSearchEvents" data-type="future" href="#" data-action="click->admin--live-event#filterType" data-admin--live-event-type-param="future">{% trans %}Future events{% endtrans %}</a>
                </li>
                <li>
                    - <a class="filterSearchEvents" data-type="today" href="#" data-action="click->admin--live-event#filterType" data-admin--live-event-type-param="today">{% trans %}Today events list{% endtrans %}</a>
                </li>
            </ul>
        </div>
    </div>
    <form id="filter_events" class="form" data-action="submit->admin--live-event#filter" action="{{ path('pumukit_new_admin_live_event_list') }}" method="GET">
        <fieldset>
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title mb-0">
                        <i class="fa-solid fa-bars float-end"></i>
                        {% trans %}Search{% endtrans %}
                    </h2>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="name" class="form-label">{% trans %}Name{% endtrans %}:</label>
                        <div>
                            {% set criteria = app.session.get('admin/live/event/dataForm')|default('') %}
                            <input type="text" class="reset form-control" name="criteria[name]" id="filters_name" value="{{ criteria['name']|default("") }}">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="date" class="form-label">{% trans %}Date{% endtrans %}:</label>
                        <div>
                            {% trans %}From{% endtrans %}:
                            <input type="date" class="form-control" name="criteria[date][from]" id="filters_date_from"
                            {% if criteria['date'] is defined and criteria['date']['from'] is not empty %}
                                value="{{ criteria['date']['from'] }}"
                            {% endif %}>
                            <br/>
                            {% trans %}To{% endtrans %}:
                            <input type="date" class="form-control" name="criteria[date][to]" id="filters_date_to"
                            {% if criteria['date'] is defined and criteria['date']['to'] is not empty %}
                                value="{{ criteria['date']['to'] }}"
                            {% endif %}>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="text-end">
            <input type="button" class="btn btn-secondary resetSession" data-action="click->admin--live-event#resetFilters" value="{% trans %}reset{% endtrans %}">
            <input type="submit" name="filter" value="{% trans %}filter{% endtrans %}" class="btn btn-pumukit">
        </div>
    </form>
</div>
