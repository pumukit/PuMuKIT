<div class="pmk-well pmk-overflow-hidden">
    <div class="row"><div class="col-12">
        <div id="list_live_events" class="row">
            {% include '@PumukitNewAdmin/LiveEvent/sessionlist.html.twig' with {'multimediaObject' : multimediaObject} %}
        </div>
    </div>

    <div class="col-12">

        <a href="{{ path('pumukit_new_admin_live_event_session_modal', {'multimediaObject': multimediaObject.getId()}) }}"  data-bs-backdrop="static" data-bs-toggle="modal" data-bs-target="#updatesessionmodal">
        {% trans %}New event session{% endtrans %}
        </a>
    </div></div>

    <br />
</div>

<!-- Modal -->
<div class="pmk-modal modal fade" id="updatesessionmodal" tabindex="-1" role="dialog" aria-labelledby="updatesessionmodalLabel" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content modal-session">
            {% include '@PumukitNewAdmin/LiveEvent/updatesessionmodal.html.twig' %}
        </div>
    </div>
</div>
