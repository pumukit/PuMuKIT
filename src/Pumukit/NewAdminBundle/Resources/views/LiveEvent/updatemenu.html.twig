<div class="dropdown">
    <i class="fa-solid fa-bars" id="list_pics_{{ multimediaObject.id }}" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></i>
    <ul class="dropdown-menu" role="menu" aria-labelledby="list_pics_{{ multimediaObject.id }}">
        <li>
            <a class="dropdown-item" href="{{ path('pumukitnewadmin_live_event_change_series', {'multimediaObject': multimediaObject.getId()}) }}" title="{% trans %}Change series{% endtrans %}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">
                <i class="fa-solid fa-pencil"></i> {% trans %}Change series{% endtrans %}
            </a>
        </li>
        {% if not is_naked() %}
            <li>
                <a href="#" title="{% trans %}Clone event{% endtrans %}" class="event_option qa-button-clone-live-event dropdown-item" data-action="click->admin--live-event#option" data-admin--live-event-url-param="{{ path('pumukit_new_admin_live_event_options', {'type' : 'clone','id': multimediaObject.id}) }}">
                    <i class="fa-solid fa-copy"></i> {% trans %}Clone event{% endtrans %}
                </a>
            </li>
        {% endif %}
        <li>
            <a href="#" title="{% trans %}Delete event{% endtrans %}" class="event_option qa-button-delete-live-event dropdown-item" data-action="click->admin--live-event#option" data-admin--live-event-url-param="{{ path('pumukit_new_admin_live_event_options', {'type' : 'delete','id': multimediaObject.id}) }}" data-admin--live-event-confirm-param="{{ 'Are you sure?'|trans }}">
                <i class="fa-solid fa-xmark"></i> {% trans %}Delete event{% endtrans %}
            </a>
        </li>
        <li>
            <a href="#" title="{% trans %}Delete event and series{% endtrans %}" class="event_option qa-button-delete-live-event-series dropdown-item" data-action="click->admin--live-event#option" data-admin--live-event-url-param="{{ path('pumukit_new_admin_live_event_options', {'type' : 'deleteAll', 'id': multimediaObject.id}) }}" data-admin--live-event-confirm-param="{{ 'Are you sure?'|trans }}">
                <i class="fa-solid fa-xmark"></i> {% trans %}Delete event and series{% endtrans %}
            </a>
        </li>
        <li>
            <a class="dropdown-item" href="#" data-action="click->admin--actions#cancel">
                <strong>{% trans %}Cancel{% endtrans %}...</strong>
            </a>
        </li>
    </ul>
</div>
