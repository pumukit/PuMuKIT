<div class="table-responsive pmk-overflow-visible">
    {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_EDIT_PLAYLIST')) %}
        <input type="hidden" name="pumukitnewadmin_playlist_sort_change_type" id="pumukitnewadmin_playlist_sort_change_type" value="{{ app.session.get('admin/playlist/type')=='asc'?'desc':'asc' }}"/>
        <table class="table table-striped table-hover">
            <thead>
            <tr>
                <th width="1%" id="th-checkbox">
                    <div class="form-check">
                        <label>
                            <input type="checkbox" data-action="click->admin--actions#checkAll" data-admin--actions-name-param="playlist">
                        </label>
                    </div>
                </th>
                <th class="pmk-width-5pct" {% if is_naked() %}colspan="2"{% endif%} id="th-icons"></th>
                <th id="th-img"></th>
                {% include '@PumukitNewAdmin/Playlist/listth.html.twig' %}
            </tr>
            </thead>

            <tbody>
            {% for oneseries in series %}
                <tr class="pmk-cursor-pointer{% if (app.session.get('admin/playlist/id') == oneseries.id ) %} success{% endif %}">
                    <td headers="th-checkbox">
                        <div class="form-check">
                            <label>
                                <input id="{{ oneseries.id }}" class="playlist_checkbox" type="checkbox">
                            </label>
                        </div>
                    </td>
                    <td headers="th-icons">
                        {% include '@PumukitNewAdmin/Playlist/updatemenu.html.twig' with {'oneseries': oneseries, 'numV': (oneseries|count_multimedia_objects)} %}
                    </td>
                    {% if is_naked() %}
                        <td headers="th-icons">
                            <a class="moodlepr-add" href="#" title="{% trans %}Publish to LMS{% endtrans %}" data-action="click->admin--actions#notifyParent" data-admin--actions-message-param="{{ {playlist: oneseries.id}|json_encode }}"><i class="fa-solid fa-image"></i></a>
                        </td>
                    {% endif %}
                    <td headers="th-img" data-action="click->admin--actions#edit dblclick->admin--actions#navigate" data-admin--actions-name-param="playlist" data-admin--actions-show-param="{{ path('pumukitnewadmin_playlist_show', {'id': oneseries.id}) }}" data-admin--actions-update-param="{{ path('pumukitnewadmin_playlist_update', {'id': oneseries.id}) }}" data-admin--actions-url-param="{{ path('pumukitnewadmin_playlistmms_index', {'id': oneseries.id }) }}">
                        {% include "@PumukitNewAdmin/Misc/img_list.html.twig"  with {'object' : oneseries, 'type': 'playlist' } %}
                    </td>
                    <td headers="th-title" data-action="click->admin--actions#edit dblclick->admin--actions#navigate" data-admin--actions-name-param="playlist" data-admin--actions-show-param="{{ path('pumukitnewadmin_playlist_show', {'id': oneseries.id}) }}" data-admin--actions-update-param="{{ path('pumukitnewadmin_playlist_update', {'id': oneseries.id}) }}" data-admin--actions-url-param="{{ path('pumukitnewadmin_playlistmms_index', {'id': oneseries.id }) }}">
                        <a title="{% trans %}List multimedia objects of the playlist{% endtrans %}" href="{{ path('pumukitnewadmin_playlistmms_index', {'id': oneseries.id }) }}">
                            {{ oneseries.getTitle() }}
                        </a>

                    </td>
                    <td headers="th-mm" data-action="click->admin--actions#edit dblclick->admin--actions#navigate" data-admin--actions-name-param="playlist" data-admin--actions-show-param="{{ path('pumukitnewadmin_playlist_show', {'id': oneseries.id}) }}" data-admin--actions-update-param="{{ path('pumukitnewadmin_playlist_update', {'id': oneseries.id}) }}" data-admin--actions-url-param="{{ path('pumukitnewadmin_playlistmms_index', {'id': oneseries.id }) }}">
                        {{ oneseries.getPlaylist().getMultimediaObjects()|length }}
                    </td>
                    <td headers="th-play">
                        <a href="{{ path('pumukit_playlistplayer_index', {'id': oneseries.id}) }}" target="_blank">
                            <i class="fa-solid fa-play"></i>
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" headers="th-checkbox th-icons th-img th-title th-mm">
                        {% trans %}There are no playlist with those values.{% endtrans %}
                    </td>
                </tr>
            {% endfor %}
            {% if (series|length - (series.getMaxPerPage() * (series.getCurrentPage() - 1))) < (series.maxPerPage) %}
                {% for i in (series|length - (series.getMaxPerPage() * (series.getCurrentPage() - 1)))..(series.maxPerPage-1) %}
                    <tr>
                        <td headers="th-checkbox">&nbsp;</td>
                        <td headers="th-icons">&nbsp;</td>
                        {% if is_naked() %}
                            <td headers="th-icons">&nbsp;</td>
                        {% endif %}
                        <td headers="th-img">&nbsp;</td>
                        <td headers="th-title">&nbsp;</td>
                        <td headers="th-mm">&nbsp;</td>
                        <td headers="th-play">&nbsp;</td>
                    </tr>
                {% endfor %}
            {% endif %}
            </tbody>
            <tfoot>
            <tr>
                <td colspan="6" class="foot-td">
                    <div class="row">
                        <div class="col-md-6">
                            {{ series.getNbResults }}
                            {{ "{0} playlist|{1} playlist|]1,Inf] playlists"|trans({'%count%': series.getNbResults}) }}
                            {% if app.session.get('admin/playlist/criteria')|length != 0 %}
                                <a class="cancel-search-button pmk-color-blue pmk-font-weight-normal" title="{% trans %}Cancel current search{% endtrans %}" href="?criteria[reset]=true">{% trans %}Cancel search{% endtrans %}</a>
                            {% endif %}
                        </div>
                        <div class="col-md-6 text-end">
                            <div class="pagerfanta">
                                {% set sorting = {('sorting[' ~ (app.session.get('admin/playlist/sort')) ~ ']') : (app.session.get('admin/playlist/type')) } %}
                                {% set pagerClass = 'twitter_bootstrap5' %}
                                {% set pagerStyles = {"css_container_class": "pagination pagination-sm", "next_message": "&raquo;", "prev_message": "&laquo;", "routeName": "pumukitnewadmin_playlist_index", "routeParams": sorting} %}
                                {% include "@PumukitNewAdmin/Misc/pager.html.twig" with {'objects' : series, 'pagerClass': pagerClass, 'pagerStyles': pagerStyles} %}
                                {% if not is_naked() %}
                                    <select data-action="change->admin--actions#go" data-admin--actions-url-param="{{ path('pumukitnewadmin_playlist_index') }}?page=1&paginate=" aria-label="{% trans %}Select the number of playlists to display per page.{% endtrans %}">
                                        <option {% if series.maxPerPage == 10 %}selected{% endif %} value="10">
                                            10
                                        </option>
                                        <option {% if series.maxPerPage == 20 %}selected{% endif %} value="20">
                                            20
                                        </option>
                                        <option {% if series.maxPerPage == 50 %}selected{% endif %} value="50">
                                            50
                                        </option>
                                    </select>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
            </tfoot>
        </table>
    {% else %}
        {% trans %}You don't have enough permissions to access this content.{% endtrans %}
    {% endif %}
</div>
