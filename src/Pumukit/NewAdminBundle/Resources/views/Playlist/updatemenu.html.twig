<div class="dropdown">
  <i class="mdi-navigation-menu" id="list_pics_{{ oneseries.id }}" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></i>
  <ul class="dropdown-menu" role="menu" aria-labelledby="list_pics_{{ oneseries.id }}">
    <li>
      <a title="{% trans %}List multimedia objects of the playlist{% endtrans %}" href="{{ path('pumukitnewadmin_playlistmms_index', {'id': oneseries.id }) }}">
        <i class="mdi-action-list"></i> {% trans %}List multimedia objects of the playlist{% endtrans %}
      </a>
    </li>
    <li>
      <a href="#" data-action="click->admin--actions#remove"
         data-admin--actions-url-param="{{ path('pumukitnewadmin_playlist_delete', {'id': oneseries.id}) }}"
         data-admin--actions-target-param="#list_playlists"
         data-admin--actions-clear-param="{{ {name: 'playlist', id: oneseries.id, message: 'Select any playlist.'|trans}|json_encode }}"
         data-admin--actions-confirm-param="{{ 'Are you sure you want to delete the playlist'|trans }} &quot;{{ oneseries.getTitle() }}&quot;? {{ 'This playlist has'|trans }} {{ oneseries|count_multimedia_objects }} {{ 'multimedia object(s)'|trans }}."
         data-admin--actions-success-param="{{ 'Playlist'|trans }} &quot;{{ oneseries.getTitle() }}&quot; {{ 'successfully deleted'|trans }}.">
        <i class="mdi-content-clear"></i> {% trans %}Delete the playlist{% endtrans %}
      </a>
    </li>
    <li>
      <a href="#" data-action="click->admin--actions#cancel">
        <strong>{% trans %}Cancel{% endtrans %}...</strong>
      </a>
    </li>
  </ul>
</div>
