{% set criteria = app.session.get('admin/playlist/criteria') %}
<div class="pmk-well">
    <form id="filter_playlist" class="form">
        <fieldset>
            <legend hidden>{% trans %}Filter playlist{% endtrans %}</legend>
            <div id="accordion" role="tablist" aria-roledescription="tablist" aria-multiselectable="true">
                <div class="card">
                    <div class="card-header" role="tab" id="headingSearch">
                        <h2 class="card-title mb-0">
                            <a class="d-block" data-bs-toggle="collapse" href="#collapseSearch" aria-expanded="true" aria-controls="collapseSearch">
                                <i class="fa-solid fa-bars float-end"></i>
                                {% trans %}Search{% endtrans %}
                            </a>
                        </h2>
                    </div>
                    <div id="collapseSearch" data-bs-parent="#accordion" class="panel-collapse collapse show" role="tabpanel" aria-labelledby="headingSearch">
                        <div class="card-body">
                            <div class="mb-3">
                                <label for="filters_search" class="form-label">
                                    {% trans %}Search{% endtrans %}:
                                </label>
                                <div>
                                    <input type="text" class="form-control" name="criteria[search]" id="filters_search" value="{{ criteria['search']|default("") }}">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="text-end">
            <input class="btn btn-secondary" data-action="click->admin--actions#navigate" data-admin--actions-url-param="?criteria[reset]=true" type="button" value="{% trans %}reset{% endtrans %}">
            <input type="submit" name="filter" value="{% trans %}filter{% endtrans %}" class="btn btn-pumukit">
        </div>
    </form>
</div>
