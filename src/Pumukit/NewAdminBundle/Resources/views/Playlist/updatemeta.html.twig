<div class="pmk-well">
  <form id="pumukitnewadmin_series_updatemeta_form"
        data-controller="admin--modal-form admin--meta-form"
        data-action="submit->admin--modal-form#submit change->admin--meta-form#changed"
        data-admin--modal-form-target-value="#list_playlists"
        data-admin--modal-form-refresh-value="{{ [{target: '#preview_playlist', url: path('pumukitnewadmin_playlist_show', {'id': series.id})}]|json_encode }}"
        data-admin--modal-form-modal-value=""
        data-admin--modal-form-success-message-value="{{ 'Series saved OK'|trans }}"
        data-admin--modal-form-fail-message-value="{{ 'Series saved ERROR'|trans }}"
        data-admin--meta-form-remember-value="#remember_save_series"
        data-admin--meta-form-prefix-value="pumukitnewadmin_series_"
        action="{{ path('pumukitnewadmin_playlist_update', {'id': series.id}) }}" method="POST">
    {% form_theme form '@PumukitNewAdmin/Themes/fields.html.twig' %}
    <input type="hidden" name="id" id="series_id_playlist" value="{{ series.id }}">

    <div class="row">
      <div class="col-6">
        <span id="remember_save_series" class="alert alert-dismissable alert-danger pmk-display-none pmk-vertical-align-middle">{% trans %}Press OK for the change to take effect{% endtrans %}</span> &nbsp;
      </div>

      <div class="col-6 text-end">
        <button id="pumukitnewadmin_series_updatemeta_cancel" type="button" class="btn btn-secondary" data-action="click->admin--meta-form#cancel">{% trans %}Cancel{% endtrans %}</button>
        <button type="submit" class="btn btn-pumukit" data-action="click->admin--meta-form#hideRemember">{% trans %}OK{% endtrans %}</button>
      </div>
    </div>

    <div>
      <fieldset class="row">
        <legend hidden>{% trans %}Multimedia Playlist metadata{% endtrans %}</legend>
        <div class="col-lg-7">
          {% for child in form %}
            {{ form_row(child) }}
          {% endfor %}

          <div class="mb-3">
            <dl>
              <dt>{% trans %}Thumbnails{% endtrans %}</dt>
              <dd>
                <div id="pic_playlist_{{ series.id }}">
                  {% include '@PumukitNewAdmin/Pic/list.html.twig' with {'resource': series, 'resource_name': 'playlist'} %}
                </div>
              </dd>
            </dl>
          </div>
        </div>
      </fieldset>
    </div>
  </form>
</div>
