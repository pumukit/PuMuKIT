{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block body %}

    <h3 class="cab_body_div">
        <ul class="breadcrumb pmk-margin-bottom-5">
            <li class="active breadcrumb-item">
                {% if app.user and is_granted('ROLE_SCOPE_PERSONAL') %}
                    {% if is_naked() %}
                        {% trans %}My Playlists{% endtrans %}
                    {% else %}
                        {% trans %}My Playlists{% endtrans %}
                    {% endif %}
                {% else %}
                    {% trans %}Playlists{% endtrans %}
                {% endif %}
            </li>
        </ul>
    </h3>

    <div class="row">
        {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_EDIT_PLAYLIST')) %}
            <div class="col-md-10">
                <div class="pmk-well">
                    <div id="list_playlists">
                        {% include '@PumukitNewAdmin/Playlist/list.html.twig' %}
                    </div>
                    <div class="row">
                        <div class="col-4">
                            <select id="options_series" class="form-select" title="{% trans %}Actions on selected items{% endtrans %}" data-controller="admin--batch" data-action="change->admin--batch#run"
                                    data-admin--batch-name-value="playlist" data-admin--batch-plural-value="playlists" data-admin--batch-preview-value="playlist"
                                    data-admin--batch-urls-value="{{ {delete: path('pumukitnewadmin_playlist_batch_delete', {'ids': '__ids__'})}|json_encode }}"
                                    data-admin--batch-messages-value="{{ {confirm: 'Are you sure?'|trans, success: 'Playlists ' ~ 'successfully deleted.'|trans, selectAny: 'Select any playlist.'|trans}|json_encode }}">
                                <option value="default" selected="selected">{% trans %}Select an action...{% endtrans %}</option>
                                <option disabled="">---</option>
                                <option value="delete_selected">{% trans %}Delete selected{% endtrans %}</option>
                            </select>
                        </div>
                        <div class="col-8 text-end">
                            {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_EDIT_PLAYLIST')) %}
                                <a title="{% trans %}Create new playlist{% endtrans %}" id="pumukitnewadmin_playlist_new_button" class="btn btn-pumukit" href="#" data-action="click->admin--actions#create"
                                   data-admin--actions-url-param="{{ path('pumukitnewadmin_playlist_create') }}"
                                   data-admin--actions-method-param="POST"
                                   data-admin--actions-key-param="playlistId"
                                   data-admin--actions-name-param="playlist"
                                   data-admin--actions-list-param="#list_playlists"
                                   data-admin--actions-list-url-param="{{ path('pumukitnewadmin_playlist_list', {'selectedSeriesId': '__id__'}) }}"
                                   data-admin--actions-show-url-param="{{ path('pumukitnewadmin_playlist_show', {'id': '__id__'}) }}"
                                   data-admin--actions-edit-url-param="{{ path('pumukitnewadmin_playlist_update', {'id': '__id__'}) }}"
                                   data-admin--actions-reset-param="#filter_playlist"
                                   data-admin--actions-success-param="{{ 'Playlist successfully created.'|trans }}">{% trans %}New{% endtrans %}</a>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div id="edit_playlist">
                    {% if(app.session.has('admin/playlist/id')) %}
                        {{ render(url('pumukitnewadmin_playlist_update', {'id': app.session.get('admin/playlist/id')})) }}
                    {% endif %}
                </div>
            </div>
            <div class="col-md-2 d-none d-md-block">
                <div id="preview_playlist" class="pmk-well">
                    {% if(app.session.has('admin/playlist/id')) %}
                        <div data-controller="admin--include" data-admin--include-src-value="{{ url('pumukitnewadmin_playlist_show', {'id': app.session.get('admin/playlist/id')}) }}"></div>
                    {% else %}
                        {% trans %}Select any playlist.{% endtrans %}
                    {% endif %}
                </div>
                {% include '@PumukitNewAdmin/Playlist/acordeon.html.twig' with {'name': 'series', 'broadcasts': 'broadcasts', 'seriestypes': 'seriestypes'} %}
            </div>
        {% else %}
            <div class="col-md-12">
                <div class="pmk-well">
                    {% trans %}You don't have enough permissions to access this content.{% endtrans %}
                </div>
            </div>
        {% endif %}
    </div>

    <div class="pmk-modal fade" id="myAuxModal_template" tabindex="-1" role="dialog" aria-labelledby="myAuxModal_templateLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
            </div>
        </div>
    </div>
{% endblock %}
