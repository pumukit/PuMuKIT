{% extends '@PumukitWebTV/layout.html.twig' %}
{% block meta %}
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="IE=edge,chrome=1" http-equiv="X-UA-Compatible">
{% endblock meta %}
{% block title %}Pumukit admin{% endblock %}
{% block stylesheets %}
    <!-- Font Awesome -->
    <link href="{{ asset('bundles/pumukitcore/vendor/fontawesome/css/all.min.css') }}" rel="stylesheet">
    <!-- Bootstrap -->
    <link href="{{ asset('bundles/pumukitcore/vendor/bootstrap5/css/bootstrap.min.css') }}" rel="stylesheet">
    <!-- Material Design Icons -->
    <link href="{{ asset('bundles/pumukitnewadmin/css/mdi-icons.css') }}" rel="stylesheet">
    <!-- jQuery UI custom (autocomplete) -->
    <link href="{{ asset('bundles/pumukitcore/vendor/jquery-ui/jquery-ui.min.css') }}" rel="stylesheet">
    <link href="{{ path('pumukit_jquery_ui_autocomplete_css') }}" rel="stylesheet">
    <link href="{{ asset('bundles/pumukitnewadmin/css/material.css') }}" rel="stylesheet">
    <link href="{{ asset('bundles/pumukitnewadmin/css/keywords.css') }}" rel="stylesheet">
    <link href="{{ asset('bundles/pumukitnewadmin/css/backoffice.css') }}" rel="stylesheet">
    <!-- Pumukit CSS modifications -->
    <link href="{{ path('pumukitnewadmin_css') }}" rel="stylesheet">

{% endblock %}

{% block javascripts %}
    <script src="{{ asset('bundles/pumukitcore/vendor/jquery/jquery.min.js') }}"></script>
    <script src="{{ asset('bundles/pumukitcore/vendor/bootstrap5/js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ asset('bundles/pumukitcore/vendor/jquery-ui/jquery-ui.min.js') }}"></script>

    {{ importmap(['pumukit', '@pumukit/new-admin/backoffice']) }}
{% endblock %}

{% block body_base %}
    <div data-controller="admin--actions"{% if is_naked() %} data-naked-backoffice{% endif %}>
    {% block naked_menu %}
        {% include is_naked() ? '@PumukitNewAdmin/naked_menu.html.twig' : '@PumukitNewAdmin/menu.html.twig' %}
    {% endblock %}
    <div class="container-fluid main">
        {% block body %}{% endblock %}
    </div>
    <div class="pmk-modal modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
            </div>
        </div>
    </div>
    {% include '@PumukitNewAdmin/footer.html.twig' %}
    </div>
{% endblock body_base %}
