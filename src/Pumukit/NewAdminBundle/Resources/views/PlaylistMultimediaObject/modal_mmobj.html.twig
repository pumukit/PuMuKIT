<div class="d-flex">
  <div class="flex-shrink-0 me-3">
    <div class="img-thumbnail pmk-width-100 pmk-text-align-center pmk-float-left">
      {#<span class="video-duration">{{ mmobj_duration(mmobj) | duration_string }}</span>#}
      <img alt="serial_pic" class="serial thumbnailimg" src="{{ mmobj|first_url_pic(true) }}"/>
      {#div class="thumbnailholder"></div>#}
    </div>
  </div>
  <div class="flex-grow-1">
    <div class="fw-bold">
      <div class="pmk-overflow-hidden pmk-height-1_5em">
        {{ mmobj.title }}
      </div>
    </div>
    <!-- <div>
    {{ mmobj.series.title }}
    </div> -->
    <div class="pmk-overflow-hidden pmk-height-3em pmk-font-weight-normal">
      {{ mmobj.description }}
    </div>
    <div class="date mmobj pmk-font-style-italic">
      {{ mmobj.recordDate| format_datetime('medium','none',locale=app.request.getLocale()) }}
    </div>
  </div>
</div>
