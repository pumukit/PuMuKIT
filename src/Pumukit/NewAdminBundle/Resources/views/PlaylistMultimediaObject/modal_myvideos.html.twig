<form class="modal_form pmk-height-92pct" data-action="change->admin--playlist-modal#changed"
>
    <fieldset class="pmk-height-100pct pmk-overflow-auto" id="form_my_mmobjs_list" data-admin--playlist-modal-target="videos" data-action="scroll->admin--playlist-modal#moreVideos">
        <br>
        <div class="pmk-display-none" id="my_mmobjs_nommobjs_message" data-admin--playlist-modal-target="noVideos">{% trans %}This user does not own any multimedia objects {% endtrans %}.
        </div>
    </fieldset>
    <img id="my_mmobjs_ajax_loader" data-admin--playlist-modal-target="videosLoader" src="{{ asset('bundles/pumukitnewadmin/images/admin/load/spinner.gif') }}" alt="Loading more resources"/>
</form>
