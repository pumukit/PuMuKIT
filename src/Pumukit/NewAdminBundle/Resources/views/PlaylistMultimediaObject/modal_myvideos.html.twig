<form class="modal_form" data-action="change->admin--playlist-modal#changed"
      style="height:92%;"
>
    <fieldset style="height:100%;overflow:auto" id="form_my_mmobjs_list" data-admin--playlist-modal-target="videos" data-action="scroll->admin--playlist-modal#moreVideos">
        <br>
        <div id="my_mmobjs_nommobjs_message" data-admin--playlist-modal-target="noVideos"
             style="display:none">{% trans %}This user does not own any multimedia objects {% endtrans %}.
        </div>
    </fieldset>
    <img id="my_mmobjs_ajax_loader" data-admin--playlist-modal-target="videosLoader" src="{{ asset('bundles/pumukitnewadmin/images/admin/load/spinner.gif') }}" alt="Loading more resources"/>
</form>
