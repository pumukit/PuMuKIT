<div class="table-responsive" {% include '@PumukitNewAdmin/PlaylistMultimediaObject/_controller.html.twig' %}>
    <table class="table table-striped table-hover">
        <thead>
        <tr>
            <th width="1%">
                <div class="form-check pumukit-mms-checkbox">
                    <label>
                        <input type="checkbox" data-action="click->admin--actions#checkAll" data-admin--actions-name-param="playlistmm">
                    </label>
                </div>
            </th>
            <th colspan="{{ is_naked() ? 4 : 6 }}" width="5%"></th>
            <th id="th-img">{{ "Images"|trans }}</th>
            <th id="th-title">{{ "Title"|trans }}</th>
            <th id="th-type" class="text-center">{{ "Type"|trans }}</th>
            <th id="th-media" class="text-center">{{ "Media"|trans }}</th>
            <th id="th-duration" class="text-center">{{ "Duration"|trans }}</th>
            <th id="th-rec-date">{{ "Recording"|trans }}</th>
            <th id="th-pub-date">{{ "Publication"|trans }}</th>
            <th id="th-channel" class="text-center">{{ "WebTV"|trans }}</th>
            <th id="th-broadcast" class="text-center">{{ "Broadcast"|trans }}</th>
            <th id="th-views" class="text-center">{{ "Views"|trans }}</th>
            <th id="th-play">&nbsp;</th>
        </tr>
        </thead>

        <tbody>
        {% set mms_offset = (mms.getCurrentPage()-1)*mms.getMaxPerPage() %}{# Init this in controller instead? #}
        {% for mm in mms %}
            {% set mm_pos = loop.index0 + mms_offset %}
            {% set is_selected = (app.session.get('admin/playlistmms/id') == mm.id)  and (app.session.get('admin/playlistmms/pos', -1) == mm_pos) %}
            <tr class="mm_listed {{ is_selected?'success':'' }} pmk-cursor-pointer" data-id="{{ mm.id }}" data-pos="{{ mm_pos }}"
                data-action="click->admin--playlist-mms#select dblclick->admin--actions#openModal"
                data-admin--playlist-mms-id-param="{{ mm.id|json_encode }}"
                data-admin--playlist-mms-pos-param="{{ mm_pos }}"
                data-admin--actions-url-param="{{ path('pumukitnewadmin_mms_modal_preview', {'id': mm.id}) }}">
                <td>
                    <div class="form-check pumukit-mms-checkbox">
                        <label>
                            <input id="{{ mm.id }}" data-pos="{{ mm_pos }}" class="playlistmm_checkbox" type="checkbox">
                        </label>
                    </div>
                </td>
                <td>
                    {% if not is_playable_on_playlist(mm) %}
                        <i id="table_playable_mm_{{ mm.id }}" class="non-playable-warning mdi-action-report-problem pmk-color-orange pmk-font-size-16" data-bs-toggle="tooltip" data-bs-placement="right" title="{% trans %}This object cannot be played on the playlist{% endtrans %}"></i>
                    {% endif %}
                </td>
                {% if not is_naked() %}
                    <td>
                        <i id="table_mms_status_{{ mm.id }}" class="{{ mm.status|status_icon }}" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm|status_text }}"></i>
                    </td>
                    <td>
                        {{ mm.containsTagWithCod('PUDENEW')?'<i class="mdi-action-spellcheck">':'&nbsp;' }}
                    </td>
                {% endif %}
                <td>
                    {% include '@PumukitNewAdmin/PlaylistMultimediaObject/updatemenu.html.twig' with {'mm': mm, 'mm_pos':mm_pos} %}
                </td>
                <td>
                    {% if mms.getCurrentPage() != 1 or not loop.first %}
                        {% apply pumukit_spaceless %}
                            <a href="{{ path('pumukitnewadmin_playlistmms_up', {'id': playlist.id, 'mm_pos':mm_pos}) }}" title="{% trans %}Move one position up{% endtrans %}">&#8593;</a>
                            <a href="{{ path('pumukitnewadmin_playlistmms_top', {'id': playlist.id, 'mm_pos':mm_pos}) }}" title="{% trans %}Move to the beginning of the list{% endtrans %}"><i class="mdi-editor-vertical-align-top"></i></a>
                        {% endapply %}
                    {% endif %}
                </td>
                <td>
                    {% if (mms.getCurrentPage() != mms.getNbPages()) or (loop.index + ((mms.getCurrentPage() - 1 ) * mms.getMaxPerPage()) != mms.getNbResults()) %}
                        {% apply pumukit_spaceless %}
                            <a href="{{ path('pumukitnewadmin_playlistmms_down', {'id': playlist.id, 'mm_pos':mm_pos}) }}" title="{% trans %}Move one position down{% endtrans %}">&#8595;</a>
                            <a href="{{ path('pumukitnewadmin_playlistmms_bottom', {'id': playlist.id, 'mm_pos':mm_pos}) }}" title="{% trans %}Move to the end of the list{% endtrans %}"><i class="mdi-editor-vertical-align-bottom"></i></a>
                        {% endapply %}
                    {% endif %}
                </td>
                <td>
                    <img class="mini" src="{{ mm|first_url_pic(false, false) }}" alt="{% trans %}No_pic{% endtrans %}" height="23" width="30">
                </td>
                <td>
                    <span class="shorten-title">{{ mm.getTitle() }}</span>
                </td>
                <td class="text-center">
                    {% if mm.isVideoType() %}
                        <i class="fa-solid fa-file-video pmk-font-size-20" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getStringType(mm.getType()) }}"></i>
                    {% elseif mm.isAudioType() %}
                        <i class="fa-solid fa-file-audio pmk-font-size-20" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getStringType(mm.getType()) }}"></i>
                    {% elseif mm.isImageType() %}
                        <i class="fa-solid fa-file-image pmk-font-size-20" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getStringType(mm.getType()) }}"></i>
                    {% elseif mm.isDocumentType() %}
                        <i class="fa-solid fa-file-lines pmk-font-size-20" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getStringType(mm.getType()) }}"></i>
                    {% elseif mm.isExternalType() %}
                        <i class="fa-solid fa-link pmk-font-size-20" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getStringType(mm.getType()) }}"></i>
                    {% endif %}
                </td>
                <td class="text-center">
                    {{ mm.medias|length }}
                </td>
                <td class="text-center">
                    {{ mm.getRealDuration()| duration_string }}
                    {% if mm.getProperty('soft-editing-duration') %}
                        <i class="mdi-content-content-cut" data-bs-toggle="tooltip" data-bs-placement="left" title="{{ mmobj_duration(mm) | duration_string }}"></i>
                    {% endif %}
                </td>
                <td class="text-nowrap">
                    {{ mm.getRecordDate()| format_datetime('medium','none',locale=app.request.getLocale()) }}
                </td>
                <td class="text-nowrap">
                    {{ mm.getPublicDate()| format_datetime('medium','none',locale=app.request.getLocale()) }}
                </td>
                <td class="text-center">
                    {% if mm.containsTagWithCod('PUCHWEBTV') %}
                        <i class="fa-solid fa-check text-success"></i>
                    {% else %}
                        <i class="fa-solid fa-xmark text-danger"></i>
                    {% endif %}
                </td>
                <td class="text-center">
                    {% if mm.getEmbeddedBroadcast().getType() == 'public' %}
                        <i class="fa-solid fa-globe" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getEmbeddedBroadcast().getStringType() }}"></i>
                    {% elseif mm.getEmbeddedBroadcast().getType() == 'password' %}
                        <i class="fa-solid fa-unlock" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getEmbeddedBroadcast().getStringType() }}"></i>
                    {% elseif mm.getEmbeddedBroadcast().getType() == 'login' %}
                        <i class="fa-solid fa-user" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getEmbeddedBroadcast().getStringType() }}"></i>
                    {% elseif mm.getEmbeddedBroadcast().getType() == 'groups' %}
                        <i class="fa-solid fa-users" data-bs-toggle="tooltip" data-bs-placement="right" title="{{ mm.getEmbeddedBroadcast().getStringType() }}"></i>
                    {% endif %}
                </td>
                <td class="text-center">
                    <span>{{ mm.getNumview() }}</span>
                </td>
                <td data-action="click->admin--actions#openModal" data-admin--actions-url-param="{{ path('pumukitnewadmin_mms_modal_preview', {'id': mm.id}) }}">
                    <small><i class="fa-solid fa-play pmk-color-grey"></i></small>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="13">
                    {% trans %}There are no multimedia objects with those values.{% endtrans %}
                </td>
            </tr>
        {% endfor %}

        {% if 0 == mms|length %}
            {% set range = 1..9 %}
        {% elseif (mms|length - (mms.getMaxPerPage() * (mms.getCurrentPage() - 1))) < (mms.maxPerPage) %}
            {% set range = (mms|length - (mms.getMaxPerPage() * (mms.getCurrentPage() - 1)))..(mms.maxPerPage-1) %}
        {% else %}
            {% set range = [] %}
        {% endif %}

        {% for i in range %}
            <tr>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                {% if not is_naked() %}
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                {% endif %}
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
            </tr>
        {% endfor %}
        </tbody>
        <tfoot>
        <tr>
            <th colspan="18" class="foot-td">
                <div class="row pmk-margin-left-0 pmk-margin-right-0">
                    <div class="col-md-6">
                        {{ mms.getNbResults }} {% trans %}Mm. Obj.{% endtrans %}
                        {% if app.session.get('admin/playlistmms/criteria')|length != 0 %}
                            <a class="cancel-search-button pmk-color-blue pmk-font-weight-normal" title="{% trans %}Cancel current search{% endtrans %}" href="?criteria[reset]=true">{% trans %}Cancel search{% endtrans %}</a>
                        {% endif %}
                    </div>
                    <div class="col-md-6 text-end">
                        <div class="pagerfanta">
                            {% set pagerClass = 'twitter_bootstrap5' %}
                            {% set pagerStyles = {"css_container_class": "pagination pagination-sm", "next_message": "&raquo;", "prev_message": "&laquo;", "routeParams": {"id": playlist.id}, "routeName": "pumukitnewadmin_playlistmms_index"} %}
                            {% include "@PumukitNewAdmin/Misc/pager.html.twig" with {'objects' : mms, 'pagerClass': pagerClass, 'pagerStyles': pagerStyles} %}

                            {% if not is_naked() %}
                                <select data-action="change->admin--actions#go" data-admin--actions-url-param="{{ path('pumukitnewadmin_playlistmms_index') }}?page=1&paginate=" aria-label="{% trans %}Select the number of playlists to display per page.{% endtrans %}">
                                    <option {% if mms.maxPerPage == 10 %}selected{% endif %} value="10">10</option>
                                    <option {% if mms.maxPerPage == 20 %}selected{% endif %} value="20">20</option>
                                    <option {% if mms.maxPerPage == 50 %}selected{% endif %} value="50">50</option>
                                </select>
                            {% endif %}

                        </div>
                    </div>
                </div>
            </th>
        </tr>
        </tfoot>
    </table>
</div>
