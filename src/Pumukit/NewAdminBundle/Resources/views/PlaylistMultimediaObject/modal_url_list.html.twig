{% if mmobj %}
    <input class="pmk-display-none" type="checkbox" name="{{mmobj.id}}" id="modal-{{mmobj.id}}" checked="checked" disabled="disabled" value="{{mmobj.id}}"/>
    <h3>{{mmobj.title}} - {{mmobj.series.title}}</h3>
    <div class="pmk-display-block pmk-width-80pct pmk-margin-0-auto">
      {% set url_iframe = url('pumukit_videoplayer_index', {'id':mmobj.id, 'autostart':false}) %}
      <iframe src="{{url_iframe}}"
              id="paellaiframe"
              data-action="load->admin--playlist-modal#urlPlayerLoaded"
              frameborder="0"
              border="0"
              width="100%"
              height="200px"
              scrolling="no"
              allowfullscreen>
      </iframe>
    </div>
  </div>
{% else %}
  <b>
    {% trans %}There is no published Multimedia Object with the following id: {% endtrans %}
  </b>
  {{ mmobj_id }}
{% endif %}
