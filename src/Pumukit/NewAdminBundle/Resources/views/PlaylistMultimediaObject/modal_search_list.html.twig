<hr>
{% if noPerson is defined %}
<p class="alert alert-warning">{% trans %}Your user has no associated person, so its videos cannot be searched.{% endtrans %}</p>
{% else %}
<b>{{ (mmobjs.getNbResults <= 50)? mmobjs.getNbResults : 50 }} {% trans %}Mm. Obj.{% endtrans %}:</b>
<br>
<br>
<div class="row pmk-height-100pct pmk-overflow-auto">
  <br>
  {% for mmobj in mmobjs %}
    <div class="col-md-12 mmobj">
      <input class="pmk-display-none" type="checkbox" name="{{mmobj.id}}" id="modal-{{mmobj.id}}" value="{{mmobj.id}}"/>
      <label class="pmk-width-100pct" for="modal-{{mmobj.id}}">
        <div class="mmobj_elem">
          {% include "@PumukitNewAdmin/PlaylistMultimediaObject/modal_mmobj.html.twig" %}
        </div>
      </label>
    </div>
  {% endfor %}
</div>
{% endif %}
