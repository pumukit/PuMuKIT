<div class="modal-header">
  <h4 class="modal-title" id="myModalLabel">{% trans %}Add to playlist{% endtrans %}</h4>
  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body"
     data-controller="admin--playlist-add"
     data-admin--playlist-add-create-url-value="{{ path('pumukitnewadmin_playlist_create') }}"
     data-admin--playlist-add-add-url-value="{{ path('pumukitnewadmin_playlistmms_batch_add_to_several_playlist') }}"
     data-admin--playlist-add-messages-value="{{ {createError: 'Error creating playlist'|trans, addError: 'Error adding object to playlist'|trans}|json_encode }}">

  {% if multimediaObject %}
    {% trans with {'%title%': multimediaObject.title|default(ids) } %}Add the object "%title%" to the playlist{% endtrans %}:
  {% else %}
    {% trans with {'%num%': num_mm|default('') } %}Add %num% multimedia objects to the playlist{% endtrans %}::
  {% endif %}

  <div class="form-control-wrapper">

    <fieldset class="pmk-height-150 pmk-margin-bottom-25 pmk-overflow-y-scroll">
      <legend hidden>{% trans %}Add to playlist{% endtrans %}</legend>
      <form id="add_playlist_form" data-admin--playlist-add-target="playlists" data-action="change->admin--playlist-add#selected">
        {% for oneseries in series %}
          <div class="form-check" style="padding-top: 10px">
            <label>
              <input type="checkbox"
                     class="add_playlist_form_checkbox"
                     name="pub_{{oneseries.id}}"
                     id="{{ oneseries.id }}" />
              {{ oneseries.title }}
            </label>
          </div>
          {% else %}
          <p id="add_playlist_form_none" data-admin--playlist-add-target="none" class="text-muted pmk-margin-left-15">{% trans %}There are no playlist, please create one.{% endtrans %}</p>
        {% endfor %}
        <input type="hidden" id="add_playlist_form_ids" name="ids" value="{{ids}}" data-admin--playlist-add-target="ids"/>
        <input type="hidden" id="add_playlist_form_id" name="id" value="{{id}}" data-admin--playlist-add-target="id"/>
      </form>
    </fieldset>

    <div class="new_playlist">
      <a href="#" data-action="click->admin--actions#toggle" data-admin--actions-selectors-param="{{ ['.new_playlist']|json_encode }}">{% trans %}Create new playlist{% endtrans %}</a>
    </div>

    <div class="row new_playlist pmk-display-none" id="new_playlist_panel">
      <div id="" class="col-md-7">
        <form id="new_playlist_form" data-admin--playlist-add-target="newForm" data-action="submit->admin--playlist-add#createPlaylist">
          <fieldset>
            <div class="mb-3">
              <label class="form-label" for="title">{% trans  %}Title{% endtrans %}</label>
              {% for locale in locales %}
                <div class="input-group">
                  <input type="text" name="playlist_title[{{ locale }}]" class="new_playlist_form_title form-control" data-admin--playlist-add-target="title" data-action="input->admin--playlist-add#titles" placeholder="title {{locale}}"/>
                  <span class="input-group-text">{{ locale }}</span>
                </div>
              {% endfor %}
            </div>
          </fieldset>
        </form>
      </div>
    </div>

    <div class="modal-footer">
      <button disabled="disabled" id="new_playlist_btn" style="display:none" type="button" data-admin--playlist-add-target="create" data-action="click->admin--playlist-add#createPlaylist" class="new_playlist me-auto btn btn-secondary btn-primary">{% trans %}Create playlist{% endtrans %}</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Cancel{% endtrans %}</button>
      <button disabled="disabled" id="add_playlist_btn" type="submit" class="btn btn-pumukit" data-admin--playlist-add-target="ok" data-action="click->admin--playlist-add#save">{% trans %}OK{% endtrans %}</button>
    </div>

  </div>
</div>
