<div class="dropdown">
  <i class="fa-solid fa-bars" id="list_pics_mm_{{ mm.id }}" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></i>
  <ul class="dropdown-menu" role="menu" aria-labelledby="list_pics_mm_{{ mm.id }}">
    {% if is_mmobj_owner(app.user, mm) %}
    <li>
      <a class="dropdown-item" href="{{ path('pumukitnewadmin_mms_shortener', {'id': mm.id }) }}">
        <i class="fa-solid fa-pencil"></i>{% trans %}Edit multimedia object{% endtrans %}
      </a>
    </li>
    {% endif %}
    <li>
      <a class="dropdown-item" href="#" data-action="click->admin--playlist-mms#remove" data-admin--playlist-mms-id-param="{{ mm.id|json_encode }}" data-admin--playlist-mms-pos-param="{{ mm_pos }}">
        <i class="fa-solid fa-xmark"></i>{% trans %}Delete multimedia object from the playlist{% endtrans %}
      </a>
    </li>
    <li>
      <a class="dropdown-item" href="#" data-action="click->admin--actions#cancel">
        <strong>{% trans %}Cancel{% endtrans %}...</strong>
      </a>
    </li>
  </ul>
</div>
