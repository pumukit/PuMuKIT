{% if app.request.session.has('seriesstyle/msg') %}
    <p id="series_style_msg" class="alert alert-warning">{{ app.request.session.get('seriesstyle/msg') }}</p>
{% endif %}

<p>{% trans %}Choose style{% endtrans %}:</p>
<ul class="list-group">
    {% for style in styles %}
        <li class="list-group-item" style="padding:10px 15px; background-color:#fff; border: 1px solid #ddd">
            <a class="show_style" data-action="click->admin--series-styles#show" data-admin--series-styles-id-param="{{ style.getId()|json_encode }}" style="text-decoration:none;cursor:pointer;">{{ style.getName() }}</a>
            <a href="#" data-action="click->admin--series-styles#remove" data-admin--series-styles-url-param="{{ path('pumukit_newadmin_series_styles_delete', {'id' : style.getId() })|json_encode }}" class="pull-right delete_style" style="text-decoration:none;cursor:pointer;">
                <i class="mdi-content-clear"></i>
            </a>
        </li>
    {% else %}
        <li class="list-group-item">
            <p class="text-warning">{% trans %}There aren't defined styles{% endtrans %}</p>
        </li>
    {% endfor %}
</ul>

<div class="col-xs-12">
    <p>Crear un estilo:</p>
    <form id="styleform" method="GET" action="{{ path('pumukit_newadmin_series_styles_create') }}" class="form-inline" data-action="submit->admin--series-styles#create">
        <div class="form-group">
            <input type="text" name="name" class="form-control"/>
        </div>
        <button type="submit" class="btn btn-pumukit btn-raised">{% trans %}New{% endtrans %}</button>
    </form>
</div>
