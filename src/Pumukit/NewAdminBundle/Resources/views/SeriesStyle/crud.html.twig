{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block body %}

    <h3 class="cab_body_div">
        <ul class="breadcrumb pmk-margin-bottom-5">
            <li class="active breadcrumb-item">{% trans %}Series style{% endtrans %}</li>
        </ul>
    </h3>

    <div class="pmk-well" data-controller="admin--series-styles"
         data-admin--series-styles-urls-value="{{ {
             list: path('pumukit_newadmin_series_styles_list'),
             create: path('pumukit_newadmin_series_styles_create'),
             edit: path('pumukit_newadmin_series_styles_edit'),
             show: path('pumukit_newadmin_series_styles_show', {'id': '__ID__'}),
             empty: path('pumukit_newadmin_series_styles_show')
         }|json_encode }}"
         data-admin--series-styles-messages-value="{{ {
             created: 'Style created OK'|trans,
             createError: 'Style created ERROR'|trans,
             editError: 'Style edited ERROR'|trans
         }|json_encode }}">
        <div class="row">
            <div id="style_list" class="col-md-3">
                {{ render(controller('Pumukit\\NewAdminBundle\\Controller\\SeriesStylesController::listAction')) }}
            </div>
            <div id="style_show" class="col-md-9">
                {% if app.session.get('seriesstyle/id') is defined and app.session.get('seriesstyle/id') is not empty %}
                    {{ render(controller('Pumukit\\NewAdminBundle\\Controller\\SeriesStylesController::showAction', {'id' : app.session.get('seriesstyle/id') } )) }}
                {% endif %}
            </div>
        </div>
    </div>

{% endblock %}
