<div class="modal-header">
    <p>
        {% trans %}Add the name of the person you want to add. In case this person already exists in the database, a pull-down list will be shown, where you can select him/her and
        <strong>use him/her</strong>. If he/she doesn't exist in the database,
        <strong>create</strong> a new entrance with the written name{% endtrans %}.
    </p>
</div>
<div class="modal-body"
     data-controller="admin--person-picker"
     data-admin--person-picker-autocomplete-url-value="{{ path('pumukitnewadmin_person_auto_complete', {'mmId': mm.id, 'roleId': role.id}) }}"
     data-admin--person-picker-link-url-value="{{ path('pumukitnewadmin_person_link', {'id': '__personId__', 'roleId': role.id, 'mmId': mm.id, 'owner': owner}) }}"
     data-admin--person-picker-create-url-value="{{ path('pumukitnewadmin_person_create_relation', {'mmId': mm.id, 'roleId': role.id, 'name': '__aux__', 'owner': owner}) }}"
     data-admin--person-picker-target-value="#{{ role.id }}_person_mms{{ template }}"
     data-admin--person-picker-preview-value="{{ template != '_template' ? path('pumukitnewadmin_mms_show', {'id': mm.id}) : '' }}"
     data-admin--person-picker-modal-value="#myAuxModal{{ template }}"
     data-admin--person-picker-messages-value="{{ {linked: 'Person successfully associated to Multimedia Object'|trans ~ ' \'' ~ mm.getTitle() ~ '\' ' ~ 'with role'|trans ~ ' \'' ~ role.getName() ~ '\'', selectFirst: 'Select before a person'|trans}|json_encode }}">
    {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) %}
        <fieldset>
            <legend hidden>{% trans %}Search person{% endtrans %}</legend>
            <div class="mb-3">
                <label for="name" class="form-label">{% trans %}Name{% endtrans %}:</label>
                <input type="text" name="name" id="name" placeholder="{% trans %}name to search for{% endtrans %}" class="form-control" data-admin--person-picker-target="name" data-action="input->admin--person-picker#clear"/>
                <span id="indicator1" class="input-group-text pmk-display-none"><img alt="{% trans %}working{% endtrans %}..." src="{{ asset('bundles/pumukitnewadmin/images/admin/load/spinner.gif') }}" height="18" width="18"></span>
                <input type="hidden" name="person_id" value="" id="person_id" data-admin--person-picker-target="person"/>
            </div>
        </fieldset>
        <div class="modal-footer">
            {% if ldap_enabled  and role.cod != personal_scope_role_code %}
                {{ render(controller('Pumukit\\LDAPBundle\\Controller\\PersonController::buttonAction', {'mmId': mm.id, 'roleId': role.id})) }}
            {% endif %}
            <button type="button" class="btn btn-primary" data-action="click->admin--person-picker#use">
                {% trans %}Use{% endtrans %}
            </button>
            {% if app.user and ((role.cod != personal_scope_role_code) and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_PEOPLE'))) or ((role.cod == personal_scope_role_code) and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::MODIFY_OWNER'))) %}
                <button type="button" class="btn btn-pumukit" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-dismiss="modal" data-bs-target="#myModal"
                        id="create_relation" href="#" data-admin--person-picker-target="create" data-action="click->admin--person-picker#create">
                    {% trans %}New{% endtrans %}
                </button>
            {% endif %}
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Cancel{% endtrans %}</button>
        </div>
    {% else %}
        {% trans %}You don't have enough permissions to access this content.{% endtrans %}
    {% endif %}
</div>

<div class="pmk-clear-right"></div>

