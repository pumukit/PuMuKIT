{% set sorting = {('sorting[' ~ (app.session.get('admin/person/sort')) ~ ']') : (app.session.get('admin/person/type')) } %}

<div class="table-responsive">
    {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_PEOPLE')) %}
        <input type="hidden" name="pumukitnewadmin_person_sort_change_type" id="pumukitnewadmin_person_sort_change_type" value="{{ app.session.get('admin/person/type')=='asc'?'desc':'asc' }}"/>
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    {% include '@PumukitNewAdmin/Person/listth.html.twig' %}
                </tr>
            </thead>

            <tbody>
            {% if people|length == 0 %}
                <tr>
                    <td colspan="9" headers="th-checkbox th-icons th-icons th-id th-name th-email th-phone th-mm">
                        {% trans %}There are no people with those values.{% endtrans %}
                    </td>
                </tr>
            {% endif %}

            {% for person in people %}
                {% set urlShowPerson = path('pumukitnewadmin_person_show', {'id': person.id}) %}
                <tr>
                    <td headers="th-checkbox">
                        <div class="form-check">
                            <label>
                                <input id="{{ person.id }}" class="person_checkbox" type="checkbox" size="1">
                            </label>
                        </div>
                    </td>
                    <td headers="th-icons">
                        <a title="{% trans %}Edit Person{% endtrans %} {{ person.getHName() }}" href="{{ path('pumukitnewadmin_person_update', {'id': person.id}) }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">
                            <i class="fa-solid fa-pencil"></i>
                        </a>
                    </td>
                    <td headers="th-icons">
                        {% if app.user and not is_granted('ROLE_SCOPE_GLOBAL') %}
                            <i title="{% trans %}You don't have enough permissions to access this content.{% endtrans %}" class="fa-solid fa-ban pmk-color-009587"></i>
                        {% elseif person.getUser() %}
                            <i title="{% trans %}Can't delete Person{% endtrans %} '{{ person.name }}'. {% trans %}There is a referenced User{% endtrans %}." class="fa-solid fa-ban pmk-color-009587"></i>
                        {% elseif countMmPeople[person.id] != 0 %}
                            <i title="{% trans %}Cannot delete the data of{% endtrans %} '{{ person.name }}'. '{{ countMmPeople[person.id] }}' {% trans %}multimedia object(s) contain(s) this person{% endtrans %}." class="fa-solid fa-ban pmk-color-009587"></i>
                        {% else %}
                            <a href="#" title="Delete Person '{{ person.name }}'" data-action="click->admin--actions#remove"
                               data-admin--actions-url-param="{{ path('pumukitnewadmin_person_delete', {'id': person.id}) }}"
                               data-admin--actions-target-param="#list_people"
                               data-admin--actions-confirm-param="{{ 'Are you sure you want to delete the data of'|trans }} {{ person.getHName() }}?"
                               data-admin--actions-success-param="{{ 'Person'|trans }} &quot;{{ person.getHName() }}&quot; {{ 'successfully deleted.'|trans }}"
                               data-admin--actions-error-param="{{ 'Error deleting Person'|trans }} &quot;{{ person.getHName() }}&quot;">
                                <i class="fa-solid fa-xmark"></i>
                            </a>
                        {% endif %}
                    </td>
                    <td headers="th-name" data-action="click->admin--actions#preview" data-admin--actions-name-param="person" data-admin--actions-url-param="{{ urlShowPerson }}">
                        <span class="pmk-color-gray">{{ person.getHonorific() }}</span> {{ person.getName() }}
                    </td>
                    <td headers="th-post" data-action="click->admin--actions#preview" data-admin--actions-name-param="person" data-admin--actions-url-param="{{ urlShowPerson }}">
                        {{ person.getPost() }}
                    </td>
                    <td headers="th-email" data-action="click->admin--actions#preview" data-admin--actions-name-param="person" data-admin--actions-url-param="{{ urlShowPerson }}">
                        {{ person.getEmail() }}
                    </td>
                    <td headers="th-phone" data-action="click->admin--actions#preview" data-admin--actions-name-param="person" data-admin--actions-url-param="{{ urlShowPerson }}">
                        {{ person.getPhone() }}
                    </td>
                    <td headers="th-mm" data-action="click->admin--actions#preview" data-admin--actions-name-param="person" data-admin--actions-url-param="{{ urlShowPerson }}">
                        {{ countMmPeople[person.id] }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="9" class="foot-td">
                        {% set column = ((people.getNbPages/5)|round(0, 'floor')) %}
                        <div class="row"><div class="col-md-8">
                            {{ people.getNbResults }}
                            {{ "{0} people|{1} person|]1,Inf] people"|trans({'%count%':  people.getNbResults}) }}
                            {% if app.session.get('admin/person/criteria')|length != 0 %}
                                <a class="cancel-search-button pmk-color-blue pmk-font-weight-normal" title="{% trans %}Cancel current search{% endtrans %}" href="?criteria[reset]=true">{% trans %}Cancel search{% endtrans %}</a>
                            {% endif %}
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="pagerfanta">
                                {% set pagerClass = 'twitter_bootstrap5' %}
                                {% set pagerStyles = {"css_container_class": "pagination pagination-sm", "next_message": "&raquo;", "prev_message": "&laquo;", "routeName": "pumukitnewadmin_person_index", "routeParams": sorting} %}
                                {% include "@PumukitNewAdmin/Misc/pager.html.twig" with {'objects' : people, 'pagerClass': pagerClass, 'pagerStyles': pagerStyles} %}

                            </div>
                        </div></div>
                    </td>
                </tr>
            </tfoot>
        </table>
    {% else %}
        {% trans %}You don't have enough permissions to access this content.{% endtrans %}
    {% endif %}
</div>
