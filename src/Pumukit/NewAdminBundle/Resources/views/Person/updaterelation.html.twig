<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span>
    </button>
    <h4 class="modal-title" id="myAuxModal{{ template }}Label">{% trans %}edit person{% endtrans %}</h4>
</div>
<div class="modal-body">
    {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_PEOPLE')) %}
        <form action="{{ path('pumukitnewadmin_person_update_relation', {'id': person.id, 'roleId': role.id, 'mmId': mm.id, 'owner': owner}) }}"
              data-controller="admin--modal-form" data-action="submit->admin--modal-form#submit"
              data-admin--modal-form-target-value="#{{ role.id }}_person_mms{{ template }}"
              data-admin--modal-form-modal-value="#myAuxModal{{ template }}"
              data-admin--modal-form-refresh-value="{{ (template != '_template' ? [{target: '#preview_mm', url: path('pumukitnewadmin_mms_show', {'id': mm.id})}] : [])|json_encode }}"
              data-admin--modal-form-success-message-value="{{ 'Person associated to Multimedia Object'|trans }} '{{ mm.getTitle() }}' {{ 'with role'|trans }} '{{ role.getName() }}' {{ 'successfully updated'|trans }}."
              method="POST">
            {% form_theme form '@PumukitNewAdmin/Themes/fields.html.twig' %}
            <input type="hidden" name="id" id="person_id_update" value="{{ person.id }}">
            <fieldset>
                {% for child in form %}
                    {{ form_row(child) }}
                {% endfor %}
            </fieldset>
            <div class="modal-footer">
                <button type="button" class="btn btn-default btn-raised" data-dismiss="modal">{% trans %}Cancel{% endtrans %}</button>
                <button type="submit" class="btn btn-pumukit btn-raised">{% trans %}Save changes{% endtrans %}</button>
            </div>
        </form>
    {% else %}
        {% trans %}You don't have enough permissions to access this content.{% endtrans %}
    {% endif %}
</div>
