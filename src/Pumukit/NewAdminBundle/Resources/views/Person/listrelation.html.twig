{% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_PEOPLE')) %}
    <table>
        <tbody>
        {% for person in people %}
            <tr>
                <td>
                    <ul>
                        <li></li>
                    </ul>
                </td>
                {% if ((role.getCod() == personal_scope_role_code) and app.user and not is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::MODIFY_OWNER'))) %}
                    <td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td>
                    <td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td>
                    <td>&nbsp;&nbsp;</td>
                    <td>&nbsp;&nbsp;</td>
                {% else %}
                    <td>
                        <a title="{% trans %}Edit Person{% endtrans %} '{{ person.getHName() }}'" href="{{ path('pumukitnewadmin_person_update_relation', {'id': person.id, 'roleId': role.id, 'mmId': mm.id}) }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-dismiss="modal" data-bs-target="#myAuxModal{{ template }}">
                            <i class="fa-solid fa-pencil"></i>
                        </a>
                    </td>
                    <td>
                        <a href="#" data-action="click->admin--actions#remove"
                           data-admin--actions-url-param="{{ path('pumukitnewadmin_person_delete_relation', {'id': person.id, 'roleId': role.id, 'mmId': mm.id, 'owner': false}) }}"
                           data-admin--actions-target-param="#{{ role.id }}_person_mms{{ template }}"
                           data-admin--actions-refresh-param="{{ [{target: '#preview_mm', url: path('pumukitnewadmin_mms_show', {'id': mm.id})}]|json_encode }}"
                           data-admin--actions-confirm-param="{{ 'Are you sure you want to delete the relation of'|trans }} {{ person.getHName() }}?"
                           data-admin--actions-success-param="{{ 'Person successfully removed from Multimedia Object'|trans }}"
                           data-admin--actions-error-param="{{ 'Error deleting Person'|trans }} &quot;{{ person.getHName() }} from MultimediaObject&quot;">
                            <i class="fa-solid fa-xmark"></i>
                        </a>
                    </td>
                    <td>
                        {% if loop.first %}
                            &nbsp;&nbsp;
                        {% else %}
                            <a href="#" data-action="click->admin--actions#load"
                               data-admin--actions-url-param="{{ path('pumukitnewadmin_person_up', {'id': person.id, 'roleId': role.id, 'mmId': mm.id}) }}"
                               data-admin--actions-data-param="{{ {'_method': 'POST'}|json_encode }}"
                               data-admin--actions-target-param="#{{ role.id }}_person_mms{{ template }}">&#8593;</a>
                        {% endif %}
                    </td>
                    <td>
                        {% if loop.last %}
                            &nbsp;&nbsp;
                        {% else %}
                            <a href="#" data-action="click->admin--actions#load"
                               data-admin--actions-url-param="{{ path('pumukitnewadmin_person_down', {'id': person.id, 'roleId': role.id, 'mmId': mm.id}) }}"
                               data-admin--actions-data-param="{{ {'_method': 'POST'}|json_encode }}"
                               data-admin--actions-target-param="#{{ role.id }}_person_mms{{ template }}">&#8595;</a>
                        {% endif %}
                    </td>
                {% endif %}
                <td>&nbsp;{% if not is_naked() %}{{ person.id }} - {% endif %}{{ person.getHName() }}</td>
            </tr>
        {% endfor %}
        {% if not ((role.getCod() == personal_scope_role_code) and app.user and not is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::MODIFY_OWNER'))) %}
            <tr>
                <td>
                    <ul>
                        <li></li>
                    </ul>
                </td>
                <td colspan="6">
                    <a title="{% trans %}Create{% endtrans %} {{ role.getName() }}"
                       class="new_person_relation new_person_relation_{{ role.getCod() }}"
                       href="{{ path('pumukitnewadmin_person_list_autocomplete', {'roleId': role.id, 'mmId': mm.id}) }}"
                       data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myAuxModal{{ template }}">
                        {% trans %}new{% endtrans %}...
                    </a>
                </td>
            </tr>
        {% endif %}
        </tbody>
    </table>
{% else %}
    {% trans %}You don't have enough permissions to access this content.{% endtrans %}
{% endif %}
