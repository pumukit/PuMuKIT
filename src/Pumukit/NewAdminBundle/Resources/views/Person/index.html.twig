{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block body %}

    <h3 class="cab_body_div">
        <ul class="breadcrumb pmk-margin-bottom-5">
            <li class="active breadcrumb-item">{% trans %}People{% endtrans %}</li>
        </ul>
    </h3>

    <div class="row">
        {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_PEOPLE')) %}
            <div class="col-md-10">
                <div class="pmk-well">
                    <div id="list_people">
                        {% include '@PumukitNewAdmin/Person/list.html.twig' %}
                    </div>
                    <div class="row">
                        <div class="col-4">
                            <select id="options_people" class="form-select" title="{% trans %}Actions on selected items{% endtrans %}" data-controller="admin--batch" data-action="change->admin--batch#run"
                                    data-admin--batch-name-value="person" data-admin--batch-plural-value="people"
                                    data-admin--batch-urls-value="{{ {delete: path('pumukitnewadmin_person_batch_delete', {'ids': '__ids__'})}|json_encode }}"
                                    data-admin--batch-messages-value="{{ {confirm: 'Are you sure?'|trans, success: 'People ' ~ 'successfully deleted.'|trans}|json_encode }}">
                                <option value="default" selected="selected">{% trans %}Select an action...{% endtrans %}</option>
                                <option disabled="">---</option>
                                <option value="delete_selected">{% trans %}Delete selected{% endtrans %}</option>
                            </select>
                        </div>
                        <div class="col-8 text-end">
                            <a href="{{ path('pumukitnewadmin_person_create') }}" class="btn btn-pumukit btn-create-person" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">{% trans %}New{% endtrans %}</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-2 d-none d-md-block">
                {% include '@PumukitNewAdmin/Person/filters.html.twig' %}
                <div id="preview_person" class="pmk-well">
                    {% if(app.session.has('admin/person/id')) %}
                        <div data-controller="admin--include" data-admin--include-src-value="{{ url('pumukitnewadmin_person_show', {'id': app.session.get('admin/person/id')}) }}"></div>
                    {% else %}
                        {% trans %}Select any person.{% endtrans %}
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="col-md-12">
                <div class="pmk-well">
                    {% trans %}You don't have enough permissions to access this content.{% endtrans %}
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
