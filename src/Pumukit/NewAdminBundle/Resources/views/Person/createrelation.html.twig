<div class="modal-header">
    <h4 class="modal-title" id="myAuxModal{{ template }}Label">{% trans %}create new person{% endtrans %}</h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_PEOPLE')) %}
        <form action="{{ path('pumukitnewadmin_person_create_relation', {'id': person.id, 'roleId': role.id, 'mmId': mm.id, 'owner': owner}) }}"
              data-controller="admin--modal-form" data-action="submit->admin--modal-form#submit"
              data-admin--modal-form-target-value="#{{ role.id }}_person_mms{{ template }}"
              data-admin--modal-form-modal-value="#myModal"
              data-admin--modal-form-refresh-value="{{ (template != '_template' ? [{target: '#preview_mm', url: path('pumukitnewadmin_mms_show', {'id': mm.id})}] : [])|json_encode }}"
              data-admin--modal-form-success-message-value="{{ 'Person successfully associated to Multimedia Object'|trans }} '{{ mm.getTitle() }}' {{ 'with role'|trans }} '{{ role.getName() }}'"
              method="POST">
            {% form_theme form '@PumukitNewAdmin/Themes/fields.html.twig' %}
            <input type="hidden" name="id" id="person_id" value="{{ person.id }}">
            <input type="hidden" name="roleId" id="roleId" value="{{ role.id }}">
            <input type="hidden" name="mmId" id="mmId" value="{{ mm.id }}">
            <fieldset>
                {% for child in form %}
                    {{ form_row(child) }}
                {% endfor %}
            </fieldset>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Close{% endtrans %}</button>
                <button type="submit" class="btn btn-pumukit">{% trans %}Save changes{% endtrans %}</button>
            </div>
        </form>
    {% else %}
        {% trans %}You don't have enough permissions to access this content.{% endtrans %}
    {% endif %}
</div>
