<div class="table-responsive">
  {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_GROUPS')) %}
  <input type="hidden" name="pumukitnewadmin_group_sort_change_type" id="pumukitnewadmin_group_sort_change_type" value="{{ app.session.get('admin/group/type')=='asc'?'desc':'asc' }}"/>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th width="1%" id="th-checkbox">
          <div class="form-check">
            <label>
              <input type="checkbox" data-action="click->admin--actions#checkAll" data-admin--actions-name-param="group">
            </label>
          </div>
        </th>
        <th colspan="3" width="5%" id="th-icons"></th>
        {% include '@PumukitNewAdmin/Group/listth.html.twig' %}
      </tr>
    </thead>

    <tbody>
      {% if groups|length == 0 %}
      <tr>
        <td colspan="11" headers="th-checkbox th-icons th-icons th-icons th-key th-name th-origin th-comments">
          {% trans %}There are no groups with those values.{% endtrans %}
        </td>
      </tr>
      {% endif %}

      {% for group in groups %}
      <tr>
        <td headers="th-checkbox">
          <div class="form-check">
            <label>
              <input id="{{ group.id }}" class="group_checkbox" type="checkbox" size="1">
            </label>
          </div>
        </td>
        <td headers="th-icons">
          {% if group.isLocal() %}
          <a title="{% trans %}Edit Group{% endtrans %} {{ group.getName() }}" href="{{ path('pumukitnewadmin_group_update', {'id': group.id}) }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">
            <i class="fa-solid fa-pencil"></i>
          </a>
          {% else %}
          <i data-bs-toggle="tooltip" data-bs-placement="right" title="{% trans %}External defined groups can not be edited here, contact your directory service administrator.{% endtrans %}" class="fa-solid fa-pencil pmk-color-grey-i"></i>
          {% endif %}
        </td>
        <td headers="th-icons">
          <a title="{% trans %}Delete Group{% endtrans %}" href="{{ path('pumukitnewadmin_group_info', {'id': group.id, 'action': true}) }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">
            <i data-bs-toggle="tooltip" data-bs-placement="right" title="{% trans %}Delete Group or Group relations{% endtrans %}" class="fa-solid fa-xmark"></i>
          </a>
        </td>
        <td headers="th-icons">
          <a title="{% trans %}Group Info{% endtrans %}" href="{{ path('pumukitnewadmin_group_info', {'id': group.id, 'action': false}) }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">
            <i class="fa-solid fa-circle-info"></i>
          </a>
        </td>
        <td headers="th-key">
          {{ group.getKey()[:10] }}{% if ((group.getKey()|length) > 10 ) %}...{% endif %}
        </td>
        <td headers="th-name">
          {{ group.getName()[:20] }}{% if ((group.getName()|length) > 20 ) %}...{% endif %}
        </td>
        <td headers="th-origin">
          {{ group.getOrigin() }}
        </td>
        <td headers="th-comments">
          {{ group.getComments()[:150] }}{% if ((group.getComments()|length) > 150 ) %}...{% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
    <tfoot>
      <tr>
        <td colspan="9" class="foot-td">
            {% set column = ((groups.getNbPages/5)|round(0, 'floor')) %}
            <div class="row"><div class="col-md-8">
              {{ groups.getNbResults }}
                {{ "{0} groups|{1} group|]1,Inf] groups"|trans({'%count%': groups.getNbResults}) }}
	          {% if app.session.get('admin/group/criteria')|length != 0%}
              <a class="cancel-search-button pmk-color-blue pmk-font-weight-normal" title="{% trans %}Cancel current search{% endtrans %}" href="?criteria[reset]=true" >{% trans %}Cancel search{% endtrans %}</a>
	          {% endif %}
            </div>
            <div class="col-md-4 text-end">
              <div class="pagerfanta">
                {% set sorting = {('sorting[' ~ (app.session.get('admin/group/sort')) ~ ']') : (app.session.get('admin/group/type')) } %}

                  {% set pagerClass = 'twitter_bootstrap5' %}
                  {% set pagerStyles = {"css_container_class": "pagination pagination-sm", "next_message": "&raquo;", "prev_message": "&laquo;", "routeName": "pumukitnewadmin_group_index", "routeParams": sorting} %}
                  {% include "@PumukitNewAdmin/Misc/pager.html.twig" with {'objects' : groups, 'pagerClass': pagerClass, 'pagerStyles': pagerStyles} %}
              </div>
            </div></div>
        </td>
      </tr>
    </tfoot>
  </table>
  {% else %}
    {% trans %}You don't have enough permissions to access this content.{% endtrans %}
  {% endif %}
</div>
