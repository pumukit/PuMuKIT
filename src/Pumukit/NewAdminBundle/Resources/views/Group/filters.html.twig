<!-- Filter -->
<div class="pmk-well">
    <form id="filter_groups" data-controller="admin--filter-form" data-action="submit->admin--filter-form#submit" data-admin--filter-form-url-value="{{ path('pumukitnewadmin_group_list') }}" data-admin--filter-form-target-value="#list_groups" data-admin--filter-form-letters-value=".pmk-group-letter" action="{{ path('pumukitnewadmin_group_list') }}" method="post">
        <fieldset>
            <legend hidden>{% trans %}Filter Groups{% endtrans %}</legend>
            <div id="accordion" role="tablist" aria-roledescription="tablist" aria-multiselectable="true">
                <div class="card">
                    <div class="card-header" role="tab" id="headingSearch">
                        <h2 class="card-title mb-0">
                            <a class="d-block" data-bs-toggle="collapse" href="#collapseSearch" aria-expanded="true" aria-controls="collapseSearch">
                                <i class="fa-solid fa-bars float-end"></i>
                                {% trans %}Search{% endtrans %}
                            </a>
                        </h2>
                    </div>
                    <div id="collapseSearch" data-bs-parent="#accordion" class="panel-collapse collapse show" role="tabpanel" aria-labelledby="headingSearch">
                        <div class="card-body">

                            <div class="mb-3">
                                <label for="filters_key" class="form-label">{% trans %}Key{% endtrans %}:</label>
                                {% set criteria = app.session.get('admin/group/criteria') %}
                                <div>
                                    <input type="text" class="reset form-control" name="criteria[key]" id="filters_key" value="{{ criteria['key']|default("") }}">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="filters_name" class="form-label">{% trans %}Name{% endtrans %}:</label>

                                <div>
                                    <input type="text" class="reset form-control" name="criteria[name]" id="filters_name" value="{{ criteria['name']|default("") }}">
                                </div>
                            </div>

                            {% if origins|length > 1 %}
                                <div class="mb-3">
                                    <label for="filters_origin" class="form-label">{% trans %}Origin{% endtrans %}:</label>
                                    <div>
                                        <select class="form-select" name="criteria[origin]" id="filters_origin">
                                            <option value="all" {% if criteria is null or criteria['origin'] == 'all' %}selected="selected"{% endif %}>{% trans %}All{% endtrans %}</option>
                                            {% for origin in origins %}
                                                <option value="{{ origin }}" {% if criteria and criteria['origin'] == origin %}selected="selected"{% endif %}>{{ origin }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

        </fieldset>

        <div class="text-end">
            <input class="btn btn-secondary" data-action="click->admin--filter-form#reset" type="button" value="{% trans %}reset{% endtrans %}">
            <input class="btn btn-pumukit" type="submit" name="filter" value="{% trans %}filter{% endtrans %}">
        </div>
    </form>
</div>
