<div data-controller="admin--group-info"
     data-admin--group-info-delete-url-value="{{ path('pumukitnewadmin_group_delete', {'id': group.id}) }}"
     data-admin--group-info-check-url-value="{{ path('pumukitnewadmin_group_can_be_deleted', {'id': group.id}) }}"
     data-admin--group-info-name-value="{{ group.getName() }}"
     data-admin--group-info-delete-message-value="{{ delete_group_message }}"
     data-admin--group-info-can-delete-value="{{ can_delete ? 'true' : 'false' }}"
     data-admin--group-info-messages-value="{{ {error: 'Error deleting Group'|trans, group: 'Group'|trans, deleted: 'successfully deleted.'|trans}|json_encode }}">
<div class="modal-header">
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    {% if action %}
        <h4 class="modal-title" id="myModalLabel">{% trans %}group deletion{% endtrans %}</h4>
    {% else %}
        <h4 class="modal-title" id="myModalLabel">{% trans %}group info{% endtrans %}</h4>
    {% endif %}
    <div class="row"><div class="col-md-12">
        <h2 class="modal-title pumukitnewadmin-trim-row">&laquo;{{ group.getName() }}&raquo;</h2>
        <input type="hidden" name="pumukitnewadmin_group_id" id="pumukitnewadmin_group_id" value="{{ group.id }}">
    </div></div>
</div>
<div class="modal-body">
    <div class="row"><div class="col-md-4">
        <div id="group_users" class="card pmk-margin-top-20">
            {% include '@PumukitNewAdmin/Group/inforesources.html.twig' with {'resources': users, 'title': 'USERS'|trans, 'resource_name': 'user', 'count': countResources['users']} %}
        </div>
    </div>
    <div class="col-md-4">
        <div id="group_mms" class="card pmk-margin-top-20">
            {% include '@PumukitNewAdmin/Group/inforesources.html.twig' with {'resources': admin_multimedia_objects, 'title': 'ADMIN MULTIMEDIA OBJECTS'|trans, 'resource_name': 'multimediaobject', 'count': countResources['adminMultimediaObjects']} %}
        </div>
    </div>
    <div class="col-md-4">
        <div id="group_broadcasts" class="card pmk-margin-top-20">
            {% include '@PumukitNewAdmin/Group/inforesources.html.twig' with {'resources': viewer_multimedia_objects, 'title': 'PLAY MULTIMEDIA OBJECTS'|trans, 'resource_name': 'embeddedbroadcast', 'count': countResources['playMultimediaObjects']} %}
        </div>
    </div></div>
    <div class="modal-footer">
        {% if action %}
            <button type="button" class="btn btn-secondary"
                    data-bs-dismiss="modal">{% trans %}Cancel{% endtrans %}</button>
            <button id="pumukitnewadmin_group_delete" type="submit" class="btn btn-pumukit"
                    data-action="click->admin--group-info#deleteGroup">{% trans %}Delete Group{% endtrans %}</button>
        {% else %}
            <button type="button" class="btn btn-secondary"
                    data-bs-dismiss="modal">{% trans %}Close{% endtrans %}</button>
        {% endif %}
    </div>
</div>
</div>
