<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">{% trans %}Job info{% endtrans %}</h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) %}
        <div class="box-body">
            <dl class="row">
                <dt class="col-sm-3">{% trans %}Id{% endtrans %}</dt>
                <dd class="col-sm-9">{{ job.id }}</dd>
                <dt class="col-sm-3">{% trans %}Status{% endtrans %}</dt>
                <dd class="col-sm-9 job-status-{{ job.status }}">{{ job.statusText }} <small>[{{ job.status }}]</small></dd>
                <dt class="col-sm-3">{% trans %}Mm{% endtrans %}</dt>
                <dd class="col-sm-9">{{ job.getMmId() }}</dd>
                <dt class="col-sm-3">{% trans %}Profile{% endtrans %}</dt>
                <dd class="col-sm-9">{{ job.getProfile() }}</dd>
                <dt class="col-sm-3">{% trans %}Cpu{% endtrans %}</dt>
                <dd class="col-sm-9">{{ job.getCpu() }}</dd>
                <dt class="col-sm-3">{% trans %}Duration{% endtrans %}</dt>
                <dd class="col-sm-9">
                    {% trans %}Before{% endtrans %}: {{ job.duration|duration_string }}, {% trans %}after{% endtrans %}
                    : {{ job.getNewDuration()|duration_string }}
                </dd>
                <dt class="col-sm-3">{% trans %}Times{% endtrans %}</dt>
                <dd class="col-sm-9">
                    {% trans %}Created{% endtrans %}
                    : {{ job.getTimeini('Y-m-d H:i:s')| format_datetime('medium','medium',locale=app.request.getLocale()) }}
                    , {% trans %}started{% endtrans %}
                    : {{ job.getTimestart()| format_datetime('medium','medium',app.request.getLocale()) }}
                    , {% trans %}finished{% endtrans %}
                    : {{ job.getTimeend()| format_datetime('medium','medium',app.request.getLocale()) }}
                </dd>
                <dt class="col-sm-3">{% trans %}Priority{% endtrans %}</dt>
                <dd{% if job.isPending() %} data-controller="admin--job-priority"
                    data-admin--job-priority-url-value="{{ path('pumukitnewadmin_track_update_job', {'mmId': multimediaObject.Id}) }}"
                    data-admin--job-priority-job-value="{{ job.id }}"{% endif %}>
                    {% if job.isPending() %}
                        <span id="job_info_priority_show" class="job_info_priority" data-admin--job-priority-target="show">
                            <span id="job_info_priority_show_val" data-admin--job-priority-target="value">{{ job.getPriority() }}</span>
                            <a href="#" data-action="click->admin--job-priority#toggle" title="{% trans %}Edit priority{% endtrans %}">
                                <i class="fa-solid fa-pencil"></i>
                            </a>
                        </span>
                        <span id="job_info_priority_edit" class="job_info_priority pmk-display-none" data-admin--job-priority-target="edit">
                            <input type="number" max="3" min="1" value="{{ job.getPriority() }}" id="job_info_priority_edit_input" data-admin--job-priority-target="input"/>
                            <a href="#"
                                data-action="click->admin--job-priority#save"
                                title="{% trans %}Edit priority{% endtrans %}">
                                <i class="fa-solid fa-floppy-disk"></i>
                            </a>
                        </span>
                    {% else %}
                        {{ job.getPriority() }}
                    {% endif %}
                </dd>
            </dl>

            <div class="shell-wrap">
                <p class="shell-top-bar">{% trans %}Output Command{% endtrans %}</p>
                <ul class="shell-body">
                    <li class="command">{{ command|replace({' ':'&nbsp;', '\n': '</li><li class="command">'})|raw }}</li>
                    <li>&nbsp;</li>
                    <li>{{ job.getOutput()|replace({' ':'&nbsp;', '\n': '</li><li>'})|raw }}</li>
                    {% if constant('STATUS_EXECUTING', job) == job.getStatus() %}
                        <li>executing...</li>
                    {% endif %}
                    {% if constant('STATUS_WAITING', job) == job.getStatus() %}
                        <li>waiting...</li>
                    {% endif %}
                </ul>
            </div>
        </div>
        <form enctype="multipart/form-data" action="#" method="POST">
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">{% trans %}Cancel{% endtrans %}</button>
                {% if constant('STATUS_ERROR', job) == job.getStatus() %}
                    <button type="submit" class="btn btn-pumukit"
                            data-action="click->admin--actions#load"
                            data-admin--actions-url-param="{{ path('pumukitnewadmin_track_retry_job', {'mmId': multimediaObject.Id, 'jobId': job.id, 'preview': 1}) }}"
                            data-admin--actions-target-param="#tracks_mms_{{ multimediaObject.Id }}"
                            data-bs-dismiss="modal">{% trans %}RETRY{% endtrans %}</button>
                {% endif %}
                {% if constant('STATUS_ERROR', job) == job.getStatus() or constant('STATUS_WAITING', job) == job.getStatus() %}
                    <button type="submit" class="btn btn-danger"
                            data-action="click->admin--actions#load"
                            data-admin--actions-url-param="{{ path('pumukitnewadmin_track_delete_job', {'mmId': multimediaObject.Id, 'jobId': job.id, 'preview': 1}) }}"
                            data-admin--actions-target-param="#tracks_mms_{{ multimediaObject.Id }}"
                            data-admin--actions-data-param="{{ {_method: 'DELETE'}|json_encode }}"
                            data-bs-dismiss="modal">{% trans %}DELETE{% endtrans %}</button>
                {% endif %}
            </div>
        </form>
    {% else %}
        {% trans %}You don't have enough permissions to access this content.{% endtrans %}
    {% endif %}
</div>
