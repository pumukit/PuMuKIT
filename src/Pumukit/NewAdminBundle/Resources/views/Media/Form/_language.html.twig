<div class="mb-3" id="pumukitnewadmin_media_language">
    <label for="language" class="form-label">{{ "Language"|trans }}</label>
    <select id="language" name="language" class="form-select">
        {% for  key, lang in predefined_languages() %}
            <option value="{{ key }}" {% if key == track.language() %}selected{% endif %}>{{ (is_addon_language(key) ? lang|trans : lang)|capitalize }}</option>
        {% endfor %}
    </select>
</div>
