{% set need_reload_status = jobs|filter(job => not job.isExecuted())|length > 0 %}
{% set can_access = app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_MULTIMEDIA_SERIES')) %}
<table data-controller="admin--track-list"
       data-admin--track-list-error-message-value="{{ 'Error extracting thumbnail'|trans }}"
       {% if can_access and reload_links is defined and reload_links %}
       data-admin--track-list-refresh-value="{{ [{target: '#links_mm_' ~ mm.id, url: path('pumukitnewadmin_mms_links', {'id': mm.id})}]|json_encode }}"
       {% endif %}
       {% if can_access and need_reload_status %}
       data-admin--track-list-poll-value="{{ [{target: '#tracks_mms_' ~ mm.id, url: url('pumukitnewadmin_track_list', {'id': mm.id})}, {target: '#list_mms', url: path('pumukitnewadmin_mms_list', {'seriesId': mm.getSeries().getId()})}, {target: '#preview_mm', url: path('pumukitnewadmin_mms_show', {'id': mm.id})}]|json_encode }}"
       {% if 'XMLHttpRequest' == app.request.headers.get('X-Requested-With') %}
       data-admin--track-list-status-value="{{ {target: '#table_mms_status_wrapper_' ~ mm.id, html: '<i class="fa-solid fa-arrows-rotate pmk-job-animate table_mms_job_animate" data-bs-toggle="tooltip" data-bs-placement="right" title="' ~ ('{0} |{1} 1 pending job.  |]1,Inf[ %count% pending jobs.'|trans({'%count%': mm.getProperty('pending_jobs')|length}) ~ ' ' ~ '{0} |{1} 1 executing job. |]1,Inf[ %count% executing jobs.'|trans({'%count%': mm.getProperty('executing_jobs')|length}))|trim|e ~ '"></i>'}|json_encode }}"
       {% endif %}
       {% endif %}>
    <tbody>
    {% if can_access %}

        {% include '@PumukitNewAdmin/Media/List/_jobs.html.twig' %}

        {% for track in mm.getMedias() %}
            {% if mm.isVideoType() %}
                {% include '@PumukitNewAdmin/Media/Type/_video.html.twig' %}
            {% endif %}
            {% if mm.isAudioType() %}
                {% include '@PumukitNewAdmin/Media/Type/_audio.html.twig' %}
            {% endif %}
            {% if mm.isImageType() %}
                {% include '@PumukitNewAdmin/Media/Type/_image.html.twig' %}
            {% endif %}
            {% if mm.isDocumentType() %}
                {% include '@PumukitNewAdmin/Media/Type/_document.html.twig' %}
            {% endif %}
            {% if mm.isExternalType() %}
                {% include '@PumukitNewAdmin/Media/Type/_external.html.twig' %}
            {% endif %}
        {% endfor %}

        {% include '@PumukitNewAdmin/Media/List/_opencast.html.twig' %}
        {% include '@PumukitNewAdmin/Media/List/_create_options.html.twig' %}

    {% else %}
        {% trans %}You don't have enough permissions to access this content.{% endtrans %}
    {% endif %}
    </tbody>
</table>
