<div>
    <form id="update_media" action="{{ path('pumukitnewadmin_track_update', {'id': track.id, 'mmId': mm.getId()}) }}" method="POST"
          data-controller="admin--modal-form"
          data-action="submit->admin--modal-form#submit"
          data-admin--modal-form-refresh-value="{{ [{target: '#tracks_mms_' ~ mm.getId(), url: path('pumukitnewadmin_track_list', {'id': mm.getId()})}]|json_encode }}"
          data-admin--modal-form-success-message-value="{{ 'Track successfully updated.'|trans }}">
        <input type="hidden" name="track" id="track" value="{{ track.id }}" />
        <input type="hidden" name="mmId" id="mmId" value="{{ mm.getId() }}" />
        <input type="hidden" name="preview" id="preview" value="true" />
        <fieldset>

            {% include '@PumukitNewAdmin/Media/Form/_description.html.twig' %}
            {% include '@PumukitNewAdmin/Media/Form/_download.html.twig' %}
            {% include '@PumukitNewAdmin/Media/Form/_hide.html.twig' %}

            <div class="mb-3" id="pumukitnewadmin_media_update_profile">
                <label for="profile" class="form-label">{% trans %}Profile{% endtrans %}</label>
                <select name="profile" id="profile" class="form-select" disabled>
                    <option value="" selected>{{ track.profileName }}</option>
                </select>
            </div>

            {% include '@PumukitNewAdmin/Media/Form/_language.html.twig' %}
            {% include '@PumukitNewAdmin/Media/Form/_tags.html.twig' %}

        </fieldset>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Cancel{% endtrans %}</button>
            <button type="submit" class="btn btn-pumukit">{% trans %}OK{% endtrans %}</button>
        </div>
    </form>
</div>

