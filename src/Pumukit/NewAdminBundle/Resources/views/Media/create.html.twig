<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    <h4 class="modal-title" id="myModalLabel">{{ "Add new track"|trans }}</h4>
</div>
<div class="modal-body">
    {% set pathToUpload = path('pumukitnewadmin_track_upload', {'id': mm.id}) %}

    <div data-controller="admin--upload-form"
         data-action="submit->admin--upload-form#submit core--uploader:success->admin--upload-form#uploaded core--uploader:failed->admin--upload-form#failed">
    <form id="pumukit_media_form" method="post" action="{{ pathToUpload }}" enctype="multipart/form-data"
          {{ uploader_attributes({
              transport: 'xhr',
              endpoint: pathToUpload,
              debug: true,
              formMeta: true,
              restrictions: {maxNumberOfFiles: 1, allowedFileTypes: uploader_allowed_types(mm)},
              xhr: {fieldName: 'resource[]'},
              dashboard: {height: 260, hideUploadButton: true, note: "Max."|trans ~ ' ' ~ php_upload_max_filesize()}
          }) }}>
        <fieldset>
            {% include '@PumukitWizard/Upload/_profiles.html.twig' %}
            {% include '@PumukitNewAdmin/Media/Form/_upload.html.twig' %}

            <span id="error_file" class="error pmk-display-none pmk-color-red">{% trans %}Empty file field{% endtrans %}</span>
        </fieldset>
        <div class="modal-footer">
            <button type="button" class="btn btn-default btn-raised" data-dismiss="modal">{% trans %}Cancel{% endtrans %}</button>
            <button type="submit" class="btn btn-pumukit btn-raised" id="pumukitnewadmin_media_ok_button" data-core--uploader-target="submit" disabled>{% trans %}OK{% endtrans %}</button>
        </div>
    </form>
    </div>
</div>
