{% for job in jobs %}
    <tr>
        <td><ul><li></li></ul></td>
        <td {% if mm.isVideoType() %}colspan="6"{% else %}colspan="5"{% endif %}>&nbsp;</td>
        <td{% if constant('STATUS_ERROR', job) == job.getStatus() %} class="pmk-color-red"{% endif %}>
            <a class="pmk-color-inherit" title="{% trans %}Encoder Job info{% endtrans %}"
               data-bs-toggle="modal" data-bs-backdrop="static" data-bs-dismiss="modal" data-bs-target="#myModal"
               href="{{ path('pumukitnewadmin_track_info_job', {'mmId': mm.id, 'jobId': job.id, 'preview': 1}) }}">
                <i class="{% if constant('STATUS_ERROR', job) == job.getStatus() %}fa-solid fa-circle-info{% else %}fa-solid fa-arrows-rotate pmk-job-animate pmk-job-animate-hover{% endif %}"></i>
            </a>

            {% if constant('STATUS_EXECUTING', job) != job.getStatus() %}
                <a class="pmk-color-inherit" title="{% trans %}Delete Encoder Job{% endtrans %}"
                   href="#"
                   data-action="click->admin--actions#load"
                   data-admin--actions-url-param="{{ path('pumukitnewadmin_track_delete_job', {'mmId': mm.Id, 'jobId': job.id, 'preview': 1}) }}"
                   data-admin--actions-target-param="#tracks_mms_{{ mm.Id }}"
                   data-admin--actions-data-param="{{ {_method: 'DELETE'}|json_encode }}">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            {% endif %}

{#            <small>{{ job.getStatusText() }}</small>#}
        </td>
        <td>
            &nbsp;{% if not is_naked() %}{{ job.getId() }} - {% endif %}<strong>{{ job.getProfile() }}</strong> - {{ job.getPathIni()|basename }} - {{ job.getDuration()|duration_string }}
        </td>
    </tr>
{% endfor %}
