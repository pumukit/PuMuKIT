{% form_theme form '@PumukitNewAdmin/Themes/fields.html.twig' %}

{% if error is defined %}
    <div class="alert alert-danger pmk-line-height-0_5em">{{ error['message'] }}</div>
{% endif %}

<form id="pumukitnewadmin_user_form_update_profile" action="{{ path('pumukitnewadmin_profile_user_index') }}" method="POST">
    <fieldset>
        {% for child in form %}
            {{ form_row(child) }}
        {% endfor %}
    </fieldset>
    <button type="submit" class="btn btn-pumukit btn-raised">{{ "Save"|trans }}</button>
</form>
