<div class="modal-header">
  <h4 class="modal-title" id="myModalLabel">{% trans %}create new live event{% endtrans %}</h4>
  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
  {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_LIVE_EVENTS')) %}
  {% form_theme form '@PumukitNewAdmin/Themes/fields.html.twig' %}
  <form id="pumukitnewadmin_event_create_form"
     data-controller="admin--modal-form" data-action="submit->admin--modal-form#submit" data-admin--modal-form-created-value="{{ {key: 'eventId', list: '#list_events', listUrl: path('pumukitnewadmin_event_list', {'newEventId': '__id__'}), preview: '#preview_event', showUrl: path('pumukitnewadmin_event_show', {'id': '__id__'})}|json_encode }}" data-admin--modal-form-success-message-value="{{ 'Live event successfully created.'|trans }}" data-admin--modal-form-error-message-value="{{ 'There was an error in creating the Live event.'|trans }}" data-admin--modal-form-disable-submit-value="true" data-admin--modal-form-title-error-value="true"
     action="{{ path('pumukitnewadmin_event_create') }}" method="POST">
    <fieldset>
      {% for child in form %}
        {{ form_row(child) }}
      {% endfor %}
    </fieldset>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Close{% endtrans %}</button>
      <button type="submit" class="btn btn-pumukit">{% trans %}Save changes{% endtrans %}</button>
    </div>
  </form>
  {% else %}
    {% trans %}You don't have enough permissions to access this content.{% endtrans %}
  {% endif %}
</div>
