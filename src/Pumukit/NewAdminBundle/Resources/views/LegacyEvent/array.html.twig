<div class="table-responsive pmk-overflow-visible">
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th width="1%" id="th-checkbox">
          <div class="form-check">
            <label>
              <input type="checkbox" data-action="click->admin--actions#checkAll" data-admin--actions-name-param="event">
            </label>
          </div>
        </th>
        <th id="th-icons" colspan="3" width="5%"></th>
        <th id="th-date" width="8%">{% trans %}Date{% endtrans %}</th>
        <th id="th-img"width="5%"></th>
        <th id="th-name">{% trans %}Event{% endtrans %}</th>
        <th id="th-public"width="1%">{% trans %}Public{% endtrans %}</th>
      </tr>
    </thead>
    <tbody>
      {% if events|length == 0 %}
      <tr>
        <td headers="th-checkbox th-icons th-icons th-icons th-date th-img th-name th-public" colspan="8">
          {% trans %}There are no live events with those values.{% endtrans %}
        </td>
      </tr>
      {% endif %}
      {% for event in events %}
      <tr class="pmk-cursor-pointer{% if (app.session.get('admin/event/id') == event.id) %} success{% endif %}">
      <td headers="th-checkbox" >
        <div class="form-check">
          <label>
            <input id="{{ event.id }}" class="event_checkbox" type="checkbox">
          </label>
        </div>
      </td>
      <td headers="th-icons" data-action="click->admin--actions#preview" data-admin--actions-name-param="event" data-admin--actions-url-param="{{ path('pumukitnewadmin_event_show', {'id': event.id}) }}">
        <a title="{% trans %}Edit Event {% endtrans %}{{ event.id }}" href="{{ path('pumukitnewadmin_event_update', {'id': event.id}) }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">
          <i class="fa-solid fa-pencil"></i>
        </a>
      </td>
      <td headers="th-icons">
        <div class="dropdown">
          {% include '@PumukitNewAdmin/LegacyEvent/updatemenu.html.twig' with {'event': event} %}
        </div>
      </td>
      <td headers="th-icons">
        <a href="#" data-action="click->admin--actions#remove"
               data-admin--actions-url-param="{{ path('pumukitnewadmin_event_delete', {'id': event.id}) }}"
               data-admin--actions-target-param="#list_events"
               data-admin--actions-confirm-param="{{ 'Are you sure you want to delete this live event?'|trans }}"
               data-admin--actions-success-param="{{ 'Live event successfully deleted.'|trans }}" title="{% trans %}Delete event{% endtrans %}">
          <i class="fa-solid fa-xmark"></i>
        </a>
      </td>
      <td headers="th-date" class="text-nowrap" data-action="click->admin--actions#preview" data-admin--actions-name-param="event" data-admin--actions-url-param="{{ path('pumukitnewadmin_event_show', {'id': event.id}) }}">
        {{ event.date| format_datetime('medium','medium',locale=app.request.getLocale()) }}
      </td>
      <td headers="th-img" data-action="click->admin--actions#preview" data-admin--actions-name-param="event" data-admin--actions-url-param="{{ path('pumukitnewadmin_event_show', {'id': event.id}) }}">
        {% if event.getPic() is not empty %}
        <img src="{{ event.getPic() }}" height="23" width="23" />
        {% endif %}
      </td>
      <td headers="th-name" data-action="click->admin--actions#preview" data-admin--actions-name-param="event" data-admin--actions-url-param="{{ path('pumukitnewadmin_event_show', {'id': event.id}) }}">
        {{ event.name }}
      </td>
      <td headers="th-public" data-action="click->admin--actions#preview" data-admin--actions-name-param="event" data-admin--actions-url-param="{{ path('pumukitnewadmin_event_show', {'id': event.id}) }}">
        {{ event.display }}
      </td>
      </tr>
      {% endfor %}
    </tbody>
    <tfoot>
      <tr>
        <td colspan="8" class="foot-td">
          {% set column = ((events.getNbPages/5)|round(0, 'floor')) %}
          <div class="row"><div class="col-md-8">
            {{ events.getNbResults }}
              {{ "{0} live events|{1} live event|]1,Inf] live events"|trans({'%count%': events.getNbResults}) }}
            {% if app.session.get('admin/event/criteria')|length != 0%}
            <a class="cancel-search-button pmk-color-blue pmk-font-weight-normal" title="{% trans %}Cancel current search{% endtrans %}" href="?criteria[reset]=true" >{% trans %}Cancel search{% endtrans %}</a>
            {% endif %}
          </div>
          <div class="col-md-4 text-end">
            <div class="pagerfanta">
              {% set sorting = {('sorting[' ~ (app.session.get('admin/event/sort')) ~ ']') : (app.session.get('admin/event/type')) } %}

                {% set pagerClass = 'twitter_bootstrap5' %}
                {% set pagerStyles = {"css_container_class": "pagination pagination-sm", "next_message": "&raquo;", "prev_message": "&laquo;", "routeName": "pumukitnewadmin_event_index", "routeParams": sorting} %}
                {% include "@PumukitNewAdmin/Misc/pager.html.twig" with {'objects' : events, 'pagerClass': pagerClass, 'pagerStyles': pagerStyles} %}
            </div>
          </div></div>
        </td>
      </tr>
    </tfoot>
  </table>
</div>
