<div class="table-responsive pmk-overflow-visible">
<table class="table table-bordered">
  <thead>
    <tr>
      <th id="0" width="14%" class="text-center">{% trans %}MONDAY{% endtrans %}</th>
      <th id="1" width="14%" class="text-center">{% trans %}TUESDAY{% endtrans %}</th>
      <th id="2" width="14%" class="text-center">{% trans %}WEDNESDAY{% endtrans %}</th>
      <th id="3" width="14%" class="text-center">{% trans %}THURSDAY{% endtrans %}</th>
      <th id="4" width="14%" class="text-center">{% trans %}FRIDAY{% endtrans %}</th>
      <th id="5" width="14%" class="text-center">{% trans %}SATURDAY{% endtrans %}</th>
      <th id="6" width="14%" class="text-center">{% trans %}SUNDAY{% endtrans %}</th>
    </tr>
  </thead>

  <tbody>
  {% set total_event = 0 %}
  {% for key,dweek in calendar %}
    <tr>
    {% for dkey in range(0, 6) %}
      {% if dweek[dkey] is defined %}
        {% set d = dweek[dkey] %}
      {% else %}
        {% set d = '' %}
      {% endif %}
      <td headers="{{ dkey }}" class="table-hover pmk-cursor-auto{{ ((d == 'now'|date('d')) and (m == 'now'|date('m')) and (y == 'now'|date('Y'))) ? ' pmk-border-3-solid-000' : '' }}">
        <div class="pmk-overflow-y-auto pmk-position-relative pmk-height-70">
          {% if d is not empty %}
            <span class="pmk-position-absolute pmk-top-0 pmk-right-0">{{ d }}</span>
            {% set calendar_events = [] %}
            {% for event in calendar_all_events %}
              {% if ((y == event.date|date('Y')) and (m == event.date|date('m')) and (d == event.date|date('d'))) %}
                {% set calendar_events = calendar_events|merge([event]) %}
              {% endif %}
            {% endfor %}
            <ul class="pmk-padding-left-6 pmk-list-style-type-none">
              {% for day_event in calendar_events %}
                {% set total_event = total_event + 1 %}
                <li>
                  <a href="#" data-action="click->admin--actions#remove"
               data-admin--actions-url-param="{{ path('pumukitnewadmin_event_delete', {'id': day_event.id}) }}"
               data-admin--actions-target-param="#list_events"
               data-admin--actions-confirm-param="{{ 'Are you sure you want to delete this live event?'|trans }}"
               data-admin--actions-success-param="{{ 'Live event successfully deleted.'|trans }}" title="{% trans %}Delete event{% endtrans %}">
                    <i class="fa-solid fa-xmark"></i>
                  </a>
                  <span class="dropdown">
                    {% include '@PumukitNewAdmin/LegacyEvent/updatemenu.html.twig' with {'event': day_event} %}
                  </span>
                  <span data-action="click->admin--actions#preview" data-admin--actions-name-param="event" data-admin--actions-url-param="{{ path('pumukitnewadmin_event_show', {'id': day_event.id}) }}">
                    {% if day_event.getPic() is not empty %}
                    <img src="{{ day_event.getPic() }}" height="16" width="18" />
                    {% endif %}
                  </span>
                  <a title="{% trans %}Edit Event{% endtrans %} {{ day_event.name }}" href="{{ path('pumukitnewadmin_event_update', {'id': day_event.id}) }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">
                    <i class="fa-solid fa-pencil"></i> {{ day_event.date| format_datetime('none','medium',locale=app.request.getLocale()) }} {{ day_event.name }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </td>
    {% endfor %}
    </tr>
  {% endfor %}
  </tbody>
  <tfoot>
    <tr>
      <td colspan="7" class="foot-td">
        {% set column = ((events.getNbPages/5)|round(0, 'floor')) %}
        <div class="row"><div class="col-md-8">
          {{ events.getNbResults }}
            {{ "{0} live events|{1} live event|]1,Inf] live events"|trans({'%count%':  events.getNbResults}) }}
          {% if app.session.get('admin/event/criteria')|length != 0%}
          <a class="cancel-search-button pmk-color-blue pmk-font-weight-normal" title="{% trans %}Cancel current search{% endtrans %}" href="?criteria[reset]=true" >{% trans %}Cancel search{% endtrans %}</a>
          {% endif %}
        </div>
        <div class="col-md-4 text-end">
          <div class="pagerfanta">
            <ul class="pagination pagination-sm">
              <li class="prev page-item">
                <a id="previousMonth" class="azul page-link" href="#" data-action="click->admin--actions#load" data-admin--actions-url-param="{{ path('pumukitnewadmin_event_list', {'month': 'previous'}) }}" data-admin--actions-target-param="#list_events" data-admin--actions-data-param="{{ {_method: 'POST'}|json_encode }}">
                  &laquo;{% trans %}Previous{% endtrans %}
                </a>
              </li>
              <li class="prev active page-item">
                <span class="page-link">
                  &nbsp;{{ m ~'-'~y }}&nbsp;
                </span>
              </li>
              <li class="next page-item">
                <a id="todayMonth" class="azul page-link" href="#" data-action="click->admin--actions#load" data-admin--actions-url-param="{{ path('pumukitnewadmin_event_list', {'month': 'today'}) }}" data-admin--actions-target-param="#list_events" data-admin--actions-data-param="{{ {_method: 'POST'}|json_encode }}">
                  {% trans %}TODAY{% endtrans %}
                </a>
              </li>
              <li class="next page-item">
                <a id="nextMonth" class="azul page-link" href="#" data-action="click->admin--actions#load" data-admin--actions-url-param="{{ path('pumukitnewadmin_event_list', {'month': 'next'}) }}" data-admin--actions-target-param="#list_events" data-admin--actions-data-param="{{ {_method: 'POST'}|json_encode }}">
                  {% trans %}Next{% endtrans %}&raquo;
                </a>
              </li>
            </ul>
          </div>
        </div></div>
     </td>
    </tr>
  </tfoot>
</table>
</div>
