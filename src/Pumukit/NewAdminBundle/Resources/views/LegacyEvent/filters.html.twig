<div class="pmk-well">
    <form id="filter_events" class="form" data-controller="admin--filter-form" data-action="submit->admin--filter-form#submit" data-admin--filter-form-url-value="{{ path('pumukitnewadmin_event_list') }}" data-admin--filter-form-target-value="#list_events" action="{{ path('pumukitnewadmin_event_index') }}" method="GET">
        <fieldset>
            <legend hidden>{% trans %}Filter Live Events{% endtrans %}</legend>
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title mb-0">
                        <i class="fa-solid fa-bars float-end"></i>
                        {% trans %}Search{% endtrans %}
                    </h2>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="filters_name" class="form-label">{% trans %}Name{% endtrans %}:</label>
                        <div>
                            {% set criteria = app.session.get('admin/event/criteria') %}
                            <input type="text" class="reset form-control" name="criteria[name]" id="filters_name" value="{{ criteria['name']|default("") }}">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="filters_date_from" class="form-label">{% trans %}Date{% endtrans %}:</label>
                        <div>
                            {% trans %}From{% endtrans %}
                            :&nbsp;<input type="date" class="form-control" name="criteria[date][from]" id="filters_date_from" value="{{ criteria['date']['from']|default("") }}" aria-label="date from">
                            <br/>
                            {% trans %}To{% endtrans %}
                            :&nbsp;&nbsp;<input type="date" class="form-control" name="criteria[date][to]" id="filters_date_to" value="{{ criteria['date']['to']|default("") }}" aria-label="date to">
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="text-end">
            <input type="button" class="btn btn-secondary" data-action="click->admin--actions#navigate" data-admin--actions-url-param="?criteria[reset]=true" value="{% trans %}reset{% endtrans %}">
            <input type="submit" name="filter" value="{% trans %}filter{% endtrans %}" class="btn btn-pumukit">
        </div>
    </form>
</div>
