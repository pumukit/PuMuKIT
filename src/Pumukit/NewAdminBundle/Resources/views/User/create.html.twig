<div class="modal-header">
  <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
  <h4 class="modal-title" id="myModalLabel">{% trans %}create new user{% endtrans %}</h4>
</div>
<div class="modal-body">
  {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_ADMIN_USERS')) %}
  {% form_theme form '@PumukitNewAdmin/Themes/fields.html.twig' %}
  <form id="pumukitnewadmin_user_form_create"
        data-controller="admin--modal-form" data-action="submit->admin--modal-form#submit" data-admin--modal-form-target-value="#list_users" data-admin--modal-form-success-message-value="{{ 'User successfully created.'|trans }}" data-admin--modal-form-error-message-value="{{ 'There was an error in creating the User.'|trans }}" data-admin--modal-form-disable-submit-value="true" data-admin--modal-form-title-error-value="true"
        action="{{ path('pumukitnewadmin_user_create') }}" method="POST">
    <fieldset>
      {% for child in form %}
        {{ form_row(child) }}
      {% endfor %}
    </fieldset>
    <div class="modal-footer">
      <button type="button" class="btn btn-default btn-raised" data-dismiss="modal">{% trans %}Close{% endtrans %}</button>
      <button type="submit" class="btn btn-pumukit btn-raised" id="pumukitnewadmin_user_form_save">{% trans %}Save changes{% endtrans %}</button>
    </div>
  </form>
  {% else %}
    {% trans %}You don't have enough permissions to access this content.{% endtrans %}
  {% endif %}
</div>
