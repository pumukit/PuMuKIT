<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">{% trans %}edit groups for user{% endtrans %}:</h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    <h2 class="modal-title">&laquo;{{ user.getUsername() }}&raquo;</h2>
</div>

<div class="modal-body">
    {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_ADMIN_USERS')) %}
        <div data-controller="admin--group-picker"
             data-admin--group-picker-update-url-value="{{ path('pumukitnewadmin_user_updategroups', {'id': user.id}) }}"
             data-admin--group-picker-groups-url-value="{{ path('pumukitnewadmin_user_getgroups', {'id': user.id}) }}"
             data-admin--group-picker-target-value="#list_users"
             data-admin--group-picker-local-origin-value="{{ constant('Pumukit\\SchemaBundle\\Document\\Group::ORIGIN_LOCAL') }}"
             data-admin--group-picker-show-codes-value="{{ is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::SHOW_CODES')) ? 'true' : 'false' }}"
             data-admin--group-picker-messages-value="{{ {success: 'Successfully updated groups in User.'|trans, external: 'External defined groups. Contact your directory service administrator to change membership.'|trans}|json_encode }}">
        <input type="hidden" id="user_id" value="{{ user.id }}"/>
        <div class="card">
            <div class="card-header pmk-text-align-center">{% trans %}GROUPS{% endtrans %}</div>
            <div class="card-body" id="group_mode">
                <div class="row pumukitnewadmin-groups-list-title-row">
                    <div class="pumukitnewadmin-groups-list-title list-title-1">
                        {% trans %}Available Groups{% endtrans %}:
                    </div>
                    <div class="pumukitnewadmin-groups-list-title list-title-2">
                        {% trans %}User current Groups{% endtrans %}:
                    </div>
                </div>
                <div class="pumukitnewadmin-groups-boxes">
                    <div class="tag list-group pmk-tag-tree pumukitnewadmin-groups-list-box" id="delete_groups" data-admin--group-picker-target="available">
                        {% include '@PumukitNewAdmin/User/availablegroups.html.twig' with {'user': user, 'groups': groups} %}
                    </div>
                    <div class="pumukitnewadmin-groups-arrows">
                        <a href="#" data-action="click->admin--group-picker#moveFromCurrent">&#8592;</a>
                        <a href="#" data-action="click->admin--group-picker#moveFromAvailable">&#8594;</a>
                    </div>
                    {# Groups added to the user #}
                    <div class="tag pumukitnewadmin-groups-list-box" id="select_tag">
                        <div class="tag_tree list-group" id="add_groups" data-admin--group-picker-target="current">
                            {% include '@PumukitNewAdmin/User/selectedgroups.html.twig' with {'user': user, 'groups': groups} %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Cancel{% endtrans %}</button>
            <button type="button" class="btn btn-primary" id="pumukitnewadmin_user_groups_reset" data-action="click->admin--group-picker#reset">{% trans %}Reset{% endtrans %}</button>
            <button type="submit" class="btn btn-pumukit" id="pumukitnewadmin_user_groups_submit" data-action="click->admin--group-picker#save">{% trans %}Save changes{% endtrans %}</button>
        </div>
        </div>
    {% else %}
        {% trans %}You don't have enough permissions to access this content.{% endtrans %}
    {% endif %}
</div>
