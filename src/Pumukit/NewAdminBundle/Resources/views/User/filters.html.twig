<!-- Filter -->
<div class="pmk-well">
    <form id="filter_users" action="{{ path('pumukitnewadmin_user_index') }}" method="get">
        <fieldset>
            <legend hidden>{% trans %}Filter Users{% endtrans %}</legend>
            <div id="accordion" role="tablist" aria-roledescription="tablist" aria-multiselectable="true">
                <div class="card">
                    <div class="card-header" role="tab" id="headingSearch">
                        <h2 class="card-title mb-0">
                            <a class="d-block" data-bs-toggle="collapse" href="#collapseSearch" aria-expanded="true" aria-controls="collapseSearch">
                                <i class="fa-solid fa-bars float-end"></i>
                                {% trans %}Search{% endtrans %}
                            </a>
                        </h2>
                    </div>
                    <div id="collapseSearch" data-bs-parent="#accordion" class="panel-collapse collapse show" role="tabpanel" aria-labelledby="headingSearch">
                        <div class="card-body">

                            <div class="mb-3">
                                <label for="filters_username" class="form-label">{% trans %}Username{% endtrans %}:</label>
                                {% set criteria = app.session.get('admin/user/criteria') %}
                                <div>
                                    <input type="text" class="reset form-control" name="criteria[username]" id="filters_username" value="{{ criteria['username']|default("") }}">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="filters_email" class="form-label">{% trans %}Email{% endtrans %}:</label>
                                {% set criteria = app.session.get('admin/user/criteria') %}
                                <div>
                                    <input type="text" class="reset form-control" name="criteria[email]" id="filters_email" value="{{ criteria['email']|default("") }}">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="filters_profile" class="form-label">{% trans %}Permission Profile{% endtrans %}:</label>
                                <div>
                                    <select class="form-select" name="criteria[permissionProfile]" id="filters_profile">
                                        <option value="all" {% if criteria is null or criteria['permissionProfile']|default == 'all' %}selected="selected"{% endif %}>{% trans %}All{% endtrans %}</option>
                                        {% for profile in profiles %}
                                            <option value="{{ profile.id }}" {% if criteria and criteria['permissionProfile']|default == profile.id %}selected="selected"{% endif %}>{{ profile }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>

                            {% if origins|length > 1 %}
                                <div class="mb-3">
                                    <label for="filters_origin" class="form-label">{% trans %}Origin{% endtrans %}:</label>
                                    <div>
                                        <select class="form-select" name="criteria[origin]" id="filters_origin">
                                            <option value="all" {% if criteria is null or criteria['origin']|default == 'all' %}selected="selected"{% endif %}>{% trans %}All{% endtrans %}</option>
                                            {% for origin in origins %}
                                                <option value="{{ origin }}" {% if criteria and criteria['origin']|default == origin %}selected="selected"{% endif %}>{{ origin }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

        </fieldset>

        <div class="text-end">
            <input class="btn btn-secondary" data-action="click->admin--actions#navigate" data-admin--actions-url-param="?criteria[reset]=true" type="button" value="{% trans %}reset{% endtrans %}">
            <input class="btn btn-pumukit" type="submit" name="filter" value="{% trans %}filter{% endtrans %}">
        </div>
    </form>
</div>
