<div class="table-responsive pmk-overflow-visible">
  {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_LIVE_CHANNELS')) %}
  <table class="table table-striped table-hover">
    <thead>
      <tr>
    <th width="1%" id="th-checkbox">
      <div class="form-check">
        <label>
              <input type="checkbox" data-action="click->admin--actions#checkAll" data-admin--actions-name-param="live">
        </label>
      </div>
    </th>
    <th colspan="2" width="5%" id="th-icons"></th>
    <th id="th-name">{% trans %}Name{% endtrans %}</th>
    <th id="th-url">{% trans %}URL{% endtrans %}</th>
    <th id="th-source-name">{% trans %}Source Name{% endtrans %}</th>
    <th width="8%" id="th-type">{% trans %}Type{% endtrans %}</th>
      </tr>
    </thead>
    <tbody>
      {% if lives|length == 0 %}
      <tr>
    <td colspan="10" headers="th-checkbox th-icons th-icons th-name th-type th-url">
      {% trans %}There are no live channels with those values.{% endtrans %}
    </td>
      </tr>
      {% else %}
        {% for live in lives %}
          <tr class="pmk-cursor-pointer{% if (app.session.get('admin/live/id') == live.id) %} success{% endif %}">
            <td headers="th-checkbox">
              <div class="form-check">
                <label>
                  <input id="{{ live.id }}" class="live_checkbox" type="checkbox">
                </label>
              </div>
            </td>
            <td headers="th-icons">
              <a title="{% trans %}Edit live channel{% endtrans %} {{ live.id }}" href="{{ path('pumukitnewadmin_live_update', {'id': live.id}) }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">
                <i class="fa-solid fa-pencil"></i>
              </a>
            </td>
            <td headers="th-icons">
              <a href="#" data-action="click->admin--actions#remove"
               data-admin--actions-url-param="{{ path('pumukitnewadmin_live_delete', {'id': live.id}) }}"
               data-admin--actions-target-param="#list_lives"
               data-admin--actions-reload-param="{{ path('pumukitnewadmin_live_list') }}"
               data-admin--actions-error-marker-param="error"
               data-admin--actions-confirm-param="{{ 'Are you sure you want to delete this live channel?'|trans }}"
               data-admin--actions-success-param="{{ 'Live channel successfully deleted.'|trans }}"
               data-admin--actions-error-param="{{ 'Delete error. Live channel channel is associated to live event.'|trans }}" title="{% trans %}Delete live channel{% endtrans %}">
                <i class="fa-solid fa-xmark"></i>
              </a>
            </td>
            <td headers="th-name" data-action="click->admin--actions#preview" data-admin--actions-name-param="live" data-admin--actions-url-param="{{ path('pumukitnewadmin_live_show', {'id': live.id}) }}">
              {{ live.name }}
            </td>
            <td headers="th-url" data-action="click->admin--actions#preview" data-admin--actions-name-param="live" data-admin--actions-url-param="{{ path('pumukitnewadmin_live_show', {'id': live.id}) }}">
              {{ live.url }}
            </td>
            <td headers="th-source-name" data-action="click->admin--actions#preview" data-admin--actions-name-param="live" data-admin--actions-url-param="{{ path('pumukitnewadmin_live_show', {'id': live.id}) }}">
              {{ live.getSourceName() }}
            </td>
            <td headers="th-type" data-action="click->admin--actions#preview" data-admin--actions-name-param="live" data-admin--actions-url-param="{{ path('pumukitnewadmin_live_show', {'id': live.id}) }}">
              {{ live.getLiveType }}
            </td>
          </tr>
        {% endfor %}
      {% endif %}
    </tbody>
    <tfoot>
    <tr>
      <td colspan="10" class="foot-td">
        {% set column = ((lives.getNbPages/5)|round(0, 'floor')) %}
        <div class="row"><div class="col-md-8">
          {{ lives.getNbResults }}
            {{ "{0} live channels|{1} live channel|]1,Inf] live channels"|trans({'%count%':  lives.getNbResults}) }}
          {% if app.session.get('admin/live/criteria')|length != 0%}
          <a class="cancel-search-button pmk-color-blue pmk-font-weight-normal" title="{% trans %}Cancel current search{% endtrans %}" href="?criteria[reset]=true" >{% trans %}Cancel search{% endtrans %}</a>
          {% endif %}
        </div>
        <div class="col-md-4 text-end">
          <div class="pagerfanta">
            {% set sorting = {('sorting[' ~ (app.session.get('admin/live/sort')) ~ ']') : (app.session.get('admin/live/type')) } %}

              {% set pagerClass = 'twitter_bootstrap5' %}
              {% set pagerStyles = {"css_container_class": "pagination pagination-sm", "next_message": "&raquo;", "prev_message": "&laquo;", "routeName": "pumukitnewadmin_live_index", "routeParams": sorting} %}
              {% include "@PumukitNewAdmin/Misc/pager.html.twig" with {'objects' : lives, 'pagerClass': pagerClass, 'pagerStyles': pagerStyles} %}
          </div>
        </div></div>
      </td>
    </tr>
  </tfoot>
</table>
{% else %}
  {% trans %}You don't have enough permissions to access this content.{% endtrans %}
{% endif %}
</div>
