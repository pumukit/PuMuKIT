<div class="pmk-well">
    <form id="filter_lives" class="form" data-controller="admin--filter-form" data-action="submit->admin--filter-form#submit" data-admin--filter-form-url-value="{{ path('pumukitnewadmin_live_list') }}" data-admin--filter-form-target-value="#list_lives" action="{{ path('pumukitnewadmin_live_list') }}" method="POST">
        <fieldset>
            <legend hidden>{% trans %}Filter Live Channels{% endtrans %}</legend>
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title mb-0">
                        <i class="fa-solid fa-bars float-end"></i>
                        {% trans %}Search{% endtrans %}
                    </h2>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="name" class="form-label">{% trans %}Name{% endtrans %}:</label>
                        <div>
                            {% set criteria = app.session.get('admin/live/criteria') %}
                            <input type="text" class="reset form-control" name="criteria[name.{{ app.request.getLocale() }}]" id="filters_name" value="{{ criteria['name.{{ app.request.getLocale() }}']|default("") }}" aria-label="Name">
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="text-end">
            <input type="button" class="btn btn-secondary" data-action="click->admin--actions#navigate" data-admin--actions-url-param="?criteria[reset]=true" value="{% trans %}reset{% endtrans %}">
            <input type="submit" name="filter" value="{% trans %}filter{% endtrans %}" class="btn btn-pumukit">
        </div>
    </form>
</div>
