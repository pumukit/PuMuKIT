{% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_TAGS')) %}
    {% for tag in children %}

        {% if not tag.getProperty('hide_in_tag_group') %}
            {% set has_children = tag.children|length %}

            <tr class="tv_admin_row_0 c_{{ tag.path|replace({ ("|" ~ tag.cod ~ "|"): '', '|': ' c_'}) }} d_{{ tag.parent.cod|default("") }}" id="row_tag_{{ tag.id }}" data-level="{{ tag.level }}">
                <td headers="th-checkbox">
                    <div class="form-check">
                        <label>
                            <input id="{{ tag.id }}" class="tag_checkbox" type="checkbox">
                        </label>
                    </div>
                </td>
                <td headers="th-icons">
                    <a href="#" title="{% trans %}delete{% endtrans %}" data-action="click->admin--tag-tree#remove"
                       data-admin--tag-tree-id-param="{{ tag.id|json_encode }}" data-admin--tag-tree-pid-param="{{ tag.parent.id|default("")|json_encode }}"
                       {% if tag.getNumberMultimediaObjects() > 0 %}data-admin--tag-tree-blocked-param="{{ 'Can not delete tag with code'|trans }} {{ tag.cod }}. {{ tag.getNumberMultimediaObjects() }} {{ 'Multimedia Object(s) has/have this tag'|trans }}."{% endif %}
                       data-admin--tag-tree-confirm-param="{{ 'Are you sure you want to delete the tag with code'|trans }} {{ tag.cod }}?"
                       data-admin--tag-tree-success-param="{{ 'Tag'|trans }} &quot;{{ tag.cod }}&quot; {{ 'successfully deleted'|trans }}." class="tag_delete_{{ tag.cod }}">
                        <i class="fa-solid fa-xmark"></i>
                    </a>
                </td>
                <td headers="th-icons">
                    <a title="{% trans %}Edit tag {% endtrans %} {{ tag.cod }}" href="{{ path('pumukitnewadmin_tag_update', {'id': tag.id}) }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal" class="tag_edit_{{ tag.cod }}">
                        <i class="fa-solid fa-pencil"></i>
                    </a>
                </td>
                <td headers="th-icons">
                    <a title="{% trans %}Create child tag for{% endtrans %} {{ tag.cod }}" href="{{ path('pumukitnewadmin_tag_create', {'parent': tag.id}) }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal" class="tag_create_children_{{ tag.cod }}">
                        <i class="fa-solid fa-square-plus"></i>
                    </a>
                </td>
                <td headers="th-code" class="{{ has_children?'collapsed noload':'element' }}">
                    <span class="pmk-padding-left-{{ 10 * tag.level }}" data-action="click->admin--tag-tree#toggle" data-admin--tag-tree-id-param="{{ tag.id|json_encode }}" data-admin--tag-tree-cod-param="{{ tag.cod }}">
                    {{ tag.cod }}
                    </span>
                </td>
                <td headers="th-name" class="{{ has_children?'collapsed noload':'element' }}">
                    <span class="pmk-padding-left-{{ 10 * tag.level }}" data-action="click->admin--tag-tree#toggle" data-admin--tag-tree-id-param="{{ tag.id|json_encode }}" data-admin--tag-tree-cod-param="{{ tag.cod }}">
                      <i class="fa-solid tag_icon tag_children_{{ tag.cod }}"></i>
                        {{ tag.title }}
                    </span>
                </td>
                <td headers="th-num">
                    <span class="pmk-padding-left-{{ 10 * tag.level }}" data-action="click->admin--tag-tree#toggle" data-admin--tag-tree-id-param="{{ tag.id|json_encode }}" data-admin--tag-tree-cod-param="{{ tag.cod }}">
                    {{ tag.getNumberMultimediaObjects() }}
                    </span>
                </td>
            </tr>
        {% endif %}
    {% endfor %}
{% endif %}
