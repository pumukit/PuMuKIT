<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">{% trans %}modify tag{% endtrans %}</h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_TAGS')) %}
        {% form_theme form '@PumukitNewAdmin/Themes/fields.html.twig' %}
        <form data-controller="admin--modal-form" data-action="submit->admin--modal-form#submit" data-admin--modal-form-target-value="#list_tags" data-admin--modal-form-success-message-value="{{ "Tag successfully updated."|trans }}" data-admin--modal-form-error-message-value="{{ "There was an error in updating the Tag."|trans }}"
              action="{{ path('pumukitnewadmin_tag_update', {'id': tag.id}) }}" method="POST">
            <fieldset>
                {% for child in form %}
                    {{ form_row(child) }}
                {% endfor %}
            </fieldset>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Close{% endtrans %}</button>
                <button type="submit" class="btn btn-primary">{% trans %}Save changes{% endtrans %}</button>
            </div>
        </form>
    {% else %}
        {% trans %}You don't have enough permissions to access this content.{% endtrans %}
    {% endif %}
</div>
