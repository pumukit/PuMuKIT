<table class="table table-bordered table-condensed">
    <thead>
        {% if app.request.attributes.get('_route') == 'pumukit_stats_series_index' %}
            <th class="pmk-width-60" id="ranking">{% trans %}Ranking{% endtrans %}</th>
            <th id="title">{% trans %}Title{% endtrans %}</th>
            <th id="videos">{% trans %}Videos{% endtrans %}</th>
            <th id="views">{% trans %}Views{% endtrans %}</th>
        {% endif %}

        {% if app.request.attributes.get('_route') == 'pumukit_stats_mmobj_index' %}
            <th class="pmk-width-60" id="ranking">{% trans %}Ranking{% endtrans %}</th>
            <th id="title">{% trans %}Title{% endtrans %}</th>
            <th class="pmk-width-20pct" id="recording">{% trans %}Record date{% endtrans %}</th>
            <th class="pmk-min-width-110" id="series">{% trans %}Series{% endtrans %}</th>
            <th id="views">{% trans %}Views{% endtrans %}</th>
        {% endif %}

        {% if app.request.attributes.get('_route') == 'pumukit_stats_series_index_id' or app.request.attributes.get('_route') == 'pumukit_stats_mmobj_index_id' %}
            <th class="pmk-width-60" id="ranking">{% trans %}Ranking{% endtrans %}</th>
            <th id="title">{% trans %}Title{% endtrans %}</th>
            <th id="recording">{% trans %}Record date{% endtrans %}</th>
            <th class="pmk-min-width-110" id="series">{% trans %}Series{% endtrans %}</th>
            <th id="views">{% trans %}Views{% endtrans %}</th>
        {% endif %}
    </thead>
    <tbody class="most-viewed-table-body" data-stats-ui--stats-target="mostViewedBody">
    </tbody>
</table>