{% if app.request.attributes.get('_route') == 'pumukit_stats_series_index' %}
    {% set title = "Most viewed series"|trans %}
{% elseif app.request.attributes.get('_route') == 'pumukit_stats_mmobj_index' %}
    {% set title = "Most viewed objects (videos/audios)"|trans %}
{% elseif app.request.attributes.get('_route') == 'pumukit_stats_series_index_id' %}
    {% set title = "Views of this series objects"|trans %}
{% elseif app.request.attributes.get('_route') == 'pumukit_stats_mmobj_index_id' %}
    {% set title = "Video"|trans %}
{% endif %}

<div class="col-md-12 block-preview">
    <div class="row">
        <div class="col-md-12">
            <h2 class="title_of_most_viewed" data-stats-ui--stats-target="mostViewedTitle">
                {{ title }}
            </h2>
        </div>
        <div class="col-sm-6 col-md-6">
            {% include "@PumukitStatsUI/MostViewed/list.html.twig" %}
        </div>
        <div class="col-sm-6 col-md-6">
            {% if app.request.attributes.get('_route') == 'pumukit_stats_mmobj_index_id' %}
                <div id="chart-most-viewed" data-stats-ui--stats-target="preview"></div>
                <template data-stats-ui--stats-target="previewTemplate">
                    <a target="_blank">
                        <div class="pumukit_mmobj">
                            <div class="thumbnail">
                                <span class="play_icon"></span>
                                <img title="serial_pic" class="serial thumbnailimg" alt="" />
                                <div class="thumbnailholder"></div>
                            </div>
                            <div class="info-wrapper">
                                <div class="info">
                                    <div class="title"><span class="mmobj_thumbnail_title"></span></div>
                                    <div class="subtitle"><abbr></abbr></div>
                                    <div class="date mmobj"></div>
                                </div>
                            </div>
                        </div>
                    </a>
                </template>
            {% else %}
                <div id="chart-most-viewed" class="stats-chart">
                    <canvas data-stats-ui--stats-target="mostViewedChart"></canvas>
                </div>
            {% endif %}
        </div>
        <div class="col-md-12 text-center most-viewed-paginator" data-stats-ui--stats-target="pager">
        </div>
    </div>
</div>
