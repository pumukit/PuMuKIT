<div class="col-md-12">
    <div class="row">
        <div class="col-md-12">
            <h2>{% trans %}Views by time period{% endtrans %}</h2>
        </div>
        <div class="col-md-6">
            {% include "@PumukitStatsUI/Views/list.html.twig" %}
        </div>
        <div class="col-md-6">
            <div class="row">
                <div class="col-md-12">
                    <div class="btn-group float-end" role="group">
                        <button type="button" class="day btn-all-views-group btn btn-secondary" data-stats-ui--stats-target="group" data-action="stats-ui--stats#group" data-stats-ui--stats-group-param="day">
                            {% trans %}Day{% endtrans %}
                        </button>
                        <button type="button" class="month btn-all-views-group btn btn-secondary active-button" data-stats-ui--stats-target="group" data-action="stats-ui--stats#group" data-stats-ui--stats-group-param="month">
                            {% trans %}Month{% endtrans %}
                        </button>
                        <button type="button" class="year btn-all-views-group btn btn-secondary" data-stats-ui--stats-target="group" data-action="stats-ui--stats#group" data-stats-ui--stats-group-param="year">
                            {% trans %}Year{% endtrans %}
                        </button>
                    </div>
                </div>
                <div class="col-md-12">
                    <div id="chart-all-views" class="stats-chart">
                        <canvas data-stats-ui--stats-target="viewsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
