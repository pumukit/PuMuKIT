<div class="col-md-7 block-results-views">
    <div class="row">
        <div class="col-md-4">
            <h2 class="total-views-objects" data-stats-ui--stats-target="totalViews"></h2>
        </div>
        <div class="col-md-6">
            <h4>{% trans %}Total views in the date{% endtrans %}</h4>
        </div>
        <div class="col-md-2 float-end">
            <i class="fa-solid fa-eye"></i>
        </div>
    </div>
</div>
<div class="clearfix"></div>

{% if app.request.attributes.get('_route') != 'pumukit_stats_mmobj_index_id' %}
    <div class="col-md-7 block-results-objects">
        <div class="row">
            <div class="col-md-4">
                <h2 class="total-objects" data-stats-ui--stats-target="totalObjects"></h2>
            </div>
            <div class="col-md-6">
                <h4>{% trans %}Total Objects{% endtrans %} </h4>
            </div>
            <div class="col-md-2 float-end">
                <i class="ion ion-stats-bars fa-solid fa-chart-simple"></i>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
{% endif %}