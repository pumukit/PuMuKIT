<div class="col-md-9 col-lg-7">
    <div class="stats-total stats-total-views">
        <span class="stats-total-value" data-stats-ui--stats-target="totalViews"></span>
        <span class="stats-total-label">{% trans %}Total views in the date{% endtrans %}</span>
        <i class="fa-solid fa-eye stats-total-icon" aria-hidden="true"></i>
    </div>

    {% if app.request.attributes.get('_route') != 'pumukit_stats_mmobj_index_id' %}
        <div class="stats-total stats-total-objects">
            <span class="stats-total-value" data-stats-ui--stats-target="totalObjects"></span>
            <span class="stats-total-label">{% trans %}Total Objects{% endtrans %}</span>
            <i class="fa-solid fa-chart-simple stats-total-icon" aria-hidden="true"></i>
        </div>
    {% endif %}
</div>
