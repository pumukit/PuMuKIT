<div class="col-md-10 offset-md-1 text-start mt-4">
    {% if app.request.attributes.get('_route') != 'pumukit_stats_mmobj_index_id' %}
        <label for="title" class="form-label">
            {% trans %}Search by title{% endtrans %}:
        </label>
        <div class="input-group mb-3">
            <input id="title" type="text" class="form-control" data-stats-ui--stats-target="title" data-action="keydown.enter->stats-ui--stats#search" />
            <button type="button" class="btn btn-outline-secondary" data-action="stats-ui--stats#search" title="{% trans %}Set URL parameters{% endtrans %}">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-outline-secondary" data-action="stats-ui--stats#reset" title="{% trans %}Clear filter{% endtrans %}">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </div>
    {% endif %}

    <label for="stats_date_preset" class="form-label">
        {% trans %}Date range{% endtrans %}:
    </label>
    <div class="row g-2 mb-3">
        <div class="col-sm-4">
            <select id="stats_date_preset" class="form-select" data-stats-ui--stats-target="preset" data-action="stats-ui--stats#preset" aria-label="{% trans %}Date range{% endtrans %}">
                <option value="">{% trans %}Custom range{% endtrans %}</option>
                <option value="yesterday">{% trans %}Yesterday{% endtrans %}</option>
                <option value="last7">{% trans %}Last 7 Days{% endtrans %}</option>
                <option value="last30">{% trans %}Last 30 Days{% endtrans %}</option>
                <option value="thisMonth">{% trans %}This Month{% endtrans %}</option>
                <option value="lastMonth">{% trans %}Last Month{% endtrans %}</option>
                <option value="thisYear">{% trans %}This Year{% endtrans %}</option>
                {% if app.request.attributes.get('_route') ends with '_id' %}
                    <option value="all">{% trans %}All History{% endtrans %}</option>
                {% endif %}
            </select>
        </div>
        <div class="col-6 col-sm-4">
            <input type="date" id="stats_from_date" class="form-control" min="1970-01-01" max="{{ 'now'|date('Y-m-d') }}" data-stats-ui--stats-target="from" data-action="change->stats-ui--stats#dates" aria-label="{% trans %}From{% endtrans %}" />
        </div>
        <div class="col-6 col-sm-4">
            <div class="input-group">
                <input type="date" id="stats_to_date" class="form-control" min="1970-01-01" max="{{ 'now'|date('Y-m-d') }}" data-stats-ui--stats-target="to" data-action="change->stats-ui--stats#dates" aria-label="{% trans %}Until{% endtrans %}" />
                <button type="button" class="btn btn-outline-secondary" data-action="stats-ui--stats#reset" title="{% trans %}Clear filter{% endtrans %}">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </div>
</div>
