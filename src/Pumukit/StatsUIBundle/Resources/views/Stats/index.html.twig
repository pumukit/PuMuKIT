{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('bundles/pumukitstatsui/css/statsui.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
    {% set stats_modes = {
        'pumukit_stats_series_index': 'series',
        'pumukit_stats_mmobj_index': 'mmobj',
        'pumukit_stats_series_index_id': 'series-id',
        'pumukit_stats_mmobj_index_id': 'mmobj-id'
    } %}
    {% set stats_urls = {
        seriesMostViewed: path('pumukit_stats_api_seriesmostviewed'),
        mmobjMostViewed: path('pumukit_stats_api_mmobjmostviewed'),
        multimediaObjects: path('pumukit_schema_api_multimediaobjects'),
        views: path('pumukit_stats_api_views'),
        viewsSeries: path('pumukit_stats_api_viewsseries'),
        viewsMmobj: path('pumukit_stats_api_viewsmmobj'),
        seriesStats: path('pumukit_stats_series_index_id', {'id': '__ID__'}),
        mmobjStats: path('pumukit_stats_mmobj_index_id', {'id': '__ID__'}),
        mmobjPortal: path('pumukit_webtv_multimediaobject_index', {'id': '__ID__'})
    } %}

    <div class="container-fluid"
         data-controller="stats-ui--stats"
         data-stats-ui--stats-mode-value="{{ stats_modes[app.request.attributes.get('_route')]|default('series') }}"
         data-stats-ui--stats-id-value="{{ app.request.attributes.get('id')|default('') }}"
         data-stats-ui--stats-locale-value="{{ app.request.getLocale() }}"
         data-stats-ui--stats-page-value="{{ app.request.query.getInt('page') }}"
         data-stats-ui--stats-urls-value="{{ stats_urls|json_encode }}">

        <h3 class="cab_body_div">
            <ul class="breadcrumb">
                <li class="active breadcrumb-item">{{ template_title }}</li>
            </ul>
        </h3>

        <div class="row block-search-and-views">
            {% include "@PumukitStatsUI/Search/index.html.twig" %}
        </div>

        <div class="row block-stats-most-viewed">
            {% include "@PumukitStatsUI/MostViewed/index.html.twig" %}
        </div>

        <div class="row block-views">
            {% include "@PumukitStatsUI/Views/index.html.twig" %}
        </div>

    </div>
{% endblock %}
