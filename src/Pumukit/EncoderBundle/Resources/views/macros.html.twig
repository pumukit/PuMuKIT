{% macro job_status_icon(status) %}{% apply pumukit_spaceless %}

{% set icons = {
  (constant('Pumukit\\EncoderBundle\\Document\\Job::STATUS_ERROR')): 'fa-solid fa-circle-exclamation',
  (constant('Pumukit\\EncoderBundle\\Document\\Job::STATUS_PAUSED')): 'fa-solid fa-circle-pause',
  (constant('Pumukit\\EncoderBundle\\Document\\Job::STATUS_WAITING')): 'fa-solid fa-repeat',
  (constant('Pumukit\\EncoderBundle\\Document\\Job::STATUS_EXECUTING')): 'fa-solid fa-chart-simple',
  (constant('Pumukit\\EncoderBundle\\Document\\Job::STATUS_FINISHED')): 'fa-solid fa-circle-play',
}
%}
{{ icons[status] }}

{% endapply %}{% endmacro %}


{% macro job_status_class(status, property) %}{% apply pumukit_spaceless %}

{% set colors = {
  (constant('Pumukit\\EncoderBundle\\Document\\Job::STATUS_ERROR')): 'rgb-221-75-57',
  (constant('Pumukit\\EncoderBundle\\Document\\Job::STATUS_PAUSED')): 'rgb-178-178-178',
  (constant('Pumukit\\EncoderBundle\\Document\\Job::STATUS_WAITING')): 'rgb-75-148-192',
  (constant('Pumukit\\EncoderBundle\\Document\\Job::STATUS_EXECUTING')): 'rgb-243-156-18',
  (constant('Pumukit\\EncoderBundle\\Document\\Job::STATUS_FINISHED')): 'rgb-0-166-90',
}
%}
pmk-{{ property }}-{{ colors[status] }}

{% endapply %}{% endmacro %}
