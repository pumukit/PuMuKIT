{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block body %}

    <h3 class="cab_body_div">
        <ul class="breadcrumb pmk-margin-bottom-5">
            <li class="active breadcrumb-item">{% trans %}Encoder{% endtrans %}</li>
        </ul>
    </h3>

    {% set can_access_jobs = app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_JOBS')) %}
    <div{% if can_access_jobs %} data-controller="encoder--dashboard" data-encoder--dashboard-url-value="{{ path('pumukit_encoder_info_block', {block: '__block__'}) }}" data-encoder--dashboard-busy-value="{{ busy ? 'true' : 'false' }}"{% endif %}>
    <div class="row stats_jobs" data-encoder--dashboard-target="block" data-block="stats">
        {% if can_access_jobs %}
            {% include '@PumukitEncoder/Info/block.html.twig' with {block: 'stats'} %}
        {% endif %}
    </div>

    <div class="row">
        {% if can_access_jobs %}
            <div class="col-md-9">
                <div class="pmk-well" id="list_jobs">
                    {% for block in ['pending', 'executing', 'executed'] %}
                        <div data-encoder--dashboard-target="block" data-block="{{ block }}">
                            {% include '@PumukitEncoder/Info/block.html.twig' %}
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="col-md-3">
                <div class="pmk-well" id="list_cpus" data-encoder--dashboard-target="block" data-block="cpus">
                    {% include '@PumukitEncoder/Info/block.html.twig' with {block: 'cpus'} %}
                </div>
            </div>
        {% else %}
            <div class="col-md-12">
                <div class="pmk-well">
                    {% trans %}You don't have enough permissions to access this content.{% endtrans %}
                </div>
            </div>
        {% endif %}
    </div>
    </div>

{% endblock %}
