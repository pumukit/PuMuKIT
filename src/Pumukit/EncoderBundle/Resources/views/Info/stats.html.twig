{% import "@PumukitEncoder/macros.html.twig" as macros %}

<div class="offset-md-1 col-md-2 col-sm-6 col-12">
  <div class="list-group">
    <div class="list-group-item">
      <div class="row-action-primary">
        <i class="{{ macros.job_status_icon(constant('Pumukit\\EncoderBundle\\Document\\Job::STATUS_PAUSED')) }} {{ macros.job_status_class(constant('Pumukit\\EncoderBundle\\Document\\Job::STATUS_PAUSED'), 'background') }}"></i>
      </div>
      <div class="row-content">
        <div class="least-content togglebutton form-check form-switch" style="bottom: 10px; top: inherit">
          <label><input class="form-check-input" role="switch" id="show_paused" type="checkbox" data-action="change->encoder--stats#filter" {% if app.request.query.get('show_paused', true) %}checked="checked"{% endif %}></label>
        </div>
        <h4 class="list-group-item-heading">{% trans %}Paused{% endtrans %}</h4>
        <p class="list-group-item-text">{{ stats['paused'] }} {% trans %}jobs{% endtrans %}</p>
      </div>
    </div>
  </div>
</div>
