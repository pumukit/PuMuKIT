<h3>CPUs</h3>

<div class="list-group">
  {% for name, cpu in cpus %}
    {% if not loop.first %}
      <div class="list-group-separator"></div>
    {% endif %}
    {% set deactivated = (name in deactivated_cpus) %}
    <div class="list-group-item">
      <div class="row-action-primary pmk-position-relative">
        <i class="mdi-action-dns"></i>
        {% if deactivated %}
          <i id="maintenance-{{name}}-warning" title="{% trans %}This CPU is in maintenance mode.{% endtrans %}" class="mdi-av-new-releases pmk-cursor-pointer pmk-position-absolute pmk-background-none pmk-color-orange pmk-border-radius-0 pmk-line-height-1 pmk-left-n35 pmk-top-0" aria-hidden="true"></i>
        {% endif %}
      </div>
      <div class="row-content">
        {% if cpu.profiles is not empty %}
          <i
            title="{% trans %}This cpu only executes jobs from the following profiles:{% endtrans %} {{ cpu.profiles | join(', ')}}"
            class="mdi-action-info pmk-cursor-pointer pmk-border-radius-0 pmk-float-right"
            aria-hidden="true"
          >
          </i>
        {% endif %}
        <h4 class="list-group-item-heading">{{ name }} ({{ cpu.max }})</h4>
        <p class="list-group-item-text">{{ cpu.description|default('No description') }} (type: {{ cpu.type }})</p>
        <small>{{ cpu.host }}</small>
        <div>
          <div class="least-content togglebutton form-check form-switch pmk-bottom-10 pmk-top-inherit">
              {% if is_granted('ROLE_SCOPE_PERSONAL') %}
                  <label>
                      <input class="form-check-input" role="switch" type="checkbox" disabled {% if not deactivated %}checked="checked"{% endif %}>
                  </label>
              {% else %}
                    <label>
                        <input class="form-check-input" role="switch" id="maintenance-{{name}}-toggle" type="checkbox" {% if not deactivated %}checked="checked"{% endif %}
                               data-controller="encoder--cpu-maintenance"
                               data-action="click->encoder--cpu-maintenance#toggle"
                               data-encoder--cpu-maintenance-activate-url-value="{{ path('pumukit_encoder_cpu_maintenance_switch', {'activateMaintenance': 'activate', 'cpuName': name}) }}"
                               data-encoder--cpu-maintenance-deactivate-url-value="{{ path('pumukit_encoder_cpu_maintenance_switch', {'activateMaintenance': 'deactivate', 'cpuName': name}) }}">
                    </label>
              {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% endfor %}
</div>
