<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">{% trans %}Job info{% endtrans %}</h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body"
     data-controller="encoder--job"
     data-encoder--job-id-value="{{ job.id }}"
     data-encoder--job-update-url-value="{{ path('pumukit_encoder_update_job') }}"
     data-encoder--job-retry-url-value="{{ path('pumukit_encoder_retry_job', {'id': job.id}) }}"
     data-encoder--job-error-url-value="{{ path('pumukit_encoder_error_job') }}"
     data-encoder--job-delete-url-value="{{ path('pumukit_encoder_delete_job') }}">
    {% if app.user and is_granted(constant('Pumukit\\SchemaBundle\\Security\\Permission::ACCESS_JOBS')) %}
        <div class="box-body">
            <dl class="row">
                <dt class="col-sm-3">{% trans %}Id{% endtrans %}</dt>
                <dd class="col-sm-9">{{ job.id }}</dd>
                <dt class="col-sm-3">{% trans %}Status{% endtrans %}</dt>
                <dd class="col-sm-9 job-status-{{ job.status }}">{{ job.statusText }} <small>[{{ job.status }}]</small></dd>
                <dt class="col-sm-3">{% trans %}Mm{% endtrans %}</dt>
                <dd class="col-sm-9">{{ job.getMmId() }}</dd>
                <dt class="col-sm-3">{% trans %}Profile{% endtrans %}</dt>
                <dd class="col-sm-9">{{ job.getProfile() }}</dd>
                <dt class="col-sm-3">{% trans %}Cpu{% endtrans %}</dt>
                <dd class="col-sm-9">{{ job.getCpu() }}</dd>
                <dt class="col-sm-3">{% trans %}Duration{% endtrans %}</dt>
                <dd class="col-sm-9">{% trans %}Before{% endtrans %}: {{ job.duration|duration_string }}, {% trans %}after{% endtrans %}
                    : {{ job.getNewDuration()|duration_string }}</dd>
                <dt class="col-sm-3">{% trans %}Times{% endtrans %}</dt>
                <dd class="col-sm-9">{% trans %}Created{% endtrans %}
                    : {{ job.getTimeini()| format_datetime('medium','medium',locale=app.request.getLocale()) }}
                    , {% trans %}started{% endtrans %}
                    : {{ job.getTimestart()| format_datetime('medium','medium',app.request.getLocale()) }}
                    , {% trans %}finished{% endtrans %}
                    : {{ job.getTimeend()| format_datetime('medium','medium',app.request.getLocale()) }}</dd>
                <dt class="col-sm-3">{% trans %}Priority{% endtrans %}</dt>
                <dd class="col-sm-9">
                    {% if job.isPending() %}
                        <span id="job_info_priority_show" class="job_info_priority" data-encoder--job-target="priority">
          <span id="job_info_priority_show_val" data-encoder--job-target="priorityValue">{{ job.getPriority() }}</span>
          <a href="#" data-action="encoder--job#togglePriority"
             title="{% trans %}Edit priority{% endtrans %}">
            <i class="fa-solid fa-pencil"></i>
          </a>
        </span>
                        <span id="job_info_priority_edit" class="job_info_priority pmk-display-none" data-encoder--job-target="priority">
          <input type="number" max="3" min="1" value="{{ job.getPriority() }}" id="job_info_priority_edit_input" data-encoder--job-target="priorityInput"/>
          <a href="#"
             data-action="encoder--job#savePriority"
             title="{% trans %}Edit priority{% endtrans %}">
            <i class="fa-solid fa-floppy-disk"></i>
          </a>
        </span>
                    {% else %}
                        {{ job.getPriority() }}
                    {% endif %}
                </dd>
            </dl>

            <div class="shell-wrap">
                <p class="shell-top-bar">{% trans %}Output Command{% endtrans %}</p>
                <ul class="shell-body">
                    <li class="command">{{ command|e|replace({' ':'&nbsp;', '\n': '</li><li class="command">'})|raw }}</li>
                    <li>&nbsp;</li>
                    <li>{{ job.getOutput()|e|replace({' ':'&nbsp;', '\n': '</li><li>'})|raw }}</li>
                    {% if job.isExecuting() %}
                        <li>executing...</li>{% endif %}
                    {% if job.isPending() %}
                        <li>waiting...</li>{% endif %}
                </ul>
            </div>
        </div>
        <form enctype="multipart/form-data" action="#" method="POST">
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">{% trans %}Cancel{% endtrans %}</button>
                {% if job.isFailed() and not deletedMultimediaObject %}
                    <button type="submit" class="btn btn-pumukit"
                            data-action="encoder--job#retry"
                            data-bs-dismiss="modal">
                        {% trans %}RETRY{% endtrans %}
                    </button>
                {% endif %}
                {% if job.isWaiting() or job.isExecuting() %}
                    <button type="submit" class="btn btn-warning"
                            data-action="encoder--job#stop"
                            data-bs-dismiss="modal">
                        {% trans %}STOP{% endtrans %}
                    </button>
                {% endif %}
                {% if job.isFailed() or job.isWaiting() %}
                    <button type="submit" class="btn btn-danger"
                            data-action="encoder--job#remove"
                            data-bs-dismiss="modal">
                        {% trans %}DELETE{% endtrans %}
                    </button>
                {% endif %}
            </div>
        </form>
    {% else %}
        {% trans %}You don't have enough permissions to access this content.{% endtrans %}
    {% endif %}
</div>
