{% set isNaked = is_naked() %}
{% set lmsUrl = inbox_lms_upload_url() %}
{% set currentSeries = folder is defined ? folder : series.id %}
{% if isNaked and lmsUrl %}
    {% set endpoint = lmsUrl ~ '?' ~ {'series': currentSeries, 'username': username|default(''), 'email': email|default(''), 'hash': hash|default('')}|url_encode %}
{% else %}
    {% set endpoint = inboxUploadURL|default(inbox_upload_url()) ~ '?' ~ {'series': currentSeries, 'temporaryFolder': folder is defined ? '0' : '1'}|url_encode %}
{% endif %}
<div hidden {{ uploader_attributes({
    transport: 'tus',
    endpoint: endpoint,
    renameFiles: true,
    meta: {series: currentSeries},
    dashboard: {target: '#uploader_drag_and_drop'},
    import: isNaked
        ? {url: path('moodle_dispatch_import'), params: {username: username|default(''), email: email|default(''), hash: hash|default('')}, sendUuid: true}
        : {url: path('inbox_auto_import')}
}) }}></div>
