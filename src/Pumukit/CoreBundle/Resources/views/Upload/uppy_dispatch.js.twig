uppyTUS.on('upload-success', (file, response) => {
    const uploadURL = response?.uploadURL || response?.url;
    if (!uploadURL) return;

    const uuid = uploadURL.split('/').pop();
    uppyTUS.setFileState(file.id, { tusUuid: uuid });
    file.tusUuid = uuid;

    sendInboxXHRImportRequest(file);
});
