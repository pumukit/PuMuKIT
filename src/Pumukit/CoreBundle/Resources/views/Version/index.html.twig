{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block body %}
    <h1>{% trans %}Pumukit Bundle Versions{% endtrans %}</h1>

    <div class="well">
        <table class="table table-striped table-hover">
            <thead>
            <tr>
                <th>{% trans %}Type{% endtrans %}</th>
                <th>{% trans %}Name{% endtrans %}</th>
                <th>{% trans %}Version{% endtrans %}</th>
                <th>{% trans %}Commit{% endtrans %}</th>
                <th>{% trans %}Tags{% endtrans %}</th>
                <th>{% trans %}Description{% endtrans %}</th>
            </tr>
            </thead>
            <tbody>
                {% for item in pumukitPackages %}
                    <tr>
                        <td>{{ item.type }}</td>
                        <td>{{ item.name }}</td>
                        <td><span class="label label-success">{{ item.version }}</span></td>
                        <td>{{ item.source.reference|slice(0, 9)|default('') }}</td>
                        <td>
                            {% if item.keywords is defined %}
                                {% for keyword in item.keywords %}
                                    <span class="label label-info">{{ keyword }}</span>
                                {% endfor  %}
                            {% endif %}
                        </td>
                        <td>{{ item.description }}</td>
                    </tr>
                {% endfor %}
                {% for item in otherPackages %}
                    <tr class="otherPackages pmk-display-none">
                        <td>{{ item.type }}</td>
                        <td>{{ item.name }}</td>
                        <td><span class="label label-success">{{ item.version }}</span></td>
                        <td>{{ item.source.reference|slice(0, 9)|default('') }}</td>
                        <td>
                            {% if item.keywords is defined %}
                                {% for keyword in item.keywords %}
                                    <span class="label label-info">{{ keyword }}</span>
                                {% endfor  %}
                            {% endif %}
                        </td>
                        <td>{{ item.description }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <button id="expandOtherPackages" class="btn btn-primary" type="button" data-controller="core--toggle" data-core--toggle-selector-value=".otherPackages" data-action="core--toggle#toggle">{{ 'Other packages' | trans }}</button>
    </div>

{% endblock %}
