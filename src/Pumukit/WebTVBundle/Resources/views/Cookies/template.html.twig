{% if enable_cookie_banner is defined and enable_cookie_banner %}
    <div id="headercookie" class="cookielaw" data-controller="webtv--cookies" data-webtv--cookies-domain-value="{{ app.request.getHttpHost() }}">
        <div class="titlecookie">
            {{ "Cookies"|trans }}
        </div>
        <div class="textcookie">
            {% include '@PumukitWebTV/Cookies/cookies_text.html.twig' %}
            <div class="clearfix"></div>
            <button id="btn-accept-cookies" class="btn btn-secondary btn-accept-cookies pmk-margin-top-9" data-action="webtv--cookies#accept">{{ "Accept"|trans }}</button>
        </div>
    </div>
{% endif %}

