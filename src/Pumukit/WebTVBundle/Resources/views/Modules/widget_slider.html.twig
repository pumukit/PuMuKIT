<div class="block-media-pmk wall_block">
    {% include "@PumukitWebTV/Resources/template_widget_title.html.twig" %}
    <div id="carousel-wall" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-indicators">
            {% for multimediaObject in multimediaObjects %}
                <button type="button" data-bs-target="#carousel-wall" data-bs-slide-to="{{ loop.index0 }}" {% if loop.index == 1 %}class="active" aria-current="true"{% endif %} aria-label="{{ multimediaObject.getTitle() }}"></button>
            {% else %}
                <button type="button" data-bs-target="#carousel-wall" data-bs-slide-to="0" class="active" aria-current="true" aria-label="{% trans %}Carousel{% endtrans %}"></button>
            {% endfor %}
        </div>

        <div class="carousel-inner pmk-max-height-450">
            {% for multimediaObject in multimediaObjects %}
                <div class="carousel-item {% if loop.index == 1 %}active{% endif %}">
                    <a href="{{ path('pumukit_webtv_multimediaobject_index', {'id': multimediaObject.getId()}) }}">
                        <img class="pmk-min-width-100pct" src="{{ asset(multimediaObject|first_url_pic(true)) }}" alt="{{ multimediaObject.getTitle() }}">

                        <div class="carousel-caption">
                            <div class="background-title">
                                {{ multimediaObject.getTitle() }}
                            </div>
                        </div>
                    </a>
                </div>
            {% else %}
                <div class="carousel-item active">
                    <img class="pmk-width-100pct" src="{{ asset(posterEvent) }}" alt="{% trans %}Carousel{% endtrans %}">
                </div>
            {% endfor %}
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#carousel-wall" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carousel-wall" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>
