<div class="block-search-pmk pmk-margin-top-20">
    <div class="row">
        <div class="col-12">
            <form method="get" action="{{ path('pumukit_webtv_search_multimediaobjects') }}">
                <label for="Search" class="visually-hidden">
                    {% trans %}Search{% endtrans %}
                </label>
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="{% trans %}Search{% endtrans %}..." name="search" id="Search"/>
                    <button class="btn btn-secondary" type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </form>
        </div>
        <div class="col-12 text-end">
            <a title="{% trans %}Advanced search{% endtrans %}" href="{{ path('pumukit_webtv_search_multimediaobjects') }}">
                <small>{% trans %}Advanced search{% endtrans %}</small>
            </a>
        </div>
    </div>
</div>
