<div class="container-fluid breadcrumb-pmk">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb breadcrumb-pmk-list" data-controller="webtv--breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="{{ breadcrumbs[0]["link"] }}" {% if breadcrumbs|length == 1 %}class="active" aria-current="page"{% endif %} title="{{ breadcrumbs[0]["title"] }}">
                            {{ breadcrumbs[0]["title"] }}
                        </a>
                    </li>

                    {% if breadcrumbs|length > 1 %}
                        <li class="breadcrumb-item">
                            <a href="{{ breadcrumbs[1]["link"] }}" {% if breadcrumbs|length == 2 %}class="active" aria-current="page"{% endif %} title="{{ breadcrumbs[1]["title"] }}">
                                {{ breadcrumbs[1]["title"] }}
                            </a>
                        </li>
                    {% endif %}

                    {% if breadcrumbs|length > 2 %}
                        <li class="breadcrumb-item">
                            <a id="breadcrumbs_series_a" data-webtv--breadcrumb-target="series" href="{{ breadcrumbs[2]["link"] }}" {% if breadcrumbs|length == 3 %}class="active" aria-current="page"{% endif %} title="{{ breadcrumbs[2]["title"] }}">
                                {{ breadcrumbs[2]["title"] }}
                            </a>
                        </li>
                    {% endif %}

                    {% if breadcrumbs|length > 3 %}
                        <li class="breadcrumb-item">
                            <a id="breadcrumbs_mmobj_a" data-webtv--breadcrumb-target="multimediaObject" href="{{ breadcrumbs[3]["link"] }}" {% if breadcrumbs|length == 4 %}class="active" aria-current="page"{% endif %} title="{{ breadcrumbs[3]["title"] }}">
                                {{ breadcrumbs[3]["title"] }}
                            </a>
                        </li>
                    {% endif %}
                </ol>
            </div>
        </div>
    </div>
</div>

