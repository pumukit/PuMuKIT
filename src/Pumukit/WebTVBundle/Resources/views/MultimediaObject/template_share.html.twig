{% set trackid = (track.id is defined)?track.id:null %}
{% if (url is not defined or url is null) or (urlIframe is not defined or urlIframe is null) %}
    {% if multimediaObject.isVideoAudioType() %}
        {% if multimediaObject.isPublished %}
            {% set url = url('pumukit_webtv_multimediaobject_index', {'id': multimediaObject.id, 'track_id': trackid}) %}
            {% set urlIframe = url('pumukit_webtv_multimediaobject_iframe', {'id':multimediaObject.id, 'track_id': trackid}) %}
        {% else %}
            {% set url = url('pumukit_webtv_multimediaobject_magicindex', {'secret': multimediaObject.secret, 'track_id': trackid }) %}
            {% set urlIframe = url('pumukit_webtv_multimediaobject_magiciframe', {'secret': multimediaObject.secret, 'track_id': trackid }) %}
        {% endif %}
    {% else %}
        {% if multimediaObject.isPublished %}
            {% set url = url('pumukit_webtv_multimediaobject_index', {'id': multimediaObject.id, 'track_id': trackid}) %}
            {% set urlIframe = url('pumukit_player_index_iframe', {'id':multimediaObject.id, 'track_id': trackid}) %}
        {% else %}
            {% set url = url('pumukit_webtv_multimediaobject_magicindex', {'secret': multimediaObject.secret, 'track_id': trackid }) %}
            {% set urlIframe = url('pumukit_player_magic_index_iframe', {'secret': multimediaObject.secret, 'track_id': trackid }) %}
        {% endif %}
    {% endif %}
{% endif %}

<div class="card panel-pmk">
    <div class="card-header" data-bs-toggle="collapse" data-bs-target="#shareBars" aria-expanded="false" aria-controls="shareBars" role="button">
        <h2 class="card-title mb-0">
            {% trans %}Share this{% endtrans %}
            {% if multimediaObject.isVideoType() %}
                {{ multimediaObject.getStringType(multimediaObject.getType())|trans|lower }}
            {% elseif multimediaObject.isAudioType() %}
                {{ multimediaObject.getStringType(multimediaObject.getType())|trans|lower }}
            {% elseif multimediaObject.isImageType() %}
                {{ multimediaObject.getStringType(multimediaObject.getType())|trans|lower }}
            {% elseif multimediaObject.isDocumentType() %}
                {{ multimediaObject.getStringType(multimediaObject.getType())|trans|lower }}
            {% elseif multimediaObject.isExternalType() %}
                {{ multimediaObject.getStringType(multimediaObject.getType())|trans|lower ~" multimedia object"|trans|lower }}
            {% endif %}
        </h2>
    </div>
    <div class="card-body">
        <div class="row"><div class="qa-player-share-facebook col-md-4 offset-md-2 text-center block_facebook">
            <div class="fb-share-button" data-href="{{ url }}" data-layout="button" data-size="large"></div>
        </div>
        <div class="qa-player-share-twitter col-md-4 text-center block_twitter">
            <a target="_blank" href="https://twitter.com/intent/tweet?text={{ multimediaObject.getTitle() }}&url={{ url }}" title="{% trans %}Share on Twitter{% endtrans %}">
                <i class="fa fa-twitter fa-2x"></i>
            </a>
        </div></div>
    </div>
    <ul class="list-group">
        <li class="list-group-item list-group-item-pmk">
            <div class="qa-player-share-url share_url">
                <span>{% trans %} URL: {% endtrans %}</span>
                <input class="pmk-width-70pct pmk-border-1-solid-ccc pmk-float-right pmk-padding-0 pmk-margin-0" type="text" value="{{ url }}" aria-label="share-url" data-controller="core--select" data-action="click->core--select#select" readonly="readonly" />
            </div>
        </li>
        <li class="list-group-item list-group-item-pmk">
            <div class="qa-player-share-iframe share_url share_iframe">
                <span>{% trans %} IFRAME: {% endtrans %}</span>
                {% set trackid = (track.id is defined)?track.id:null %}
                {% set iframe_value %}{% apply pumukit_spaceless %}
                    <iframe src='{{ urlIframe }}'
                            {{- " id='pumukitiframe'" -}}
                            {{- " frameborder='0'" -}}
                            {{- " border='0'" -}}
                            {{- " width='560'" -}}
                            {{- " height='315'" -}}
                            {{- " allowfullscreen" -}}
                            {{- " loading='lazy'" -}}
                    ></iframe>
                {% endapply %}{% endset %}
                <input class="pmk-width-70pct pmk-border-1-solid-ccc pmk-float-right pmk-padding-0 pmk-margin-0" type="text" value="{{ iframe_value }}" aria-label="share-iframe" data-controller="core--select" data-action="click->core--select#select" readonly="readonly" />
            </div>
        </li>
    </ul>
</div>

<div hidden data-controller="core--external-script" data-core--external-script-src-value="https://connect.facebook.net/en_US/sdk.js#xfbml=1&amp;version=v3.0" data-core--external-script-script-id-value="facebook-jssdk"></div>
