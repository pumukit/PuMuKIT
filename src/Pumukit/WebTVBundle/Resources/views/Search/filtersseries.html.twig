<form class="row" id="form_search" name="busqueda" method="get" data-controller="webtv--search" action="{{ path('pumukit_webtv_search_series') }}">
    <input class="pmk-display-none" type="submit" value="submit-hidden" aria-hidden="true"/>
    <div class="mb-3 col-md-4">
        <label for="search">{% trans %}Search{% endtrans %}:</label>
        <div class="input-group">
            <input type="text" class="form-control" id="search" name="search" value="{{ app.request.query.get('search') }}" placeholder="{% trans %}Search{% endtrans %}">
            <button type="submit" class="btn btn-secondary" aria-label="search">
                <span class="visually-hidden">{% trans %}Search{% endtrans %}</span>
                <span class="fa fa-search"></span>
            </button>
        </div>
    </div>


    <div class="mb-3 col-md-6 col-sm-10 col-12">
        <div class="row">
            {% set activated = app.request.query.get('start') or app.request.query.get('end') %}
            <div class="row{{ activated ? '' : ' pmk-display-none' }}" id="advanced-date-search" data-webtv--search-target="advancedDate">
                <div class="col-6">
                    <span class="pmk-white-space-nowrap pmk-overflow-hidden">
                        <label id="start-date" for="start">{% trans %}Start date{% endtrans %}:</label>
                        <a class="pmk-margin-right-n15 pmk-cursor-pointer" data-action="webtv--search#toggleDates">{% trans %} Select by year {% endtrans %}</a>
                    </span>
                    <div class="date date-picker" id='start' data-webtv--search-target="start">
                        <input type="date" class="form-control" dataformat="" name="start" value="{{ app.request.query.get('start') }}" placeholder="{% trans %}From{% endtrans %}" data-action="change->webtv--search#submit" aria-labelledby="start-date" {{ activated?'':'disabled' }}/>
                    </div>
                </div>
                <div class="col-6">
                    <label id="end-date" for="end">{% trans %}Finish date{% endtrans %}:</label>
                    <div class="date date-picker" id="end" data-webtv--search-target="end">
                        <input type="date" class="form-control" name="end" value="{{ app.request.query.get('end') }}" placeholder="{% trans %}Until{% endtrans %}" data-action="change->webtv--search#submit" aria-labelledby="end-date" {{ activated?'':'disabled' }}/>
                    </div>
                </div>
            </div>
            <div class="row{{ activated ? ' pmk-display-none' : '' }}" id="simple-date-search" data-webtv--search-target="simpleDate">
                <div class="col-md-12 col-12">
                    <label for="year">{% trans %}Year{% endtrans %}</label>
                    <a class="pmk-padding-left-20 pmk-cursor-pointer" data-action="webtv--search#toggleDates">{% trans %}Select by date range {% endtrans %}</a>
                    <select id='year' data-webtv--search-target="year" name='year' class='form-select' data-action="webtv--search#submit" {{ activated?'disabled':'' }}>
                        <option value="" {% if app.request.query.get('year') == "" %} selected="selected" {% endif %}>
                            {% trans %}Any{% endtrans %}
                        </option>
                        {% for year in search_years %}
                            <option value="{{ year }}" {% if app.request.query.get('year') == year %} selected="selected" {% endif %}>
                                {{ year }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="mb-3 col-md-2 col-sm-2 col-12">
        <label for="reset">{% trans %}Reset filters{% endtrans %}:</label>
        <input id="reset" type="button" class="btn btn-secondary form-control" id="exampleInputEmail1" placeholder="{% trans %}Email{% endtrans %}" value="{% trans %}Reset filters{% endtrans %}" data-action="click->webtv--search#reset" />
    </div>

</form>

<div class="row"><div class="col-12">
    <a href="{{ path('pumukit_webtv_search_multimediaobjects') }}">
        {% trans %}Search by multimedia objects{% endtrans %}
    </a>
</div></div>
