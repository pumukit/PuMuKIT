
{% if true and live %}
    <div class="card panel-pmk event-chat-panel"
         data-controller="webtv--chat"
         data-webtv--chat-post-url-value="{{ path('pumukit_live_chat_basic_post', {'id': live.id}) }}"
         data-webtv--chat-list-url-value="{{ path('pumukit_live_chat_basic_list', {'id': live.id}) }}"
         data-webtv--chat-interval-value="{{ chatUpdateInterval }}">
        <div class="card-header chat-panel-heading">
            <div class="panel-heading-table">
                <div class="panel-heading-table-row">
                    <div class="panel-heading-table-cell">{% trans %}Live chat{% endtrans %}</div>
                    <div class="panel-heading-table-cell panel-heading-image">
                        <img src="{{ asset('bundles/pumukitwebtv/images/chat.svg') }}" alt="{% trans %}Chat icon{% endtrans %}" title="{% trans %}Chat icon{% endtrans %}" class="chat-icon-heading"/>
                    </div>
                </div>
            </div>
        </div>
        <div id="chat-panel-body" data-webtv--chat-target="body" class="card-body" style="height:200px;overflow: auto;">
            <div id="chatList" data-webtv--chat-target="list" style="overflow: hidden;">
                {{ render(controller('Pumukit\\WebTVBundle\\Controller\\ChatController::listBasicAction', {'id': live.id})) }}
            </div>
        </div>
        <div class="card-footer">
            <form id="chatForm" data-action="webtv--chat#submit" action="{{ path('pumukit_live_chat_basic_post', {'id': live.id}) }}" method="post">
                <fieldset>
                    <div id="event-chat-form-name" class="mb-3" data-webtv--chat-target="nameGroup">
                        <label for="name">{% trans %}Name{% endtrans %}:</label>
                        <input type="text" name="name" id="chatName" data-webtv--chat-target="name" maxlength="30" class="form-control" value="{{ username }}" {{ username ? 'disabled':'' }}/>
                        <div id="chat-name-error" class="chat-name-error" data-webtv--chat-target="nameError">{% trans %}Name cannot be empty{% endtrans %}</div>
                    </div>
                    <div class="mb-3">
                        <label for="name">{% trans %}Message{% endtrans %}:</label>
                        <input type="textarea" name="message" id="chatMessage" data-webtv--chat-target="message" data-action="keypress->webtv--chat#keypress" wrap="virtual" class="form-control chatInputMessage" value=""/>
                    </div>
                </fieldset>
            </form>
        </div>
    </div>

{% endif %}
