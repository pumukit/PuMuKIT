<script src='https://www.google.com/recaptcha/api.js'></script>

<div class="row">
    <div class="col-12 col-sm-8 col-md-8">

        <a class="btn btn-secondary pmk-margin-bottom-20" role="button" data-bs-toggle="collapse" href="#collapseEmail" aria-expanded="false" aria-controls="collapseEmail">
            {% trans %}Questions{% endtrans %}
        </a>

        <div class="collapse pmk-padding-20" id="collapseEmail" data-controller="webtv--contact">

            <div class="pmk-visible-none pmk-padding-10" id="captcha_message" data-webtv--contact-target="message"></div>

            {{ form_start(contact, {'attr': {'id': 'contact_us', 'data-webtv--contact-target': 'form', 'data-action': 'webtv--contact#submit'},'action': path('pumukit_webtv_contact_event', {'id': multimediaObject.getId()}), 'method': 'POST'}) }}
                {{ form_row(contact.name) }}
                {{ form_row(contact.email) }}
                {{ form_row(contact.content) }}
                <div class="g-recaptcha" data-sitekey="{{ captcha_public_key }}"></div>
                <button type="submit" class="btn btn-primary pmk-margin-top-10">
                    {% trans %}Send{% endtrans %}
                </button>
            {{ form_end(contact) }}

        </div>
    </div>
</div>

