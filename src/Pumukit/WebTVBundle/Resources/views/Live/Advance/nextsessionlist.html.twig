{% if events and events[0]['data'] %}
    <div class="card panel-pmk">
        <div class="card-header">
            <h2 class="card-title mb-0">
                {% trans %}Next session{% endtrans %}
            </h2>
        </div>
        <div class="card-body">
            {% for event in events[0]['data'] %}
                {% include '@PumukitWebTV/Resources/template_event_vertical.html.twig' %}
            {% endfor %}
        </div>
    </div>
{% endif %}
