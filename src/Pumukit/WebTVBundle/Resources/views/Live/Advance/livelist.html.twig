{% if events|length > 0 %}
    <div class="card panel-pmk">
        <div class="card-header">
            <h2 class="card-title mb-0">
                {% trans %}Live events{% endtrans %}
            </h2>
        </div>
        <div class="card-body">
            {% if events|length > 0 %}
                {% for key, event in events %}
                    {% include '@PumukitWebTV/Resources/template_event_vertical.html.twig' with {'event': event['data'] } %}
                {% endfor %}
            {% endif %}
        </div>
    </div>
{% endif %}
