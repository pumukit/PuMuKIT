.header-pmk .header-logo {
    margin-right:0;
    margin-bottom:10px;
    margin-left:0;
}

.header-pmk .header-logo div {
    padding-left:0;
    padding-right:0;
}

.header-pmk, .header-top-pmk, .header-bottom-pmk {
    padding-left:0;
    padding-right:0;
}

.header-pmk .header-top-pmk {
    padding:5px;
    font-size:14px;
}

.navbar-custom-links a:hover {
    color: #000000 !important;
}

.navbar-custom .navbar-nav .nav-link.active, .navbar-custom .navbar-nav .nav-link.active:hover, .navbar-custom .navbar-nav .nav-link.active:focus {
    background-color: #443A32;
}

.navbar-custom .navbar-nav .nav-link {
    color: #ffffff;
}

.navbar-custom .navbar-nav .nav-link:hover {
    color: #ffffff;
}

.navbar-custom-links a:active {
    text-decoration: none;
    color: #ffffff;
}

