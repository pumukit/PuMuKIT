{% if clearFixIndex is not defined %}
    {% set clearFixIndex = loop.index %}
{% endif %}

{% if add_clear_fix_md(clearFixIndex, objectByCol) %}
    <div class="w-100 d-none d-md-block"></div>
{% endif %}
{% if add_clear_fix_sm(clearFixIndex, objectByCol) %}
    <div class="w-100 d-none d-sm-block d-md-none"></div>
{% endif %}
