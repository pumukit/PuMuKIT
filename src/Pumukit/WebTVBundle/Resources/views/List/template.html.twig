{% extends '@PumukitWebTV/layout.html.twig' %}

{% block title %}{{ parent() }} - {{ title }}{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-12">
            <h1>{{ title }}</h1>
        </div>

        {% if scroll_list %}
            <div data-controller="webtv--announces" data-webtv--announces-url-value="{{ path(scroll_list_path, { (scroll_element_key) : scroll_element_value, 'type': type}) }}">
                <div class="announces" id="announces" data-webtv--announces-target="list"></div>
                <div class="pmk-display-none" id="announces_loading" data-webtv--announces-target="loading">
                    <img alt="spinner" class="d-block mx-auto" src="{{ asset('bundles/pumukitwebtv/images/icons/spinner.gif') }}"/>
                </div>
            </div>
        {% else %}
            {% include '@PumukitWebTV/List/template_list.html.twig' %}
            {% include '@PumukitWebTV/Misc/pager.html.twig' %}
        {% endif %}
    </div>
{% endblock %}
