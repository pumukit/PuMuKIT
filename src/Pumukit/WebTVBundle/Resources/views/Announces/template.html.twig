{% extends '@PumukitWebTV/layout.html.twig' %}
{% set title = template_title %}

{% block title %}{{ parent() }} - {{ title }}{% endblock %}

{% block body %}
    {% include "@PumukitWebTV/Misc/page_title.html.twig" %}

    <div data-controller="webtv--announces" data-webtv--announces-url-value="{{ path('pumukit_webtv_announces_latestuploads_pager') }}">
        <div class="announces" id="announces" data-webtv--announces-target="list"></div>

        <div class="noMmo" id="noMmo" hidden data-webtv--announces-target="empty">
            <h2>{% trans %}There are no multimedia objects{% endtrans %}</h2>
        </div>

        <div id="announces_loading" style="display:none" data-webtv--announces-target="loading">
            <img alt="spinner" class="d-block mx-auto" src="{{ asset('bundles/pumukitwebtv/images/icons/spinner.gif') }}"/>
        </div>
    </div>

{% endblock %}
