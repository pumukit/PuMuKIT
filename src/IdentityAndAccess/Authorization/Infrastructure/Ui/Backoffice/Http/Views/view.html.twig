{% extends '@Shared/Views/layout/layout.html.twig' %}

{% block body %}
    <div class="container-fluid mt-3">

        {% include '@PermissionProfile/Views/partials/_permission_profile_header.html.twig' with {
            permissionProfile: permissionProfile
        } %}

        <ul class="nav nav-tabs modern-tabs text-uppercase small flex-wrap justify-content-start" role="tablist">
            {% for tabItem in tabs %}
                <li class="nav-item">
                    <a class="nav-link {{ tab == tabItem.key ? 'active' : '' }}"
                       href="{{ path('permission_profile_view', {id: permissionProfile.id, tab: tabItem.key}) }}">
                        {% if tabItem.icon %}
                            <i class="fa {{ tabItem.icon }} me-1"></i>
                        {% endif %}
                        {{ tabItem.label|trans }}
                    </a>
                </li>
            {% endfor %}
        </ul>

        <div class="mt-3">
            {% set currentTab = tabs[tab] ?? tabs['general'] %}
            {% if currentTab.template %}
                {% include currentTab.template %}
            {% else %}
                <div class="alert alert-warning">
                    Tab template not found: {{ currentTab.template }}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

