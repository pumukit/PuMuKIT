<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">
            <i class="fa fa-shield-alt me-2"></i>
            {{ permissionProfile.name }}
        </h2>
        <div class="text-muted">
            <span class="badge bg-{{ permissionProfile.scope == 'ROLE_SCOPE_GLOBAL' ? 'primary' : (permissionProfile.scope == 'ROLE_SCOPE_PERSONAL' ? 'info' : 'secondary') }}">
                {{ permissionProfile.scope }}
            </span>
            {% if permissionProfile.system %}
                <span class="badge bg-danger ms-2">
                    <i class="fa fa-lock"></i> System
                </span>
            {% endif %}
            {% if permissionProfile.default %}
                <span class="badge bg-success ms-2">
                    <i class="fa fa-star"></i> Default
                </span>
            {% endif %}
        </div>
    </div>
    <div>
{#        <a href="{{ path('permission_profile_update', {id: permissionProfile.id}) }}" class="btn btn-primary">#}
{#            <i class="fa fa-edit"></i> Edit#}
{#        </a>#}
        {% if not permissionProfile.system %}
            <a href="{{ path('permission_profile_delete', {id: permissionProfile.id}) }}"
               class="btn btn-danger"
               onclick="return confirm('Are you sure you want to delete this permission profile?');">
                <i class="fa fa-trash"></i> Delete
            </a>
        {% endif %}
    </div>
</div>

