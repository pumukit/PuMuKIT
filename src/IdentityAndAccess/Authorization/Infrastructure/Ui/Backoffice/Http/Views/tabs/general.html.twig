<div class="card">
    <div class="card-body">
        <h5 class="card-title">
            <i class="fa fa-info-circle me-2"></i>
            General Information
        </h5>

        <div class="row">
            <div class="col-md-6">
                <table class="table table-striped">
                    <tbody>
                        <tr>
                            <th width="30%">ID</th>
                            <td>{{ permissionProfile.id }}</td>
                        </tr>
                        <tr>
                            <th>Name</th>
                            <td>{{ permissionProfile.name }}</td>
                        </tr>
                        <tr>
                            <th>Scope</th>
                            <td>
                                <span class="badge bg-{{ permissionProfile.scope == 'ROLE_SCOPE_GLOBAL' ? 'primary' : (permissionProfile.scope == 'ROLE_SCOPE_PERSONAL' ? 'info' : 'secondary') }}">
                                    {{ permissionProfile.scope }}
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <th>System Profile</th>
                            <td>
                                {% if permissionProfile.system %}
                                    <i class="fa fa-check-circle text-success"></i> Yes
                                {% else %}
                                    <i class="fa fa-times-circle text-danger"></i> No
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>Default Profile</th>
                            <td>
                                {% if permissionProfile.default %}
                                    <i class="fa fa-check-circle text-success"></i> Yes
                                {% else %}
                                    <i class="fa fa-times-circle text-danger"></i> No
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>Rank</th>
                            <td>{{ permissionProfile.rank ?? 'N/A' }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="col-md-6">
                <div class="alert alert-info">
                    <h6><i class="fa fa-info-circle"></i> About Scopes</h6>
                    <ul class="mb-0">
                        <li><strong>Global:</strong> Access to all content</li>
                        <li><strong>Personal:</strong> Access to own content only</li>
                        <li><strong>None:</strong> No scope restrictions</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
