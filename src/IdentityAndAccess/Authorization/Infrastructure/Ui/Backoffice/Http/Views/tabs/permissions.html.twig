<div class="card">
    <div class="card-body">
        <h5 class="card-title">
            <i class="fa fa-key me-2"></i>
            Permissions ({{ permissionProfile.permissions|length }})
        </h5>

        {% if permissionProfile.permissions is empty %}
            <div class="alert alert-warning">
                <i class="fa fa-exclamation-triangle"></i>
                No permissions assigned to this profile.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th width="5%">#</th>
                            <th width="40%">Permission Key</th>
                            <th width="55%">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for permission in permissionProfile.permissions %}
                            <tr>
                                <td>{{ loop.index }}</td>
                                <td>
                                    <code>{{ permission }}</code>
                                </td>
                                <td>
                                    <span class="text-muted">{{ permission|split('.')|last|title }}</span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-3">
                <p class="text-muted">
                    <i class="fa fa-info-circle"></i>
                    <strong>Total:</strong> {{ permissionProfile.permissions|length }} permission(s) assigned
                </p>
            </div>
        {% endif %}
    </div>
</div>

