<div class="card">
    <div class="card-body">
        <h5 class="card-title">
            <i class="fa fa-info-circle me-2"></i>
            {{ 'group.general.title'|trans({}, 'group') }}
        </h5>

        <div class="row">
            <div class="col-md-6">
                <table class="table table-striped">
                    <tbody>
                        <tr>
                            <th width="30%">{{ 'group.general.field.id'|trans({}, 'group') }}</th>
                            <td>{{ group.id }}</td>
                        </tr>
                        <tr>
                            <th>{{ 'group.general.field.key'|trans({}, 'group') }}</th>
                            <td><code>{{ group.key }}</code></td>
                        </tr>
                        <tr>
                            <th>{{ 'group.general.field.name'|trans({}, 'group') }}</th>
                            <td>{{ group.name }}</td>
                        </tr>
                        <tr>
                            <th>{{ 'group.general.field.origin'|trans({}, 'group') }}</th>
                            <td>
                                <span class="badge bg-info">
                                    {{ group.origin ?? 'local' }}
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <th>{{ 'group.general.field.comments'|trans({}, 'group') }}</th>
                            <td>{{ group.comments|default('group.common.na'|trans({}, 'group')) }}</td>
                        </tr>
                        <tr>
                            <th>{{ 'group.general.field.created_at'|trans({}, 'group') }}</th>
                            <td>
                                {% if group.createdAt %}
                                    {{ group.createdAt|date('Y-m-d H:i:s') }}
                                {% else %}
                                    {{ 'group.common.na'|trans({}, 'group') }}
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>{{ 'group.general.field.updated_at'|trans({}, 'group') }}</th>
                            <td>
                                {% if group.updatedAt %}
                                    {{ group.updatedAt|date('Y-m-d H:i:s') }}
                                {% else %}
                                    {{ 'group.common.na'|trans({}, 'group') }}
                                {% endif %}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="col-md-6">
                <div class="alert alert-info">
                    <h6><i class="fa fa-info-circle"></i> {{ 'group.general.about_title'|trans({}, 'group') }}</h6>
                    <p class="mb-0">
                        {{ 'group.general.about_description'|trans({}, 'group') }}
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

