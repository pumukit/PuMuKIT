<div class="card">
    <div class="card-body">
        <h5 class="card-title">
            <i class="fa fa-photo-video me-2"></i>
            Multimedia Objects Associated with this Group
        </h5>

        {% set multimediaObjects = tabData.multimedia_objects|default([]) %}

        {% if multimediaObjects is empty %}
            <div class="alert alert-info">
                <i class="fa fa-info-circle"></i>
                No multimedia objects are currently associated with this group.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="groupMultimediaObjectsTable">
                    <thead>
                        <tr>
                            <th width="5%">#</th>
                            <th width="30%">Id</th>
                            <th width="30%">Title</th>
                            <th width="30%">Series</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for mmObject in multimediaObjects %}
                            <tr>
                                <td>{{ loop.index }}</td>
                                <td>
                                    {{ mmObject.id }}
                                </td>
                                <td>
                                    <strong>{{ mmObject.title[app.request.getLocale()] }}</strong>
                                </td>
                                <td>
                                    <i class="fa fa-folder me-1"></i>
                                    {{ mmObject.series }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-3">
                <p class="text-muted">
                    <i class="fa fa-info-circle"></i>
                    <strong>Total:</strong> {{ multimediaObjects|length }} multimedia object(s) associated with this group
                </p>
            </div>
        {% endif %}

        <div class="alert alert-info mt-3">
            <h6><i class="fa fa-info-circle"></i> About Multimedia Objects</h6>
            <p class="mb-0">
                This list shows all multimedia objects that have this group in their permissions or groups field.
                Users in this group may have access to these multimedia objects depend ing on the permission profile.
            </p>
        </div>
    </div>
</div>
