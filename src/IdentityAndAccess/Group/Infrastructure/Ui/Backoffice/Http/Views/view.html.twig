{% extends '@Shared/Views/layout/layout.html.twig' %}

{% block body %}
    <div class="container-fluid mt-3">

        {% include '@Group/Views/partials/_group_header.html.twig' with {
            group: group
        } %}

        <div class="tabs-scroll">
            <ul class="nav nav-tabs modern-tabs text-uppercase small mobile-tabs">
                {% for t in tabs %}
                    <li class="nav-item">
                        <a class="nav-link {{ t.key == activeTab.key ? 'active' : '' }}"
                           href="{{ path('group_view', {id: group.id, tab: t.key}) }}">
                            <i class="fa {{ t.icon }}"></i> {{ t.label|trans({}, 'group') }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>

        <div class="tab-content mt-4">
            {% include activeTab.template with activeTab.parameters|merge({'group': group}) %}
        </div>
    </div>
{% endblock %}
