<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="card-title mb-0">
                <i class="fa fa-users me-2"></i>
                Users in this Group
            </h5>
            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addUserModal">
                <i class="fa fa-plus"></i> Add User
            </button>
        </div>

        {% include '@Shared/Views/components/table/_table.html.twig' with {
            id: 'groupUsersTable',
            server_side: true,
            ajax_url: path('group_users_data', {id: group.id}),
            checkbox: false,
            columns: [
                {'field': 'username', 'label': 'Username', 'sortable': true},
                {'field': 'full_name', 'label': 'Full Name', 'sortable': true},
                {'field': 'email', 'label': 'Email', 'sortable': true},
                {'field': 'enabled', 'label': 'Enabled', 'formatter': 'boolean', 'sortable': true},
                {'field': 'last_login', 'label': 'Last Login', 'sortable': true},
                {'field': 'origin', 'label': 'Origin', 'sortable': true},
                {'field': 'actions', 'label': 'Actions', 'align': 'right'}
            ],
        } %}
    </div>
</div>

<!-- Add User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addUserModalLabel">
                    <i class="fa fa-user-plus"></i> Add User to Group
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addUserForm" action="{{ path('group_add_user', {id: group.id}) }}" method="post">
                    <div class="mb-3">
                        <label for="user_select" class="form-label">Select User</label>
                        <select class="form-select" id="user_select" name="user_id" required>
                            <option value="">-- Select a user --</option>
                        </select>
                        <div class="form-text">Select a user to add to this group</div>
                    </div>
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle"></i>
                        Only users not already in this group will be shown.
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times"></i> Cancel
                </button>
                <button type="submit" form="addUserForm" class="btn btn-success">
                    <i class="fa fa-plus"></i> Add User
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// Handle remove user click
document.addEventListener('DOMContentLoaded', function() {
    document.addEventListener('click', function(e) {
        if (e.target.closest('.remove-user-btn')) {
            const btn = e.target.closest('.remove-user-btn');
            const userId = btn.dataset.userId;
            const userName = btn.dataset.userName;
            const groupId = btn.dataset.groupId;

            if (!confirm('Are you sure you want to remove user "' + userName + '" from this group?')) {
                return;
            }

            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '{{ path('group_remove_user', {id: group.id}) }}';

            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'user_id';
            input.value = userId;

            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }
    });

    // Initialize Select2 for better user selection (if available)
    const userSelect = document.getElementById('user_select');
    if (userSelect && typeof $ !== 'undefined' && $.fn.select2) {
        $(userSelect).select2({
            placeholder: 'Search for a user...',
            ajax: {
                url: '{{ path('users_list_data') }}',
                dataType: 'json',
                delay: 250,
                processResults: function (data) {
                    return {
                        results: data.rows.map(function(user) {
                            return {
                                id: user.id,
                                text: user.username + ' (' + user.email + ')'
                            };
                        })
                    };
                },
                cache: true
            },
            minimumInputLength: 2
        });
    }
});
</script>

