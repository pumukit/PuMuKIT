<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="card-title mb-0">
                <i class="fa fa-users me-2"></i>
                Users in this Group
            </h5>
            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addUserModal">
                <i class="fa fa-plus"></i> Add User
            </button>
        </div>

        {% set users = group.users %}

        {% if users is empty %}
            <div class="alert alert-info">
                <i class="fa fa-info-circle"></i>
                No users are currently assigned to this group.
                Click "Add User" to assign users to this group.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="groupUsersTable">
                    <thead>
                        <tr>
                            <th width="5%">#</th>
                            <th width="20%">Username</th>
                            <th width="25%">Full Name</th>
                            <th width="25%">Email</th>
                            <th width="15%">Enabled</th>
                            <th width="10%" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td>{{ loop.index }}</td>
                                <td>
                                    <i class="fa fa-user me-1"></i>
                                    {{ user.username }}
                                </td>
                                <td>{{ user.fullName|default('N/A') }}</td>
                                <td>{{ user.email|default('N/A') }}</td>
                                <td>
                                    {% if user.enabled %}
                                        <span class="badge bg-success">
                                            <i class="fa fa-check"></i> Yes
                                        </span>
                                    {% else %}
                                        <span class="badge bg-danger">
                                            <i class="fa fa-times"></i> No
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            onclick="removeUserFromGroup('{{ user.id }}', '{{ user.username }}')"
                                            title="Remove user from group">
                                        <i class="fa fa-user-times"></i>
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-3">
                <p class="text-muted">
                    <i class="fa fa-info-circle"></i>
                    <strong>Total:</strong> {{ users|length }} user(s) in this group
                </p>
            </div>
        {% endif %}
    </div>
</div>

<!-- Add User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addUserModalLabel">
                    <i class="fa fa-user-plus"></i> Add User to Group
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addUserForm" action="{{ path('group_add_user', {id: group.id}) }}" method="post">
                    <div class="mb-3">
                        <label for="user_select" class="form-label">Select User</label>
                        <select class="form-select" id="user_select" name="user_id" required>
                            <option value="">-- Select a user --</option>
                            {# This would be populated via AJAX or server-side #}
                        </select>
                        <div class="form-text">Select a user to add to this group</div>
                    </div>
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle"></i>
                        Only users not already in this group will be shown.
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times"></i> Cancel
                </button>
                <button type="submit" form="addUserForm" class="btn btn-success">
                    <i class="fa fa-plus"></i> Add User
                </button>
            </div>
        </div>
    </div>
</div>

<script>
function removeUserFromGroup(userId, username) {
    if (!confirm('Are you sure you want to remove user "' + username + '" from this group?')) {
        return;
    }

    // Create a form and submit it
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '{{ path('group_remove_user', {id: group.id}) }}';

    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'user_id';
    input.value = userId;

    form.appendChild(input);
    document.body.appendChild(form);
    form.submit();
}

// Initialize Select2 for better user selection (if available)
document.addEventListener('DOMContentLoaded', function() {
    const userSelect = document.getElementById('user_select');
    if (userSelect && typeof $ !== 'undefined' && $.fn.select2) {
        $(userSelect).select2({
            placeholder: 'Search for a user...',
            ajax: {
                url: '{{ path('users_list_data') }}',
                dataType: 'json',
                delay: 250,
                processResults: function (data) {
                    return {
                        results: data.rows.map(function(user) {
                            return {
                                id: user.id,
                                text: user.username + ' (' + user.email + ')'
                            };
                        })
                    };
                },
                cache: true
            },
            minimumInputLength: 2
        });
    }
});
</script>

