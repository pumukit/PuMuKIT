{% include '@Shared/Views/components/table/_table.html.twig' with {
    id: 'groupUsersTable',
    server_side: true,
    ajax_url: path('group_users_data', {id: group.id}),
    checkbox: true,
    search: false,
    columns: [
        {'field': 'username', 'label': 'group.users.table.username'|trans({}, 'group'), 'sortable': true},
        {'field': 'full_name', 'label': 'group.users.table.full_name'|trans({}, 'group'), 'sortable': true},
        {'field': 'email', 'label': 'group.users.table.email'|trans({}, 'group'), 'sortable': true},
        {'field': 'actions', 'label': 'group.users.table.actions'|trans({}, 'group'), 'align': 'right'}
    ],
} %}

<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addUserModalLabel">
                    <i class="fa fa-user-plus"></i> {{ 'group.users.modal.title'|trans({}, 'group') }}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addUserForm" action="{{ path('group_add_user', {id: group.id}) }}" method="post">
                    <div class="mb-3">
                        <label for="user_select" class="form-label">{{ 'group.users.modal.field.user'|trans({}, 'group') }}</label>
                        <select class="form-select" id="user_select" name="user_id" required>
                            <option value="">{{ 'group.users.modal.field.user_placeholder'|trans({}, 'group') }}</option>
                        </select>
                        <div class="form-text">{{ 'group.users.modal.field.user_help'|trans({}, 'group') }}</div>
                    </div>
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle"></i>
                        {{ 'group.users.modal.info'|trans({}, 'group') }}
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times"></i> {{ 'group.users.modal.button.cancel'|trans({}, 'group') }}
                </button>
                <button type="submit" form="addUserForm" class="btn btn-success">
                    <i class="fa fa-plus"></i> {{ 'group.users.modal.button.add'|trans({}, 'group') }}
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// Handle remove user click
document.addEventListener('DOMContentLoaded', function() {
    document.addEventListener('click', function(e) {
        if (e.target.closest('.remove-user-btn')) {
            const btn = e.target.closest('.remove-user-btn');
            const userId = btn.dataset.userId;
            const userName = btn.dataset.userName;
            const groupId = btn.dataset.groupId;

            const confirmMessage = '{{ 'group.users.confirm_remove'|trans({}, 'group') }}'.replace('%username%', userName);
            if (!confirm(confirmMessage)) {
                return;
            }

            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '{{ path('group_remove_user', {id: group.id}) }}';

            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'user_id';
            input.value = userId;

            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }
    });

    // Initialize Select2 for better user selection (if available)
    const userSelect = document.getElementById('user_select');
    if (userSelect && typeof $ !== 'undefined' && $.fn.select2) {
        $(userSelect).select2({
            placeholder: '{{ 'group.users.search_placeholder'|trans({}, 'group') }}',
            ajax: {
                url: '{{ path('users_list_data') }}',
                dataType: 'json',
                delay: 250,
                processResults: function (data) {
                    return {
                        results: data.rows.map(function(user) {
                            return {
                                id: user.id,
                                text: user.username + ' (' + user.email + ')'
                            };
                        })
                    };
                },
                cache: true
            },
            minimumInputLength: 2
        });
    }
});
</script>

