<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 text-primary">
            <i class="fa fa-edit me-2"></i>
            {{ 'group.update.title'|trans({}, 'group') }}
        </h5>
    </div>

    <div class="card-body p-4">
        {{ form_start(form, {
            'action': path('group_update', {id: group.id}),
            'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}
        }) }}

        <div class="row g-4">
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.key, 'group.update.field.key'|trans({}, 'group'), {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.key, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': 'group.update.field.key_help'|trans({}, 'group')
                        }
                    }) }}
                    <div class="form-text text-muted small">{{ 'group.update.field.key_help'|trans({}, 'group') }}</div>
                    {{ form_errors(form.key) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.name, 'group.update.field.name'|trans({}, 'group'), {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.name) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.origin, 'group.update.field.origin'|trans({}, 'group'), {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.origin, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.origin) }}
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.comments, 'group.update.field.comments'|trans({}, 'group'), {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.comments, {'attr': {'class': 'form-control', 'rows': 6}}) }}
                    {{ form_errors(form.comments) }}
                </div>

                <div class="alert alert-light border-start border-warning border-4 shadow-sm" role="alert">
                    <div class="d-flex">
                        <div class="me-3">
                            <i class="fa fa-exclamation-triangle text-warning fa-lg"></i>
                        </div>
                        <div>
                            <strong class="d-block text-dark">{{ 'group.update.warning_note'|trans({}, 'group') }}</strong>
                            <span class="small text-muted">{{ 'group.update.warning_message'|trans({}, 'group') }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <hr class="my-4 text-muted opacity-25">

        <div class="d-flex justify-content-between align-items-center">
            <div>
                <button type="submit" class="btn btn-primary px-4 shadow-sm">
                    <i class="fa fa-save me-2"></i> {{ 'group.update.button.save'|trans({}, 'group') }}
                </button>
                <a href="{{ path('group_view', {id: group.id, tab: 'general'}) }}" class="btn btn-outline-secondary px-4 ms-2">
                    <i class="fa fa-times me-2"></i> {{ 'group.update.button.cancel'|trans({}, 'group') }}
                </a>
            </div>

            <small class="text-muted">
                <span class="badge bg-light text-dark border">{{ group.id }}</span>
            </small>
        </div>

        {{ form_end(form) }}
    </div>
</div>
