{% extends '@Shared/Views/layout/layout.html.twig' %}

{% block body %}

    <div class="container-fluid mt-3">
        {% include '@Shared/Views/partials/_title.html.twig' with {'page_title': 'group.page.list'|trans({}, 'group')} %}

        {% include '@Shared/Views/components/table/_table.html.twig' with {
            id: 'groupsTable',
            title: 'group.table.title'|trans({}, 'group'),
            server_side: true,
            ajax_url: path('groups_list_data'),
            checkbox: true,
            bulk_operations_template: '@Shared/Views/partials/_bulk_operations.html.twig',
            bulk_operations_config: {
                translation_domain: 'group'
            },
            columns: [
                {'field': 'key', 'label': 'group.table.key'|trans({}, 'group'), 'sortable': true},
                {'field': 'name', 'label': 'group.table.name'|trans({}, 'group'), 'sortable': true},
                {'field': 'origin', 'label': 'group.table.origin'|trans({}, 'group'), 'sortable': true},
                {'field': 'comments', 'label': 'group.table.comments'|trans({}, 'group'), 'sortable': true},
                {'field': 'created_at', 'label': 'group.table.created_at'|trans({}, 'group'), 'sortable': true},
                {'field': 'updated_at', 'label': 'group.table.updated_at'|trans({}, 'group'), 'sortable': true},
                {'field': 'actions', 'label': 'group.table.actions'|trans({}, 'group'), 'align': 'right'}
            ],
        } %}

        {% include '@Shared/Views/partials/_actions.html.twig' with {
            translationDomain: 'group'
        } %}

    </div>

    <div class="modal fade" id="createGroupModal" tabindex="-1" aria-labelledby="createGroupModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="createGroupModalLabel">
                        <i class="fa fa-plus-circle"></i> {{ 'group.create.modal.title'|trans({}, 'group') }}
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    {{ form_start(create_form, {'attr': {'id': 'createGroupForm'}}) }}
                    <div class="mb-3">
                        {{ form_label(create_form.name, null, {'label_attr': {'class': 'form-label'}}) }}
                        <span class="text-danger">*</span>
                        {{ form_widget(create_form.name) }}
                        {{ form_errors(create_form.name) }}
                        <div class="form-text">{{ 'group.create.modal.field.name_help'|trans({}, 'group') }}</div>
                    </div>
                    {{ form_end(create_form) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fa fa-times"></i> {{ 'group.create.modal.button.cancel'|trans({}, 'group') }}
                    </button>
                    <button type="submit" form="createGroupForm" class="btn btn-primary">
                        <i class="fa fa-plus"></i> {{ 'group.create.modal.button.create'|trans({}, 'group') }}
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

