<header class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top px-3">
    <button id="sidebarToggle" class="btn btn-outline-secondary me-3 d-lg-none" type="button">
        <i class="fa-solid fa-bars"></i>
    </button>

    <div class="ms-auto d-flex align-items-center gap-3">
        <button type="button" class="btn btn-default position-relative">
            <i class="fa-solid fa-bell"></i>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                99+
                <span class="visually-hidden">unread messages</span>
            </span>
        </button>

        <button type="button" class="btn btn-default position-relative">
            <i class="fa-solid fa-rotate-right"></i>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning">
                3+
                <span class="visually-hidden">processing jobs</span>
            </span>
        </button>

        <div class="dropdown">
            <a class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle" href="#" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                {{ app.user.username|capitalize }}
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                <li class="dropdown-header small text-muted">
                    {{ "Login since"|trans }}: {{ app.user.lastLogin|format_datetime('medium','medium',locale=app.request.locale) }}
                </li>
                <li class="dropdown-header small text-muted">{{ app.user.email }}</li>
                {{ render(controller('Pumukit\\NewAdminBundle\\Controller\\WidgetController::languageselectAction') ) }}
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item text-danger" href="{{ path('pumukit_logout') }}">
                        {{ "Logout"|trans }}
                    </a>
                </li>
            </ul>
        </div>
    </div>
</header>
