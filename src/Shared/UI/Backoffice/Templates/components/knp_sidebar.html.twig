{% extends 'knp_menu_base.html.twig' %}

{% block root %}
    <ul class="nav flex-column sidebar-menu m-0 p-0">
        {{ block('list') }}
    </ul>
{% endblock %}

{% block list %}
    {% import _self as knp_menu %}
    {% for item in item.children %}
        {{ block('item') }}
    {% endfor %}
{% endblock %}

{% block item %}
    {% set hasChildren = item.hasChildren and options.depth is not same as(0) %}
    <li class="nav-item mb-2">
        {% if hasChildren %}
            <div class="nav-link py-2 nav-link-pumukit-group">
                {{ item.label|trans }}
            </div>

            <ul class="list-group list-group-flush ps-3 mt-1 mb-2">
                {% for child in item.children %}
                    <li class="list-group-item list-group-item-pumukit">
                        <a href="{{ child.uri }}" class="link-light d-block py-1 text-decoration-none d-flex align-items-center">
                            <i class="fa-solid fa-circle me-2" style="font-size: 0.6rem;"></i>
                            {{ child.label|trans|capitalize }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <a href="{{ item.uri }}" class="nav-link nav-link-pumukit-menu d-flex align-items-center px-3 py-2 mb-1">
                <i class="fa-solid fa-circle me-2" style="font-size: 0.6rem;"></i>
                {{ item.label|trans|capitalize }}
            </a>
        {% endif %}
    </li>
{% endblock %}
