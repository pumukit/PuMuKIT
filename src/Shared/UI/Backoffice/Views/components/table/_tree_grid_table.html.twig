{% set default_classes = 'table table-striped table-hover' %}
{% set table_id = id|default('treeGridTable') %}
{% set table_classes = classes|default(default_classes) %}
{% set enable_checkbox = checkbox|default(false) %}
{% set enable_pagination = pagination|default(false) %}
{% set enable_search = search|default(true) %}
{% set enable_show_columns = show_columns|default(true) %}
{% set enable_show_refresh = show_refresh|default(true) %}
{% set enable_show_toggle = show_toggle|default(false) %}
{% set id_field_name = id_field|default('id') %}
{% set parent_id_field_name = parent_id_field|default('parent_id') %}
{% set root_parent_value = root_parent_id is defined ? root_parent_id : 'null' %}

<div class="tree-grid-table-wrapper">
    {% if title is defined %}
        <h3 class="mb-3">{{ title }}</h3>
    {% endif %}


    {% if id == 'tagsTreeTable' %}
        <div class="row">
            <div class="col-2">
                {% include '@Taxonomy/UI/Backoffice/Views/partials/_bulk_operations.html.twig' %}
            </div>
            <div class="col">
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" onclick="collapseAllTags()">
                        <i class="fa fa-compress"></i> Collapse All
                    </button>
                </div>
            </div>
        </div>
    {% endif %}

    <table
        id="{{ table_id }}"
        class="{{ table_classes }} table-bordered"
        data-url="{{ ajax_url }}"
        data-id-field="{{ id_field_name }}"
        data-parent-id-field="{{ parent_id_field_name }}"
        data-tree-show-field="{{ tree_show_field|default(columns[0].field) }}"
        data-root-parent-value="{{ root_parent_value }}"
        {% if enable_checkbox %}data-check-on-init="true"{% endif %}
        {% if enable_pagination %}data-pagination="true"{% else %}data-pagination="false"{% endif %}
        {% if enable_search %}data-search="true"{% endif %}
        {% if enable_show_columns %}data-show-columns="true"{% endif %}
        {% if enable_show_refresh %}data-show-refresh="true"{% endif %}
        {% if enable_show_toggle %}data-show-toggle="true"{% endif %}
        {% if toolbar is defined %}data-toolbar="{{ toolbar }}"{% endif %}
        {% if height is defined %}data-height="{{ height }}"{% endif %}
        style="margin-top: 1.5em;">
    </table>

</div>

<script>
(function() {
    'use strict';

    var $table = $('#{{ table_id }}');

    $(document).ready(function() {
        function initializeTable() {
            var rootParentValue = $table.data('root-parent-value');
            var rootParentId;

            if (rootParentValue === 'null' || rootParentValue === null || rootParentValue === '') {
                rootParentId = null;
            } else {
                rootParentId = rootParentValue;
            }

            var columns = [
                {% if enable_checkbox %}
                {
                    field: 'state',
                    checkbox: true,
                    align: 'center',
                    valign: 'middle'
                },
                {% endif %}
                {% for column in columns %}
                {
                    field: '{{ column.field }}',
                    title: '{{ column.label }}'
                    {% if column.sortable|default(false) %},sortable: true{% endif %}
                    {% if column.align is defined %},align: '{{ column.align }}'{% endif %}
                    {% if column.width is defined %},width: '{{ column.width }}'{% endif %}
                    {% if column.formatter is defined %}
                    ,formatter: function(value, row, index) {
                        var formatterPath = '{{ column.formatter }}'.split('.');
                        var formatter = window;
                        for (var i = 0; i < formatterPath.length; i++) {
                            formatter = formatter[formatterPath[i]];
                            if (!formatter) break;
                        }
                        if (typeof formatter === 'function') {
                            return formatter(value, row, index);
                        }
                        return value;
                    }
                    {% endif %}
                    {% if column.class is defined %},class: '{{ column.class }}'{% endif %}
                    {% if column.visible is defined and not column.visible %},visible: false{% endif %}
                }{% if not loop.last %},{% endif %}
                {% endfor %}
            ];

            var loadedNodes = {};
            var childrenUrl = '{{ ajax_url }}'.replace('/data', '/{parentId}/children');

            function buildRow(item, level) {
                level = level || 0;
                var parentClass = item.parent_id === rootParentId ? '' : ' treegrid-parent-' + item.parent_id;
                var hasChildren = item.number_children > 0;
                var loadingClass = hasChildren ? ' has-children' : '';

                var bgColor = '';
                if (level > 0) {
                    var opacity = 0.02 + (level * 0.03);
                    bgColor = 'background-color: rgba(0, 0, 0, ' + opacity + ');';
                }

                var row = '<tr class="treegrid-' + item.id + parentClass + loadingClass + ' tree-level-' + level + '" data-item-id="' + item.id + '" data-has-children="' + hasChildren + '" data-loaded="false" data-level="' + level + '" style="' + bgColor + '">';

                {% if enable_checkbox %}
                row += '<td><input type="checkbox" class="row-checkbox" value="' + item.id + '"></td>';
                {% endif %}

                {% for column in columns %}
                row += '<td>';
                var value = item['{{ column.field }}'];

                {% if loop.first %}
                var indent = level * 25;
                row += '<span style="display: inline-block; width: ' + indent + 'px;"></span>';

                if (level > 0) {
                    row += '<i class="fa fa-level-up-alt fa-rotate-90" style="margin-right: 8px; color: #adb5bd; font-size: 0.75em;"></i>';
                }

                if (hasChildren) {
                    row += '<span class="treegrid-expander treegrid-expander-collapsed" data-item-id="' + item.id + '" style="cursor: pointer; margin-right: 8px;"></span>';
                } else {
                    // Icono de nodo hoja (sin hijos)
                    if (level > 0) {
                        row += '<i class="fa fa-circle" style="font-size: 0.4em; margin-right: 8px; color: #dee2e6; vertical-align: middle;"></i>';
                    } else {
                        row += '<span style="display: inline-block; width: 20px; margin-right: 8px;"></span>';
                    }
                }
                {% endif %}

                {% if column.formatter is defined %}
                var formatterPath = '{{ column.formatter }}'.split('.');
                var formatter = window;
                for (var i = 0; i < formatterPath.length; i++) {
                    formatter = formatter[formatterPath[i]];
                    if (!formatter) break;
                }
                if (typeof formatter === 'function') {
                    row += formatter(value, item, 0);
                } else {
                    row += value || '';
                }
                {% else %}
                row += value || '';
                {% endif %}

                row += '</td>';
                {% endfor %}

                row += '</tr>';
                return row;
            }

            function loadChildren(parentId, $parentRow) {
                var url = childrenUrl.replace('{parentId}', parentId);
                var $expander = $parentRow.find('.treegrid-expander');
                var level = parseInt($parentRow.data('level')) + 1;

                $.ajax({
                    url: url,
                    method: 'GET',
                    success: function(res) {
                        var children = res.data || [];

                        loadedNodes[parentId] = children;

                        $parentRow.data('loaded', 'true');

                        $expander.removeClass('treegrid-expander-collapsed').addClass('treegrid-expander-expanded');

                        var $insertAfter = $parentRow;
                        children.forEach(function(child) {
                            var $childRow = $(buildRow(child, level));
                            $childRow.insertAfter($insertAfter);
                            $insertAfter = $childRow;
                        });

                        attachExpanderHandlers();
                    },
                    error: function(xhr, status, error) {
                        console.error('Error loading children:', error);
                        $expander.html('<i class="fa fa-exclamation-triangle text-danger"></i>');
                    }
                });
            }

            function collapseChildren(parentId, $parentRow) {
                var $expander = $parentRow.find('.treegrid-expander');

                $expander.removeClass('treegrid-expander-expanded').addClass('treegrid-expander-collapsed');
                function removeChildren(id) {
                    $table.find('tr.treegrid-parent-' + id).each(function() {
                        var childId = $(this).data('item-id');
                        removeChildren(childId);
                        $(this).remove();
                    });
                }

                removeChildren(parentId);
            }

            function attachExpanderHandlers() {
                $('.treegrid-expander').off('click').on('click', function(e) {
                    e.stopPropagation();
                    var $expander = $(this);
                    var itemId = $expander.data('item-id');
                    var $row = $expander.closest('tr');
                    var isExpanded = $expander.hasClass('treegrid-expander-expanded');

                    if (isExpanded) {
                        collapseChildren(itemId, $row);
                    } else {
                        var isLoaded = $row.data('loaded') === 'true' || $row.data('loaded') === true;
                        if (isLoaded) {
                            $expander.removeClass('treegrid-expander-collapsed').addClass('treegrid-expander-expanded');

                            var children = loadedNodes[itemId] || [];
                            var level = parseInt($row.data('level')) + 1;
                            var $insertAfter = $row;
                            children.forEach(function(child) {
                                var $childRow = $(buildRow(child, level));
                                $childRow.insertAfter($insertAfter);
                                $insertAfter = $childRow;
                            });
                            attachExpanderHandlers();
                        } else {
                            loadChildren(itemId, $row);
                        }
                    }
                });
            }

            $.ajax({
                url: '{{ ajax_url }}?lazy=true',
                method: 'GET',
                success: function(res) {
                    if (res.rootParentId !== undefined && res.rootParentId !== null) {
                        rootParentId = res.rootParentId;
                    }

                    var data = res.data || [];

                    var thead = '<thead><tr>';
                    {% if enable_checkbox %}
                    thead += '<th><input type="checkbox" id="select-all-{{ table_id }}"></th>';
                    {% endif %}
                    {% for column in columns %}
                    thead += '<th>{{ column.label }}</th>';
                    {% endfor %}
                    thead += '</tr></thead>';

                    var tbody = '<tbody>';

                    data.forEach(function(item) {
                        tbody += buildRow(item, 0);
                    });

                    tbody += '</tbody>';

                    $table.html(thead + tbody);

                    attachExpanderHandlers();

                    {% if enable_checkbox %}
                    $('#select-all-{{ table_id }}').on('change', function() {
                        $('.row-checkbox').prop('checked', $(this).prop('checked'));
                    });
                    {% endif %}
                },
                error: function(xhr, status, error) {
                    console.error('Error loading data:', error);
                }
            });
        }

        initializeTable();
    });

    window.treeGridFormatters = window.treeGridFormatters || {};

    window.treeGridFormatters.booleanFormatter = function(value, row, index) {
        if (value === true || value === 'true' || value === 1 || value === '1') {
            return '<i class="fa fa-check text-success"></i>';
        }
        return '<i class="fa fa-times text-danger"></i>';
    };

    window.treeGridFormatters.badgeFormatter = function(value, row, index) {
        if (!value) return '';
        return '<span class="badge bg-primary">' + value + '</span>';
    };

    window.treeGridFormatters.levelFormatter = function(value, row, index) {
        var level = value || 0;
        var indent = '&nbsp;'.repeat(level * 4);
        return indent + level;
    };
})();
</script>
