<div class="card shadow-sm mb-3">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="fa fa-list"></i> {{ label }}
        </h5>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <label for="{{ field_name }}" class="form-label font-bold">
                {{ label }}
                {% if required|default(false) %}<span class="text-danger">*</span>{% endif %}
            </label>
            <select class="form-select" id="{{ field_name }}" name="{{ field_name }}" {% if required|default(false) %}required{% endif %}>
                <option value="">{{ "Select an option"|trans }}</option>
                {% for value, option_label in options %}
                    <option value="{{ value }}" {% if selected|default('') == value %}selected{% endif %}>
                        {{ option_label }}
                    </option>
                {% endfor %}
            </select>
            {% if help_text is defined and help_text %}
                <small class="form-text text-muted">{{ help_text }}</small>
            {% endif %}
        </div>
    </div>
</div>

