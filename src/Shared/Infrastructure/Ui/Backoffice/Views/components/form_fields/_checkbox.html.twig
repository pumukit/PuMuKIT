<div class="card shadow-sm mb-3">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="fa fa-check-square"></i> {{ label }}
        </h5>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="{{ field_name }}" name="{{ field_name }}" {% if checked|default(false) %}checked{% endif %}>
                <label class="form-check-label font-bold" for="{{ field_name }}">
                    {{ label }}
                </label>
                {% if help_text is defined and help_text %}
                    <small class="form-text text-muted d-block">{{ help_text }}</small>
                {% endif %}
            </div>
        </div>
    </div>
</div>

