{% extends '@Shared/UI/Backoffice/Views/layout/layout.html.twig' %}

{% block body %}

    <div class="container-fluid mt-3">
        {% include '@Shared/UI/Backoffice/Views/partials/_title.html.twig' with {'page_title': 'user.page.list'|trans({}, 'user')} %}

        {% include '@Shared/UI/Backoffice/Views/components/table/_table.html.twig' with {
            id: 'usersTable',
            title: 'user.table.title'|trans({}, 'user'),
            server_side: true,
            ajax_url: path('users_list_data'),
            checkbox: true,
            bulk_operations_template: '@Shared/UI/Backoffice/Views/partials/_bulk_operations.html.twig',
            bulk_operations_config: {
                translation_domain: 'user'
            },
            columns: [
                {'field': 'fullName', 'label': 'user.table.full_name'|trans({}, 'user'), 'sortable': true},
                {'field': 'username', 'label': 'user.table.username'|trans({}, 'user'), 'sortable': true},
                {'field': 'email', 'label': 'user.table.email'|trans({}, 'user'), 'sortable': true},
                {'field': 'origin', 'label': 'user.table.origin'|trans({}, 'user'), 'sortable': true},
                {'field': 'last_login', 'label': 'user.table.last_login'|trans({}, 'user'), 'sortable': true},
                {'field': 'enabled', 'label': 'user.table.enabled'|trans({}, 'user'), 'formatter': 'boolean','sortable': true},
                {'field': 'actions', 'label': 'user.table.actions'|trans({}, 'user'), 'align': 'right'}
            ],
        } %}

        {% include '@Shared/UI/Backoffice/Views/partials/_actions.html.twig' with {
            translationDomain: 'user'
        } %}

    </div>
{% endblock %}
