{% extends '@Shared/UI/Backoffice/Views/layout/layout.html.twig' %}

{% block body %}

    <div class="container-fluid mt-3">
        {% include '@Shared/UI/Backoffice/Views/partials/_title.html.twig' with {'page_title': 'User list'} %}

        {% include '@Shared/UI/Backoffice/Views/components/table/_table.html.twig' with {
            id: 'usersTable',
            title: 'Users',
            server_side: true,
            ajax_url: path('users_list_data'),
            checkbox: true,
            bulk_operations_template: '@User/UI/Backoffice/Views/partials/_bulk_operations.html.twig',
            columns: [
                {'field': 'fullName', 'label': 'fullName', 'sortable': true},
                {'field': 'username', 'label': 'Username', 'sortable': true},
                {'field': 'email', 'label': 'Email', 'sortable': true},
                {'field': 'origin', 'label': 'Origin', 'sortable': true},
                {'field': 'last_login', 'label': 'Last login', 'sortable': true},
                {'field': 'enabled', 'label': 'Enabled', 'formatter': 'boolean','sortable': true},
                {'field': 'actions', 'label': 'Actions', 'align': 'right'}
            ],
        } %}

        {% include '@User/UI/Backoffice/Views/partials/_actions.html.twig' %}

    </div>
{% endblock %}
