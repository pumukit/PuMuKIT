{% extends '@Shared/UI/Backoffice/Views/layout/layout.html.twig' %}

{% block body %}

    {% include "@Shared/UI/Backoffice/Views/partials/_title.html.twig" with { page_title: 'Storage' } %}

    <div class="well">
        <div class="row">
            {% for disk in data.storage %}
                {% set usedBytes = disk.total - disk.free %}
                {% set percentUsed = (usedBytes / disk.total * 100) | round(1) %}

                {# Convertir a GB para mostrar #}
                {% set usedGB = usedBytes / 1024 / 1024 / 1024 %}
                {% set freeGB = disk.free / 1024 / 1024 / 1024 %}
                {% set totalGB = disk.total / 1024 / 1024 / 1024 %}

                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="card-title mb-0 text-truncate" title="{{ disk.dir }}">
                                    {{ disk.dir|split('/')|last }}
                                </h6>
                                <i class="fa-solid fa-hdd fa-lg text-secondary"></i>
                            </div>

                            <h3 class="fw-bold">{{ usedGB | number_format(2, '.', ',') }} GB</h3>
                            <small class="text-muted">
                                Libre: {{ freeGB | number_format(2, '.', ',') }} GB / Total: {{ totalGB | number_format(2, '.', ',') }} GB
                            </small>

                            <div class="progress mt-2" style="height: 8px;">
                                <div class="progress-bar bg-warning" role="progressbar"
                                     style="width: {{ percentUsed }}%;"
                                     aria-valuenow="{{ percentUsed }}" aria-valuemin="0" aria-valuemax="100">
                                </div>
                            </div>
                            <small class="text-muted">{{ percentUsed }}% usado</small>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

    </div>
    {% include "@Shared/UI/Backoffice/Views/partials/_title.html.twig" with { page_title: 'Multimedia Objects' } %}

    <div class="well">
        <div class="row">

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-success shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                    Videos
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">{{ data['multimedia_object_video'] }}</div>
                            </div>
                            <div class="col-auto">
                                <i class="fa fa-video fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-success shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                    Audios
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">{{ data['multimedia_object_audio'] }}</div>
                            </div>
                            <div class="col-auto">
                                <i class="fa fa-headphones fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-success shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                    Images
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">{{ data['multimedia_object_image'] }}</div>
                            </div>
                            <div class="col-auto">
                                <i class="fa fa-images fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-success shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                    Documents
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">{{ data['multimedia_object_document'] }}</div>
                            </div>
                            <div class="col-auto">
                                <i class="fa fa-file fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-success shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                    External
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">{{ data['multimedia_object_external'] }}</div>
                            </div>
                            <div class="col-auto">
                                <i class="fa fa-link fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>


    {% include "@Shared/UI/Backoffice/Views/partials/_title.html.twig" with { page_title: 'Series' } %}

    <div class="well">
        <div class="row">

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-success shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                    Total
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">{{ data['series'] }}</div>
                            </div>
                            <div class="col-auto">
                                <i class="fa fa-folder fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    {% include "@Shared/UI/Backoffice/Views/partials/_title.html.twig" with { page_title: 'Users' } %}

    <div class="well">
        <div class="row">

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-success shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                    Total
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">{{ data['num_users'] }}</div>
                            </div>
                            <div class="col-auto">
                                <i class="fa fa-users fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
{% endblock %}
