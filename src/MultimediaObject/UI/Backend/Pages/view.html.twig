{% extends '@Shared/UI/Backend/Templates/layout/layout.html.twig' %}

{% block body %}
    <div class="container-fluid mt-3">
        <a href="{{ path('series_view', {id: object.series.id, tab: 'objects'}) }}" class="btn btn-sm btn-primary">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>

        <hr />

        <h4 class="mb-4">Objeto Multimedia: {{ object.title  }}</h4>

        <ul class="nav nav-tabs modern-tabs text-uppercase small flex-wrap justify-content-start" role="tablist">
            <li class="nav-item">
                <a class="nav-link {{ tab == 'general' ? 'active' : '' }}" href="{{ path('multimediaobject_view', {id: object.id, tab: 'general'}) }}">
                    <i class="fa-solid fa-photo-film"></i> {{ "General"|trans }}
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link {{ tab == 'publication' ? 'active' : '' }}" href="{{ path('multimediaobject_view', {id: object.id, tab: 'publication'}) }}">
                    <i class="fa-solid fa-newspaper"></i> {{ "Publication"|trans }}
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link {{ tab == 'metadata' ? 'active' : '' }}" href="{{ path('multimediaobject_view', {id: object.id, tab: 'metadata'}) }}">
                    <i class="fa fa-edit me-1"></i> {{ "Metadata"|trans }}
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link {{ tab == 'tags' ? 'active' : '' }}" href="{{ path('multimediaobject_view', {id: object.id, tab: 'tags'}) }}">
                    <i class="fa fa-tags me-1"></i> {{ "Tags"|trans }}
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link {{ tab == 'owners' ? 'active' : '' }}" href="{{ path('multimediaobject_view', {id: object.id, tab: 'owners'}) }}">
                    <i class="fa fa-users me-1"></i> {{ "Owners"|trans }}
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link {{ tab == 'people' ? 'active' : '' }}" href="{{ path('multimediaobject_view', {id: object.id, tab: 'people'}) }}">
                    <i class="fa fa-user me-1"></i> {{ "People"|trans }}
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link {{ tab == 'media' ? 'active' : '' }}" href="{{ path('multimediaobject_view', {id: object.id, tab: 'media'}) }}">
                    <i class="fa fa-photo-video me-1"></i> {{ "Media"|trans }}
                </a>
            </li>
        </ul>

        <div class="mt-3">
            {% include '@MultimediaObject/UI/Backend/Pages/tabs/' ~ tab ~ '.html.twig' %}
        </div>
    </div>
{% endblock %}


{% block stylesheets %}
    {{ parent() }}
    <style>
        .modern-tabs .nav-link {
            font-weight: 500;
            color: #6c757d;
            border: none;
            position: relative;
            transition: color 0.25s ease, transform 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .modern-tabs .nav-link:hover {
            color: #0d6efd;
            transform: translateY(-2px);
        }

        .modern-tabs .nav-link.active {
            color: #0d6efd;
            font-weight: 600;
            border-bottom: 3px solid #0d6efd;
            background-color: transparent;
        }

        .modern-tabs .nav-link i {
            font-size: 1rem;
            opacity: 0.8;
        }

        .modern-tabs .nav-link.active i {
            opacity: 1;
            color: #0d6efd;
        }

        ul.nav-tabs.modern-tabs .nav-link {
            margin: 4px 4px;
            padding: 8px 12px;
            border-radius: 0;
            text-align: center;
        }

        ul.nav-tabs.modern-tabs {
            flex-wrap: wrap;
            gap: 4px;
        }
    </style>
{% endblock %}
