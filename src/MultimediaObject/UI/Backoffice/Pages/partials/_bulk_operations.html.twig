<div id="bulk-action-toolbar" class="d-flex gap-2 mb-2">
    <select id="bulk-action-select" class="form-select" data-operations='{{ bulk_operations_config|default('{}')|raw }}'>
        <option value="">{{ "Select an operation..."|trans }}</option>
        {% for operation in multimediaObjectBulkOperations %}
            <option
                value="{{ operation.key }}"
                data-type="{{ operation.type }}"
                data-handler="{{ operation.handler }}"
                {% if operation.icon %}data-icon="{{ operation.icon }}"{% endif %}
                {% if operation.confirm_message %}data-confirm="{{ operation.confirm_message|trans }}"{% endif %}>
                {% if operation.icon %}<i class="fa {{ operation.icon }}"></i> {% endif %}
                {{ operation.label|trans }}
            </option>
        {% endfor %}
    </select>
    <button id="multimedia-bulk-action-apply" class="btn btn-pumukit">
        {{ "Apply"|trans }}
    </button>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const selectElement = document.getElementById('multimedia-bulk-action-select');
        const applyButton = document.getElementById('multimedia-bulk-action-apply');
        const tableElement = document.getElementById('multimediaObjectsTable');

        if (!selectElement || !applyButton || !tableElement) {
            console.error('Multimedia bulk operations: Required elements not found');
            return;
        }

        applyButton.addEventListener('click', function() {
            const selectedOption = selectElement.options[selectElement.selectedIndex];
            const operation = selectedOption.value;

            if (!operation) {
                alert('{{ "Please select an operation"|trans }}');
                return;
            }

            const selectedRows = $(tableElement).bootstrapTable('getSelections');

            if (selectedRows.length === 0) {
                alert('{{ "Please select at least one item"|trans }}');
                return;
            }

            const selectedIds = selectedRows.map(row => row.id);
            const confirmMessage = selectedOption.dataset.confirm;

            if (confirmMessage && !confirm(confirmMessage)) {
                return;
            }

            const operationType = selectedOption.dataset.type;
            const handler = selectedOption.dataset.handler;

            console.log('Multimedia bulk operation:', operation, 'IDs:', selectedIds);

            if (operationType === 'url') {
                fetch(handler, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ ids: selectedIds })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                            $(tableElement).bootstrapTable('refresh');
                        } else {
                            alert('Error: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('An error occurred while executing the operation');
                    });
            } else if (operationType === 'js') {
                if (typeof window[handler] === 'function') {
                    window[handler](selectedIds);
                } else {
                    console.error('Handler function not found:', handler);
                }
            }
        });
    });
</script>
