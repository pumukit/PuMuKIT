{% include '@Shared/UI/Backoffice/Views/components/table/_table.html.twig' with {
    id: 'multimediaObjectsTable',
    server_side: true,
    ajax_url: path('series_multimedia_object_data', {id: series.id}),
    checkbox: true,
    toolbar: '#multimedia-bulk-action-toolbar',
    bulkOperations: multimediaObjectBulkOperations|default([]),
    bulk_operations_template: '@Shared/UI/Backoffice/Views/partials/_bulk_operations.html.twig',
    bulk_operations_config: {
        translation_domain: 'multimedia_object'
    },
    columns: [
        {'field': 'thumbnail', 'label': 'series.objects.table.thumbnail'|trans({}, 'series')},
        {'field': 'title', 'label': 'series.objects.table.title'|trans({}, 'series'), 'sortable': true, 'truncate': true},
        {'field': 'type', 'label': 'series.objects.table.type'|trans({}, 'series'), 'sortable': true},
        {'field': 'status', 'label': 'series.objects.table.status'|trans({}, 'series'), 'sortable': true},
        {'field': 'hide', 'label': 'series.objects.table.hide'|trans({}, 'series'), 'formatter': 'boolean'},
        {'field': 'duration', 'label': 'series.objects.table.duration'|trans({}, 'series'), 'sortable': true},
        {'field': 'public_date', 'label': 'series.objects.table.public_date'|trans({}, 'series'), 'sortable': true},
        {'field': 'record_date', 'label': 'series.objects.table.record_date'|trans({}, 'series'), 'sortable': true},
        {'field': 'actions', 'label': 'series.objects.table.actions'|trans({}, 'series'), 'align': 'right'}
    ],
} %}

{% if multimediaObjectCustomActions is defined and multimediaObjectCustomActions is not empty %}
    <div class="mb-3">
        {% include '@Shared/UI/Backoffice/Views/partials/_actions.html.twig' with {
            customActions: multimediaObjectCustomActions,
            translationDomain: 'multimedia_object'
        } %}
