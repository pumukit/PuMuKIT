{% extends '@Shared/UI/Backoffice/Views/layout/layout.html.twig' %}

{% block body %}
<div class="container-fluid mt-3">
    {% include '@Shared/UI/Backoffice/Views/partials/_title.html.twig' with {'page_title': 'series.page.list'|trans({}, 'series')} %}

    {% include '@Shared/UI/Backoffice/Views/components/table/_table.html.twig' with {
        id: 'seriesTable',
        title: 'series.table.title'|trans({}, 'series'),
        server_side: true,
        ajax_url: path('series_list_data'),
        checkbox: true,
        bulk_operations_template: '@Shared/UI/Backoffice/Views/partials/_bulk_operations.html.twig',
        bulk_operations_config: {
            translation_domain: 'series'
        },
        columns: [
            {'field': 'thumbnail', 'label': 'series.table.thumbnail'|trans({}, 'series')},
            {'field': 'title', 'label': 'series.table.title_column'|trans({}, 'series'), 'sortable': true},
            {'field': 'public_date', 'label': 'series.table.public_date'|trans({}, 'series'), 'sortable': true},
            {'field': 'hide', 'label': 'series.table.hide'|trans({}, 'series')},
            {'field': 'announce', 'label': 'series.table.announce'|trans({}, 'series')},
            {'field': 'objectCount', 'label': 'series.table.objects'|trans({}, 'series')},
            {'field': 'eventCount', 'label': 'series.table.events'|trans({}, 'series')},
            {'field': 'actions', 'label': 'series.table.actions'|trans({}, 'series'), 'align': 'right'}
        ]
    } %}

    {% include '@Shared/UI/Backoffice/Views/partials/_actions.html.twig' with {
        translationDomain: 'series'
    } %}
</div>
{% endblock %}
