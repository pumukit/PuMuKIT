{% extends '@Shared/UI/Backoffice/Templates/layout/layout.html.twig' %}

{% block body %}
<div class="container-fluid mt-3">
    {% include '@Shared/UI/Backoffice/Templates/partials/_title.html.twig' with {'page_title': 'Listado de Series'} %}

    {% include '@Shared/UI/Backoffice/Templates/components/table/_table.html.twig' with {
        id: 'seriesTable',
        title: 'Series',
        server_side: true,
        ajax_url: path('series_list_data'),
        checkbox: true,
        columns: [
            {'field': 'thumbnail', 'label': 'Image'},
            {'field': 'title', 'label': 'Title', 'sortable': true},
            {'field': 'public_date', 'label': 'Publication Date', 'sortable': true},
            {'field': 'hide', 'label': 'Hide'},
            {'field': 'announce', 'label': 'Announce'},
            {'field': 'objectCount', 'label': 'Objects'},
            {'field': 'eventCount', 'label': 'Events'},
            {'field': 'actions', 'label': 'Actions', 'align': 'right'}
        ]
    } %}

    {% include '@Series/UI/Backoffice/Pages/partials/_actions.html.twig' %}
</div>
{% endblock %}
