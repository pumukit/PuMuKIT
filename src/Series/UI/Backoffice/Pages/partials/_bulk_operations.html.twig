<div id="bulk-action-toolbar" class="d-flex gap-2 mb-2">
    <select id="bulk-action-select" class="form-select" data-operations='{{ bulk_operations_config|default('{}')|raw }}'>
        <option value="">{{ "Select an option..."|trans }}</option>
        {% if bulkOperations is defined and bulkOperations is not empty %}
            {% for operation in bulkOperations %}
                <option
                    value="{{ operation.key }}"
                    data-type="{{ operation.type }}"
                    data-handler="{{ operation.handler }}"
                    {% if operation.icon %}data-icon="{{ operation.icon }}"{% endif %}
                    {% if operation.confirm_message %}data-confirm="{{ operation.confirm_message|trans }}"{% endif %}>
                    {% if operation.icon %}<i class="fa {{ operation.icon }}"></i> {% endif %}
                    {{ operation.label|trans }}
                </option>
            {% endfor %}
        {% endif %}
    </select>
    <button id="bulk-action-apply" class="btn btn-sm btn-pumukit">{{ "Apply"|trans }}</button>
</div>

<script>
(function() {
    'use strict';

    document.addEventListener('DOMContentLoaded', function() {
        const selectElement = document.getElementById('bulk-action-select');
        const applyButton = document.getElementById('bulk-action-apply');
        const tableElement = document.querySelector('[data-toolbar="#bulk-action-toolbar"]');

        if (!selectElement || !applyButton || !tableElement) {
            console.error('Bulk operations: Required elements not found');
            return;
        }

        applyButton.addEventListener('click', function() {
            const selectedOption = selectElement.options[selectElement.selectedIndex];
            const operation = selectedOption.value;

            if (!operation) {
                alert('{{ "Please select an operation"|trans }}');
                return;
            }

            const selectedRows = $(tableElement).bootstrapTable('getSelections');

            if (selectedRows.length === 0) {
                alert('{{ "Please select at least one item"|trans }}');
                return;
            }

            const selectedIds = selectedRows.map(row => row.id);
            const confirmMessage = selectedOption.dataset.confirm;

            if (confirmMessage && !confirm(confirmMessage)) {
                return;
            }

            const operationType = selectedOption.dataset.type;
            const handler = selectedOption.dataset.handler;

            console.log('Bulk operation:', operation, 'IDs:', selectedIds);

            if (operationType === 'core') {
                handleCoreOperation(operation, selectedIds);
            } else if (operationType === 'url') {
                handleUrlOperation(handler, selectedIds);
            } else if (operationType === 'js') {
                handleJsOperation(handler, selectedIds);
            }
        });

        function handleCoreOperation(operation, ids) {
            if (operation === 'announce') {
                console.log('Toggle announce for:', ids);
                alert('Announce operation not yet implemented');
            } else if (operation === 'delete') {
                console.log('Delete:', ids);
                alert('Delete operation not yet implemented');
            }
        }

        function handleUrlOperation(url, ids) {
            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ ids: ids })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showFlashMessage('success', data.message || '{{ "Operation completed successfully"|trans }}');
                    $(tableElement).bootstrapTable('refresh');
                    selectElement.selectedIndex = 0;
                } else {
                    showFlashMessage('danger', data.message || '{{ "Operation failed"|trans }}');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showFlashMessage('danger', '{{ "An error occurred"|trans }}');
            });
        }

        function showFlashMessage(type, message) {
            const container = document.querySelector('.flash-container');
            if (!container) {
                console.error('Flash container not found');
                return;
            }

            const alertDiv = document.createElement('div');
            alertDiv.className = `custom-flash ${type === 'success' ? 'success-flash' : 'danger-flash'} alert-dismissible fade show mb-2 shadow-lg rounded-3`;
            alertDiv.setAttribute('role', 'alert');
            alertDiv.textContent = message;

            container.appendChild(alertDiv);

            // Auto-dismiss after 3 seconds
            setTimeout(() => {
                const bsAlert = bootstrap.Alert.getOrCreateInstance(alertDiv);
                bsAlert.close();
            }, 3000);
        }

        function handleJsOperation(functionName, ids) {
            if (typeof window[functionName] === 'function') {
                window[functionName](ids, function(success, message) {
                    if (success) {
                        showFlashMessage('success', message || '{{ "Operation completed successfully"|trans }}');
                        $(tableElement).bootstrapTable('refresh');
                        selectElement.selectedIndex = 0;
                    } else {
                        showFlashMessage('danger', message || '{{ "Operation failed"|trans }}');
                    }
                });
            } else {
                console.error('Function not found:', functionName);
                showFlashMessage('danger', '{{ "Handler function not found"|trans }}');
            }
        }
    });
})();
</script>

