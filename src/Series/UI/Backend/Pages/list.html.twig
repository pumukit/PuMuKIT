{% extends '@Shared/UI/Backend/Templates/layout/layout.html.twig' %}

{% block body %}
<div class="container-fluid mt-3">
    {% include '@Shared/UI/Backend/Templates/partials/_title.html.twig' with {'page_title': 'Listado de Series'} %}

    {% include '@Shared/UI/Backend/Templates/components/table/_table.html.twig' with {
        id: 'seriesTable',
        title: 'Series',
        server_side: true,
        ajax_url: path('series_list_data'),
        checkbox: true,
        columns: [
            {'field': 'thumbnail', 'label': 'Image', 'formatter': 'thumbnailFormatter', 'escape': false},
            {'field': 'oneSeries.title', 'label': 'Title', 'sortable': true, 'truncate': true},
            {'field': 'oneSeries.publicDate', 'label': 'Publication Date', 'sortable': true, 'formatter': 'date'},
            {'field': 'oneSeries.announce', 'label': 'Announce', 'formatter': 'boolean'},
            {'field': 'oneSeries.hide', 'label': 'Hide', 'formatter': 'boolean'},
            {'field': 'oneSeries.copyright', 'label': 'Copyright',},
            {'field': 'objectCount', 'label': 'Multimedia Objects'},
            {'field': 'eventCount', 'label': 'Events'},
            {'field': 'actions', 'label': 'Actions', 'align': 'right'}
        ],
        create_button: {
            'url': path('series_create'),
            'icon': 'fa fa-plus',
            'label': 'Create'
        }
    } %}

</div>
{% endblock %}
