{% extends '@Shared/UI/Backend/Templates/layout/layout.html.twig' %}

{% block body %}
<div class="container-fluid mt-3">

    {% if title is defined %}
        {% include '@Shared/UI/Backend/Templates/partials/_title.html.twig' with {'page_title': title} %}
    {% endif %}

    {% include '@Shared/UI/Backend/Templates/components/table/_table.html.twig' with {
        id: 'seriesTable',
        title: 'Series',
        server_side: false,
        data: series,
        checkbox: true,
        columns: [
            {'field': 'oneSeries.title', 'label': 'Title', 'sortable': true, 'truncate': true},
            {'field': 'oneSeries.subtitle', 'label': 'Subtitle', 'sortable': true, 'truncate': true},
            {'field': 'oneSeries.publicDate', 'label': 'Publication Date', 'sortable': true, 'formatter': 'date'},
            {'field': 'oneSeries.announce', 'label': 'Announce', 'sortable': true, 'formatter': 'boolean'},
            {'field': 'oneSeries.hide', 'label': 'Hide', 'sortable': true, 'formatter': 'boolean'},
            {'field': 'oneSeries.copyright', 'label': 'Copyright', 'sortable': true},
            {'field': 'objectCount', 'label': 'Multimedia Objects'},
            {'field': 'eventCount', 'label': 'Events'},
            {'field': 'actions', 'label': 'Actions', 'align': 'right'}
        ],
        create_button: {
            'url': path('series_create'),
            'icon': 'fa fa-plus',
            'label': 'Create'
        }
    } %}

</div>
{% endblock %}
