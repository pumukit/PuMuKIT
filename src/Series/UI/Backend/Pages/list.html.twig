{% extends '@Shared/UI/Backend/Templates/layout/layout.html.twig' %}
{% block body %}
    <div class="container mt-3">
        <h2>Series</h2>
        <table class="table table-striped">
            <thead><tr><th>Title</th><th>Actions</th></tr></thead>
            <tbody>
            {% for serie in series %}
                <tr>
                    <td>{{ serie.title }}</td>
                    <td><a href="{{ path('series_view', {id: serie.id}) }}" class="btn btn-sm btn-primary">View</a></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
