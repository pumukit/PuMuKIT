{% extends '@Shared/UI/Backend/Templates/layout/layout.html.twig' %}

{% block body %}
    <div class="container-fluid mt-3">
{#        {% include '@Shared/UI/Backend/Templates/partials/_title.html.twig' with {'page_title': "Series"} %}#}

        {% include '@Series/UI/Backend/Pages/partials/_series_header.html.twig' with {
            series: series,
            multimediaObjects: multimediaObjects
        } %}

        <ul class="nav nav-tabs modern-tabs text-uppercase small">
            <li class="nav-item">
                <a class="nav-link {{ tab == 'objects' ? 'active' : '' }}" href="{{ path('series_view', {id: series.id, tab: 'objects'}) }}">
                    <i class="fa-solid fa-photo-film"></i> {{ "Multimedia Objects"|trans }}
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link {{ tab == 'edit' ? 'active' : '' }}" href="{{ path('series_view', {id: series.id, tab: 'edit'}) }}">
                    <i class="fa-solid fa-edit"></i> {{ "Series"|trans }}
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link {{ tab == 'template' ? 'active' : '' }}" href="{{ path('series_view', {id: series.id, tab: 'template'}) }}">
                    <i class="fa-solid fa-file-lines"></i> {{ "Template"|trans }}
                </a>
            </li>
        </ul>


        <div class="mt-3">
            {% include '@Series/UI/Backend/Pages/tabs/' ~ tab ~ '.html.twig' %}
        </div>

    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .modern-tabs .nav-link {
            font-weight: 500;
            color: #6c757d;
            border: none;
            position: relative;
            transition: color 0.25s ease, transform 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .modern-tabs .nav-link:hover {
            color: #0d6efd;
            transform: translateY(-2px);
        }

        .modern-tabs .nav-link.active {
            color: #0d6efd;
            font-weight: 600;
            border-bottom: 3px solid #0d6efd;
            background-color: transparent;
        }

        .modern-tabs .nav-link i {
            font-size: 1rem;
            opacity: 0.8;
        }

        .modern-tabs .nav-link.active i {
            opacity: 1;
            color: #0d6efd;
        }
    </style>
{% endblock %}
