{% include '@Shared/UI/Backend/Templates/components/table/_table.html.twig' with {
    id: 'multimediaObjectsTable',
    server_side: true,
    ajax_url: path('series_multimedia_data', {id: series.id}),
    checkbox: true,
    toolbar: '#multimedia-bulk-action-toolbar',
    columns: [
        {'field': 'thumbnail', 'label': 'Image'},
        {'field': 'title', 'label': 'Title', 'sortable': true, 'truncate': true},
        {'field': 'type', 'label': 'Type', 'sortable': true},
        {'field': 'status', 'label': 'Status', 'sortable': true},
        {'field': 'hide', 'label': 'Hide', 'formatter': 'boolean'},
        {'field': 'duration', 'label': 'Duration', 'sortable': true},
        {'field': 'public_date', 'label': 'Record Date', 'sortable': true},
        {'field': 'record_date', 'label': 'Public Date', 'sortable': true},
        {'field': 'actions', 'label': 'Actions', 'align': 'right'}
    ],
} %}

{% if multimediaObjectCustomActions is defined and multimediaObjectCustomActions is not empty %}
    <div class="mb-3">
        {% include '@MultimediaObject/UI/Backend/Pages/partials/_actions.html.twig' with {
            customActions: multimediaObjectCustomActions
        } %}
    </div>
{% endif %}
