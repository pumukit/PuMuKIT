<div id="bulk-action-toolbar" class="d-flex gap-2 mb-2">
    <select id="bulk-action-select" class="form-select" data-operations='{{ bulk_operations_config|default('{}')|raw }}'>
        <option value="">Seleccionar una opción...</option>
        {% if bulkOperations is defined and bulkOperations is not empty %}
            {% for operation in bulkOperations %}
                <option
                    value="{{ operation.key }}"
                    data-type="{{ operation.type }}"
                    data-handler="{{ operation.handler }}"
                    {% if operation.icon %}data-icon="{{ operation.icon }}"{% endif %}
                    {% if operation.confirm_message %}data-confirm="{{ operation.confirm_message }}"{% endif %}>
                    {% if operation.icon %}<i class="fa {{ operation.icon }}"></i> {% endif %}
                    {{ operation.label }}
                </option>
            {% endfor %}
        {% endif %}
    </select>
    <button id="bulk-action-apply" class="btn btn-sm btn-pumukit">Aplicar</button>
</div>

<script>
(function() {
    'use strict';

    document.addEventListener('DOMContentLoaded', function() {
        const selectElement = document.getElementById('bulk-action-select');
        const applyButton = document.getElementById('bulk-action-apply');
        const tableElement = document.querySelector('[data-toolbar="#bulk-action-toolbar"]');

        if (!selectElement || !applyButton || !tableElement) {
            console.error('Bulk operations: Required elements not found');
            return;
        }

        applyButton.addEventListener('click', function() {
            const selectedOption = selectElement.options[selectElement.selectedIndex];
            const operation = selectedOption.value;

            if (!operation) {
                alert('Por favor seleccione una operación');
                return;
            }

            const selectedRows = $(tableElement).bootstrapTable('getSelections');

            if (selectedRows.length === 0) {
                alert('Por favor seleccione al menos un elemento');
                return;
            }

            const selectedIds = selectedRows.map(row => row.id);
            const handler = selectedOption.getAttribute('data-handler');
            const type = selectedOption.getAttribute('data-type');
            const confirmMessage = selectedOption.getAttribute('data-confirm');

            if (confirmMessage && !confirm(confirmMessage)) {
                return;
            }

            if (type === 'url') {
                executeBulkOperation(handler, selectedIds, tableElement);
            } else if (type === 'js') {
                if (typeof window[handler] === 'function') {
                    window[handler](selectedIds);
                } else {
                    console.error('Bulk operation handler not found:', handler);
                    alert('Error: Handler de operación no encontrado');
                }
            }

            selectElement.selectedIndex = 0;
        });

        function executeBulkOperation(url, ids, tableElement) {
            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ ids: ids })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message || 'Operación completada exitosamente');
                    $(tableElement).bootstrapTable('refresh');
                } else {
                    let errorMsg = data.message || 'Error al ejecutar la operación';
                    if (data.errors && data.errors.length > 0) {
                        errorMsg += '\n\nErrores:\n' + data.errors.join('\n');
                    }
                    alert(errorMsg);
                    if (data.deleted_count > 0) {
                        $(tableElement).bootstrapTable('refresh');
                    }
                }
            })
            .catch(error => {
                console.error('Error executing bulk operation:', error);
                alert('Error al ejecutar la operación');
            });
        }
    });
})();
</script>

