{% extends '@Shared/UI/Backoffice/Views/layout/layout.html.twig' %}

{% block body %}
<div class="container-fluid mt-3">
    {% include '@Shared/UI/Backoffice/Views/partials/_title.html.twig' with {'page_title': 'streaming.page.list'|trans({}, 'streaming')} %}

    {% include '@Shared/UI/Backoffice/Views/components/table/_table.html.twig' with {
        id: 'channelsTable',
        title: 'streaming.table.title'|trans({}, 'streaming'),
        server_side: true,
        ajax_url: path('streaming_channels_list_data'),
        checkbox: true,
        bulk_operations_template: '@Streaming/UI/Backoffice/Views/partials/_bulk_operations.html.twig',
        columns: [
            {'field': 'id', 'label': 'ID', 'visible': false},
            {'field': 'name', 'label': 'streaming.table.name'|trans({}, 'streaming'), 'sortable': true},
            {'field': 'source_name', 'label': 'streaming.table.source'|trans({}, 'streaming'), 'sortable': true},
            {'field': 'url', 'label': 'streaming.table.url'|trans({}, 'streaming'), 'sortable': false},
            {'field': 'live_type', 'label': 'streaming.table.type'|trans({}, 'streaming'), 'sortable': true},
            {'field': 'broadcasting', 'label': 'streaming.table.broadcasting'|trans({}, 'streaming'), 'sortable': true},
            {'field': 'index_play', 'label': 'streaming.table.index_play'|trans({}, 'streaming'), 'sortable': false},
            {'field': 'chat', 'label': 'streaming.table.chat'|trans({}, 'streaming'), 'sortable': false},
            {'field': 'actions', 'label': 'streaming.table.actions'|trans({}, 'streaming'), 'align': 'right'}
        ]
    } %}

    {% include '@Streaming/UI/Backoffice/Views/partials/_actions.html.twig' %}
</div>
{% endblock %}


