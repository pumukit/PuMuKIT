<div class="card shadow-sm">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0"><i class="fa fa-video"></i> {{ 'playlist.objects.header'|trans({}, 'playlist') }}</h5>
    </div>
    <div class="card-body">
        <p class="text-muted">
            {{ 'playlist.objects.count'|trans({'%count%': playlist.getPlaylist().getMultimediaObjects().count()}, 'playlist') }}
        </p>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>{{ 'playlist.objects.table.thumbnail'|trans({}, 'playlist') }}</th>
                        <th>{{ 'playlist.objects.table.title'|trans({}, 'playlist') }}</th>
                        <th>{{ 'playlist.objects.table.status'|trans({}, 'playlist') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for mmobj in playlist.getPlaylist().getMultimediaObjects() %}
                        <tr>
                            <td>
                                <img src="{{ mmobj.getMainThumbnail(app.request.scheme, app.request.host) }}"
                                     alt="{{ mmobj.getTitle() }}"
                                     width="80"
                                     class="rounded">
                            </td>
                            <td>{{ mmobj.getTitle() }}</td>
                            <td>
                                {% if mmobj.isPublished() %}
                                    <span class="badge bg-success">{{ 'playlist.objects.status.published'|trans({}, 'playlist') }}</span>
                                {% elseif mmobj.isHidden() %}
                                    <span class="badge bg-warning">{{ 'playlist.objects.status.hidden'|trans({}, 'playlist') }}</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ 'playlist.objects.status.blocked'|trans({}, 'playlist') }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center text-muted">
                                {{ 'playlist.objects.empty'|trans({}, 'playlist') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

