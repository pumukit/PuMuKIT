<div class="card shadow-sm">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0"><i class="fa fa-video"></i> {{ "Multimedia Objects in Playlist"|trans }}</h5>
    </div>
    <div class="card-body">
        <p class="text-muted">
            {{ "This playlist contains %count% multimedia objects"|trans({'%count%': playlist.getPlaylist().getMultimediaObjects().count()}) }}
        </p>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>{{ "Thumbnail"|trans }}</th>
                        <th>{{ "Title"|trans }}</th>
                        <th>{{ "Status"|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for mmobj in playlist.getPlaylist().getMultimediaObjects() %}
                        <tr>
                            <td>
                                <img src="{{ mmobj.getMainThumbnail(app.request.scheme, app.request.host) }}"
                                     alt="{{ mmobj.getTitle() }}"
                                     width="80"
                                     class="rounded">
                            </td>
                            <td>{{ mmobj.getTitle() }}</td>
                            <td>
                                {% if mmobj.isPublished() %}
                                    <span class="badge bg-success">{{ "Published"|trans }}</span>
                                {% elseif mmobj.isHidden() %}
                                    <span class="badge bg-warning">{{ "Hidden"|trans }}</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ "Blocked"|trans }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center text-muted">
                                {{ "No multimedia objects in this playlist"|trans }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

