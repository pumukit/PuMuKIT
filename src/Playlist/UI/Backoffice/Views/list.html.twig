{% extends '@Shared/UI/Backoffice/Views/layout/layout.html.twig' %}

{% block body %}
<div class="container-fluid mt-3">
    {% include '@Shared/UI/Backoffice/Views/partials/_title.html.twig' with {'page_title': 'Playlist List'} %}

    {% include '@Shared/UI/Backoffice/Views/components/table/_table.html.twig' with {
        id: 'playlistTable',
        title: 'Playlists',
        server_side: true,
        ajax_url: path('playlist_list_data'),
        checkbox: true,
        columns: [
            {'field': 'thumbnail', 'label': 'Image'},
            {'field': 'title', 'label': 'Title', 'sortable': true},
            {'field': 'public_date', 'label': 'Publication Date', 'sortable': true},
            {'field': 'hide', 'label': 'Hide'},
            {'field': 'objectCount', 'label': 'Objects'},
            {'field': 'actions', 'label': 'Actions', 'align': 'right'}
        ]
    } %}

    {% include '@Playlist/UI/Backoffice/Views/partials/_actions.html.twig' %}
</div>
{% endblock %}

