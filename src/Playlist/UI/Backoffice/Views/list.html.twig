{% extends '@Shared/UI/Backoffice/Views/layout/layout.html.twig' %}

{% block body %}
<div class="container-fluid mt-3">
    {% include '@Shared/UI/Backoffice/Views/partials/_title.html.twig' with {'page_title': 'playlist.page.list'|trans({}, 'playlist')} %}

    {% include '@Shared/UI/Backoffice/Views/components/table/_table.html.twig' with {
        id: 'playlistTable',
        title: 'playlist.table.title'|trans({}, 'playlist'),
        server_side: true,
        ajax_url: path('playlist_list_data'),
        checkbox: true,
        bulk_operations_template: '@Playlist/UI/Backoffice/Views/partials/_bulk_operations.html.twig',
        columns: [
            {'field': 'thumbnail', 'label': 'playlist.table.thumbnail'|trans({}, 'playlist')},
            {'field': 'title', 'label': 'playlist.table.title_column'|trans({}, 'playlist'), 'sortable': true},
            {'field': 'public_date', 'label': 'playlist.table.public_date'|trans({}, 'playlist'), 'sortable': true},
            {'field': 'hide', 'label': 'playlist.table.hide'|trans({}, 'playlist')},
            {'field': 'objectCount', 'label': 'playlist.table.objects'|trans({}, 'playlist')},
            {'field': 'actions', 'label': 'playlist.table.actions'|trans({}, 'playlist'), 'align': 'right'}
        ]
    } %}

    {% include '@Shared/UI/Backoffice/Views/partials/_actions.html.twig' with {
        translationDomain: 'playlist'
    } %}
</div>
{% endblock %}

