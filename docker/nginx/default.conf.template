server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_tokens off;

    ssl_certificate /etc/nginx/ssl/cert.crt;
    ssl_certificate_key /etc/nginx/ssl/cert.key;

    client_max_body_size 10000m;
    client_body_buffer_size 128k;

    server_name localhost;
    root /srv/pumukit/public;

    # Security headers
    add_header_inherit merge;
    add_header X-Content-Type-Options "nosniff" always;

    # Block direct access to storage
    location ^~ /storage {
        deny all;
        return 404;
    }

    # Public uploads
    location ^~ /uploads {
        access_log off;
        add_header Cache-Control "public, max-age=86400";
    }

    # Bundles (Symfony assets)
    location ^~ /bundles {
        access_log off;
        add_header Cache-Control "public, max-age=31536000";
        expires 1y;
    }

    # Deny access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # WebTV/Admin dynamic CSS/JS (generated by Symfony from Twig)
    location ~* ^/(webtv|admin)/(?:css|js)/ {
        try_files $uri /index.php$is_args$args;
    }

    # Static media: images, fonts, etc (NO videos - must go through /trackfile with tokens)
    location ~* \.(?:jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|css|js|woff|woff2|ttf|eot)$ {
        access_log off;
        add_header Cache-Control "public, max-age=86400";
        expires 1d;
        try_files $uri /index.php$is_args$args;
    }

    # Trackfile routes - MUST validate tokens (WSTG-ATHN-04 protection)
    # ^~ takes precedence over any regex location (including the static media block above),
    # so every /trackfile/* request (images, documents, video, audio, HLS) is routed through
    # the token-validating controller regardless of its extension.
    location ^~ /trackfile/ {
        try_files $uri /index.php$is_args$args;
    }

    location ^~ /internal-storage/ {
        internal;
        alias ${PUMUKIT_STORAGE_DIR}/;
    }

    location / {
        try_files $uri /index.php$is_args$args;
    }

    # PHP-FPM handler
    location ~ ^/index\.php(/|$) {
        fastcgi_pass php:9000;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;

        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_X_SENDFILE_TYPE X-Accel-Redirect;
        fastcgi_param HTTP_X_ACCEL_MAPPING ${PUMUKIT_STORAGE_DIR}/=/internal-storage/;
        fastcgi_param HTTP_X_FORWARDED_FOR $remote_addr;
    }

    # Deny access to any other .php files
    location ~ \.php$ {
        return 404;
    }

    error_log /var/log/nginx/pumukit_error.log;
    access_log /var/log/nginx/pumukit_access.log;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_tokens off;

    ssl_certificate /etc/nginx/ssl/cert.crt;
    ssl_certificate_key /etc/nginx/ssl/cert.key;

    server_name ${PUMUKIT_DLS_HOST};

    location / {
        proxy_pass http://dls;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    error_log /var/log/nginx/dls_error.log;
    access_log /var/log/nginx/dls_access.log;
}
