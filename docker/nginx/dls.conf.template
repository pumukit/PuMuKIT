include /etc/nginx/pumukit-dls/http.conf;

server {
    listen 80;
    listen [::]:80;
    server_tokens off;

    server_name _;

    include /etc/nginx/pumukit-dls/locations.conf;

    location / {
        include /etc/nginx/pumukit-dls/headers.conf;
        return 404;
    }

    error_log /var/log/nginx/dls_error.log;
    access_log /var/log/nginx/dls_access.log;
}
