# =============================================================================
# PuMuKIT - Download Server vhost (descarga.localhost)
# =============================================================================
#
# DEPLOYMENT NOTE: Set PUMUKIT_DLS_BACKEND in docker/.env (or as an environment
# variable) to point to the Pumukit application server.
# - Co-located deployment (default): 127.0.0.1:443
# - Separate DLS server: pumukit.your-domain.com:443
upstream pumukit_app {
    server ${PUMUKIT_DLS_BACKEND};
}
#
# =============================================================================
#
# This vhost serves encoded media files from the downloads directory.
# SECURITY: ALL requests must pass HMAC-SHA256 token validation via
# nginx auth_request before any file is served. This prevents unauthenticated
# access even when MongoDB ObjectIds are known/enumerated.
#
# Flow:
#   1. Client requests: GET /downloads/<SeriesId>/<JobId>.mp4?token=X&expires=Y&resource=Z
#   2. nginx calls Symfony: GET /download/validate-token?token=X&expires=Y&resource=Z
#   3. Symfony validates HMAC-SHA256 → returns 200 (allow) or 401 (deny)
#   4. nginx serves the file (200) or returns 401 to the client
#
# The token is generated by TrackUrlService and appended by TrackFileController
# when redirecting to this server. Direct access without a valid token is blocked.
# =============================================================================

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    ssl_certificate     /etc/nginx/ssl/cert.crt;
    ssl_certificate_key /etc/nginx/ssl/cert.key;

    server_name descarga.localhost;

    # Root points to the downloads directory
    root /srv/pumukit/public/storage/downloads;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    # No directory listings
    autoindex off;

    # ==========================================================================
    # All media files require a valid token
    # ==========================================================================
    location / {
        auth_request /_validate_token;

        # Pass the auth status to use in error handling
        auth_request_set $auth_status $upstream_status;

        # On auth failure → 401
        error_page 401 = @unauthorized;

        # Serve the file or 404
        try_files $uri =404;

        # Cache headers for authenticated responses
        add_header Cache-Control "private, no-store" always;
    }

    # ==========================================================================
    # Internal auth subrequest to Symfony (calls DownloadAuthController)
    # The original query string (?token=...&expires=...&resource=...) is passed
    # to Symfony via $args. Symfony validates the HMAC and returns
    # 200 (valid token) or 401 (invalid/missing/expired token).
    #
    # proxy_pass is used instead of fastcgi_pass so this config works whether
    # the DLS is co-located with Pumukit or deployed on a separate server.
    # Update the 'pumukit_app' upstream at the top of this file accordingly.
    # ==========================================================================
    location = /_validate_token {
        internal;

        proxy_pass https://pumukit_app/download/validate-token?$args;
        proxy_ssl_verify          off;
        proxy_pass_request_body   off;
        proxy_set_header Content-Length "";
        proxy_set_header Host             localhost;
        proxy_set_header X-Original-URI  $request_uri;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # ==========================================================================
    # Unauthorized response
    # ==========================================================================
    location @unauthorized {
        add_header Content-Type "application/json" always;
        return 401 '{"error":"Access denied: invalid, missing, or expired authentication token."}';
    }

    # Deny hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    error_log  /var/log/nginx/pumukit_download_error.log;
    access_log /var/log/nginx/pumukit_download_access.log;
}
