{
    "name": "pumukit/pumukit",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "description": "Media Portal",
    "require": {
        "php": "^8.5",
        "ext-amqp": "*",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mongodb": "*",
        "ext-sysvsem": "*",
        "ankitpokhrel/tus-php": "^2.4",
        "api-platform/core": "^5.0",
        "babdev/pagerfanta-bundle": "^4",
        "doctrine/mongodb-odm": "^2.17",
        "doctrine/mongodb-odm-bundle": "^5.6",
        "gedmo/doctrine-extensions": "^3.22",
        "jaybizzle/crawler-detect": "^1.2",
        "jms/serializer-bundle": "^5.2",
        "knplabs/knp-menu-bundle": "^3.7",
        "mobiledetect/mobiledetectlib": "^4",
        "mongodb/mongodb": "^2.5",
        "pagerfanta/doctrine-collections-adapter": "^4",
        "pagerfanta/doctrine-mongodb-odm-adapter": "^4",
        "pagerfanta/twig": "^4",
        "phpdocumentor/reflection-docblock": "^6.0",
        "symfony/amqp-messenger": "*",
        "symfony/asset": "*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/dotenv": "*",
        "symfony/event-dispatcher": "*",
        "symfony/expression-language": "*",
        "symfony/flex": "^2",
        "symfony/form": "*",
        "symfony/html-sanitizer": "*",
        "symfony/http-kernel": "*",
        "symfony/intl": "*",
        "symfony/lock": "*",
        "symfony/mailer": "*",
        "symfony/messenger": "*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/rate-limiter": "*",
        "symfony/security-bundle": "*",
        "symfony/serializer": "*",
        "symfony/stimulus-bundle": "^3.6",
        "symfony/translation": "*",
        "symfony/twig-bundle": "*",
        "symfony/ux-translator": "^3.6",
        "symfony/validator": "*",
        "symfony/yaml": "*",
        "twig/extra-bundle": "^3.19",
        "twig/intl-extra": "^3.19"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-doctrine": "^2",
        "phpstan/phpstan-symfony": "^2",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2",
        "symfony/browser-kit": "*",
        "symfony/css-selector": "*",
        "symfony/debug-bundle": "*",
        "symfony/phpunit-bridge": "*",
        "symfony/var-dumper": "*",
        "symfony/web-profiler-bundle": "*"
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "lint-xliff": [
            "bin/console lint:xliff src/Pumukit/BaseLivePlayerBundle",
            "bin/console lint:xliff src/Pumukit/BasePlayerBundle",
            "bin/console lint:xliff src/Pumukit/CoreBundle",
            "bin/console lint:xliff src/Pumukit/EncoderBundle",
            "bin/console lint:xliff src/Pumukit/InspectionBundle",
            "bin/console lint:xliff src/Pumukit/NewAdminBundle",
            "bin/console lint:xliff src/Pumukit/NotificationBundle",
            "bin/console lint:xliff src/Pumukit/PaellaPlayerBundle",
            "bin/console lint:xliff src/Pumukit/SchemaBundle",
            "bin/console lint:xliff src/Pumukit/StatsBundle",
            "bin/console lint:xliff src/Pumukit/StatsUIBundle",
            "bin/console lint:xliff src/Pumukit/WebTVBundle",
            "bin/console lint:xliff src/Pumukit/WizardBundle",
            "bin/console lint:xliff src/Pumukit/WorkflowBundle",
            "bin/console lint:xliff translations"
        ],
        "lint-yaml": [
            "bin/console lint:yaml src",
            "bin/console lint:yaml config"
        ],
        "lint-twig": [
            "bin/console lint:twig src",
            "bin/console lint:twig templates"
        ],
        "lint-generic": [
            "bin/check/php_syntax",
            "bin/check/console_log"
        ],
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix src --dry-run --using-cache=no -v",
        "php-stan": [
            "vendor/bin/phpstan analyse -l 1 src"
        ],
        "php-rector": "vendor/bin/rector process src --dry-run",
        "tests": "APP_ENV=test vendor/bin/phpunit",
        "tests-smoke": "APP_ENV=test vendor/bin/phpunit --group smoke",
        "ci": [
            "@lint-yaml",
            "@lint-twig",
            "@lint-xliff",
            "@lint-generic",
            "@php-cs-fixer",
            "@php-stan",
            "@php-rector",
            "@tests"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Pumukit\\": "src/Pumukit/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "Pumukit\\Tests\\": "tests/"
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
