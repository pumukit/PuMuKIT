            <!-- Bulk Delete Messages -->
            <trans-unit id="group.bulk_delete.success">
                <source>group.bulk_delete.success</source>
                <target>All selected groups were deleted successfully.</target>
            </trans-unit>
            <trans-unit id="group.bulk_delete.partial_success">
                <source>group.bulk_delete.partial_success</source>
                <target>Some groups were deleted, but errors occurred with others.</target>
            </trans-unit>
            <trans-unit id="group.bulk_delete.error.no_ids">
                <source>group.bulk_delete.error.no_ids</source>
                <target>No groups were selected for deletion.</target>
            </trans-unit>
            <trans-unit id="group.bulk_delete.error.all_failed">
                <source>group.bulk_delete.error.all_failed</source>
                <target>Failed to delete all selected groups.</target>
            </trans-unit>
            <trans-unit id="group.bulk_delete.confirm">
                <source>group.bulk_delete.confirm</source>
                <target>Are you sure you want to delete the selected groups? This action cannot be undone.</target>
