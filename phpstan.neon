includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-symfony/extension.neon

parameters:
    doctrine:
        objectManagerLoader: bin/object-manager.php
    ignoreErrors:
        # OpencastBundle is an optional dependency (not installed by default).
        - message: '#has invalid type Pumukit\\OpencastBundle\\Services\\Client#'
          path: src/Pumukit/PaellaPlayerBundle/Services/FrameListManifest.php
