includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-symfony/extension.neon

parameters:
    level: 2
    paths:
        - src
    doctrine:
        objectManagerLoader: bin/object-manager.php
    ignoreErrors:
        -
            identifier: constructor.unusedParameter
            path: src/Pumukit/BasePlayerBundle/Controller/TrackFileController.php
