includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-symfony/extension.neon

parameters:
    level: 5
    treatPhpDocTypesAsCertain: false
    paths:
        - src
    doctrine:
        objectManagerLoader: bin/object-manager.php
    ignoreErrors:
        -
            identifier: property.onlyWritten
            message: '#UserService::\$personalScopeDeleteOwners#'
            path: src/Pumukit/SchemaBundle/Services/UserService.php
        -
            identifier: argument.type
            message: '#^Parameter \$keys of attribute class Doctrine\\ODM\\MongoDB\\Mapping\\Attribute\\Index constructor#'

services:
    -
        class: Pumukit\Tests\PHPStan\OdmMappedPropertiesExtension
        tags:
            - phpstan.properties.readWriteExtension
